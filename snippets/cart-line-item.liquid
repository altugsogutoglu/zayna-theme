{% doc %}
  Renders a single cart line item (image, title, options, quantity stepper, remove, line price).
  Quantity/remove buttons carry the target quantity; assets/cart.js submits the change.
  @param {object} line_item - A cart line_item object.
  @param {string} [layout] - 'drawer' (default) or 'page'.
  @example
  {% render 'cart-line-item', line_item: item, layout: 'drawer' %}
{% enddoc %}
{%- liquid
  assign li = line_item
  assign img = li.image
  assign show_options = false
  unless li.product.has_only_default_variant
    assign show_options = true
  endunless
  assign dec_qty = li.quantity | minus: 1
  assign inc_qty = li.quantity | plus: 1
  assign unit_price_cents = li.final_price

  assign cart_display_title = li.product.title
  assign cart_display_meta = ''

  if li.product.handle == 'digitale-weeglepel-500g-0-1g'
    assign cart_display_title = 'Digitale weeglepel'
    assign cart_display_meta = 'Tot 500 g · nauwkeurig tot 0,1 g'
  elsif li.product.handle == 'voorraadpot-600ml-borosilicaatglas'
    assign cart_display_title = 'Glazen voorraadpot – 600 ml'
    assign cart_display_meta = 'Borosilicaatglas · Luchtdicht'
  elsif li.product.handle == 'set-van-12-vierkante-kruidenpotten-120-ml-incl-labels-trechter-borosilicaat-glas'
    assign cart_display_title = 'Kruidenpotten set – 12 stuks'
    assign cart_display_meta = '120 ml per pot · Bamboe deksel'
  elsif li.product.handle == 'theepotset-dua-450-ml-1300-ml-borosilicaat-glas-met-rvs-filter'
    assign cart_display_title = 'Theepotset Dua'
    assign cart_display_meta = '450 ml + 1300 ml · RVS-filter'
  elsif li.product.handle == 'glazen-drinkglas-300-ml-hoog-borosilicaatglas'
    assign cart_display_title = 'Glazen drinkglas – 300 ml'
    assign cart_display_meta = 'Borosilicaatglas · Vaatwasserbestendig'
  elsif li.product.handle == 'vierkante-wandhaak-zwart'
    assign cart_display_title = 'Vierkante wandhaken – zwart'
    assign cart_display_meta = 'Set van 2 · Zelfklevend'
  endif
-%}
<li
  data-cart-line
  data-line-key="{{ li.key }}"
  data-unit-price-cents="{{ unit_price_cents }}"
  data-current-quantity="{{ li.quantity }}"
  class="zh-cart-line"
>
  {%- if img -%}
    <a href="{{ li.url }}" class="zh-cart-line__media">
      {{ img | image_url: width: 200 | image_tag:
        loading: 'lazy', width: 100, height: 100,
        alt: li.title,
        class: 'zh-cart-line__image' }}
    </a>
  {%- endif -%}

  <div class="zh-cart-line__main">
    <div class="zh-cart-line__top">
      <div class="min-w-0 flex-1">
        <a
          href="{{ li.url }}"
          class="zh-cart-line__title-link"
        >
          <span class="zh-cart-line__title">{{ cart_display_title }}</span>
        </a>
        {%- if cart_display_meta != blank -%}
          <p class="zh-cart-line__meta">
            {{ cart_display_meta }}
          </p>
        {%- endif -%}
      </div>
      <button type="button" data-cart-change data-line-key="{{ li.key }}" data-quantity="0" aria-label="Verwijderen uit winkelmand" class="zh-cart-line__remove">
        {% render 'icon', name: 'trash', size: 15 %}
      </button>
    </div>

    {%- if show_options -%}
      <ul class="zh-cart-line__options">
        {%- for opt in li.options_with_values -%}
          {%- unless opt.value == 'Default Title' -%}
            <li><small class="zh-cart-line__option">{{ opt.name }}: {{ opt.value }}</small></li>
          {%- endunless -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if li.selling_plan_allocation -%}
      <small class="zh-cart-line__option">{{ li.selling_plan_allocation.selling_plan.name }}</small>
    {%- endif -%}

    <div class="zh-cart-line__bottom">
      <div data-qty-stepper class="zh-cart-qty" role="group" aria-label="Aantal">
        <button
          type="button"
          data-cart-change
          data-step="dec"
          data-line-key="{{ li.key }}"
          data-quantity="{{ dec_qty }}"
          aria-label="{% if li.quantity <= 1 %}Product verwijderen{% else %}Aantal verlagen{% endif %}"
          class="zh-cart-qty__button"
        >
          {% render 'icon', name: 'minus', size: 14 %}
        </button>
        <span data-line-qty aria-live="polite" class="zh-cart-qty__value">{{ li.quantity }}</span>
        <button type="button" data-cart-change data-step="inc" data-line-key="{{ li.key }}" data-quantity="{{ inc_qty }}" aria-label="Aantal verhogen" class="zh-cart-qty__button">
          {% render 'icon', name: 'plus', size: 14 %}
        </button>
      </div>
      <div
        class="zh-cart-line__price"
        data-line-price
        data-line-price-cents="{{ li.final_line_price }}"
      >
        {{ li.final_line_price | money }}
      </div>
    </div>
  </div>
</li>