{%- comment -%}
  Zayna Home — rustig mobiel menu, fase 2U.
  Doel: nog compacter, zachtere lijnen en minder drawer-zwaarte.
{%- endcomment -%}

{%- liquid
  assign menu = section_menu | default: 'main-menu'
-%}

<div class="zayna-mobile-menu">
  <nav
    aria-label="Hoofdnavigatie"
    class="zayna-mobile-menu__nav"
  >
    <p class="zayna-mobile-menu__label">
      {{ 'general.accessibility.menu' | t }}
    </p>

    <ul class="zayna-mobile-menu__main-list">
      <li>
        <a
          href="{{ routes.root_url }}"
          data-aside-close
          class="zayna-mobile-menu__main-link{% if request.page_type == 'index' %} is-active{% endif %}"
          {% if request.page_type == 'index' %}aria-current="page"{% endif %}
        >
          <span>Home</span>
        </a>
      </li>

      {%- for link in linklists[menu].links -%}
        {%- assign link_key = link.title | downcase | strip -%}

        {%- unless link_key == 'home' -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details
                class="zayna-mobile-menu__details"
                {% if link.active or link.child_active %}open{% endif %}
              >
                <summary
                  class="zayna-mobile-menu__summary{% if link.active or link.child_active %} is-active{% endif %}"
                >
                  <span>{{ link.title | escape }}</span>

                  <span
                    aria-hidden="true"
                    class="zayna-mobile-menu__toggle"
                  >
                    <span class="zayna-mobile-menu__plus">+</span>
                    <span class="zayna-mobile-menu__minus">−</span>
                  </span>
                </summary>

                <div class="zayna-mobile-menu__submenu">
                  <p class="zayna-mobile-menu__submenu-label">
                    Shop per categorie
                  </p>

                  <ul class="zayna-mobile-menu__categories">
                    <li class="zayna-mobile-menu__category-all">
                      <a
                        href="{{ routes.all_products_collection_url }}"
                        data-aside-close
                        class="zayna-mobile-menu__all-products"
                      >
                        Alle producten
                      </a>
                    </li>

                    {%- for child in link.links -%}
                      <li>
                        <a
                          href="{{ child.url }}"
                          data-aside-close
                          class="zayna-mobile-menu__category-link{% if child.active %} is-active{% endif %}"
                          {% if child.active %}aria-current="page"{% endif %}
                        >
                          {{ child.title | escape }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              </details>
            {%- else -%}
              <a
                href="{{ link.url }}"
                data-aside-close
                class="zayna-mobile-menu__main-link{% if link.active %} is-active{% endif %}"
                {% if link.active %}aria-current="page"{% endif %}
              >
                <span>{{ link.title | escape }}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </nav>

  <section
    aria-label="Service"
    class="zayna-mobile-menu__service"
  >
    <p class="zayna-mobile-menu__label">
      Service
    </p>

    <ul class="zayna-mobile-menu__service-list">
      <li>
        <button
          type="button"
          data-aside-open="search"
          class="zayna-mobile-menu__service-link"
        >
          {{ 'general.accessibility.search' | t }}
        </button>
      </li>

      <li>
        <a
          href="/pages/retour-aanmelden"
          data-aside-close
          class="zayna-mobile-menu__service-link"
        >
          Retour aanmelden
        </a>
      </li>

      <li>
        <a
          href="/policies/shipping-policy"
          data-aside-close
          class="zayna-mobile-menu__service-link"
        >
          Verzending
        </a>
      </li>

      <li>
        <a
          href="/policies/refund-policy"
          data-aside-close
          class="zayna-mobile-menu__service-link"
        >
          Retourneren
        </a>
      </li>
    </ul>
  </section>

  <div class="zayna-mobile-menu__footer">
    <p>
      Met zorg geselecteerd en verzonden vanuit Nederland.
    </p>
  </div>
</div>

{% style %}
  .zayna-mobile-menu {
    display: flex;
    width: 100%;
    min-height: 100%;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #fbf7f2;
    color: #2b2622;
    -webkit-overflow-scrolling: touch;
  }

  .zayna-mobile-menu__nav {
    padding: 15px 24px 0;
  }

  .zayna-mobile-menu__label {
    margin: 0 0 10px;
    color: rgba(43, 38, 34, 0.40);
    font-size: 9px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .zayna-mobile-menu__main-list,
  .zayna-mobile-menu__categories,
  .zayna-mobile-menu__service-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zayna-mobile-menu__main-list {
    border-top: 1px solid rgba(42, 37, 32, 0.038);
  }

  .zayna-mobile-menu__main-link,
  .zayna-mobile-menu__summary {
    display: flex;
    width: 100%;
    min-height: 41px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0;
    padding: 7px 0;
    border: 0;
    border-bottom: 1px solid rgba(42, 37, 32, 0.042);
    background: transparent;
    color: #2b2622;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(18.5px, 4.8vw, 20.5px);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.014em;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 160ms ease,
      background-color 160ms ease;
  }

  .zayna-mobile-menu__main-link.is-active,
  .zayna-mobile-menu__summary.is-active {
    color: #8f5732;
  }

  .zayna-mobile-menu__main-link:focus-visible,
  .zayna-mobile-menu__summary:focus-visible {
    position: relative;
    z-index: 1;
    outline: 1px solid rgba(166, 106, 63, 0.46);
    outline-offset: 3px;
  }

  .zayna-mobile-menu__summary {
    list-style: none;
  }

  .zayna-mobile-menu__summary::-webkit-details-marker {
    display: none;
  }

  .zayna-mobile-menu__summary::marker {
    content: "";
  }

  .zayna-mobile-menu__details[open]
  > .zayna-mobile-menu__summary:not(.is-active) {
    color: #2b2622;
  }

  .zayna-mobile-menu__toggle {
    display: grid;
    width: 20px;
    height: 30px;
    flex: 0 0 20px;
    place-items: center;
    color: rgba(43, 38, 34, 0.48);
    font-family: Arial, sans-serif;
    font-size: 15.5px;
    font-weight: 300;
    line-height: 1;
    transition: color 160ms ease;
  }

  .zayna-mobile-menu__details[open]
  > .zayna-mobile-menu__summary
  .zayna-mobile-menu__toggle {
    color: #8f5732;
  }

  .zayna-mobile-menu__plus,
  .zayna-mobile-menu__minus {
    grid-area: 1 / 1;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .zayna-mobile-menu__minus {
    opacity: 0;
    transform: rotate(-45deg);
  }

  .zayna-mobile-menu__details[open]
  .zayna-mobile-menu__plus {
    opacity: 0;
    transform: rotate(45deg);
  }

  .zayna-mobile-menu__details[open]
  .zayna-mobile-menu__minus {
    opacity: 1;
    transform: rotate(0);
  }

  .zayna-mobile-menu__submenu {
    padding: 10px 0 12px;
    border-bottom: 1px solid rgba(42, 37, 32, 0.042);
    background: transparent;
  }

  .zayna-mobile-menu__submenu-label {
    margin: 0 0 7px;
    color: rgba(43, 38, 34, 0.38);
    font-size: 8.4px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .zayna-mobile-menu__categories {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .zayna-mobile-menu__category-all {
    margin-bottom: 5px;
  }

  .zayna-mobile-menu__all-products {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    color: #8f5732;
    font-size: 12.1px;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease;
  }

  .zayna-mobile-menu__all-products::after {
    display: inline-block;
    margin-left: 8px;
    color: rgba(143, 87, 50, 0.58);
    content: "→";
    transition: transform 160ms ease;
  }

  .zayna-mobile-menu__category-link {
    display: flex;
    width: 100%;
    min-width: 0;
    min-height: 31px;
    align-items: center;
    padding: 4px 0;
    color: rgba(43, 38, 34, 0.70);
    font-size: 13.1px;
    line-height: 1.35;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease;
  }

  .zayna-mobile-menu__category-link.is-active {
    color: #8f5732;
  }

  .zayna-mobile-menu__all-products:focus-visible,
  .zayna-mobile-menu__category-link:focus-visible,
  .zayna-mobile-menu__service-link:focus-visible {
    position: relative;
    z-index: 1;
    outline: 1px solid rgba(166, 106, 63, 0.46);
    outline-offset: 3px;
  }

  .zayna-mobile-menu__service {
    padding: 17px 24px 0;
  }

  .zayna-mobile-menu__service-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 7px;
    padding-top: 2px;
  }

  .zayna-mobile-menu__service-link {
    display: inline-flex;
    min-height: 29px;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(43, 38, 34, 0.64);
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 12.3px;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0;
    text-align: left;
    text-decoration: none;
    text-transform: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: color 160ms ease;
  }

  .zayna-mobile-menu__footer {
    margin-top: auto;
    padding:
      20px 24px
      max(22px, env(safe-area-inset-bottom));
  }

  .zayna-mobile-menu__footer::before {
    content: "";
    display: block;
    height: 1px;
    margin-bottom: 12px;
    background: rgba(42, 37, 32, 0.038);
  }

  .zayna-mobile-menu__footer p {
    max-width: 32ch;
    margin: 0;
    color: rgba(43, 38, 34, 0.52);
    font-size: 11.3px;
    line-height: 1.55;
  }

  @media (hover: hover) and (pointer: fine) {
    .zayna-mobile-menu__main-link:hover,
    .zayna-mobile-menu__summary:hover,
    .zayna-mobile-menu__all-products:hover,
    .zayna-mobile-menu__category-link:hover,
    .zayna-mobile-menu__service-link:hover {
      color: #8f5732;
    }

    .zayna-mobile-menu__all-products:hover::after {
      transform: translateX(3px);
    }
  }

  @media (max-width: 339px) {
    .zayna-mobile-menu__nav,
    .zayna-mobile-menu__service,
    .zayna-mobile-menu__footer {
      padding-right: 19px;
      padding-left: 19px;
    }

    .zayna-mobile-menu__main-link,
    .zayna-mobile-menu__summary {
      min-height: 40px;
      font-size: 18.5px;
    }

    .zayna-mobile-menu__service-list {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zayna-mobile-menu__main-link,
    .zayna-mobile-menu__summary,
    .zayna-mobile-menu__toggle,
    .zayna-mobile-menu__plus,
    .zayna-mobile-menu__minus,
    .zayna-mobile-menu__all-products,
    .zayna-mobile-menu__all-products::after,
    .zayna-mobile-menu__category-link,
    .zayna-mobile-menu__service-link {
      transition: none;
    }
  }
{% endstyle %}
