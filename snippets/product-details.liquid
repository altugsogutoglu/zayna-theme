{%- comment -%}
  Zayna Home — product details accordion

  Doel:
  - één rustige Details-weergave voor alle producten met detail_weergavetekst;
  - oude invoer met losse label/waarde-regels netjes samenvoegen;
  - nieuwe invoer met "Label — waarde" direct compact tonen;
  - technische producten zacht en niet-tabelachtig tonen;
  - geen pseudo-hitboxes, geen transform/will-change en geen onrustige hover.
{%- endcomment -%}

{%- liquid
  assign detail_display_text = product.metafields.custom.detail_weergavetekst.value | strip

  assign is_technical_detail_product = false
  if product.handle == 'digitale-weeglepel-500g-0-1g'
    assign is_technical_detail_product = true
  elsif product.handle == 'mini-thermische-printer-groen'
    assign is_technical_detail_product = true
  endif

  assign detail_lines = detail_display_text | newline_to_br | split: '<br />'
-%}

{%- if detail_display_text != blank -%}
  {% style %}
    .zh-product--accordion-system .zh-product-details__content {
      width: 100%;
      max-width: 520px;
      padding-top: .18rem;
      padding-bottom: .9rem;
    }

    .zh-product--accordion-system .zh-product-details__quiet-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .68rem 1.18rem;
      width: 100%;
      min-width: 0;
    }

    .zh-product--accordion-system .zh-product-details__quiet-item {
      min-width: 0;
    }

    .zh-product--accordion-system .zh-product-details__quiet-item.is-wide {
      grid-column: 1 / -1;
      max-width: 48ch;
      padding-top: .04rem;
    }

    .zh-product--accordion-system .zh-product-details__quiet-label {
      display: block;
      margin: 0 0 .13rem;
      color: #81776d;
      font-size: .64rem;
      font-weight: 500;
      letter-spacing: .002em;
      line-height: 1.35;
    }

    .zh-product--accordion-system .zh-product-details__quiet-value {
      display: block;
      color: #48423c;
      font-size: .825rem;
      font-weight: 400;
      line-height: 1.48;
      overflow-wrap: anywhere;
    }

    .zh-product--accordion-system .zh-product-details__quiet-note {
      grid-column: 1 / -1;
      max-width: 52ch;
      margin: .08rem 0 0;
      color: #6b625a;
      font-size: .805rem;
      line-height: 1.58;
      text-wrap: pretty;
    }

    .zh-product--accordion-system .zh-product-details__soft {
      display: grid;
      gap: .32rem;
      max-width: 48ch;
    }

    .zh-product--accordion-system .zh-product-details__tech-lead {
      margin: 0;
      color: #48423c;
      font-size: .825rem;
      line-height: 1.58;
      text-wrap: pretty;
    }

    .zh-product--accordion-system .zh-product-details__soft-item {
      margin: 0;
      color: #6b625a;
      font-size: .805rem;
      line-height: 1.5;
    }

    @media (max-width: 379px) {
      .zh-product--accordion-system .zh-product-details__quiet-grid {
        gap: .62rem .9rem;
      }

      .zh-product--accordion-system .zh-product-details__quiet-value {
        font-size: .8rem;
      }
    }

    @media (min-width: 750px) and (max-width: 1180px) {
      .zh-product--accordion-system .zh-product-details__content {
        padding-top: .16rem;
        padding-bottom: .84rem;
      }

      .zh-product--accordion-system .zh-product-details__quiet-grid {
        gap: .62rem 1.05rem;
      }
    }

    @media (min-width: 1180px) {
      .zh-product--accordion-system .zh-product-details__content {
        max-width: 520px;
      }

      .zh-product--accordion-system .zh-product-details__quiet-grid {
        gap: .66rem 1.16rem;
      }
    }
  {% endstyle %}

  <details class="zh-product__accordion zh-product-details">
    <summary>
      <span>Details</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    <div class="zh-product__accordion-body zh-product__accordion-body--editorial zh-product-details__content">
      {%- if is_technical_detail_product -%}
        <div class="zh-product-details__soft">
          {%- assign technical_line_count = 0 -%}
          {%- for line in detail_lines -%}
            {%- assign clean_line = line | strip -%}
            {%- if clean_line != blank -%}
              {%- if technical_line_count == 0 -%}
                <p class="zh-product-details__tech-lead">{{ clean_line | escape }}</p>
              {%- else -%}
                <p class="zh-product-details__soft-item">{{ clean_line | escape }}</p>
              {%- endif -%}
              {%- assign technical_line_count = technical_line_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="zh-product-details__quiet-grid">
          {%- assign pending_label = '' -%}
          {%- assign rendered_pair_count = 0 -%}

          {%- for line in detail_lines -%}
            {%- assign clean_line = line | strip -%}
            {%- if clean_line != blank -%}
              {%- assign pair_label = '' -%}
              {%- assign pair_value = '' -%}

              {%- if clean_line contains '—' -%}
                {%- assign pair_parts = clean_line | split: '—' -%}
                {%- assign pair_label = pair_parts | first | strip -%}
                {%- assign pair_value = clean_line | remove_first: pair_label | remove_first: '—' | strip -%}
              {%- elsif clean_line contains ':' -%}
                {%- assign pair_parts = clean_line | split: ':' -%}
                {%- assign pair_label = pair_parts | first | strip -%}
                {%- assign pair_value = clean_line | remove_first: pair_label | remove_first: ':' | strip -%}
              {%- endif -%}

              {%- if pair_label != blank and pair_value != blank -%}
                {%- if pending_label != blank -%}
                  <p class="zh-product-details__quiet-note">{{ pending_label | escape }}</p>
                  {%- assign pending_label = '' -%}
                {%- endif -%}

                {%- assign item_is_wide = false -%}
                {%- if pair_value.size > 34 or pair_label contains 'Meegeleverd' or pair_label contains 'Gebruik' or rendered_pair_count >= 4 -%}
                  {%- assign item_is_wide = true -%}
                {%- endif -%}

                <div class="zh-product-details__quiet-item{% if item_is_wide %} is-wide{% endif %}">
                  <span class="zh-product-details__quiet-label">{{ pair_label | escape }}</span>
                  <span class="zh-product-details__quiet-value">{{ pair_value | escape }}</span>
                </div>
                {%- assign rendered_pair_count = rendered_pair_count | plus: 1 -%}
              {%- elsif pending_label != blank -%}
                {%- assign item_is_wide = false -%}
                {%- if clean_line.size > 34 or pending_label contains 'Meegeleverd' or pending_label contains 'Gebruik' or rendered_pair_count >= 4 -%}
                  {%- assign item_is_wide = true -%}
                {%- endif -%}

                <div class="zh-product-details__quiet-item{% if item_is_wide %} is-wide{% endif %}">
                  <span class="zh-product-details__quiet-label">{{ pending_label | escape }}</span>
                  <span class="zh-product-details__quiet-value">{{ clean_line | escape }}</span>
                </div>
                {%- assign rendered_pair_count = rendered_pair_count | plus: 1 -%}
                {%- assign pending_label = '' -%}
              {%- else -%}
                {%- assign line_is_label = true -%}
                {%- if clean_line.size > 32 -%}
                  {%- assign line_is_label = false -%}
                {%- endif -%}
                {%- if clean_line contains '.' or clean_line contains ',' or clean_line contains '·' or clean_line contains ' met ' or clean_line contains 'Met ' or clean_line contains ' voor ' or clean_line contains 'Voor ' or clean_line contains ' en ' or clean_line contains 'Inclusief ' or clean_line contains 'incl.' -%}
                  {%- assign line_is_label = false -%}
                {%- endif -%}

                {%- if line_is_label -%}
                  {%- assign pending_label = clean_line -%}
                {%- else -%}
                  <p class="zh-product-details__quiet-note">{{ clean_line | escape }}</p>
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if pending_label != blank -%}
            <p class="zh-product-details__quiet-note">{{ pending_label | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </details>
{%- endif -%}
