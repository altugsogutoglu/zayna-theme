{%- comment -%}
  Zayna Home — product details accordion

  Doel:
  - alle producten met detail_weergavetekst krijgen standaard een rustige premium detailsweergave;
  - technische producten krijgen een zachtere lijstweergave;
  - afwijkende oudere detailregels blijven leesbaar via fallback;
  - geen conditioneel openstaande HTML-tags over meerdere Liquid-branches.
{%- endcomment -%}

{%- liquid
  assign detail_display_text = product.metafields.custom.detail_weergavetekst.value | strip

  assign is_technical_detail_product = false
  if product.handle == 'digitale-weeglepel-500g-0-1g'
    assign is_technical_detail_product = true
  elsif product.handle == 'mini-thermische-printer-groen'
    assign is_technical_detail_product = true
  endif

  assign detail_lines = detail_display_text | newline_to_br | split: '<br />'
  assign clean_line_count = 0

  for line in detail_lines
    assign clean_line = line | strip
    if clean_line != blank
      assign clean_line_count = clean_line_count | plus: 1
    endif
  endfor
-%}

{%- if detail_display_text != blank -%}
  {% style %}
    .zh-product-details__content {
      display: grid;
      gap: .52rem;
      width: 100%;
      max-width: 44ch;
      padding: .02rem 0;
    }

    .zh-product-details__quiet-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .56rem .9rem;
      max-width: 38rem;
      min-width: 0;
    }

    .zh-product-details__quiet-item {
      display: grid;
      gap: .08rem;
      min-width: 0;
    }

    .zh-product-details__quiet-label {
      color: #8a8178;
      font-size: .61rem;
      font-weight: 500;
      letter-spacing: .002em;
      line-height: 1.34;
    }

    .zh-product-details__quiet-value {
      color: #514a44;
      font-size: .77rem;
      font-weight: 400;
      line-height: 1.44;
      overflow-wrap: normal;
      word-break: normal;
    }

    .zh-product-details__quiet-note {
      grid-column: 1 / -1;
      max-width: 40ch;
      margin: .08rem 0 0;
      color: #746a60;
      font-size: .735rem;
      line-height: 1.52;
      text-wrap: pretty;
    }

    .zh-product-details__soft {
      display: grid;
      gap: .48rem;
      max-width: 38ch;
    }

    .zh-product-details__tech-lead {
      margin: 0;
      color: #3c352f;
      font-size: .815rem;
      line-height: 1.6;
      text-wrap: pretty;
    }

    .zh-product-details__soft-list {
      display: grid;
      gap: .15rem;
      margin: .1rem 0 0;
      padding: 0;
      list-style: none;
    }

    .zh-product-details__soft-list li {
      margin: 0;
      color: #7a7067;
      font-size: .755rem;
      font-weight: 400;
      line-height: 1.5;
    }

    .zh-product-details__lead,
    .zh-product-details__note {
      max-width: 62ch;
      margin: 0;
      color: #554e48;
      font-size: .9375rem;
      line-height: 1.72;
      text-wrap: pretty;
    }

    .zh-product-details__lead {
      margin-bottom: .45rem;
    }

    .zh-product-details__note {
      margin-top: .45rem;
      color: #625a53;
      font-size: .875rem;
    }

    .zh-product-details__fact {
      display: grid;
      grid-template-columns: minmax(6.5rem, 7.5rem) minmax(0, 1fr);
      gap: .75rem;
      align-items: start;
      min-width: 0;
    }

    .zh-product-details__fact-label,
    .zh-product-details__fact-value {
      min-width: 0;
      font-size: .875rem;
      line-height: 1.55;
    }

    .zh-product-details__fact-label {
      color: #2a2520;
      font-weight: 600;
    }

    .zh-product-details__fact-value {
      color: #625a53;
      overflow-wrap: anywhere;
    }

    @media (min-width: 640px) {
      .zh-product-details__content {
        gap: .42rem;
        max-width: 48ch;
      }

      .zh-product-details__fact {
        grid-template-columns: minmax(7.5rem, 9rem) minmax(0, 1fr);
        gap: 1rem;
      }
    }

    @media (min-width: 760px) {
      .zh-product-details__quiet-grid {
        gap: .6rem 1rem;
      }
    }

    @media (min-width: 1180px) {
      .zh-product-details__content {
        max-width: 460px;
      }

      .zh-product-details__quiet-grid {
        gap: .6rem 1.08rem;
      }
    }
  {% endstyle %}

  <details class="zh-product__accordion zh-product-details">
    <summary>
      <span>Details</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    <div class="zh-product__accordion-body zh-product__accordion-body--editorial zh-product-details__content">
      {%- if is_technical_detail_product -%}
        <div class="zh-product-details__soft">
          {%- assign technical_lead_rendered = false -%}
          <ul class="zh-product-details__soft-list">
            {%- for line in detail_lines -%}
              {%- assign clean_line = line | strip -%}
              {%- if clean_line != blank -%}
                {%- if technical_lead_rendered == false -%}
                  <p class="zh-product-details__tech-lead">{{ clean_line | escape }}</p>
                  {%- assign technical_lead_rendered = true -%}
                {%- else -%}
                  <li>{{ clean_line | escape }}</li>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

      {%- else -%}
        <div class="zh-product-details__quiet-grid">
          {%- assign rendered_pair_count = 0 -%}

          {%- for line in detail_lines -%}
            {%- assign clean_line = line | strip -%}
            {%- if clean_line != blank -%}
              {%- assign pair_label = '' -%}
              {%- assign pair_value = '' -%}

              {%- if clean_line contains '—' -%}
                {%- assign pair_parts = clean_line | split: '—' -%}
                {%- assign pair_label = pair_parts | first | strip -%}
                {%- assign pair_value = clean_line | remove_first: pair_label | remove_first: '—' | strip -%}
              {%- elsif clean_line contains ':' -%}
                {%- assign pair_parts = clean_line | split: ':' -%}
                {%- assign pair_label = pair_parts | first | strip -%}
                {%- assign pair_value = clean_line | remove_first: pair_label | remove_first: ':' | strip -%}
              {%- endif -%}

              {%- if pair_label != blank and pair_value != blank and rendered_pair_count < 4 -%}
                <div class="zh-product-details__quiet-item">
                  <span class="zh-product-details__quiet-label">{{ pair_label | escape }}</span>
                  <span class="zh-product-details__quiet-value">{{ pair_value | escape }}</span>
                </div>
                {%- assign rendered_pair_count = rendered_pair_count | plus: 1 -%}
              {%- else -%}
                <p class="zh-product-details__quiet-note">{{ clean_line | escape }}</p>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </details>
{%- endif -%}