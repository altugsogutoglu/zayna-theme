{%- comment -%}
  Zayna Home — UX-prototype v3 voor twee proefproducten.

  Prototypeproducten:
  - voorraadpot-600ml-borosilicaatglas
  - digitale-weeglepel-500g-0-1g

  Voor deze twee producten:
  - optionele korte openingszin;
  - productfeiten in een rustig editorial grid;
  - lange informatie zoals "Meegeleverd" over de volle breedte.

  Alle andere producten behouden de bestaande v2-weergave.
{%- endcomment -%}

{%- liquid
  assign detail_display_text = product.metafields.custom.detail_weergavetekst.value | strip
  assign is_ux_prototype_v3 = false

  if product.handle == 'voorraadpot-600ml-borosilicaatglas' or product.handle == 'digitale-weeglepel-500g-0-1g'
    assign is_ux_prototype_v3 = true
  endif
-%}

{%- if detail_display_text != blank -%}
  {% style %}
    .zh-product-details__content {
      display: grid;
      gap: .5rem;
      width: 100%;
    }

    .zh-product-details__lead,
    .zh-product-details__note {
      max-width: 62ch;
      margin: 0;
      color: #554e48;
      font-size: .9375rem;
      line-height: 1.72;
      text-wrap: pretty;
    }

    .zh-product-details__lead {
      margin-bottom: .45rem;
    }

    .zh-product-details__note {
      margin-top: .45rem;
      color: #625a53;
      font-size: .875rem;
    }

    .zh-product-details__fact {
      display: grid;
      grid-template-columns: minmax(6.5rem, 7.5rem) minmax(0, 1fr);
      gap: .75rem;
      align-items: start;
      min-width: 0;
    }

    .zh-product-details__fact-label,
    .zh-product-details__fact-value {
      min-width: 0;
      font-size: .875rem;
      line-height: 1.55;
    }

    .zh-product-details__fact-label {
      color: #2a2520;
      font-weight: 600;
    }

    .zh-product-details__fact-value {
      color: #625a53;
      overflow-wrap: anywhere;
    }

    /* UX-prototype v3: editorial detail grid */
    .zh-product-details--ux-v3 .zh-product-details__content {
      gap: 1rem;
      padding: .05rem 0 .15rem;
    }

    .zh-product-details--ux-v3 .zh-product-details__lead {
      max-width: 48ch;
      margin: 0 0 .1rem;
      color: #625a53;
      font-size: .9rem;
      line-height: 1.65;
    }

    .zh-product-details__grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.05rem 1.2rem;
      min-width: 0;
    }

    .zh-product-details__tile {
      min-width: 0;
    }

    .zh-product-details__tile--wide {
      grid-column: 1 / -1;
    }

    .zh-product-details__tile-label {
      display: block;
      margin: 0 0 .22rem;
      color: #9b5f35;
      font-size: .625rem;
      font-weight: 600;
      letter-spacing: .12em;
      line-height: 1.35;
      text-transform: uppercase;
    }

    .zh-product-details__tile-value {
      display: block;
      color: #2a2520;
      font-size: .9rem;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .zh-product-details--ux-v3 .zh-product-details__note {
      max-width: 52ch;
      margin: .1rem 0 0;
      color: #625a53;
      font-size: .84rem;
      line-height: 1.65;
    }

    @media (min-width: 640px) {
      .zh-product-details__content {
        gap: .42rem;
      }

      .zh-product-details__fact {
        grid-template-columns: minmax(7.5rem, 9rem) minmax(0, 1fr);
        gap: 1rem;
      }

      .zh-product-details--ux-v3 .zh-product-details__content {
        gap: 1.05rem;
      }
    }

    @media (min-width: 1180px) {
      .zh-product-details__grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.15rem 1.45rem;
      }
    }
  {% endstyle %}

  <details class="zh-product__accordion zh-product-details{% if is_ux_prototype_v3 %} zh-product-details--ux-v3{% endif %}">
    <summary class="font-display">
      <span>Details</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    {%- assign detail_lines = detail_display_text | newline_to_br | split: '<br />' -%}

    {%- if is_ux_prototype_v3 -%}
      <div class="zh-product__accordion-body zh-product__accordion-body--editorial zh-product-details__content">
        {%- assign has_seen_fact = false -%}
        {%- assign facts_open = false -%}

        {%- for line in detail_lines -%}
          {%- assign clean_line = line | strip -%}
          {%- if clean_line != blank -%}
            {%- if clean_line contains ':' -%}
              {%- assign fact_label = clean_line | split: ':' | first | strip -%}
              {%- assign fact_value = clean_line | remove_first: fact_label | remove_first: ':' | strip -%}

              {%- if fact_label != blank and fact_value != blank -%}
                {%- unless facts_open -%}
                  <div class="zh-product-details__grid">
                  {%- assign facts_open = true -%}
                {%- endunless -%}

                {%- assign fact_label_downcase = fact_label | downcase -%}
                <div class="zh-product-details__tile{% if fact_label_downcase == 'meegeleverd' %} zh-product-details__tile--wide{% endif %}">
                  <span class="zh-product-details__tile-label">{{ fact_label | escape }}</span>
                  <span class="zh-product-details__tile-value">{{ fact_value | escape }}</span>
                </div>
                {%- assign has_seen_fact = true -%}
              {%- else -%}
                {%- if facts_open -%}</div>{%- assign facts_open = false -%}{%- endif -%}
                <p class="{% if has_seen_fact %}zh-product-details__note{% else %}zh-product-details__lead{% endif %}">{{ clean_line | escape }}</p>
              {%- endif -%}
            {%- else -%}
              {%- if facts_open -%}</div>{%- assign facts_open = false -%}{%- endif -%}
              <p class="{% if has_seen_fact %}zh-product-details__note{% else %}zh-product-details__lead{% endif %}">{{ clean_line | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if facts_open -%}</div>{%- endif -%}
      </div>
    {%- else -%}
      <div class="zh-product__accordion-body zh-product__accordion-body--editorial zh-product-details__content">
        {%- assign has_seen_fact = false -%}

        {%- for line in detail_lines -%}
          {%- assign clean_line = line | strip -%}
          {%- if clean_line != blank -%}
            {%- if clean_line contains ':' -%}
              {%- assign fact_label = clean_line | split: ':' | first | strip -%}
              {%- assign fact_value = clean_line | remove_first: fact_label | remove_first: ':' | strip -%}

              {%- if fact_label != blank and fact_value != blank -%}
                <div class="zh-product-details__fact">
                  <span class="zh-product-details__fact-label">{{ fact_label | escape }}</span>
                  <span class="zh-product-details__fact-value">{{ fact_value | escape }}</span>
                </div>
                {%- assign has_seen_fact = true -%}
              {%- else -%}
                <p class="{% if has_seen_fact %}zh-product-details__note{% else %}zh-product-details__lead{% endif %}">{{ clean_line | escape }}</p>
              {%- endif -%}
            {%- else -%}
              <p class="{% if has_seen_fact %}zh-product-details__note{% else %}zh-product-details__lead{% endif %}">{{ clean_line | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </details>
{%- endif -%}
