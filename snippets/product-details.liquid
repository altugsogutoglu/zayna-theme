{%- comment -%}
  Zayna Home — V35 globale Details-renderer.

  Doel:
  - één rustige Details-opmaak voor alle producten met custom.detail_weergavetekst;
  - ondersteunt dubbelepunt, em-dash en losse label/waarde-regels;
  - zet details altijd in een vaste logische volgorde;
  - gebruik en meegeleverd worden als rustige brede regels onderaan getoond;
  - specificaties vullen consequent 2 per rij waar mogelijk.

  Vaste volgorde:
  1. Set / aantal
  2. Inhoud
  3. Formaat / afmetingen
  4. Materiaal / onderdelen / kleur
  5. Afsluiting / eigenschap / design / montage
  6. Techniek
  7. Overig
  8. Meegeleverd
  9. Gebruik

  Vereist:
  - product.metafields.custom.detail_weergavetekst
{%- endcomment -%}

{%- liquid
  assign detail_display_text = product.metafields.custom.detail_weergavetekst.value | strip
  assign is_technical_detail_prototype = false

  if product.handle == 'digitale-weeglepel-500g-0-1g'
    assign is_technical_detail_prototype = true
  endif
-%}

{%- if detail_display_text != blank -%}
  {% style %}
    .zh-product-details__content {
      display: grid;
      gap: .78rem;
      width: 100%;
      max-width: 52ch;
      padding: .04rem 0 .18rem;
    }

    .zh-product-details__spec-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .76rem 1.35rem;
      width: 100%;
      min-width: 0;
    }

    .zh-product-details__spec-item {
      display: grid;
      gap: .12rem;
      min-width: 0;
      align-content: start;
    }

    .zh-product-details__spec-item--note {
      grid-column: 1 / -1;
      max-width: 48ch;
      margin-top: .02rem;
    }

    .zh-product-details__label {
      color: #82776d;
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .002em;
      line-height: 1.34;
    }

    .zh-product-details__value {
      color: #3f3832;
      font-size: .805rem;
      font-weight: 400;
      line-height: 1.52;
      overflow-wrap: normal;
      word-break: normal;
      text-wrap: pretty;
    }

    .zh-product-details__spec-item--note .zh-product-details__value {
      color: #625a53;
      font-size: .78rem;
      line-height: 1.56;
    }

    .zh-product-details__soft {
      display: grid;
      gap: .48rem;
      max-width: 38ch;
    }

    .zh-product-details__tech-lead {
      margin: 0;
      color: #3c352f;
      font-size: .815rem;
      line-height: 1.6;
      text-wrap: pretty;
    }

    .zh-product-details__soft-list {
      display: grid;
      gap: .15rem;
      margin: .1rem 0 0;
      padding: 0;
      list-style: none;
    }

    .zh-product-details__soft-list li {
      margin: 0;
      color: #7a7067;
      font-size: .755rem;
      font-weight: 400;
      line-height: 1.5;
    }

    @media (max-width: 520px) {
      .zh-product-details__content {
        max-width: none;
      }

      .zh-product-details__spec-grid {
        gap: .72rem 1.05rem;
      }

      .zh-product-details__spec-item--note {
        max-width: none;
      }
    }

    @media (min-width: 760px) {
      .zh-product-details__content {
        max-width: 54ch;
      }

      .zh-product-details__spec-grid {
        gap: .78rem 1.42rem;
      }
    }

    @media (min-width: 1180px) {
      .zh-product-details__content {
        max-width: 500px;
      }
    }
  {% endstyle %}

  <details class="zh-product__accordion zh-product-details">
    <summary>
      <span>Details</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    {%- assign detail_lines = detail_display_text | newline_to_br | split: '<br />' -%}

    <div class="zh-product__accordion-body zh-product__accordion-body--editorial zh-product-details__content">
      {%- if is_technical_detail_prototype -%}
        <div class="zh-product-details__soft">
          {%- assign detail_line_index = 0 -%}
          {%- assign tech_items = '' -%}

          {%- for line in detail_lines -%}
            {%- assign clean_line = line | strip -%}
            {%- if clean_line != blank -%}
              {%- if detail_line_index == 0 -%}
                <p class="zh-product-details__tech-lead">{{ clean_line | escape }}</p>
              {%- else -%}
                {%- capture tech_item -%}<li>{{ clean_line | escape }}</li>{%- endcapture -%}
                {%- assign tech_items = tech_items | append: tech_item -%}
              {%- endif -%}
              {%- assign detail_line_index = detail_line_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if tech_items != blank -%}
            <ul class="zh-product-details__soft-list">
              {{ tech_items }}
            </ul>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- liquid
          assign known_labels = '|inhoud|inhoud per stuk|inhoud per pot|setinhoud|formaat|afmeting|afmetingen|afmeting per pot|afmetingen per pot|lengte|breedte|hoogte|diameter|bovenkant|bodem|bovenste diameter|bodemdiameter|materiaal|materiaal potten|materiaal deksels|kleur|set|aantal|pot|potten|deksel|deksels|draaideksel|draaideksels|filter|afdichting|afsluiting|eigenschap|glazen en rietjes|meegeleverd|montage|draagvermogen|design|ontwerp|vorm|gebruik|functie|toepassing|verbinding|app|printkleur|printtechniek|resolutie|papierformaat|opladen|strooidop|strooidoppen|kruidenlabels|labels|'
          assign pending_label = ''
          assign bucket_set = ''
          assign bucket_content = ''
          assign bucket_size = ''
          assign bucket_material = ''
          assign bucket_function = ''
          assign bucket_tech = ''
          assign bucket_other = ''
          assign notes_included = ''
          assign notes_use = ''
        -%}

        {%- for line in detail_lines -%}
          {%- liquid
            assign clean_line = line | strip
            assign fact_label = ''
            assign fact_value = ''
            assign note_text = ''
          -%}

          {%- if clean_line != blank -%}
            {%- liquid
              assign normalized_line = clean_line | replace: ' – ', ' — ' | replace: ' - ', ' — '
            -%}

            {%- if normalized_line contains ':' -%}
              {%- liquid
                assign fact_label = normalized_line | split: ':' | first | strip
                assign fact_value = normalized_line | remove_first: fact_label | remove_first: ':' | strip
              -%}
            {%- elsif normalized_line contains '—' -%}
              {%- liquid
                assign fact_label = normalized_line | split: '—' | first | strip
                assign fact_value = normalized_line | remove_first: fact_label | remove_first: '—' | strip
              -%}
            {%- else -%}
              {%- liquid
                assign clean_key = clean_line | downcase | strip
                assign clean_token = '|' | append: clean_key | append: '|'
              -%}

              {%- if known_labels contains clean_token -%}
                {%- if pending_label != blank -%}
                  {%- assign note_text = pending_label -%}
                {%- endif -%}
                {%- assign pending_label = clean_line -%}
              {%- elsif pending_label != blank -%}
                {%- assign fact_label = pending_label -%}
                {%- assign fact_value = clean_line -%}
                {%- assign pending_label = '' -%}
              {%- else -%}
                {%- liquid
                  assign maybe_label = false
                  assign clean_size = clean_line | size
                  assign clean_down = clean_line | downcase | strip

                  if clean_size <= 34
                    assign maybe_label = true
                  endif

                  if clean_line contains '.' or clean_line contains ',' or clean_line contains '·'
                    assign maybe_label = false
                  endif

                  if clean_down contains 'voor ' or clean_down contains 'met ' or clean_down contains 'zonder ' or clean_down contains 'incl'
                    assign maybe_label = false
                  endif
                -%}

                {%- if maybe_label -%}
                  {%- assign pending_label = clean_line -%}
                {%- else -%}
                  {%- assign note_text = clean_line -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}

            {%- if fact_label != blank and fact_value != blank -%}
              {%- liquid
                assign label_key = fact_label | downcase | strip
                assign value_clean = fact_value | strip
                assign is_included = false
                assign is_use = false

                if label_key == 'meegeleverd'
                  assign is_included = true
                endif

                if label_key == 'gebruik' or label_key == 'functie' or label_key == 'toepassing'
                  assign is_use = true
                endif
              -%}

              {%- if is_included -%}
                {%- capture note_item -%}
                  <div class="zh-product-details__spec-item zh-product-details__spec-item--note">
                    <span class="zh-product-details__label">Meegeleverd</span>
                    <span class="zh-product-details__value">{{ value_clean | escape }}</span>
                  </div>
                {%- endcapture -%}
                {%- assign notes_included = notes_included | append: note_item -%}
              {%- elsif is_use -%}
                {%- capture note_item -%}
                  <div class="zh-product-details__spec-item zh-product-details__spec-item--note">
                    <span class="zh-product-details__label">Gebruik</span>
                    <span class="zh-product-details__value">{{ value_clean | escape }}</span>
                  </div>
                {%- endcapture -%}
                {%- assign notes_use = notes_use | append: note_item -%}
              {%- else -%}
                {%- capture spec_item -%}
                  <div class="zh-product-details__spec-item">
                    <span class="zh-product-details__label">{{ fact_label | escape }}</span>
                    <span class="zh-product-details__value">{{ value_clean | escape }}</span>
                  </div>
                {%- endcapture -%}

                {%- if label_key == 'setinhoud' or label_key == 'set' or label_key == 'aantal' -%}
                  {%- assign bucket_set = bucket_set | append: spec_item -%}
                {%- elsif label_key contains 'inhoud' -%}
                  {%- assign bucket_content = bucket_content | append: spec_item -%}
                {%- elsif label_key contains 'formaat' or label_key contains 'afmeting' or label_key == 'lengte' or label_key == 'breedte' or label_key == 'hoogte' or label_key contains 'diameter' or label_key == 'bovenkant' or label_key == 'bodem' -%}
                  {%- assign bucket_size = bucket_size | append: spec_item -%}
                {%- elsif label_key contains 'materiaal' or label_key == 'pot' or label_key == 'potten' or label_key contains 'deksel' or label_key contains 'draaideksel' or label_key == 'filter' or label_key == 'glazen en rietjes' or label_key == 'kruidenlabels' or label_key == 'labels' or label_key == 'kleur' -%}
                  {%- assign bucket_material = bucket_material | append: spec_item -%}
                {%- elsif label_key contains 'afsluiting' or label_key contains 'afdichting' or label_key == 'eigenschap' or label_key == 'design' or label_key == 'ontwerp' or label_key == 'vorm' or label_key contains 'strooidop' or label_key == 'montage' or label_key == 'draagvermogen' -%}
                  {%- assign bucket_function = bucket_function | append: spec_item -%}
                {%- elsif label_key == 'verbinding' or label_key == 'app' or label_key contains 'print' or label_key == 'resolutie' or label_key == 'papierformaat' or label_key == 'opladen' -%}
                  {%- assign bucket_tech = bucket_tech | append: spec_item -%}
                {%- else -%}
                  {%- assign bucket_other = bucket_other | append: spec_item -%}
                {%- endif -%}
              {%- endif -%}
            {%- elsif note_text != blank -%}
              {%- liquid
                assign note_down = note_text | downcase | strip
                assign note_label = 'Gebruik'
                assign note_value = note_text

                if note_down contains 'meegeleverd' or note_down contains 'inclusief'
                  assign note_label = 'Meegeleverd'
                  assign note_value = note_text | replace: 'Meegeleverd met ', '' | replace: 'meegeleverd met ', '' | replace: 'Meegeleverd: ', '' | replace: 'meegeleverd: ', '' | replace: 'Inclusief ', '' | replace: 'inclusief ', ''
                elsif note_down contains 'met ' and note_down contains 'rollen'
                  assign note_label = 'Meegeleverd'
                  assign note_value = note_text | replace: 'Met ', '' | replace: 'met ', ''
                elsif note_down contains 'met ' and note_down contains 'kabel'
                  assign note_label = 'Meegeleverd'
                  assign note_value = note_text | replace: 'Met ', '' | replace: 'met ', ''
                endif
              -%}

              {%- capture note_item -%}
                <div class="zh-product-details__spec-item zh-product-details__spec-item--note">
                  <span class="zh-product-details__label">{{ note_label | escape }}</span>
                  <span class="zh-product-details__value">{{ note_value | escape }}</span>
                </div>
              {%- endcapture -%}

              {%- if note_label == 'Meegeleverd' -%}
                {%- assign notes_included = notes_included | append: note_item -%}
              {%- else -%}
                {%- assign notes_use = notes_use | append: note_item -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if pending_label != blank -%}
          {%- liquid
            assign pending_down = pending_label | downcase | strip
            assign pending_note_label = 'Gebruik'
            assign pending_note_value = pending_label

            if pending_down contains 'meegeleverd' or pending_down contains 'inclusief'
              assign pending_note_label = 'Meegeleverd'
              assign pending_note_value = pending_label | replace: 'Meegeleverd met ', '' | replace: 'meegeleverd met ', '' | replace: 'Meegeleverd: ', '' | replace: 'meegeleverd: ', '' | replace: 'Inclusief ', '' | replace: 'inclusief ', ''
            elsif pending_down contains 'met ' and pending_down contains 'rollen'
              assign pending_note_label = 'Meegeleverd'
              assign pending_note_value = pending_label | replace: 'Met ', '' | replace: 'met ', ''
            elsif pending_down contains 'met ' and pending_down contains 'kabel'
              assign pending_note_label = 'Meegeleverd'
              assign pending_note_value = pending_label | replace: 'Met ', '' | replace: 'met ', ''
            endif
          -%}

          {%- capture note_item -%}
            <div class="zh-product-details__spec-item zh-product-details__spec-item--note">
              <span class="zh-product-details__label">{{ pending_note_label | escape }}</span>
              <span class="zh-product-details__value">{{ pending_note_value | escape }}</span>
            </div>
          {%- endcapture -%}

          {%- if pending_note_label == 'Meegeleverd' -%}
            {%- assign notes_included = notes_included | append: note_item -%}
          {%- else -%}
            {%- assign notes_use = notes_use | append: note_item -%}
          {%- endif -%}
        {%- endif -%}

        {%- assign specs_markup = bucket_set | append: bucket_content | append: bucket_size | append: bucket_material | append: bucket_function | append: bucket_tech | append: bucket_other | append: notes_included | append: notes_use -%}

        {%- if specs_markup != blank -%}
          <div class="zh-product-details__spec-grid">
            {{ specs_markup }}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
  </details>
{%- endif -%}
