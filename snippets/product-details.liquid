{%- comment -%}
  Zayna Home — redactionele Details-accordion.

  Bron:
  custom.detail_weergavetekst

  Het veld is tekst met meerdere regels. Lege regels worden overgeslagen.
  Wanneer het veld leeg is, wordt de volledige accordion niet weergegeven.

  Vereist:
  - product
{%- endcomment -%}

{%- assign detail_display_text = product.metafields.custom.detail_weergavetekst.value | strip -%}

{%- if detail_display_text != blank -%}
  <details class="zh-product__accordion zh-product-details">
    <summary class="font-display">
      <span>Details</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    <div class="zh-product__accordion-body zh-product__accordion-body--editorial">
      {%- assign detail_lines = detail_display_text | newline_to_br | split: '<br />' -%}
      {%- for line in detail_lines -%}
        {%- assign clean_line = line | strip -%}
        {%- if clean_line != blank -%}
          <p>{{ clean_line | escape }}</p>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </details>
{%- endif -%}
