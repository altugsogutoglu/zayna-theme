{%- comment -%}
  Zayna Home — redactionele Details-proef.

  Alleen het testproduct gebruikt tijdelijk deze goedgekeurde redactionele tekst.
  Alle andere producten behouden tijdens deze proef de bestaande v3-weergave.

  Testhandle:
  set-van-12-vierkante-kruidenpotten-120-ml-incl-labels-trechter-borosilicaat-glas
{%- endcomment -%}

{%- if product.handle == 'set-van-12-vierkante-kruidenpotten-120-ml-incl-labels-trechter-borosilicaat-glas' -%}
  <details class="zh-product__accordion zh-product-details">
    <summary class="font-display">
      <span>Details</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    <div class="zh-product__accordion-body zh-product__accordion-body--editorial">
      <p>Het transparante glas houdt kruiden goed zichtbaar, terwijl de bamboe deksels warmte en rust toevoegen. Door de vierkante vorm staan de potten netjes naast elkaar.</p>
      <p>Elke pot bevat <span class="zh-nowrap">120 ml</span> en is <span class="zh-nowrap">10,5 cm</span> hoog en <span class="zh-nowrap">4,5 cm</span> breed. Voor iedere pot is een strooidop inbegrepen. Je ontvangt ook 40 beschrijfbare vinyllabels, een trechter, stift en reinigingsborstel.</p>
    </div>
  </details>
{%- else -%}

{%- comment -%}
  Zayna Home — ingeklapte accordion "Productdetails".

  Doel:
  - alleen gecontroleerde detail-metafields gebruiken;
  - de productpagina gesloten rustig houden;
  - gegevens compact en zonder kaarten, iconen of technische subsecties tonen;
  - onderhoud bewust niet hier tonen, maar in "Gebruik en onderhoud".

  Bewust niet zichtbaar in deze compacte interface:
  - custom.detail_kleur_afwerking
  - custom.detail_gebruik

  Deze velden blijven in Shopify bestaan, maar zijn meestal al duidelijk uit
  producttitel, fotografie, korte intro of productomschrijving.

  Vereist:
  - product
{%- endcomment -%}

{%- liquid
  assign detail_inhoud_field = product.metafields.custom.detail_inhoud
  assign detail_inhoud = detail_inhoud_field.value

  assign detail_inhoud_per_stuk_field = product.metafields.custom.detail_inhoud_per_stuk
  assign detail_inhoud_per_stuk = detail_inhoud_per_stuk_field.value

  assign detail_formaat = product.metafields.custom.detail_formaat.value
  assign detail_setinhoud = product.metafields.custom.detail_setinhoud.value

  assign detail_hoogte_field = product.metafields.custom.detail_hoogte
  assign detail_hoogte = detail_hoogte_field.value

  assign detail_breedte_field = product.metafields.custom.detail_breedte
  assign detail_breedte = detail_breedte_field.value

  assign detail_lengte_field = product.metafields.custom.detail_lengte
  assign detail_lengte = detail_lengte_field.value

  assign detail_diameter_field = product.metafields.custom.detail_diameter
  assign detail_diameter = detail_diameter_field.value

  assign detail_bovenste_diameter_field = product.metafields.custom.detail_bovenste_diameter
  assign detail_bovenste_diameter = detail_bovenste_diameter_field.value

  assign detail_bodemdiameter_field = product.metafields.custom.detail_bodemdiameter
  assign detail_bodemdiameter = detail_bodemdiameter_field.value

  assign detail_afmetingen_overig = product.metafields.custom.detail_afmetingen_overig.value
  assign detail_materialen = product.metafields.custom.detail_materialen.value
  assign detail_meegeleverd = product.metafields.custom.detail_meegeleverd.value
  assign detail_bediening = product.metafields.custom.detail_bediening.value

  assign has_dimensions = false
  if detail_hoogte != blank or detail_breedte != blank or detail_lengte != blank or detail_diameter != blank or detail_bovenste_diameter != blank or detail_bodemdiameter != blank or detail_afmetingen_overig != blank
    assign has_dimensions = true
  endif

  assign has_details = false
  if detail_inhoud != blank or detail_inhoud_per_stuk != blank or detail_setinhoud != blank or detail_formaat != blank or has_dimensions or detail_materialen != blank or detail_meegeleverd != blank or detail_bediening != blank
    assign has_details = true
  endif
-%}

{%- if has_details -%}
  {% style %}
    .zh-product-details__body {
      padding-right: 0;
    }

    .zh-product-details__list {
      display: grid;
      gap: .9rem;
      max-width: 52rem;
      margin: 0;
      padding: .05rem 0 .1rem;
    }

    .zh-product-details__item {
      display: grid;
      min-width: 0;
      margin: 0;
      gap: .18rem;
    }

    .zh-product-details__term {
      margin: 0;
      color: var(--color-ink, #2a2520);
      font-size: .84rem;
      font-weight: 600;
      line-height: 1.5;
    }

    .zh-product-details__description {
      min-width: 0;
      margin: 0;
      color: var(--zh-muted, #625a53);
      font-size: .9rem;
      line-height: 1.65;
      overflow-wrap: anywhere;
    }

    .zh-product-details__description .metafield-dimension,
    .zh-product-details__description .metafield-volume {
      color: inherit;
      font: inherit;
    }

    .zh-product-details__lines,
    .zh-product-details__measurements {
      display: grid;
      gap: .15rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .zh-product-details__lines li,
    .zh-product-details__measurements li {
      min-width: 0;
      margin: 0;
    }

    .zh-product-details__included {
      display: inline;
    }

    .zh-product-details__included-item:not(:last-child)::after {
      content: ', ';
    }

    @media (min-width: 1200px) {
      .zh-product-details__list {
        gap: .7rem;
      }

      .zh-product-details__item {
        grid-template-columns: minmax(9rem, 11rem) minmax(0, 1fr);
        gap: 1.5rem;
        align-items: start;
      }

      .zh-product-details__term,
      .zh-product-details__description {
        line-height: 1.6;
      }
    }
  {% endstyle %}

  <details class="zh-product__accordion zh-product-details">
    <summary class="font-display">
      <span>Productdetails</span>
      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
    </summary>

    <div class="zh-product__accordion-body zh-product-details__body">
      <dl class="zh-product-details__list">
        {%- if detail_inhoud != blank -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Inhoud</dt>
            <dd class="zh-product-details__description">
              {{ detail_inhoud_field | metafield_tag }}
            </dd>
          </div>
        {%- endif -%}

        {%- if detail_inhoud_per_stuk != blank -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Inhoud per stuk</dt>
            <dd class="zh-product-details__description">
              {{ detail_inhoud_per_stuk_field | metafield_tag }}
            </dd>
          </div>
        {%- endif -%}

        {%- if detail_setinhoud != blank -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Set</dt>
            <dd class="zh-product-details__description">{{ detail_setinhoud | escape }}</dd>
          </div>
        {%- endif -%}

        {%- if detail_formaat != blank -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Formaat</dt>
            <dd class="zh-product-details__description">{{ detail_formaat | escape }}</dd>
          </div>
        {%- endif -%}

        {%- if has_dimensions -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Afmetingen</dt>
            <dd class="zh-product-details__description">
              <ul class="zh-product-details__measurements" role="list">
                {%- if detail_hoogte != blank -%}
                  <li>Hoogte — {{ detail_hoogte_field | metafield_tag }}</li>
                {%- endif -%}

                {%- if detail_breedte != blank -%}
                  <li>Breedte — {{ detail_breedte_field | metafield_tag }}</li>
                {%- endif -%}

                {%- if detail_lengte != blank -%}
                  <li>Lengte — {{ detail_lengte_field | metafield_tag }}</li>
                {%- endif -%}

                {%- if detail_diameter != blank -%}
                  <li>Diameter — {{ detail_diameter_field | metafield_tag }}</li>
                {%- endif -%}

                {%- if detail_bovenste_diameter != blank -%}
                  <li>Bovenste diameter — {{ detail_bovenste_diameter_field | metafield_tag }}</li>
                {%- endif -%}

                {%- if detail_bodemdiameter != blank -%}
                  <li>Bodemdiameter — {{ detail_bodemdiameter_field | metafield_tag }}</li>
                {%- endif -%}

                {%- if detail_afmetingen_overig != blank -%}
                  {%- assign dimension_lines = detail_afmetingen_overig | newline_to_br | split: '<br />' -%}
                  {%- for line in dimension_lines -%}
                    {%- assign clean_line = line | strip -%}
                    {%- if clean_line != blank -%}
                      <li>{{ clean_line | escape }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </ul>
            </dd>
          </div>
        {%- endif -%}

        {%- if detail_materialen != blank -%}
          {%- assign material_lines = detail_materialen | newline_to_br | split: '<br />' -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Materialen</dt>
            <dd class="zh-product-details__description">
              <ul class="zh-product-details__lines" role="list">
                {%- for line in material_lines -%}
                  {%- assign clean_line = line | strip -%}
                  {%- if clean_line != blank -%}
                    <li>{{ clean_line | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </dd>
          </div>
        {%- endif -%}

        {%- if detail_meegeleverd != blank -%}
          {%- assign included_lines = detail_meegeleverd | newline_to_br | split: '<br />' -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Inbegrepen</dt>
            <dd class="zh-product-details__description zh-product-details__included">
              {%- for line in included_lines -%}
                {%- assign clean_line = line | strip -%}
                {%- if clean_line != blank -%}
                  <span class="zh-product-details__included-item">{{ clean_line | escape }}</span>
                {%- endif -%}
              {%- endfor -%}
            </dd>
          </div>
        {%- endif -%}

        {%- if detail_bediening != blank -%}
          {%- assign operation_lines = detail_bediening | newline_to_br | split: '<br />' -%}
          <div class="zh-product-details__item">
            <dt class="zh-product-details__term">Werking en toepassing</dt>
            <dd class="zh-product-details__description">
              <ul class="zh-product-details__lines" role="list">
                {%- for line in operation_lines -%}
                  {%- assign clean_line = line | strip -%}
                  {%- if clean_line != blank -%}
                    <li>{{ clean_line | escape }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </dd>
          </div>
        {%- endif -%}
      </dl>
    </div>
  </details>
{%- endif -%}


{%- endif -%}
