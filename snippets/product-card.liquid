{%- liquid
  assign loading = loading | default: 'lazy'
  assign primary = product.featured_image
  assign primary_alt = primary.alt | default: product.title
  assign secondary = null

  for img in product.images
    unless img.id == primary.id
      assign secondary = img
      break
    endunless
  endfor

  assign cond_raw = product.metafields.custom.condition.value | downcase | strip
  assign cond_label = ''

  case cond_raw
    when 'new', 'new without tags', 'nieuw zonder prijskaartje'
      assign cond_label = 'New without tags'
    when 'very good', 'heel goed'
      assign cond_label = 'Very good'
    when 'good', 'goed'
      assign cond_label = 'Good'
  endcase

  assign is_sold = false
  unless product.available
    assign is_sold = true
  endunless

  assign is_new = false
  assign now_s = 'now' | date: '%s'
  assign created_s = product.created_at | date: '%s'
  assign age = now_s | minus: created_s

  if created_s != blank and age < 604800
    assign is_new = true
  endif

  assign is_bestseller = false
  assign bs = product.metafields.custom.bestseller.value

  if bs == true or bs == 'true' or bs == '1'
    assign is_bestseller = true
  endif

  assign status_badge = ''

  if is_bestseller
    assign status_badge = 'Bestseller'
  elsif is_new
    assign status_badge = 'Nieuw'
  endif

  assign quick_variant = product.selected_or_first_available_variant
  assign can_quick_add = false

  if product.available and product.has_only_default_variant and quick_variant != blank and quick_variant.available
    assign can_quick_add = true
  endif
-%}

<div class="zh-product-card group relative">
  <div class="zh-product-card__media-wrap relative overflow-hidden">
    <a
      href="{{ product.url }}"
      class="zh-product-card__media-link block focus-visible:outline-none"
      aria-label="Bekijk {{ product.title | escape }}"
    >
      <div class="zh-product-card__media zh-frame relative overflow-hidden">
        {%- if primary -%}
          {{
            primary
            | image_url: width: 800, format: 'webp'
            | image_tag:
              loading: loading,
              sizes: '(min-width: 1024px) 25vw, 50vw',
              widths: '300, 400, 600, 800',
              alt: primary_alt,
              class: 'zh-product-card__image zh-product-card__primary absolute inset-0 h-full w-full object-contain'
          }}

          {%- if secondary -%}
            {{
              secondary
              | image_url: width: 800, format: 'webp'
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 1024px) 25vw, 50vw',
                widths: '300, 400, 600, 800',
                alt: '',
                class: 'zh-product-card__image zh-product-card__secondary absolute inset-0 h-full w-full object-contain'
            }}
          {%- endif -%}
        {%- else -%}
          <div class="absolute inset-0 grid place-items-center px-6 text-center">
            <div>
              <span
                aria-hidden="true"
                class="mx-auto mb-3 block h-px w-10 bg-stone-soft"
              ></span>

              <span class="font-display italic text-sm text-stone block leading-snug">
                Afbeelding volgt
              </span>

              <span class="mt-1 block text-[11px] uppercase tracking-[0.18em] text-stone-soft line-clamp-2">
                {{ product.title }}
              </span>
            </div>
          </div>
        {%- endif -%}

        <div class="zh-product-card__badges">
          {%- if is_sold == false and status_badge != blank -%}
            <span class="zh-product-card__status-badge">
              <span
                class="zh-product-card__status-dot"
                aria-hidden="true"
              ></span>
              {{ status_badge }}
            </span>
          {%- endif -%}

          {%- if cond_label != blank -%}
            <span class="zh-product-card__condition-badge">
              {{ cond_label }}
            </span>
          {%- endif -%}
        </div>

        {%- if is_sold -%}
          <div
            class="absolute inset-0 z-10 grid place-items-center bg-white/60 pointer-events-none"
            aria-hidden="true"
          >
            <span class="font-display italic text-sold -rotate-12 text-2xl">
              Uitverkocht
            </span>
          </div>
        {%- endif -%}
      </div>
    </a>
  </div>

  {%- unless is_sold -%}
    <div class="zh-product-card__quick-action">
        {%- if can_quick_add -%}
          <form
            method="post"
            action="{{ routes.cart_add_url }}"
            data-cart-add-form
            data-quick-add
            data-cart-add-behavior="silent"
            data-product-title="{{ product.title | escape }}"
            class="zh-product-card__quick-form"
          >
            <input type="hidden" name="id" value="{{ quick_variant.id }}">
            <input type="hidden" name="quantity" value="1">

            <button
              type="submit"
              class="zh-product-card__quick-button"
              data-cart-add-button
              aria-label="Voeg {{ product.title | escape }} toe aan je winkelmand"
            >
              <span data-cart-add-label>Toevoegen</span>
              <span data-cart-add-icon aria-hidden="true">+</span>
            </button>
          </form>
        {%- else -%}
          <a
            href="{{ product.url }}"
            class="zh-product-card__quick-button"
            aria-label="Kies opties voor {{ product.title | escape }}"
          >
            <span>Kies opties</span>
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
    </div>
  {%- endunless -%}

  <a
    href="{{ product.url }}"
    class="zh-product-card__details-link block focus-visible:outline-none"
  >
    <div class="zh-product-card__content">
      <h3 class="zh-product-card__title">
        {{ product.title }}
      </h3>

      <div class="zh-product-card__price">
        {%- if product.price and product.price > 0 -%}
          <span>{{ product.price | money }}</span>
        {%- else -%}
          <span class="zh-product-card__price-request">
            prijs op aanvraag
          </span>
        {%- endif -%}
      </div>
    </div>

    <span
      aria-hidden="true"
      class="zh-product-card__underline"
    ></span>
  </a>

  <span class="sr-only" aria-live="polite" data-cart-add-status></span>
</div>

<style>
  .zh-product-card__media-link,
  .zh-product-card__details-link,
  .zh-product-card__quick-button {
    touch-action: manipulation;
  }

  .zh-product-card__media {
    aspect-ratio: 1 / 1;
  }

  .zh-product-card__media,
  .zh-product-card__media img {
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-product-card__secondary {
    opacity: 0;
    transition: opacity 700ms ease;
  }

  .zh-product-card__badges {
    position: absolute;
    top: 9px;
    left: 9px;
    z-index: 12;
    display: flex;
    max-width: calc(100% - 18px);
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    pointer-events: none;
  }

  .zh-product-card__badges:empty {
    display: none;
  }

  .zh-product-card__status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    max-width: 100%;
    padding: 5px 8px;
    border: 1px solid rgba(166, 106, 63, 0.12);
    background: rgba(250, 245, 242, 0.92);
    color: #2a2520;
    font-size: 8px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .zh-product-card__status-dot {
    display: block;
    width: 4px;
    height: 4px;
    flex: 0 0 4px;
    border-radius: 999px;
    background: #b66a2c;
  }

  .zh-product-card__condition-badge {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    padding: 5px 7px;
    border: 1px solid rgba(118, 110, 103, 0.1);
    background: rgba(250, 245, 242, 0.9);
    color: #766e67;
    font-size: 8px;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .zh-product-card__quick-action {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .zh-product-card__quick-form {
    width: 100%;
  }

  .zh-product-card__quick-button {
    display: flex;
    width: 100%;
    min-height: 38px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 12px;
    border-top: 1px solid rgba(231, 221, 210, 0.95);
    border-bottom: 1px solid rgba(231, 221, 210, 0.82);
    background: rgba(250, 245, 242, 0.82);
    color: #2a2520;
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    transition:
      background-color 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      opacity 220ms ease,
      transform 180ms ease;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  button.zh-product-card__quick-button {
    cursor: pointer;
  }

  .zh-product-card__quick-button:hover {
    border-color: rgba(166, 106, 63, 0.28);
    background: #f1e8e0;
    color: #a66a3f;
  }

  .zh-product-card__quick-button:active {
    transform: translateY(1px);
  }

  .zh-product-card__quick-button:focus-visible,
  .zh-product-card__media-link:focus-visible,
  .zh-product-card__details-link:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 3px;
  }

  .zh-product-card__quick-button[aria-busy='true'] {
    cursor: wait;
  }

  .zh-product-card__quick-button.is-added {
    border-color: rgba(138, 154, 123, 0.32);
    background: rgba(138, 154, 123, 0.14);
    color: #485242;
  }

  .zh-product-card__content {
    display: flex;
    flex-direction: column;
    gap: 5px;
    margin-top: 12px;
  }

  .zh-product-card__title {
    display: -webkit-box;
    min-width: 0;
    min-height: 2.5em;
    margin: 0;
    overflow: hidden;
    color: #2a2520;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 14px;
    font-weight: 400;
    line-height: 1.25;
    text-decoration: none;
    transition: color 250ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .zh-product-card__price {
    color: #2a2520;
    font-size: 16px;
    line-height: 1.2;
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  .zh-product-card__price-request {
    color: #766e67;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 13px;
    font-style: italic;
  }

  .zh-product-card__underline {
    display: block;
    width: 24px;
    height: 1px;
    margin-top: 9px;
    background: #e7ddd2;
    transition:
      width 400ms ease,
      background-color 400ms ease;
  }

  .zh-product-card:focus-within .zh-product-card__secondary {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .zh-product-card:hover .zh-product-card__secondary,
    .zh-product-card:focus-within .zh-product-card__secondary {
      opacity: 1;
    }

    .zh-product-card:hover .zh-product-card__title {
      color: #a66a3f;
    }

    .zh-product-card:hover .zh-product-card__underline {
      width: 56px;
      background: rgba(166, 106, 63, 0.7);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .zh-product-card__media-link.is-touch-preview .zh-product-card__secondary {
      opacity: 1;
      transition-duration: 120ms;
    }
  }

  @media (min-width: 640px) {
    .zh-product-card__badges {
      top: 12px;
      left: 12px;
      max-width: calc(100% - 24px);
      gap: 6px;
    }

    .zh-product-card__status-badge {
      padding: 6px 9px;
      font-size: 9px;
      letter-spacing: 0.15em;
    }

    .zh-product-card__condition-badge {
      padding: 6px 8px;
      font-size: 9px;
    }

    .zh-product-card__quick-button {
      min-height: 40px;
      padding: 0 14px;
      font-size: 10px;
    }

    .zh-product-card__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 20px;
      margin-top: 14px;
    }

    .zh-product-card__title {
      min-height: 0;
      font-size: 16px;
    }

    .zh-product-card__price {
      padding-top: 1px;
      font-size: 16px;
      text-align: right;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-product-card__secondary,
    .zh-product-card__title,
    .zh-product-card__underline,
    .zh-product-card__quick-action,
    .zh-product-card__quick-button {
      transition: none;
    }
  }
</style>

<script>
  (() => {
    if (window.__zaynaProductCardTouchReady) return;
    window.__zaynaProductCardTouchReady = true;

    let activeLink = null;
    let startX = 0;
    let startY = 0;

    const clearPreview = () => {
      if (activeLink) {
        activeLink.classList.remove('is-touch-preview');
        activeLink = null;
      }
    };

    document.addEventListener(
      'touchstart',
      (event) => {
        if (event.target.closest('[data-cart-add-form]')) return;

        const link = event.target.closest('.zh-product-card__media-link');
        if (!link) return;

        activeLink = link;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        link.classList.add('is-touch-preview');
      },
      { passive: true }
    );

    document.addEventListener(
      'touchmove',
      (event) => {
        if (!activeLink) return;

        const deltaX = Math.abs(event.touches[0].clientX - startX);
        const deltaY = Math.abs(event.touches[0].clientY - startY);

        if (deltaX > 8 || deltaY > 8) {
          clearPreview();
        }
      },
      { passive: true }
    );

    document.addEventListener('touchend', clearPreview, { passive: true });
    document.addEventListener('touchcancel', clearPreview, { passive: true });

    document.addEventListener('contextmenu', (event) => {
      if (event.target.closest('.zh-product-card__media')) {
        event.preventDefault();
      }
    });

    document.addEventListener('dragstart', (event) => {
      if (event.target.closest('.zh-product-card__media')) {
        event.preventDefault();
      }
    });
  })();
</script>