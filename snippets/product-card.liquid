{%- liquid
  assign loading = loading | default: 'lazy'
  assign primary = product.featured_image
  assign primary_alt = primary.alt | default: product.title
  assign secondary = null

  for image in product.images
    unless image.id == primary.id
      assign secondary = image
      break
    endunless
  endfor

  assign cond_raw = product.metafields.custom.condition.value | downcase | strip
  assign cond_label = ''

  case cond_raw
    when 'new', 'new without tags', 'nieuw zonder prijskaartje'
      assign cond_label = 'Nieuw zonder prijskaartje'
    when 'very good', 'heel goed'
      assign cond_label = 'Zeer goed'
    when 'good', 'goed'
      assign cond_label = 'Goed'
  endcase

  assign is_sold = false
  unless product.available
    assign is_sold = true
  endunless

  assign is_new = false
  assign now_s = 'now' | date: '%s'
  assign created_s = product.created_at | date: '%s'
  assign age = now_s | minus: created_s

  if created_s != blank and age < 604800
    assign is_new = true
  endif

  assign is_bestseller = false
  assign bestseller = product.metafields.custom.bestseller.value

  if bestseller == true or bestseller == 'true' or bestseller == '1'
    assign is_bestseller = true
  endif

  assign status_badge = ''

  if is_bestseller
    assign status_badge = 'Bestseller'
  elsif is_new
    assign status_badge = 'Nieuw'
  endif

  assign quick_variant = product.selected_or_first_available_variant
  assign can_quick_add = false

  if product.available and product.has_only_default_variant and quick_variant != blank and quick_variant.available
    assign can_quick_add = true
  endif
-%}

<style>
  .zh-product-card {
    position: relative;
    min-width: 0;
  }

  .zh-product-card--collection {
    height: 100%;
  }

  .zh-product-card__media-wrap,
  .zh-product-card__media {
    position: relative;
    overflow: hidden;
  }

  .zh-product-card__media-link,
  .zh-product-card__details-link,
  .zh-product-card__quick-button {
    display: block;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
  }

  .zh-product-card__media {
    aspect-ratio: 1 / 1;
    background: #f2ede6;
  }

  .zh-product-card__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #f2ede6;
    transition:
      opacity 560ms ease,
      transform 620ms cubic-bezier(0.22, 0.61, 0.24, 1);
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-product-card__secondary {
    opacity: 0;
  }

  .zh-product-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 24px;
    text-align: center;
  }

  .zh-product-card__placeholder > span {
    width: 38px;
    height: 1px;
    margin: 0 auto 10px;
    background: #a8a29e;
  }

  .zh-product-card__placeholder strong {
    color: #78716c;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 14px;
    font-style: italic;
    font-weight: 400;
  }

  .zh-product-card__placeholder small {
    display: -webkit-box;
    margin-top: 5px;
    overflow: hidden;
    color: #a8a29e;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .zh-product-card__badges {
    position: absolute;
    top: 9px;
    left: 9px;
    z-index: 2;
    display: flex;
    max-width: calc(100% - 18px);
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    pointer-events: none;
  }

  .zh-product-card__status-badge,
  .zh-product-card__sold-badge,
  .zh-product-card__condition-badge {
    display: inline-flex;
    max-width: 100%;
    align-items: center;
    padding: 5px 8px;
    border: 1px solid rgba(118, 110, 103, 0.12);
    background: rgba(250, 245, 242, 0.93);
    color: #625a53;
    font-size: 8px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .zh-product-card__status-badge {
    gap: 5px;
    border-color: rgba(166, 106, 63, 0.12);
    color: #2a2520;
  }

  .zh-product-card__status-dot {
    width: 4px;
    height: 4px;
    flex: 0 0 4px;
    border-radius: 999px;
    background: #b66a2c;
  }

  .zh-product-card__quick-action,
  .zh-product-card__quick-form {
    width: 100%;
  }

  .zh-product-card__quick-button {
    display: flex;
    width: 100%;
    min-height: 37px;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 0 11px;
    border-top: 1px solid rgba(231, 221, 210, 0.92);
    border-bottom: 1px solid rgba(231, 221, 210, 0.76);
    background: rgba(250, 245, 242, 0.78);
    color: #2a2520;
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      color 200ms ease,
      transform 160ms ease;
  }

  button.zh-product-card__quick-button {
    border-right: 0;
    border-left: 0;
    cursor: pointer;
  }

  .zh-product-card__quick-button--sold {
    background: rgba(250, 245, 242, 0.78);
    color: #6c645e;
  }

  .zh-product-card__quick-button:active {
    transform: translateY(1px);
  }

  .zh-product-card__content {
    margin-top: 9px;
  }

  .zh-product-card__title {
    display: -webkit-box;
    min-width: 0;
    min-height: 2.5em;
    margin: 0;
    overflow: hidden;
    color: #2a2520;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.25;
    transition: color 220ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .zh-product-card__price {
    margin-top: 7px;
    color: #2a2520;
    font-size: 14px;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
  }

  .zh-product-card__price-request {
    color: #766e67;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 12px;
    font-style: italic;
  }


  .zh-product-card__quick-button:focus-visible,
  .zh-product-card__media-link:focus-visible,
  .zh-product-card__details-link:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 3px;
  }

  .zh-product-card__quick-button[aria-busy='true'] {
    cursor: wait;
  }

  .zh-product-card__quick-button.is-added {
    border-color: rgba(138, 154, 123, 0.30);
    background: rgba(138, 154, 123, 0.13);
    color: #485242;
  }


  .zh-product-card--fresh .zh-product-card__media {
    border: 1px solid rgba(42, 37, 32, 0.055);
    background:
      linear-gradient(
        180deg,
        rgba(255, 253, 250, 0.28),
        rgba(242, 237, 230, 0.18)
      ),
      #f2ede6;
  }

  .zh-product-card--fresh .zh-product-card__image {
    background: transparent;
  }

  .zh-product-card--fresh .zh-product-card__badges {
    top: 8px;
    left: 8px;
    max-width: calc(100% - 16px);
    gap: 4px;
  }

  .zh-product-card--fresh .zh-product-card__status-badge,
  .zh-product-card--fresh .zh-product-card__sold-badge,
  .zh-product-card--fresh .zh-product-card__condition-badge {
    padding: 5px 7px;
    border-color: rgba(118, 110, 103, 0.10);
    background: rgba(250, 245, 242, 0.86);
    color: #5f564f;
    font-size: 7.5px;
    letter-spacing: 0.12em;
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .zh-product-card--fresh .zh-product-card__status-badge {
    color: #4d453f;
  }

  .zh-product-card--fresh .zh-product-card__quick-action {
    margin-top: 8px;
  }

  .zh-product-card--fresh .zh-product-card__quick-button {
    min-height: 33px;
    padding: 0 10px;
    border: 1px solid rgba(42, 37, 32, 0.075);
    background: rgba(250, 245, 242, 0.34);
    color: #3b342e;
    font-size: 8.3px;
    letter-spacing: 0.108em;
  }

  button.zh-product-card--fresh .zh-product-card__quick-button,
  .zh-product-card--fresh button.zh-product-card__quick-button {
    border: 1px solid rgba(42, 37, 32, 0.075);
  }

  .zh-product-card--fresh .zh-product-card__content {
    margin-top: 8px;
  }

  .zh-product-card--fresh .zh-product-card__title {
    min-height: 2.54em;
    color: #2c2722;
    font-size: 13.15px;
    line-height: 1.27;
    letter-spacing: -0.006em;
  }

  .zh-product-card--fresh .zh-product-card__price {
    margin-top: 5px;
    color: #3c352f;
    font-size: 13.25px;
    line-height: 1.18;
  }

  @media (min-width: 640px) {
    .zh-product-card__badges {
      top: 11px;
      left: 11px;
      max-width: calc(100% - 22px);
    }

    .zh-product-card__status-badge,
    .zh-product-card__sold-badge,
    .zh-product-card__condition-badge {
      padding: 6px 9px;
      font-size: 8.5px;
    }

    .zh-product-card__quick-button {
      min-height: 39px;
      padding: 0 13px;
      font-size: 9px;
    }

    .zh-product-card__content {
      margin-top: 10px;
    }

    .zh-product-card__title {
      font-size: 14px;
    }

    .zh-product-card__price {
      margin-top: 8px;
      font-size: 15px;
    }
  }


  @media (min-width: 640px) {
    .zh-product-card--fresh .zh-product-card__media {
      border-color: rgba(42, 37, 32, 0.06);
    }

    .zh-product-card--fresh .zh-product-card__badges {
      top: 9px;
      left: 9px;
      max-width: calc(100% - 18px);
    }

    .zh-product-card--fresh .zh-product-card__quick-action {
      margin-top: 8px;
    }

    .zh-product-card--fresh .zh-product-card__quick-button {
      min-height: 34px;
      padding: 0 11px;
      font-size: 8.5px;
      letter-spacing: 0.105em;
    }

    .zh-product-card--fresh .zh-product-card__content {
      margin-top: 9px;
    }

    .zh-product-card--fresh .zh-product-card__title {
      font-size: 13.6px;
      line-height: 1.28;
    }

    .zh-product-card--fresh .zh-product-card__price {
      margin-top: 5px;
      font-size: 13.8px;
    }
  }


  @media (min-width: 900px) {
    .zh-product-card__quick-button {
      font-size: 9.5px;
      letter-spacing: 0.115em;
    }

    .zh-product-card__title {
      font-size: 15px;
      line-height: 1.27;
    }

    .zh-product-card__price {
      font-size: 15.5px;
    }
  }


  @media (min-width: 900px) {
    .zh-product-card--fresh .zh-product-card__quick-button {
      min-height: 35px;
      font-size: 8.8px;
      letter-spacing: 0.105em;
    }

    .zh-product-card--fresh .zh-product-card__title {
      font-size: 14.4px;
      line-height: 1.28;
    }

    .zh-product-card--fresh .zh-product-card__price {
      font-size: 14.5px;
    }
  }


  @media (hover: none) and (pointer: coarse) {
    .zh-product-card__quick-button.is-touch-active {
      border-color: rgba(166, 106, 63, 0.28);
      background: #f1e8e0;
      color: #955c39;
      transform: scale(0.995);
    }

    .zh-product-card__quick-button--sold.is-touch-active {
      border-color: rgba(231, 221, 210, 0.92);
      background: rgba(250, 245, 242, 0.78);
      color: #6c645e;
      transform: none;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .zh-product-card:hover .zh-product-card__primary {
      transform: scale(1.012);
    }

    .zh-product-card:hover .zh-product-card__secondary,
    .zh-product-card:focus-within .zh-product-card__secondary {
      opacity: 1;
      transform: scale(1.012);
    }

    .zh-product-card:hover .zh-product-card__title {
      color: #9a6039;
    }

    .zh-product-card__quick-button:not(
      .zh-product-card__quick-button--sold
    ):hover {
      border-color: rgba(166, 106, 63, 0.24);
      background: #f1e8e0;
      color: #955c39;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .zh-product-card__media-link.is-touch-preview .zh-product-card__secondary {
      opacity: 1;
      transition-duration: 120ms;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .zh-product-card--fresh:hover .zh-product-card__media {
      border-color: rgba(166, 106, 63, 0.18);
    }

    .zh-product-card--fresh:hover .zh-product-card__primary {
      transform: scale(1.01);
    }

    .zh-product-card--fresh .zh-product-card__quick-button:not(
      .zh-product-card__quick-button--sold
    ):hover {
      border-color: rgba(166, 106, 63, 0.22);
      background: rgba(246, 238, 230, 0.82);
      color: #8b5738;
    }
  }


  @media (hover: hover) and (pointer: fine) and (min-width: 560px) and (max-width: 749px) {
    .zh-product-card--fresh .zh-product-card__media {
      aspect-ratio: 1 / 1;
    }

    .zh-product-card--fresh .zh-product-card__quick-action {
      margin-top: 7px;
    }

    .zh-product-card--fresh .zh-product-card__quick-button {
      min-height: 32px;
      padding: 0 10px;
      font-size: 8.2px;
      letter-spacing: 0.095em;
    }

    .zh-product-card--fresh .zh-product-card__content {
      margin-top: 8px;
    }

    .zh-product-card--fresh .zh-product-card__title {
      min-height: 2.48em;
      font-size: 13.2px;
      line-height: 1.24;
    }

    .zh-product-card--fresh .zh-product-card__price {
      margin-top: 4px;
      font-size: 13.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-product-card__image,
    .zh-product-card__title,
    .zh-product-card__quick-button {
      transition: none;
    }
  }
</style>

<article
  class="zh-product-card{% if card_context == 'collection' %} zh-product-card--collection{% endif %}{% if card_context == 'freshly-listed' %} zh-product-card--fresh{% endif %}{% if is_sold %} zh-product-card--sold{% endif %}"
>
  <div class="zh-product-card__media-wrap">
    <a
      href="{{ product.url }}"
      class="zh-product-card__media-link"
      aria-label="Bekijk {{ product.title | escape }}"
    >
      <div class="zh-product-card__media zh-frame">
        {%- if primary -%}
          {{
            primary
            | image_url: width: 800, format: 'webp'
            | image_tag:
              loading: loading,
              decoding: 'async',
              sizes: '(min-width: 1024px) 25vw, 50vw',
              widths: '240, 280, 320, 360, 400, 480, 560, 640, 720, 800',
              alt: primary_alt,
              class: 'zh-product-card__image zh-product-card__primary'
          }}

          {%- if secondary -%}
            {{
              secondary
              | image_url: width: 800, format: 'webp'
              | image_tag:
                loading: 'lazy',
                fetchpriority: 'low',
                decoding: 'async',
                sizes: '(min-width: 1024px) 25vw, 50vw',
                widths: '240, 280, 320, 360, 400, 480, 560, 640, 720, 800',
                alt: '',
                class: 'zh-product-card__image zh-product-card__secondary'
            }}
          {%- endif -%}
        {%- else -%}
          <div class="zh-product-card__placeholder">
            <span aria-hidden="true"></span>
            <strong>Afbeelding volgt</strong>
            <small>{{ product.title }}</small>
          </div>
        {%- endif -%}

        <div class="zh-product-card__badges">
          {%- if is_sold -%}
            <span class="zh-product-card__sold-badge">
              Uitverkocht
            </span>
          {%- elsif status_badge != blank -%}
            <span class="zh-product-card__status-badge">
              <span
                class="zh-product-card__status-dot"
                aria-hidden="true"
              ></span>
              {{ status_badge }}
            </span>
          {%- endif -%}

          {%- if cond_label != blank -%}
            <span class="zh-product-card__condition-badge">
              {{ cond_label }}
            </span>
          {%- endif -%}
        </div>
      </div>
    </a>
  </div>

  <div class="zh-product-card__quick-action">
    {%- if is_sold -%}
      <a
        href="{{ product.url }}"
        class="zh-product-card__quick-button zh-product-card__quick-button--sold"
        aria-label="Bekijk {{ product.title | escape }}"
      >
        <span>Uitverkocht</span>
        <span aria-hidden="true">—</span>
      </a>
    {%- elsif can_quick_add -%}
      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        data-cart-add-form
        data-quick-add
        data-cart-add-behavior="silent"
        data-product-title="{{ product.title | escape }}"
        class="zh-product-card__quick-form"
      >
        <input type="hidden" name="id" value="{{ quick_variant.id }}">
        <input type="hidden" name="quantity" value="1">

        <button
          type="submit"
          class="zh-product-card__quick-button"
          data-cart-add-button
          aria-label="Voeg {{ product.title | escape }} toe aan je winkelmand"
        >
          <span data-cart-add-label>Toevoegen</span>
          <span data-cart-add-icon aria-hidden="true">+</span>
        </button>
      </form>
    {%- else -%}
      <a
        href="{{ product.url }}"
        class="zh-product-card__quick-button"
        aria-label="Kies opties voor {{ product.title | escape }}"
      >
        <span>Kies opties</span>
        <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>

  <a
    href="{{ product.url }}"
    class="zh-product-card__details-link"
  >
    <div class="zh-product-card__content">
      <h3 class="zh-product-card__title">
        {{ product.title }}
      </h3>

      <div class="zh-product-card__price">
        {%- if product.price and product.price > 0 -%}
          <span>{{ product.price | money }}</span>
        {%- else -%}
          <span class="zh-product-card__price-request">
            Prijs op aanvraag
          </span>
        {%- endif -%}
      </div>
    </div>

  </a>

  <span class="sr-only" aria-live="polite" data-cart-add-status></span>
</article>



<script>
  (() => {
    if (window.__zaynaProductCardTouchReady) return;
    window.__zaynaProductCardTouchReady = true;

    let activeLink = null;
    let startX = 0;
    let startY = 0;

    const clearPreview = () => {
      if (activeLink) {
        activeLink.classList.remove('is-touch-preview');
        activeLink = null;
      }
    };

    document.addEventListener(
      'touchstart',
      (event) => {
        if (event.target.closest('[data-cart-add-form]')) return;

        const link = event.target.closest(
          '.zh-product-card__media-link'
        );

        if (!link) return;

        activeLink = link;
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
        link.classList.add('is-touch-preview');
      },
      { passive: true }
    );

    document.addEventListener(
      'touchmove',
      (event) => {
        if (!activeLink) return;

        const deltaX = Math.abs(
          event.touches[0].clientX - startX
        );

        const deltaY = Math.abs(
          event.touches[0].clientY - startY
        );

        if (deltaX > 8 || deltaY > 8) {
          clearPreview();
        }
      },
      { passive: true }
    );

    document.addEventListener(
      'touchend',
      clearPreview,
      { passive: true }
    );

    document.addEventListener(
      'touchcancel',
      clearPreview,
      { passive: true }
    );

    document.addEventListener('contextmenu', (event) => {
      if (event.target.closest('.zh-product-card__media')) {
        event.preventDefault();
      }
    });

    document.addEventListener('dragstart', (event) => {
      if (event.target.closest('.zh-product-card__media')) {
        event.preventDefault();
      }
    });

    /*
     * Mobile Quick Add feedback.
     * It appears only for a real press and is cancelled as soon as the
     * finger moves far enough to indicate scrolling.
     */
    let quickButton = null;
    let quickStartX = 0;
    let quickStartY = 0;
    let quickTimer = null;

    const clearQuickFeedback = () => {
      if (quickTimer) {
        window.clearTimeout(quickTimer);
        quickTimer = null;
      }

      quickButton?.classList.remove('is-touch-active');
      quickButton = null;
    };

    document.addEventListener(
      'pointerdown',
      (event) => {
        if (event.pointerType !== 'touch') return;

        const button = event.target.closest(
          '.zh-product-card__quick-button'
        );

        if (!button) return;

        clearQuickFeedback();

        quickButton = button;
        quickStartX = event.clientX;
        quickStartY = event.clientY;

        quickTimer = window.setTimeout(() => {
          quickButton?.classList.add('is-touch-active');
        }, 55);
      },
      { passive: true }
    );

    document.addEventListener(
      'pointermove',
      (event) => {
        if (
          event.pointerType !== 'touch' ||
          !quickButton
        ) {
          return;
        }

        const movedX = Math.abs(
          event.clientX - quickStartX
        );

        const movedY = Math.abs(
          event.clientY - quickStartY
        );

        if (movedX > 9 || movedY > 9) {
          clearQuickFeedback();
        }
      },
      { passive: true }
    );

    document.addEventListener(
      'pointerup',
      (event) => {
        if (event.pointerType !== 'touch') return;

        window.setTimeout(clearQuickFeedback, 130);
      },
      { passive: true }
    );

    document.addEventListener(
      'pointercancel',
      clearQuickFeedback,
      { passive: true }
    );
  })();
</script>