{%- comment -%}
  Zayna Home productgalerij.
  Gedrag wordt aangestuurd door assets/product.js via data-* hooks.
  Vereist: product, is_sold.
{%- endcomment -%}

{%- assign imgs = product.images -%}

{% style %}
  .zh-gallery {
    width: 100%;
    max-width: 370px;
    margin: 0 auto;
    color: var(--color-ink, #2a2520);
  }

  .zh-gallery:focus-visible {
    outline: 2px solid #9b5f35;
    outline-offset: 5px;
  }

  .zh-gallery__mobile {
    display: block;
  }

  .zh-gallery__desktop {
    display: none;
  }

  .zh-gallery__frame,
  .zh-gallery__main-frame {
    position: relative;
    overflow: hidden;
    background: #fcfaf7;
  }

  .zh-gallery__track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .zh-gallery__track::-webkit-scrollbar,
  .zh-gallery__viewer-media::-webkit-scrollbar {
    display: none;
  }

  .zh-gallery__slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 1;
    overflow: hidden;
    scroll-snap-align: center;
    background: #fcfaf7;
  }

  .zh-gallery__image,
  .zh-gallery__main-image,
  .zh-gallery__thumb img,
  .zh-gallery__viewer-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-gallery__main-frame {
    aspect-ratio: 1;
  }

  .zh-gallery__main-image {
    transition: opacity 160ms ease;
  }

  .zh-gallery__nav,
  .zh-gallery__viewer-nav {
    display: grid;
    place-items: center;
    border: 1px solid rgb(42 37 32 / 10%);
    background: rgb(252 250 247 / 92%);
    color: #2a2520;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      opacity 160ms ease,
      border-color 160ms ease;
  }

  .zh-gallery__nav {
    position: absolute;
    z-index: 3;
    top: 50%;
    width: 2.45rem;
    height: 2.45rem;
    transform: translateY(-50%);
  }

  .zh-gallery__nav--prev {
    left: .55rem;
  }

  .zh-gallery__nav--next {
    right: .55rem;
  }

  .zh-gallery__nav:hover:not(:disabled),
  .zh-gallery__viewer-nav:hover:not(:disabled) {
    border-color: #2a2520;
    background: #2a2520;
    color: #fff;
  }

  .zh-gallery__nav:disabled,
  .zh-gallery__viewer-nav:disabled {
    opacity: .28;
    cursor: default;
  }

  .zh-gallery__open {
    position: absolute;
    z-index: 3;
    right: .65rem;
    bottom: .65rem;
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    gap: .45rem;
    padding: .45rem .7rem;
    border: 1px solid rgb(42 37 32 / 10%);
    background: rgb(252 250 247 / 92%);
    color: #2a2520;
    font-size: .72rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    backdrop-filter: blur(6px);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .zh-gallery__open:hover {
    border-color: #2a2520;
    background: #2a2520;
    color: #fff;
  }

  .zh-gallery__sold-label {
    position: absolute;
    z-index: 3;
    top: .65rem;
    left: .65rem;
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    padding: .25rem .65rem;
    border: 1px solid rgb(155 76 67 / 16%);
    background: rgb(252 250 247 / 94%);
    color: var(--color-sold, #9b4c43);
    font-size: .69rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    backdrop-filter: blur(7px);
  }

  .zh-gallery__meta {
    display: flex;
    align-items: center;
    gap: .85rem;
    min-height: 2.3rem;
    margin-top: .55rem;
  }

  .zh-gallery__counter {
    flex: 0 0 auto;
    min-width: 2.8rem;
    color: #625a53;
    font-size: .74rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .06em;
    line-height: 1.3;
  }

  .zh-gallery__segments {
    display: grid;
    grid-template-columns: repeat(var(--zh-gallery-count, 1), minmax(0, 1fr));
    flex: 1 1 auto;
    gap: .28rem;
  }

  .zh-gallery__segment {
    position: relative;
    min-width: 0;
    height: 1.65rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .zh-gallery__segment::before {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    height: 2px;
    background: #ded5cc;
    content: '';
    transform: translateY(-50%);
    transition: background-color 150ms ease, height 150ms ease;
  }

  .zh-gallery__segment:hover::before,
  .zh-gallery__segment[aria-current='true']::before {
    background: #2a2520;
  }

  .zh-gallery__segment[aria-current='true']::before {
    height: 3px;
  }

  .zh-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin-top: .7rem;
  }

  .zh-gallery__thumb {
    position: relative;
    width: 56px;
    height: 56px;
    flex: 0 0 56px;
    overflow: hidden;
    padding: 0;
    border: 1px solid transparent;
    background: #fcfaf7;
    opacity: .7;
    cursor: pointer;
    transition: border-color 160ms ease, opacity 160ms ease;
  }

  .zh-gallery__thumb:hover,
  .zh-gallery__thumb[aria-current='true'] {
    opacity: 1;
  }

  .zh-gallery__thumb[aria-current='true'] {
    border-color: #9b5f35;
  }

  .zh-gallery__nav:focus-visible,
  .zh-gallery__open:focus-visible,
  .zh-gallery__segment:focus-visible,
  .zh-gallery__thumb:focus-visible,
  .zh-gallery__viewer button:focus-visible {
    outline: 2px solid #9b5f35;
    outline-offset: 3px;
  }

  .zh-gallery__empty {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    padding: 2rem;
    border: 1px solid #ded5cc;
    text-align: center;
  }

  .zh-gallery__empty p {
    margin: 0;
    color: #625a53;
    font-size: .95rem;
  }

  .zh-gallery__viewer {
    position: fixed;
    z-index: 120;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .zh-gallery__viewer[hidden] {
    display: none !important;
  }

  .zh-gallery__viewer-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgb(42 37 32 / 44%);
    cursor: default;
    backdrop-filter: blur(3px);
  }

  .zh-gallery__viewer-panel {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(920px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(42 37 32 / 10%);
    background: #fcfaf7;
    box-shadow: 0 28px 80px rgb(42 37 32 / 25%);
  }

  .zh-gallery__viewer-header {
    display: flex;
    min-height: 3.5rem;
    align-items: center;
    gap: .75rem;
    padding: .55rem .7rem .55rem 1rem;
    border-bottom: 1px solid #ded5cc;
  }

  .zh-gallery__viewer-title {
    margin: 0;
    color: #2a2520;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1rem;
    font-weight: 400;
  }

  .zh-gallery__viewer-counter {
    margin-left: auto;
    color: #625a53;
    font-size: .72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .06em;
  }

  .zh-gallery__viewer-zoom,
  .zh-gallery__viewer-close {
    display: inline-flex;
    min-height: 2.45rem;
    align-items: center;
    justify-content: center;
    gap: .38rem;
    padding: .4rem .65rem;
    border: 0;
    background: transparent;
    color: #2a2520;
    font-size: .72rem;
    font-weight: 600;
    cursor: pointer;
  }

  .zh-gallery__viewer-zoom:hover,
  .zh-gallery__viewer-close:hover {
    background: rgb(42 37 32 / 6%);
  }

  .zh-gallery__viewer-close {
    width: 2.45rem;
    padding: 0;
  }

  .zh-gallery__viewer-body {
    position: relative;
    display: grid;
    min-height: 0;
    flex: 1 1 auto;
    place-items: center;
    padding: 1rem 3.4rem 1.2rem;
  }

  .zh-gallery__viewer-media {
    display: grid;
    width: 100%;
    max-height: min(70dvh, 700px);
    min-height: 260px;
    overflow: auto;
    place-items: center;
    scrollbar-width: thin;
    scrollbar-color: #c8b7a8 transparent;
  }

  .zh-gallery__viewer-image {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(68dvh, 680px);
    object-fit: contain;
    transition: width 180ms ease, max-width 180ms ease, max-height 180ms ease;
  }

  .zh-gallery__viewer.is-zoomed .zh-gallery__viewer-image {
    width: 125%;
    max-width: none;
    max-height: none;
  }

  .zh-gallery__viewer-nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: 2.65rem;
    height: 2.65rem;
    transform: translateY(-50%);
  }

  .zh-gallery__viewer-nav--prev {
    left: .45rem;
  }

  .zh-gallery__viewer-nav--next {
    right: .45rem;
  }

  @media (max-width: 479px) {
    .zh-gallery__nav {
      width: 2.25rem;
      height: 2.25rem;
    }

    .zh-gallery__open span:last-child {
      display: none;
    }

    .zh-gallery__open {
      width: 2.35rem;
      padding: 0;
      justify-content: center;
    }

    .zh-gallery__viewer-panel {
      width: calc(100vw - 1rem);
      max-height: calc(100dvh - 1rem);
    }

    .zh-gallery__viewer-header {
      padding-left: .8rem;
    }

    .zh-gallery__viewer-zoom span {
      display: none;
    }

    .zh-gallery__viewer-body {
      padding: .75rem 2.75rem 1rem;
    }

    .zh-gallery__viewer-media {
      max-height: 62dvh;
      min-height: 220px;
    }

    .zh-gallery__viewer-image {
      max-height: 60dvh;
    }
  }

  @media (min-width: 768px) {
    .zh-gallery {
      max-width: 400px;
      margin: 0;
    }

    .zh-gallery__mobile {
      display: none;
    }

    .zh-gallery__desktop {
      display: block;
    }
  }

  @media (min-width: 1100px) {
    .zh-gallery {
      max-width: 460px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-gallery__main-image,
    .zh-gallery__nav,
    .zh-gallery__open,
    .zh-gallery__segment::before,
    .zh-gallery__thumb,
    .zh-gallery__viewer-image {
      transition: none;
    }
  }
{% endstyle %}

<div
  class="zh-gallery"
  data-gallery
  data-images='[
    {%- for image in imgs -%}
      {%- assign image_alt = image.alt | default: product.title -%}
      {
        "src": {{ image | image_url: width: 1800, format: 'webp' | json }},
        "alt": {{ image_alt | json }},
        "width": {{ image.width | default: 0 }},
        "height": {{ image.height | default: 0 }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]'
  tabindex="0"
  role="region"
  aria-label="Productgalerij. Gebruik de pijltjestoetsen om door de afbeeldingen te bladeren."
>
  {%- if imgs.size == 0 -%}
    <div class="zh-gallery__empty">
      <p>Productfoto volgt binnenkort.</p>
    </div>
  {%- else -%}
    {%- assign first = imgs | first -%}
    {%- assign first_alt = first.alt | default: product.title -%}

    <div class="zh-gallery__mobile">
      <div class="zh-gallery__frame">
        <div data-gallery-track class="zh-gallery__track">
          {%- for image in imgs -%}
            {%- assign mobile_alt = image.alt | default: product.title -%}
            {%- assign mobile_loading = 'lazy' -%}
            {%- assign mobile_priority = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign mobile_loading = 'eager' -%}
              {%- assign mobile_priority = 'high' -%}
            {%- endif -%}
            <div
              class="zh-gallery__slide"
              data-gallery-slide
              data-gallery-index="{{ forloop.index0 }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            >
              {{ image | image_url: width: 1000, format: 'webp' | image_tag: loading: mobile_loading, fetchpriority: mobile_priority, sizes: '(max-width: 767px) min(100vw - 32px, 370px), 370px', widths: '320, 370, 500, 700, 1000', alt: mobile_alt, class: 'zh-gallery__image' }}
            </div>
          {%- endfor -%}
        </div>

        {%- if imgs.size > 1 -%}
          <button type="button" data-gallery-prev class="zh-gallery__nav zh-gallery__nav--prev" aria-label="Vorige afbeelding" disabled>
            {% render 'icon', name: 'chevron-left', size: 19 %}
          </button>
          <button type="button" data-gallery-next class="zh-gallery__nav zh-gallery__nav--next" aria-label="Volgende afbeelding">
            {% render 'icon', name: 'chevron-right', size: 19 %}
          </button>
        {%- endif -%}

        {%- if is_sold -%}
          <span data-gallery-sold-label class="zh-gallery__sold-label">Uitverkocht</span>
        {%- endif -%}

        <button type="button" data-gallery-viewer-open class="zh-gallery__open" aria-label="Bekijk de actieve productfoto groter">
          {% render 'icon', name: 'zoom-in', size: 15 %}
          <span>Bekijk groter</span>
        </button>
      </div>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__meta">
          <span data-gallery-counter class="zh-gallery__counter" aria-live="polite">1 / {{ imgs.size }}</span>
          <div class="zh-gallery__segments" style="--zh-gallery-count: {{ imgs.size }};" role="group" aria-label="Kies een productafbeelding">
            {%- for image in imgs -%}
              <button
                type="button"
                data-gallery-segment="{{ forloop.index0 }}"
                class="zh-gallery__segment"
                aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="-1"
              ></button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="zh-gallery__desktop">
      <div class="zh-gallery__main-frame">
        {{ first | image_url: width: 1400, format: 'webp' | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1100px) 460px, 400px', widths: '400, 500, 700, 900, 1200, 1400', alt: first_alt, class: 'zh-gallery__main-image' }}

        {%- if imgs.size > 1 -%}
          <button type="button" data-gallery-prev class="zh-gallery__nav zh-gallery__nav--prev" aria-label="Vorige afbeelding" disabled>
            {% render 'icon', name: 'chevron-left', size: 19 %}
          </button>
          <button type="button" data-gallery-next class="zh-gallery__nav zh-gallery__nav--next" aria-label="Volgende afbeelding">
            {% render 'icon', name: 'chevron-right', size: 19 %}
          </button>
        {%- endif -%}

        {%- if is_sold -%}
          <span data-gallery-sold-label class="zh-gallery__sold-label">Uitverkocht</span>
        {%- endif -%}

        <button type="button" data-gallery-viewer-open class="zh-gallery__open" aria-label="Bekijk de actieve productfoto groter">
          {% render 'icon', name: 'zoom-in', size: 15 %}
          <span>Bekijk groter</span>
        </button>
      </div>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__meta">
          <span data-gallery-counter class="zh-gallery__counter" aria-live="polite">1 / {{ imgs.size }}</span>
          <div class="zh-gallery__segments" style="--zh-gallery-count: {{ imgs.size }};" role="group" aria-label="Kies een productafbeelding">
            {%- for image in imgs -%}
              <button
                type="button"
                data-gallery-segment="{{ forloop.index0 }}"
                class="zh-gallery__segment"
                aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                tabindex="-1"
              ></button>
            {%- endfor -%}
          </div>
        </div>

        <div class="zh-gallery__thumbs" aria-label="Productafbeeldingen">
          {%- for image in imgs -%}
            {%- assign thumb_alt = image.alt | default: product.title -%}
            <button
              type="button"
              class="zh-gallery__thumb"
              data-gallery-thumb="{{ forloop.index0 }}"
              aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{ image | image_url: width: 180, format: 'webp' | image_tag: loading: 'lazy', sizes: '56px', widths: '56, 84, 112, 180', alt: thumb_alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div
      data-gallery-viewer
      class="zh-gallery__viewer"
      role="dialog"
      aria-modal="true"
      aria-labelledby="zh-gallery-viewer-title-{{ product.id }}"
      hidden
    >
      <button type="button" tabindex="-1" data-gallery-viewer-backdrop class="zh-gallery__viewer-backdrop" aria-label="Fotovenster sluiten"></button>

      <div class="zh-gallery__viewer-panel" role="document">
        <div class="zh-gallery__viewer-header">
          <h2 id="zh-gallery-viewer-title-{{ product.id }}" class="zh-gallery__viewer-title">Productfoto</h2>
          <span data-gallery-viewer-counter class="zh-gallery__viewer-counter">1 / {{ imgs.size }}</span>
          <button type="button" data-gallery-viewer-zoom class="zh-gallery__viewer-zoom" aria-pressed="false">
            {% render 'icon', name: 'zoom-in', size: 16 %}
            <span data-gallery-viewer-zoom-label>Vergroot</span>
          </button>
          <button type="button" data-gallery-viewer-close class="zh-gallery__viewer-close" aria-label="Fotovenster sluiten">
            {% render 'icon', name: 'x', size: 20 %}
          </button>
        </div>

        <div class="zh-gallery__viewer-body">
          <div class="zh-gallery__viewer-media" data-gallery-viewer-media>
            <img
              data-gallery-viewer-image
              class="zh-gallery__viewer-image"
              src="{{ first | image_url: width: 1800, format: 'webp' }}"
              alt="{{ first_alt | escape }}"
              width="{{ first.width }}"
              height="{{ first.height }}"
              loading="eager"
            >
          </div>

          {%- if imgs.size > 1 -%}
            <button type="button" data-gallery-viewer-prev class="zh-gallery__viewer-nav zh-gallery__viewer-nav--prev" aria-label="Vorige afbeelding" disabled>
              {% render 'icon', name: 'chevron-left', size: 21 %}
            </button>
            <button type="button" data-gallery-viewer-next class="zh-gallery__viewer-nav zh-gallery__viewer-nav--next" aria-label="Volgende afbeelding">
              {% render 'icon', name: 'chevron-right', size: 21 %}
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>
