{%- comment -%}
  Zayna Home productgalerij.
  Gedrag wordt aangestuurd door assets/product.js via data-* hooks.
  Vereist: product, is_sold.
{%- endcomment -%}

{%- assign imgs = product.images -%}

{% style %}
  .zh-gallery {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    color: var(--color-ink, #2a2520);
  }

  .zh-gallery:focus-visible {
    outline: 0;
  }

  .zh-gallery:focus-visible .zh-gallery__counter,
  .zh-gallery:focus-visible .zh-gallery__utility-link {
    color: #9b5f35;
  }

  .zh-gallery:focus-visible .zh-gallery__nav:not(:disabled) {
    border-color: rgb(155 95 53 / 58%);
    color: #9b5f35;
  }

  .zh-gallery__compact {
    display: block;
  }

  .zh-gallery__wide {
    display: none;
  }

  .zh-gallery__frame,
  .zh-gallery__main-frame {
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .zh-gallery__track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .zh-gallery__track::-webkit-scrollbar,
  .zh-gallery__viewer-media::-webkit-scrollbar {
    display: none;
  }

  .zh-gallery__slide {
    position: relative;
    flex: 0 0 100%;
    aspect-ratio: 1;
    overflow: hidden;
    scroll-snap-align: center;
    background: transparent;
  }

  .zh-gallery__image,
  .zh-gallery__main-image,
  .zh-gallery__thumb img,
  .zh-gallery__viewer-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-gallery__main-frame {
    aspect-ratio: 1;
  }

  .zh-gallery__main-image {
    transition: opacity 160ms ease;
  }

  .zh-gallery__nav,
  .zh-gallery__viewer-nav {
    display: grid;
    place-items: center;
    border: 1px solid rgb(42 37 32 / 10%);
    background: rgb(252 250 247 / 90%);
    color: #2a2520;
    cursor: pointer;
    backdrop-filter: blur(5px);
    transition:
      background-color 160ms ease,
      color 160ms ease,
      opacity 160ms ease,
      border-color 160ms ease;
  }

  .zh-gallery__nav {
    position: absolute;
    z-index: 3;
    top: 50%;
    width: 2.35rem;
    height: 2.35rem;
    transform: translateY(-50%);
  }

  .zh-gallery__nav--prev {
    left: .5rem;
  }

  .zh-gallery__nav--next {
    right: .5rem;
  }

  .zh-gallery__nav:hover:not(:disabled),
  .zh-gallery__viewer-nav:hover:not(:disabled) {
    border-color: #2a2520;
    background: #2a2520;
    color: #fff;
  }

  .zh-gallery__nav:disabled,
  .zh-gallery__viewer-nav:disabled {
    opacity: .25;
    cursor: default;
  }

  .zh-gallery__sold-label {
    position: absolute;
    z-index: 3;
    top: .6rem;
    left: .6rem;
    display: inline-flex;
    min-height: 1.7rem;
    align-items: center;
    padding: .22rem .6rem;
    border: 1px solid rgb(155 76 67 / 15%);
    background: rgb(252 250 247 / 94%);
    color: var(--color-sold, #9b4c43);
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .zh-gallery__utility {
    display: flex;
    min-height: 2.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: .35rem;
  }

  .zh-gallery__counter {
    flex: 0 0 auto;
    min-width: 2.8rem;
    color: #625a53;
    font-size: .75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .05em;
    line-height: 1.3;
  }

  .zh-gallery__utility-link {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    gap: .4rem;
    padding: .25rem 0;
    border: 0;
    background: transparent;
    color: #625a53;
    font-size: .76rem;
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
    text-underline-offset: 3px;
    transition: color 160ms ease;
  }

  .zh-gallery__utility-link:hover {
    color: #9b5f35;
    text-decoration: underline;
  }

  .zh-gallery__dots {
    display: flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    gap: .1rem;
  }

  .zh-gallery__dot {
    position: relative;
    width: 1.75rem;
    height: 2rem;
    flex: 0 0 1.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .zh-gallery__dot::before {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #cfc4ba;
    content: '';
    transform: translate(-50%, -50%);
    transition:
      width 150ms ease,
      background-color 150ms ease;
  }

  .zh-gallery__dot:hover::before,
  .zh-gallery__dot[aria-current='true']::before {
    background: #2a2520;
  }

  .zh-gallery__dot[aria-current='true']::before {
    width: 16px;
  }

  .zh-gallery__thumbs {
    display: flex;
    flex-wrap: nowrap;
    gap: .4rem;
    margin: .35rem -3px 0;
    padding: 3px 3px .35rem;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scroll-padding-inline: 3px;
    scroll-snap-type: inline proximity;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .zh-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  .zh-gallery__thumb {
    position: relative;
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    overflow: hidden;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    opacity: .66;
    cursor: pointer;
    scroll-snap-align: start;
    transition: border-color 160ms ease, opacity 160ms ease;
  }

  .zh-gallery__thumb:hover,
  .zh-gallery__thumb[aria-current='true'] {
    opacity: 1;
  }

  .zh-gallery__thumb[aria-current='true'] {
    border-color: #9b5f35;
  }

  .zh-gallery__nav:focus-visible,
  .zh-gallery__utility-link:focus-visible,
  .zh-gallery__dot:focus-visible,
  .zh-gallery__thumb:focus-visible,
  .zh-gallery__viewer button:focus-visible {
    outline: 2px solid #9b5f35;
    outline-offset: 3px;
  }

  .zh-gallery__empty {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    padding: 2rem;
    border: 1px solid #ded5cc;
    text-align: center;
  }

  .zh-gallery__empty p {
    margin: 0;
    color: #625a53;
    font-size: .95rem;
  }

  .zh-gallery__viewer {
    position: fixed;
    z-index: 120;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .zh-gallery__viewer[hidden] {
    display: none !important;
  }

  .zh-gallery__viewer-backdrop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: rgb(42 37 32 / 23%);
    cursor: default;
    backdrop-filter: blur(2px);
  }

  .zh-gallery__viewer-panel {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(690px, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgb(42 37 32 / 9%);
    background: #f8f4ef;
    box-shadow: 0 24px 70px rgb(42 37 32 / 20%);
  }

  .zh-gallery__viewer-header {
    display: flex;
    min-height: 3.35rem;
    align-items: center;
    gap: .7rem;
    padding: .45rem .55rem .45rem .9rem;
    border-bottom: 1px solid #ded5cc;
  }

  .zh-gallery__viewer-counter {
    margin-right: auto;
    color: #625a53;
    font-size: .72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .05em;
  }

  .zh-gallery__viewer-zoom,
  .zh-gallery__viewer-close {
    display: inline-flex;
    min-height: 2.45rem;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    padding: .35rem .6rem;
    border: 0;
    background: transparent;
    color: #2a2520;
    font-size: .72rem;
    font-weight: 600;
    cursor: pointer;
  }

  .zh-gallery__viewer-zoom:hover,
  .zh-gallery__viewer-close:hover {
    background: rgb(42 37 32 / 6%);
  }

  .zh-gallery__viewer-close {
    width: 2.65rem;
    height: 2.65rem;
    padding: 0;
  }

  .zh-gallery__viewer-body {
    position: relative;
    display: grid;
    min-height: 0;
    flex: 1 1 auto;
    place-items: center;
    padding: .7rem 3rem 1rem;
  }

  .zh-gallery__viewer-media {
    display: grid;
    width: 100%;
    max-height: min(58dvh, 520px);
    min-height: 240px;
    overflow: auto;
    place-items: center;
    scrollbar-width: thin;
    scrollbar-color: #c8b7a8 transparent;
  }

  .zh-gallery__viewer-image {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(56dvh, 500px);
    object-fit: contain;
    transition: width 180ms ease, max-width 180ms ease, max-height 180ms ease;
  }

  .zh-gallery__viewer.is-zoomed .zh-gallery__viewer-image {
    width: 118%;
    max-width: none;
    max-height: none;
  }

  .zh-gallery__viewer-nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    width: 2.55rem;
    height: 2.55rem;
    transform: translateY(-50%);
  }

  .zh-gallery__viewer-nav--prev {
    left: .55rem;
  }

  .zh-gallery__viewer-nav--next {
    right: .55rem;
  }

  @media (max-width: 479px) {
    .zh-gallery__nav {
      width: 2.2rem;
      height: 2.2rem;
    }

    .zh-gallery__viewer-panel {
      width: calc(100vw - 1rem);
      max-height: calc(100dvh - 1rem);
    }

    .zh-gallery__viewer-header {
      padding-left: .75rem;
    }

    .zh-gallery__viewer-zoom span {
      display: none;
    }

    .zh-gallery__viewer-body {
      padding: .55rem 2.55rem .85rem;
    }

    .zh-gallery__viewer-media {
      max-height: 54dvh;
      min-height: 210px;
    }

    .zh-gallery__viewer-image {
      max-height: 52dvh;
    }
  }

  @media (min-width: 640px) {
    .zh-gallery {
      max-width: 290px;
      margin: 0;
    }

    .zh-gallery__compact {
      display: none;
    }

    .zh-gallery__wide {
      display: block;
    }
  }

  @media (min-width: 768px) {
    .zh-gallery {
      max-width: 350px;
    }
  }

  @media (min-width: 1100px) {
    .zh-gallery {
      max-width: 395px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-gallery__main-image,
    .zh-gallery__nav,
    .zh-gallery__utility-link,
    .zh-gallery__dot::before,
    .zh-gallery__thumb,
    .zh-gallery__viewer-image {
      transition: none;
    }
  }
{% endstyle %}

<div
  class="zh-gallery"
  data-gallery
  data-images='[
    {%- for image in imgs -%}
      {%- assign image_alt = image.alt | default: product.title -%}
      {
        "src": {{ image | image_url: width: 1800, format: 'webp' | json }},
        "alt": {{ image_alt | json }},
        "width": {{ image.width | default: 0 }},
        "height": {{ image.height | default: 0 }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]'
  tabindex="0"
  role="region"
  aria-label="Productgalerij. Gebruik links en rechts om door de afbeeldingen te bladeren."
>
  {%- if imgs.size == 0 -%}
    <div class="zh-gallery__empty">
      <p>Productfoto volgt binnenkort.</p>
    </div>
  {%- else -%}
    {%- assign first = imgs | first -%}
    {%- assign first_alt = first.alt | default: product.title -%}

    <div class="zh-gallery__compact">
      <div class="zh-gallery__frame">
        <div data-gallery-track class="zh-gallery__track">
          {%- for image in imgs -%}
            {%- assign mobile_alt = image.alt | default: product.title -%}
            {%- assign mobile_loading = 'lazy' -%}
            {%- assign mobile_priority = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign mobile_loading = 'eager' -%}
              {%- assign mobile_priority = 'high' -%}
            {%- endif -%}
            <div
              class="zh-gallery__slide"
              data-gallery-slide
              data-gallery-index="{{ forloop.index0 }}"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            >
              {{ image | image_url: width: 1000, format: 'webp' | image_tag: loading: mobile_loading, fetchpriority: mobile_priority, sizes: '(max-width: 639px) min(100vw - 32px, 320px), 320px', widths: '320, 370, 500, 700, 1000', alt: mobile_alt, class: 'zh-gallery__image' }}
            </div>
          {%- endfor -%}
        </div>

        {%- if imgs.size > 1 -%}
          <button type="button" data-gallery-prev class="zh-gallery__nav zh-gallery__nav--prev" aria-label="Vorige afbeelding" disabled>
            {% render 'icon', name: 'chevron-left', size: 19 %}
          </button>
          <button type="button" data-gallery-next class="zh-gallery__nav zh-gallery__nav--next" aria-label="Volgende afbeelding">
            {% render 'icon', name: 'chevron-right', size: 19 %}
          </button>
        {%- endif -%}

        {%- if is_sold -%}
          <span data-gallery-sold-label class="zh-gallery__sold-label">Uitverkocht</span>
        {%- endif -%}
      </div>

      <div class="zh-gallery__utility">
        <span data-gallery-counter class="zh-gallery__counter" aria-live="polite">1 / {{ imgs.size }}</span>
        <button type="button" data-gallery-viewer-open class="zh-gallery__utility-link" aria-label="Bekijk de actieve productfoto groter">
          {% render 'icon', name: 'zoom-in', size: 14 %}
          <span>Bekijk groter</span>
        </button>
      </div>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__dots" role="group" aria-label="Kies een productafbeelding">
          {%- for image in imgs -%}
            <button
              type="button"
              data-gallery-segment="{{ forloop.index0 }}"
              class="zh-gallery__dot"
              aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="-1"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="zh-gallery__wide">
      <div class="zh-gallery__main-frame">
        {{ first | image_url: width: 1400, format: 'webp' | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1100px) 410px, (min-width: 768px) 360px, 300px', widths: '300, 360, 410, 500, 700, 900, 1200, 1400', alt: first_alt, class: 'zh-gallery__main-image' }}

        {%- if imgs.size > 1 -%}
          <button type="button" data-gallery-prev class="zh-gallery__nav zh-gallery__nav--prev" aria-label="Vorige afbeelding" disabled>
            {% render 'icon', name: 'chevron-left', size: 19 %}
          </button>
          <button type="button" data-gallery-next class="zh-gallery__nav zh-gallery__nav--next" aria-label="Volgende afbeelding">
            {% render 'icon', name: 'chevron-right', size: 19 %}
          </button>
        {%- endif -%}

        {%- if is_sold -%}
          <span data-gallery-sold-label class="zh-gallery__sold-label">Uitverkocht</span>
        {%- endif -%}
      </div>

      <div class="zh-gallery__utility">
        <span data-gallery-counter class="zh-gallery__counter" aria-live="polite">1 / {{ imgs.size }}</span>
        <button type="button" data-gallery-viewer-open class="zh-gallery__utility-link" aria-label="Bekijk de actieve productfoto groter">
          {% render 'icon', name: 'zoom-in', size: 14 %}
          <span>Bekijk groter</span>
        </button>
      </div>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__thumbs" aria-label="Productafbeeldingen">
          {%- for image in imgs -%}
            {%- assign thumb_alt = image.alt | default: product.title -%}
            <button
              type="button"
              class="zh-gallery__thumb"
              data-gallery-thumb="{{ forloop.index0 }}"
              aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{ image | image_url: width: 160, format: 'webp' | image_tag: loading: 'lazy', sizes: '48px', widths: '48, 72, 96, 160', alt: thumb_alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div
      data-gallery-viewer
      class="zh-gallery__viewer"
      role="dialog"
      aria-modal="true"
      aria-label="Productfoto bekijken"
      hidden
    >
      <button type="button" tabindex="-1" data-gallery-viewer-backdrop class="zh-gallery__viewer-backdrop" aria-label="Fotovenster sluiten"></button>

      <div class="zh-gallery__viewer-panel" role="document">
        <div class="zh-gallery__viewer-header">
          <span data-gallery-viewer-counter class="zh-gallery__viewer-counter">1 / {{ imgs.size }}</span>
          <button type="button" data-gallery-viewer-zoom class="zh-gallery__viewer-zoom" aria-pressed="false">
            {% render 'icon', name: 'zoom-in', size: 16 %}
            <span data-gallery-viewer-zoom-label>Vergroot</span>
          </button>
          <button type="button" data-gallery-viewer-close class="zh-gallery__viewer-close" aria-label="Fotovenster sluiten">
            {% render 'icon', name: 'x', size: 20 %}
          </button>
        </div>

        <div class="zh-gallery__viewer-body">
          <div class="zh-gallery__viewer-media" data-gallery-viewer-media>
            <img
              data-gallery-viewer-image
              class="zh-gallery__viewer-image"
              src="{{ first | image_url: width: 1800, format: 'webp' }}"
              alt="{{ first_alt | escape }}"
              width="{{ first.width }}"
              height="{{ first.height }}"
              loading="eager"
            >
          </div>

          {%- if imgs.size > 1 -%}
            <button type="button" data-gallery-viewer-prev class="zh-gallery__viewer-nav zh-gallery__viewer-nav--prev" aria-label="Vorige afbeelding" disabled>
              {% render 'icon', name: 'chevron-left', size: 21 %}
            </button>
            <button type="button" data-gallery-viewer-next class="zh-gallery__viewer-nav zh-gallery__viewer-nav--next" aria-label="Volgende afbeelding">
              {% render 'icon', name: 'chevron-right', size: 21 %}
            </button>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</div>
