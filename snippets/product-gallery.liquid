{%- comment -%}
  Productgalerij voor de individuele productpagina.
  Gedrag wordt aangestuurd door assets/product.js via data-* hooks.
  Vereist: product, is_sold.
{%- endcomment -%}

{% style %}
  .zh-gallery {
    position: relative;
  }

  .zh-gallery__frame {
    position: relative;
    overflow: hidden;
    background: var(--color-cream, #f2ede6);
  }

  .zh-gallery__mobile {
    display: block;
  }

  .zh-gallery__desktop {
    display: none;
  }

  .zh-gallery__track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .zh-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .zh-gallery__slide {
    position: relative;
    display: grid;
    flex: 0 0 100%;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: clamp(.75rem, 3vw, 1.25rem);
    border: 0;
    background: transparent;
    scroll-snap-align: center;
    cursor: zoom-in;
  }

  .zh-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-gallery__slide:focus-visible,
  .zh-gallery__main-button:focus-visible,
  .zh-gallery__thumb:focus-visible,
  .zh-gallery__lightbox button:focus-visible {
    outline: 2px solid var(--color-clay, #955c39);
    outline-offset: -3px;
  }

  .zh-gallery__meta {
    display: flex;
    align-items: center;
    gap: .75rem;
    margin-top: .75rem;
  }

  .zh-gallery__counter {
    flex: 0 0 auto;
    min-width: 2.5rem;
    color: rgb(42 37 32 / 68%);
    font-size: .7rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .1em;
    line-height: 1.3;
  }

  .zh-gallery__progress {
    position: relative;
    height: 1px;
    flex: 1 1 auto;
    overflow: hidden;
    background: rgb(42 37 32 / 14%);
  }

  .zh-gallery__progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--color-ink, #2a2520);
    transform-origin: left center;
    transition: width 180ms ease;
  }

  .zh-gallery__zoom-hint {
    position: absolute;
    right: .75rem;
    bottom: .75rem;
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    background: rgb(255 253 251 / 90%);
    color: var(--color-ink, #2a2520);
    pointer-events: none;
  }

  .zh-gallery__sold-label {
    position: absolute;
    z-index: 2;
    top: .75rem;
    left: .75rem;
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: .25rem .65rem;
    background: rgb(255 253 251 / 94%);
    color: var(--color-sold, #9b4c43);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .08em;
    line-height: 1.2;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  .zh-gallery__main-button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .zh-gallery__main-frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    padding: clamp(1rem, 2vw, 1.75rem);
    background: var(--color-cream, #f2ede6);
  }

  .zh-gallery__main-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 420ms ease;
  }

  .zh-gallery__main-button:hover .zh-gallery__main-image {
    transform: scale(1.012);
  }

  .zh-gallery__desktop-zoom {
    position: absolute;
    right: .85rem;
    bottom: .85rem;
    display: grid;
    width: 2.35rem;
    height: 2.35rem;
    place-items: center;
    background: rgb(255 253 251 / 92%);
    color: var(--color-ink, #2a2520);
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .zh-gallery__main-button:hover .zh-gallery__desktop-zoom,
  .zh-gallery__main-button:focus-visible .zh-gallery__desktop-zoom {
    opacity: 1;
  }

  .zh-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: .65rem;
    margin-top: .75rem;
  }

  .zh-gallery__thumb {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    overflow: hidden;
    padding: .25rem;
    border: 1px solid transparent;
    background: var(--color-cream, #f2ede6);
    cursor: pointer;
    opacity: .7;
    transition: border-color 160ms ease, opacity 160ms ease;
  }

  .zh-gallery__thumb:hover {
    opacity: 1;
  }

  .zh-gallery__thumb[aria-current='true'] {
    border-color: var(--color-clay, #955c39);
    opacity: 1;
  }

  .zh-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .zh-gallery__empty {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 2rem;
    background: var(--color-cream, #f2ede6);
    color: rgb(42 37 32 / 68%);
    text-align: center;
  }

  .zh-gallery__empty-title {
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-size: 1.45rem;
    line-height: 1.35;
  }

  .zh-gallery__empty-text {
    max-width: 28rem;
    margin: .65rem auto 0;
    font-size: .88rem;
    line-height: 1.65;
  }

  .zh-gallery__lightbox[hidden] {
    display: none;
  }

  .zh-gallery__lightbox {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: rgb(28 25 22 / 97%);
    color: #fffdfb;
    backdrop-filter: blur(8px);
  }

  .zh-gallery__lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.5rem;
    padding: .45rem .8rem;
  }

  .zh-gallery__lightbox-counter {
    font-size: .72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .12em;
  }

  .zh-gallery__icon-button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .zh-gallery__lightbox-stage {
    position: relative;
    min-height: 0;
    flex: 1 1 auto;
  }

  .zh-gallery__lightbox-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .zh-gallery__lightbox-track::-webkit-scrollbar {
    display: none;
  }

  .zh-gallery__lightbox-slide {
    display: grid;
    min-width: 100%;
    height: 100%;
    place-items: center;
    padding: .5rem 3.4rem 1rem;
    scroll-snap-align: center;
  }

  .zh-gallery__zoom-wrapper {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    overflow: hidden;
    touch-action: none;
    cursor: zoom-in;
  }

  .zh-gallery__zoom-target {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    transform-origin: center center;
    will-change: transform;
  }

  .zh-gallery__lightbox-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-gallery__lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid rgb(255 253 251 / 25%);
    background: rgb(255 253 251 / 8%);
  }

  .zh-gallery__lightbox-nav:disabled {
    cursor: default;
    opacity: .2;
  }

  .zh-gallery__lightbox-prev {
    left: .55rem;
  }

  .zh-gallery__lightbox-next {
    right: .55rem;
  }

  @media (min-width: 880px) {
    .zh-gallery__mobile {
      display: none;
    }

    .zh-gallery__desktop {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-gallery *,
    .zh-gallery__lightbox * {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
{% endstyle %}

{%- liquid
  assign imgs = product.images
-%}

<div
  data-gallery
  class="zh-gallery"
  data-images='[
    {%- for image in imgs -%}
      {%- assign alt = image.alt | default: product.title -%}
      {
        "src": {{ image | image_url: width: 1800, format: 'webp' | json }},
        "alt": {{ alt | json }},
        "w": {{ image.width | default: 0 | json }},
        "h": {{ image.height | default: 0 | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]'
>
  {%- if imgs.size == 0 -%}
    <div class="zh-gallery__empty">
      <div>
        <p class="zh-gallery__empty-title font-display">Productfoto volgt binnenkort.</p>
        <p class="zh-gallery__empty-text">Bekijk ondertussen de productinformatie en specificaties op deze pagina.</p>
      </div>
      <span class="zh-gallery__sold-label" data-gallery-sold-label{% unless is_sold %} hidden{% endunless %}>Uitverkocht</span>
    </div>
  {%- else -%}
    {%- assign first = imgs | first -%}
    {%- assign first_alt = first.alt | default: product.title -%}

    <div class="zh-gallery__mobile">
      <div class="zh-gallery__frame">
        <span class="zh-gallery__sold-label" data-gallery-sold-label{% unless is_sold %} hidden{% endunless %}>Uitverkocht</span>
        <div data-gallery-track class="zh-gallery__track">
          {%- for image in imgs -%}
            {%- assign img_alt = image.alt | default: product.title -%}
            {%- assign mob_loading = 'lazy' -%}
            {%- assign mob_fetch = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign mob_loading = 'eager' -%}
              {%- assign mob_fetch = 'high' -%}
            {%- endif -%}
            <button
              type="button"
              data-gallery-open="{{ forloop.index0 }}"
              data-gallery-slide
              aria-label="Vergroot afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              class="zh-gallery__slide"
            >
              {{ image | image_url: width: 1200, format: 'webp' | image_tag: loading: mob_loading, fetchpriority: mob_fetch, sizes: '100vw', widths: '400, 600, 800, 1000, 1200', alt: img_alt, class: 'zh-gallery__image' }}
            </button>
          {%- endfor -%}
        </div>
        <span class="zh-gallery__zoom-hint" aria-hidden="true">{% render 'icon', name: 'zoom-in', size: 15 %}</span>
      </div>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__meta" aria-hidden="true">
          <span data-gallery-counter class="zh-gallery__counter">1 / {{ imgs.size }}</span>
          <span class="zh-gallery__progress"><span data-gallery-progress class="zh-gallery__progress-fill" style="width: {{ 1.0 | divided_by: imgs.size | times: 100 }}%;"></span></span>
        </div>
      {%- endif -%}
    </div>

    <div class="zh-gallery__desktop">
      <button type="button" data-gallery-main-btn aria-label="Vergroot productafbeelding" class="zh-gallery__main-button">
        <span class="zh-gallery__main-frame">
          <span class="zh-gallery__sold-label" data-gallery-sold-label{% unless is_sold %} hidden{% endunless %}>Uitverkocht</span>
          {{ first | image_url: width: 1400, format: 'webp' | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1180px) 52vw, (min-width: 880px) 44vw, 100vw', widths: '600, 900, 1200, 1400', alt: first_alt, class: 'zh-gallery__main-image' }}
          <span class="zh-gallery__desktop-zoom" aria-hidden="true">{% render 'icon', name: 'zoom-in', size: 16 %}</span>
        </span>
      </button>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__thumbs" aria-label="Productafbeeldingen">
          {%- for image in imgs -%}
            {%- assign thumb_alt = image.alt | default: product.title -%}
            <button
              type="button"
              data-gallery-thumb="{{ forloop.index0 }}"
              aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              class="zh-gallery__thumb"
            >
              {{ image | image_url: width: 260, format: 'webp' | image_tag: loading: 'lazy', sizes: '120px', alt: thumb_alt, class: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div data-gallery-lightbox class="zh-gallery__lightbox" role="dialog" aria-modal="true" aria-label="Productfoto's" hidden>
      <div class="zh-gallery__lightbox-bar">
        <span data-lightbox-counter class="zh-gallery__lightbox-counter">1 / {{ imgs.size }}</span>
        <button type="button" data-lightbox-close aria-label="Sluit productfoto's" class="zh-gallery__icon-button">{% render 'icon', name: 'x', size: 21 %}</button>
      </div>

      <div class="zh-gallery__lightbox-stage">
        <div data-lightbox-track class="zh-gallery__lightbox-track">
          {%- for image in imgs -%}
            {%- assign lb_alt = image.alt | default: product.title -%}
            <div class="zh-gallery__lightbox-slide" data-lightbox-slide data-zoom-meta='{"w": {{ image.width | default: 0 }}, "h": {{ image.height | default: 0 }}}'>
              <div data-zoom-wrapper class="zh-gallery__zoom-wrapper">
                <div data-zoom-target class="zh-gallery__zoom-target">
                  {{ image | image_url: width: 2000, format: 'webp' | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: lb_alt, class: 'zh-gallery__lightbox-image' }}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if imgs.size > 1 -%}
          <button type="button" data-lightbox-prev aria-label="Vorige afbeelding" class="zh-gallery__icon-button zh-gallery__lightbox-nav zh-gallery__lightbox-prev">{% render 'icon', name: 'chevron-left', size: 22 %}</button>
          <button type="button" data-lightbox-next aria-label="Volgende afbeelding" class="zh-gallery__icon-button zh-gallery__lightbox-nav zh-gallery__lightbox-next">{% render 'icon', name: 'chevron-right', size: 22 %}</button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
