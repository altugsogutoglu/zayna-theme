{%- comment -%}
  Zayna Home productgalerij.
  Gedrag wordt aangestuurd door assets/product.js via data-* hooks.
  Vereist: product, is_sold.
{%- endcomment -%}

{%- assign imgs = product.images -%}

{% style %}
  .zh-gallery {
    width: 100%;
    max-width: 430px;
    margin: 0 auto;
  }

  .zh-gallery__mobile {
    display: block;
  }

  .zh-gallery__desktop {
    display: none;
  }

  .zh-gallery__frame,
  .zh-gallery__main-frame {
    position: relative;
    overflow: hidden;
    background: transparent;
  }

  .zh-gallery__track {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .zh-gallery__track::-webkit-scrollbar,
  .zh-gallery__lightbox-track::-webkit-scrollbar {
    display: none;
  }

  .zh-gallery__slide,
  .zh-gallery__main-button {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }

  .zh-gallery__slide {
    flex: 0 0 100%;
    aspect-ratio: 1;
    overflow: hidden;
    scroll-snap-align: center;
  }

  .zh-gallery__image,
  .zh-gallery__main-image,
  .zh-gallery__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-gallery__main-frame {
    aspect-ratio: 1;
  }

  .zh-gallery__main-image {
    transition: transform 420ms ease;
  }

  .zh-gallery__main-button:hover .zh-gallery__main-image {
    transform: scale(1.012);
  }

  .zh-gallery__slide:focus-visible,
  .zh-gallery__main-button:focus-visible,
  .zh-gallery__thumb:focus-visible,
  .zh-gallery__lightbox button:focus-visible {
    outline: 2px solid var(--color-clay, #a66a3f);
    outline-offset: 3px;
  }

  .zh-gallery__meta {
    display: flex;
    align-items: center;
    gap: .8rem;
    min-height: 2rem;
    margin-top: .65rem;
  }

  .zh-gallery__counter {
    flex: 0 0 auto;
    min-width: 2.7rem;
    color: rgb(42 37 32 / 66%);
    font-size: .72rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .08em;
    line-height: 1.3;
  }

  .zh-gallery__progress {
    position: relative;
    height: 1px;
    flex: 1 1 auto;
    overflow: hidden;
    background: rgb(42 37 32 / 15%);
  }

  .zh-gallery__progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--color-ink, #2a2520);
    transition: width 180ms ease;
  }

  .zh-gallery__zoom-hint {
    position: absolute;
    right: .75rem;
    bottom: .75rem;
    display: grid;
    width: 2.15rem;
    height: 2.15rem;
    place-items: center;
    background: rgb(255 253 251 / 90%);
    color: var(--color-ink, #2a2520);
    pointer-events: none;
    backdrop-filter: blur(6px);
  }

  .zh-gallery__sold-label {
    position: absolute;
    z-index: 2;
    top: .7rem;
    left: .7rem;
    display: inline-flex;
    min-height: 1.75rem;
    align-items: center;
    padding: .25rem .65rem;
    background: rgb(255 253 251 / 94%);
    color: var(--color-sold, #9b4c43);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-transform: uppercase;
    backdrop-filter: blur(7px);
  }

  .zh-gallery__thumbs {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
    margin-top: .8rem;
  }

  .zh-gallery__thumb {
    position: relative;
    width: 64px;
    height: 64px;
    flex: 0 0 64px;
    overflow: hidden;
    padding: 0;
    border: 1px solid transparent;
    background: transparent;
    opacity: .72;
    cursor: pointer;
    transition: border-color 160ms ease, opacity 160ms ease;
  }

  .zh-gallery__thumb:hover,
  .zh-gallery__thumb[aria-current='true'] {
    opacity: 1;
  }

  .zh-gallery__thumb[aria-current='true'] {
    border-color: var(--color-clay, #a66a3f);
  }

  .zh-gallery__empty {
    display: grid;
    aspect-ratio: 1;
    place-items: center;
    padding: 2rem;
    border: 1px solid rgb(42 37 32 / 10%);
    text-align: center;
  }

  .zh-gallery__empty p {
    margin: 0;
    color: rgb(42 37 32 / 65%);
    font-size: .95rem;
  }

  .zh-gallery__lightbox {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: rgb(42 37 32 / 97%);
    color: #fffdfb;
  }

  .zh-gallery__lightbox[hidden] {
    display: none !important;
  }

  .zh-gallery__lightbox-header {
    display: flex;
    min-height: 3.75rem;
    align-items: center;
    justify-content: space-between;
    padding: .5rem 1rem;
  }

  .zh-gallery__lightbox-counter {
    font-size: .75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: .1em;
  }

  .zh-gallery__lightbox-close,
  .zh-gallery__lightbox-nav {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: #fffdfb;
    cursor: pointer;
  }

  .zh-gallery__lightbox-close:hover,
  .zh-gallery__lightbox-nav:hover:not(:disabled) {
    background: rgb(255 255 255 / 9%);
  }

  .zh-gallery__lightbox-nav:disabled {
    opacity: .25;
    cursor: default;
  }

  .zh-gallery__lightbox-body {
    position: relative;
    min-height: 0;
    flex: 1 1 auto;
  }

  .zh-gallery__lightbox-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .zh-gallery__lightbox-slide {
    display: grid;
    height: 100%;
    flex: 0 0 100%;
    place-items: center;
    padding: 1rem;
    scroll-snap-align: center;
  }

  .zh-gallery__lightbox-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .zh-gallery__lightbox-nav {
    position: absolute;
    z-index: 2;
    top: 50%;
    display: none;
    background: rgb(255 255 255 / 7%);
    transform: translateY(-50%);
  }

  .zh-gallery__lightbox-nav--prev {
    left: 1rem;
  }

  .zh-gallery__lightbox-nav--next {
    right: 1rem;
  }

  @media (min-width: 768px) {
    .zh-gallery {
      max-width: 500px;
      margin: 0;
    }

    .zh-gallery__mobile {
      display: none;
    }

    .zh-gallery__desktop {
      display: block;
    }

    .zh-gallery__lightbox-slide {
      padding: 2rem 5rem;
    }

    .zh-gallery__lightbox-nav {
      display: grid;
    }
  }

  @media (min-width: 1180px) {
    .zh-gallery {
      max-width: 520px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-gallery__main-image,
    .zh-gallery__progress-fill,
    .zh-gallery__thumb {
      transition: none;
    }
  }
{% endstyle %}

<div
  class="zh-gallery"
  data-gallery
  data-images='[
    {%- for image in imgs -%}
      {%- assign image_alt = image.alt | default: product.title -%}
      {
        "src": {{ image | image_url: width: 1800, format: 'webp' | json }},
        "alt": {{ image_alt | json }},
        "width": {{ image.width | default: 0 }},
        "height": {{ image.height | default: 0 }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]'
>
  {%- if imgs.size == 0 -%}
    <div class="zh-gallery__empty">
      <p>Productfoto volgt binnenkort.</p>
    </div>
  {%- else -%}
    {%- assign first = imgs | first -%}
    {%- assign first_alt = first.alt | default: product.title -%}

    <div class="zh-gallery__mobile">
      <div class="zh-gallery__frame">
        <div data-gallery-track class="zh-gallery__track">
          {%- for image in imgs -%}
            {%- assign mobile_alt = image.alt | default: product.title -%}
            {%- assign mobile_loading = 'lazy' -%}
            {%- assign mobile_priority = 'auto' -%}
            {%- if forloop.first -%}
              {%- assign mobile_loading = 'eager' -%}
              {%- assign mobile_priority = 'high' -%}
            {%- endif -%}
            <button
              type="button"
              class="zh-gallery__slide"
              data-gallery-slide
              data-gallery-open="{{ forloop.index0 }}"
              data-gallery-index="{{ forloop.index0 }}"
              aria-label="Vergroot afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{ image | image_url: width: 1000, format: 'webp' | image_tag: loading: mobile_loading, fetchpriority: mobile_priority, sizes: '(max-width: 767px) min(100vw - 32px, 430px), 430px', widths: '360, 430, 600, 800, 1000', alt: mobile_alt, class: 'zh-gallery__image' }}
            </button>
          {%- endfor -%}
        </div>

        {%- if is_sold -%}
          <span data-gallery-sold-label class="zh-gallery__sold-label">Uitverkocht</span>
        {%- endif -%}

        <span aria-hidden="true" class="zh-gallery__zoom-hint">
          {% render 'icon', name: 'zoom-in', size: 15 %}
        </span>
      </div>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__meta">
          <span data-gallery-counter class="zh-gallery__counter" aria-live="polite">1 / {{ imgs.size }}</span>
          <span
            class="zh-gallery__progress"
            role="progressbar"
            aria-label="Positie in productgalerij"
            aria-valuemin="1"
            aria-valuemax="{{ imgs.size }}"
            aria-valuenow="1"
            data-gallery-progressbar
          >
            <span data-gallery-progress class="zh-gallery__progress-fill" style="width: {{ 1.0 | divided_by: imgs.size | times: 100 }}%;"></span>
          </span>
        </div>
      {%- endif -%}
    </div>

    <div class="zh-gallery__desktop">
      <button
        type="button"
        class="zh-gallery__main-button"
        data-gallery-main-btn
        data-gallery-open="0"
        aria-label="Vergroot afbeelding 1 van {{ imgs.size }}"
      >
        <span class="zh-gallery__main-frame">
          {{ first | image_url: width: 1400, format: 'webp' | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1180px) 520px, 500px', widths: '500, 700, 900, 1200, 1400', alt: first_alt, class: 'zh-gallery__main-image' }}
          {%- if is_sold -%}
            <span data-gallery-sold-label class="zh-gallery__sold-label">Uitverkocht</span>
          {%- endif -%}
          <span aria-hidden="true" class="zh-gallery__zoom-hint">
            {% render 'icon', name: 'zoom-in', size: 16 %}
          </span>
        </span>
      </button>

      {%- if imgs.size > 1 -%}
        <div class="zh-gallery__meta">
          <span data-gallery-counter class="zh-gallery__counter" aria-live="polite">1 / {{ imgs.size }}</span>
          <span
            class="zh-gallery__progress"
            role="progressbar"
            aria-label="Positie in productgalerij"
            aria-valuemin="1"
            aria-valuemax="{{ imgs.size }}"
            aria-valuenow="1"
            data-gallery-progressbar
          >
            <span data-gallery-progress class="zh-gallery__progress-fill" style="width: {{ 1.0 | divided_by: imgs.size | times: 100 }}%;"></span>
          </span>
        </div>

        <div class="zh-gallery__thumbs" aria-label="Productafbeeldingen">
          {%- for image in imgs -%}
            {%- assign thumb_alt = image.alt | default: product.title -%}
            <button
              type="button"
              class="zh-gallery__thumb"
              data-gallery-thumb="{{ forloop.index0 }}"
              aria-label="Toon afbeelding {{ forloop.index }} van {{ imgs.size }}"
              aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            >
              {{ image | image_url: width: 180, format: 'webp' | image_tag: loading: 'lazy', sizes: '64px', widths: '64, 96, 128, 180', alt: thumb_alt }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div
      data-gallery-lightbox
      class="zh-gallery__lightbox"
      role="dialog"
      aria-modal="true"
      aria-label="Productfoto's"
      hidden
    >
      <div class="zh-gallery__lightbox-header">
        <span data-lightbox-counter class="zh-gallery__lightbox-counter">1 / {{ imgs.size }}</span>
        <button type="button" data-lightbox-close class="zh-gallery__lightbox-close" aria-label="Galerij sluiten">
          {% render 'icon', name: 'x', size: 21 %}
        </button>
      </div>

      <div class="zh-gallery__lightbox-body">
        <div data-lightbox-track class="zh-gallery__lightbox-track">
          {%- for image in imgs -%}
            {%- assign lightbox_alt = image.alt | default: product.title -%}
            <div data-lightbox-slide class="zh-gallery__lightbox-slide">
              {{ image | image_url: width: 2000, format: 'webp' | image_tag: loading: 'lazy', sizes: '100vw', widths: '800, 1200, 1600, 2000', alt: lightbox_alt }}
            </div>
          {%- endfor -%}
        </div>

        {%- if imgs.size > 1 -%}
          <button type="button" data-lightbox-prev class="zh-gallery__lightbox-nav zh-gallery__lightbox-nav--prev" aria-label="Vorige afbeelding">
            {% render 'icon', name: 'chevron-left', size: 22 %}
          </button>
          <button type="button" data-lightbox-next class="zh-gallery__lightbox-nav zh-gallery__lightbox-nav--next" aria-label="Volgende afbeelding">
            {% render 'icon', name: 'chevron-right', size: 22 %}
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>
