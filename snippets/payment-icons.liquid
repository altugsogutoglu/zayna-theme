{%- liquid
  assign icon_height = 22
  if compact
    assign icon_height = 19
  endif

  assign payment_types = shop.enabled_payment_types
-%}

{%- if payment_types != blank -%}
  <ul
    class="zayna-payment-icons{% if compact %} is-compact{% endif %}"
    aria-label="Geaccepteerde betaalmethoden"
    style="--zayna-payment-icon-height: {{ icon_height }}px;"
  >
    {%- for type in payment_types limit: 6 -%}
      <li class="zayna-payment-icons__item">
        {{ type | payment_type_svg_tag: class: 'zayna-payment-icons__svg' }}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% style %}
  .zayna-payment-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zayna-payment-icons__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .zayna-payment-icons__svg {
    display: block;
    width: auto;
    height: var(--zayna-payment-icon-height);
    max-width: 44px;
  }

  .zayna-payment-icons.is-compact {
    gap: 5px;
    opacity: .82;
  }

  .zayna-payment-icons.is-compact .zayna-payment-icons__svg {
    max-width: 39px;
  }
{% endstyle %}