{%- liquid
  assign h = icon_height | default: 24
  assign payment_types = 'ideal,bancontact,apple_pay,google_pay,visa,master' | split: ','
-%}

<ul
  class="zayna-payment-icons"
  aria-label="Geaccepteerde betaalmethoden"
  style="--zayna-payment-icon-height: {{ h }}px;"
>
  {%- for type in payment_types -%}
    <li class="zayna-payment-icons__item">
      {{ type | payment_type_svg_tag: class: 'zayna-payment-icons__svg' }}
    </li>
  {%- endfor -%}
</ul>

{% style %}
  .zayna-payment-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zayna-payment-icons__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
  }

  .zayna-payment-icons__svg {
    display: block;
    width: auto;
    height: var(--zayna-payment-icon-height);
    max-width: 48px;
  }

  @media (max-width: 389px) {
    .zayna-payment-icons {
      gap: 5px;
    }

    .zayna-payment-icons__svg {
      max-width: 46px;
    }
  }
{% endstyle %}