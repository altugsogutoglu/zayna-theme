{%- liquid
  assign label_text = label | default: default_label
  if size == 'lg'
    assign img_sizes = '(min-width: 1024px) 28vw, 70vw'
    assign img_widths = '400, 600, 900'
    assign img_width = 900
  else
    assign img_sizes = '(min-width: 1024px) 18vw, 42vw'
    assign img_widths = '300, 500, 700'
    assign img_width = 700
  endif
  if eager
    assign img_loading = 'eager'
  else
    assign img_loading = 'lazy'
  endif
-%}

<div class="flex flex-col overflow-hidden border border-border-soft bg-surface/60 shadow-[0_20px_50px_color-mix(in_srgb,var(--color-ink)_9%,transparent)] {{ position }}">
  {%- if image != blank -%}
    {{ image | image_url: width: img_width | image_tag:
      loading: img_loading,
      sizes: img_sizes,
      widths: img_widths,
      alt: image.alt | default: label_text,
      class: 'block min-h-0 flex-1 object-contain p-[22px] max-sm:p-[14px]' }}
  {%- else -%}
    <div class="grid min-h-0 flex-1 place-items-center p-[22px] text-center font-display text-[clamp(1.5rem,3vw,2.625rem)] leading-none text-ink-soft">
      <span>{{ label_text }}</span>
    </div>
  {%- endif -%}
  <p class="m-0 flex h-[42px] items-center border-t border-border-soft/80 px-4 text-[10px] uppercase tracking-[0.18em] text-stone max-sm:h-9 max-sm:px-[10px] max-sm:text-[8px] max-sm:tracking-[0.14em]">{{ label_text }}</p>
</div>
