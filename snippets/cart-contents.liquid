{% doc %}
  Cart body used by both the drawer and the /cart page. Renders line items + upsell
  placeholder + summary footer when the cart has items, otherwise the empty state
  with optional "Populaire keuzes" suggestions. Behavior wired by assets/cart.js.
  @param {string} layout - 'drawer' or 'page'.
  @example
  {% render 'cart-contents', layout: 'drawer' %}
{% enddoc %}
{%- liquid
  assign is_page = false
  if layout == 'page'
    assign is_page = true
  endif

  assign threshold = settings.free_shipping_threshold | default: 0
  assign threshold_cents = threshold | times: 100
  assign subtotal_cents = cart.items_subtotal_price
  assign remaining_cents = threshold_cents | minus: subtotal_cents
  if remaining_cents < 0
    assign remaining_cents = 0
  endif
  assign reached = false
  if threshold_cents > 0 and remaining_cents == 0
    assign reached = true
  endif
  assign pct = 0
  if threshold_cents > 0
    assign pct = subtotal_cents | times: 100 | divided_by: threshold_cents
    if pct > 100
      assign pct = 100
    endif
  endif

  assign first_item = cart.items | first
  assign upsell_pid = first_item.product.id
  capture upsell_url
    echo routes.product_recommendations_url
    echo '?section_id=cart-upsell&intent=complementary&limit=3&product_id='
    echo upsell_pid
  endcapture

  assign applied_discounts = cart.cart_level_discount_applications

  assign suggestion_collection = settings.cart_empty_collection
  assign has_suggestions = false
  if suggestion_collection != blank and suggestion_collection.products_count > 0
    for suggestion_product in suggestion_collection.products
      if suggestion_product.available
        assign has_suggestions = true
        break
      endif
    endfor
  endif
-%}

{% style %}
  .zh-cart-line {
    display: flex;
    gap: 14px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(42, 37, 32, 0.075);
  }

  .zh-cart-line:last-child {
    border-bottom: 0;
  }

  .zh-cart-line__media {
    display: block;
    width: 74px;
    height: 88px;
    flex: 0 0 auto;
    overflow: hidden;
    background: #f0ebe6;
  }

  .zh-cart-line__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .zh-cart-line__main {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 4px;
  }

  .zh-cart-line__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
  }

  .zh-cart-line__title-link {
    display: block;
    max-width: 100%;
    color: #2a2520;
    font-family: var(--font-display, Georgia, serif);
    font-size: 14.5px;
    line-height: 1.26;
    letter-spacing: -0.01em;
  }

  .zh-cart-line__title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow-wrap: anywhere;
  }

  .zh-cart-line__meta {
    margin-top: 4px;
    color: rgba(86, 78, 71, 0.68);
    font-size: 10.5px;
    line-height: 1.35;
  }

  .zh-cart-line__options {
    display: flex;
    flex-wrap: wrap;
    column-gap: 10px;
    row-gap: 2px;
    margin-top: 2px;
  }

  .zh-cart-line__option {
    color: rgba(86, 78, 71, 0.70);
    font-size: 11px;
    line-height: 1.35;
  }

  .zh-cart-line__remove {
    display: inline-flex;
    width: 38px;
    height: 38px;
    margin: -8px -8px 0 0;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    color: rgba(120, 113, 108, 0.72);
    transition: color 160ms ease, background-color 160ms ease;
  }

  .zh-cart-line__remove:hover {
    background: rgba(240, 235, 230, 0.50);
    color: rgba(42, 37, 32, 0.88);
  }

  .zh-cart-line__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 9px;
  }

  .zh-cart-qty {
    position: relative;
    display: inline-flex;
    height: 36px;
    align-items: center;
    border: 1px solid rgba(42, 37, 32, 0.105);
    background: rgba(255, 253, 251, 0.54);
    user-select: none;
  }

  .zh-cart-qty__button {
    display: grid;
    width: 36px;
    height: 100%;
    place-items: center;
    color: rgba(86, 78, 71, 0.74);
    transition: color 160ms ease, background-color 160ms ease;
  }

  .zh-cart-qty__button:hover {
    background: rgba(240, 235, 230, 0.42);
    color: #2a2520;
  }

  .zh-cart-qty__button:disabled {
    cursor: not-allowed;
    opacity: 0.32;
  }

  .zh-cart-qty__value {
    min-width: 2.2ch;
    color: rgba(42, 37, 32, 0.86);
    font-size: 13px;
    line-height: 1;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .zh-cart-line__price {
    flex: 0 0 auto;
    color: rgba(42, 37, 32, 0.82);
    font-size: 15px;
    line-height: 1.2;
    font-variant-numeric: tabular-nums;
  }

  .zh-cart-clear {
    display: flex;
    justify-content: flex-end;
    margin: -1px 0 2px;
    padding: 9px 0 13px;
    border-bottom: 1px solid rgba(42, 37, 32, 0.055);
  }

  .zh-cart-clear__button {
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: rgba(86, 78, 71, 0.58);
    font-size: 11px;
    line-height: 1;
    text-decoration: underline;
    text-decoration-color: rgba(120, 113, 108, 0.24);
    text-underline-offset: 4px;
    transition: color 160ms ease, text-decoration-color 160ms ease;
  }

  .zh-cart-clear__button:hover {
    color: rgba(42, 37, 32, 0.78);
    text-decoration-color: rgba(181, 101, 29, 0.32);
  }

  .zh-cart-clear__button[disabled] {
    cursor: wait;
    opacity: 0.58;
  }

  .zh-cart-clear__button:focus-visible,
  .zh-cart-line__remove:focus-visible,
  .zh-cart-qty__button:focus-visible,
  .zh-cart-checkout:focus-visible {
    outline: 2px solid rgba(181, 101, 29, 0.42);
    outline-offset: 3px;
  }

  .zh-cart-checkout {
    display: flex;
    width: 100%;
    height: 52px;
    align-items: center;
    justify-content: center;
    background: #2a2520;
    color: #fffdfb;
    font-size: 12px;
    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: background-color 180ms ease, color 180ms ease;
  }

  .zh-cart-checkout:hover {
    background: #6f4a33;
  }

  .zh-cart-checkout:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  @media (max-width: 520px) {
    .zh-cart-line {
      gap: 13px;
      padding: 15px 0;
    }

    .zh-cart-line__media {
      width: 70px;
      height: 84px;
    }

    .zh-cart-line__title-link {
      font-size: 14px;
    }

    .zh-cart-line__price {
      font-size: 14.5px;
    }
  }
{% endstyle %}

<span data-cart-total-count data-count="{{ cart.item_count }}" hidden></span>
<section
  class="flex {% unless is_page %}h-full{% endunless %} flex-col bg-surface"
  aria-label="{% if is_page %}Winkelmand pagina{% else %}Winkelmand lade{% endif %}"
  data-cart-money-root
  data-cart-subtotal-cents="{{ subtotal_cents }}"
  data-free-shipping-threshold-cents="{{ threshold_cents }}"
  data-money-locale="{{ request.locale.iso_code | default: 'nl-NL' }}"
  data-money-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  {%- if cart.item_count > 0 -%}
    <div
      class="flex flex-1 flex-col {% unless is_page %}overflow-hidden{% endunless %}"
      data-cart-filled-state
    >
      <p class="sr-only">Producten in winkelmand</p>
      <div
        class="{% unless is_page %}flex-1 overflow-y-auto overscroll-contain{% endunless %} px-5 md:px-6 py-2 md:py-4"
        data-cart-scroll-region
        style="overflow-anchor: none;"
      >
        <ul data-cart-lines>
          {%- for item in cart.items -%}
            {% render 'cart-line-item', line_item: item, layout: layout %}
          {%- endfor -%}
        </ul>

        {%- if cart.item_count > 1 -%}
          <div class="zh-cart-clear" data-cart-clear>
            <button
              type="button"
              class="zh-cart-clear__button"
              data-cart-clear-confirm
            >
              Winkelmand leegmaken
            </button>
          </div>
        {%- endif -%}

        {%- if has_suggestions -%}
          <section
            aria-label="Populaire keuzes"
            class="mt-5 border-t border-border-soft pt-5 pb-6"
            data-cart-persistent-suggestions
          >
            <div class="mb-4 flex items-center justify-between gap-4">
              <p class="text-label text-ink-soft">Populaire keuzes</p>
              <a
                href="{{ suggestion_collection.url }}"
                class="group inline-flex min-h-8 items-center gap-2 text-[10px] uppercase tracking-[0.16em] text-stone-soft transition-colors hover:text-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2"
                aria-label="Bekijk meer producten uit {{ suggestion_collection.title | escape }}"
              >
                <span>Verder ontdekken</span>
                <span
                  aria-hidden="true"
                  class="transition-transform duration-200 group-hover:translate-x-0.5"
                >
                  →
                </span>
              </a>
            </div>

            <div class="grid grid-cols-2 gap-x-4 gap-y-8{% if is_page %} lg:grid-cols-4{% endif %}">
              {%- assign shown_suggestions = 0 -%}
              {%- for product in suggestion_collection.products -%}
                {%- unless product.available -%}
                  {%- continue -%}
                {%- endunless -%}

                {% render 'product-card', product: product, loading: 'lazy' %}

                {%- assign shown_suggestions = shown_suggestions | plus: 1 -%}
                {%- if shown_suggestions >= 4 -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- elsif upsell_pid != blank -%}
          <div data-cart-upsell data-url="{{ upsell_url }}"></div>
        {%- endif -%}
      </div>

      <div
        class="cart-drawer-footer border-t border-border-soft bg-surface px-5 md:px-6 pt-4 md:pt-5 space-y-4"
        data-cart-footer
      >
        {%- if threshold_cents > 0 -%}
          <div class="space-y-2">
            <p class="text-xs text-ink-soft" data-free-shipping-message>
              {%- if reached -%}
                Je komt in aanmerking voor gratis verzending.
              {%- else -%}
                Nog <span class="text-ink font-medium tabular-nums" data-free-shipping-remaining>{{ remaining_cents | money }}</span> tot gratis verzending
              {%- endif -%}
            </p>
            <div
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax="100"
              aria-valuenow="{{ pct }}"
              aria-label="Voortgang gratis verzending"
              class="h-1.5 w-full overflow-hidden rounded-full bg-border-soft"
              data-free-shipping-progress
            >
              <div
                class="h-full rounded-full bg-clay transition-[width] duration-300"
                style="width: {{ pct }}%"
                data-free-shipping-progress-fill
              ></div>
            </div>
          </div>
        {%- endif -%}

        <div class="border-t border-border-soft/70 pt-1">
          <button type="button" data-promo-toggle aria-expanded="{% if applied_discounts.size > 0 %}true{% else %}false{% endif %}" aria-controls="cart-promo-{{ layout }}" class="flex w-full items-center justify-between py-2 text-left text-[13px] text-ink-soft hover:text-ink transition-colors focus-visible:outline-none focus-visible:text-ink">
            <span>Kortingscode{% if applied_discounts.size > 0 %}<span class="ml-2 text-[11px] uppercase tracking-[0.14em] text-clay">Toegepast</span>{% endif %}</span>
            {% render 'icon', name: 'chevron-down', size: 16 %}
          </button>
          <div id="cart-promo-{{ layout }}" data-promo-panel class="space-y-3 pt-2 pb-1 {% if applied_discounts.size == 0 %}hidden{% endif %}">
            {%- if applied_discounts.size > 0 -%}
              <ul class="space-y-1">
                {%- for d in applied_discounts -%}
                  <li class="flex items-center justify-between text-xs">
                    <span class="text-ink">{{ d.title }}</span>
                    <span class="text-clay tabular-nums">-{{ d.total_allocated_amount | money }}</span>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <form data-discount-form class="flex gap-2">
              <label for="discount-{{ layout }}" class="sr-only">Kortingscode</label>
              <input id="discount-{{ layout }}" data-discount-input type="text" name="discount" placeholder="Kortingscode" class="flex-1 border border-border-soft bg-surface px-3 h-10 text-sm text-ink focus:outline-none focus:border-stone">
              <button type="submit" aria-label="Kortingscode toepassen" class="h-10 px-4 bg-cream text-ink text-xs uppercase tracking-wide hover:bg-border-soft">Toepassen</button>
            </form>
          </div>
        </div>

        <div class="flex items-baseline justify-between">
          <span class="text-label text-ink-soft">Subtotaal</span>
          <span
            class="text-price text-ink tabular-nums"
            data-cart-subtotal
          >
            {{ cart.items_subtotal_price | money }}
          </span>
        </div>

        <div class="space-y-3">
          {% form 'cart', cart %}
            <button type="submit" name="checkout" data-cart-checkout-button class="zh-cart-checkout">Afrekenen</button>
          {% endform %}
          <p class="text-xs text-center text-ink-soft">BTW en verzendkosten worden berekend bij het afrekenen.</p>
        </div>
      </div>
    </div>
  {%- else -%}
    <div
      class="relative flex flex-1 flex-col {% unless is_page %}overflow-y-auto overscroll-contain{% endunless %} px-6 py-8 sm:px-8 sm:py-12"
      data-cart-empty-layout
      data-cart-scroll-region
      style="overflow-anchor: none;"
    >
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-80" style="background: radial-gradient(70% 70% at 80% 10%, rgba(181,101,29,0.08), transparent 60%), radial-gradient(60% 60% at 10% 90%, rgba(138,154,123,0.10), transparent 60%);"></div>
      <div class="relative m-auto flex w-full max-w-md flex-col items-center py-4">
        <div class="max-w-xs text-center" data-cart-empty-state>
          <p class="mb-5 flex items-center justify-center gap-3 text-[10px] uppercase tracking-[0.22em] text-clay">
            <span aria-hidden="true" class="block h-px w-8 bg-clay/60"></span>Winkelmand<span aria-hidden="true" class="block h-px w-8 bg-clay/60"></span>
          </p>
          <p class="font-display text-[clamp(1.5rem,4vw,2rem)] leading-[1.1] tracking-[-0.01em] text-ink">Je winkelmand is nog leeg.</p>
          <p class="mt-4 text-[14px] leading-relaxed text-ink-soft">Bekijk onze collectie en ontdek stijlvolle producten voor je keuken en huis.</p>
          <a href="{{ routes.all_products_collection_url }}" class="group mt-7 inline-flex items-center justify-center gap-3 bg-ink px-7 py-3.5 text-[11px] uppercase tracking-[0.22em] text-surface transition-colors hover:bg-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2">
            Bekijk collectie <span aria-hidden="true" class="text-base leading-none transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
        {%- if has_suggestions -%}
          <div class="mt-10 w-full sm:mt-12">
            <section
              aria-label="Populaire keuzes"
              class="w-full"
              data-cart-persistent-suggestions
            >
              <p class="text-label text-ink-soft mb-4">Populaire keuzes</p>
              <div class="grid grid-cols-2 gap-x-4 gap-y-8">
                {%- for product in suggestion_collection.products limit: 4 -%}
                  {% render 'product-card', product: product, loading: 'lazy' %}
                {%- endfor -%}
              </div>
            </section>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>