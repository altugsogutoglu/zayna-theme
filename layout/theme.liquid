<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FAF5F2">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CX2JJ95DZC"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CX2JJ95DZC');
    </script>

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {%- comment -%} SEO: self-referential hreflang (single-locale store) {%- endcomment -%}
    <link rel="alternate" hreflang="nl-nl" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    {%- comment -%} SEO: noindex thin tag-filtered collection pages (canonical still follows) {%- endcomment -%}
    {%- if template.name == 'collection' and current_tags != blank -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

    {%- comment -%} SEO: complete Open Graph product namespace (Shopify emits og:image only) {%- endcomment -%}
    {%- if template.name == 'product' and product -%}
      {%- assign og_variant = product.selected_or_first_available_variant -%}
      <meta property="og:type" content="product">
      <meta property="og:title" content="{{ product.title | escape }}">
      <meta property="og:description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
      <meta property="og:url" content="{{ canonical_url }}">
      <meta property="product:price:amount" content="{{ og_variant.price | divided_by: 100.0 }}">
      <meta property="product:price:currency" content="{{ shop.currency }}">
      <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
      {%- if product.featured_image -%}
        <link rel="preload" as="image" fetchpriority="high" href="{{ product.featured_image | image_url: width: 1200, format: 'webp' | prepend: 'https:' }}">
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} SEO: Organization + WebSite SearchAction (homepage only) {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}{% if shop.brand.logo %},
        "logo": {{ shop.brand.logo | image_url: width: 400 | prepend: 'https:' | json }}{% endif %}
      }
      </script>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
      </script>
    {%- endif -%}

    <link rel="stylesheet" href="{{ 'tailwind.css' | asset_url }}">

    {% style %}
      :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
        outline: 2px solid #a66a3f;
        outline-offset: 3px;
      }

      :where([inert]) {
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html:focus-within {
          scroll-behavior: auto;
        }
      }
    {% endstyle %}

    <script src="{{ 'theme.js' | asset_url | append: '?zh=5' }}" defer></script>
  </head>
  <body class="min-h-dvh font-sans text-ink antialiased">
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-ink focus:shadow" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- capture mobile_body -%}{% render 'mobile-menu' %}{%- endcapture -%}
    {% render 'aside', type: 'mobile', heading: shop.name, aside_body: mobile_body %}

    {%- capture search_heading -%}{{ 'general.search.title' | t }}{%- endcapture -%}
    {%- capture search_body -%}
      <div class="zayna-search-panel">
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="zayna-search-form"
          data-predictive-form
          data-predictive-url="{{ routes.predictive_search_url }}"
          data-min-chars="2"
        >
          <label class="sr-only" for="ZaynaSearchInput">
            {{ 'general.search.title' | t }}
          </label>

          <div class="zayna-search-field">
            <span
              aria-hidden="true"
              class="zayna-search-icon"
            >
              {% render 'icon', name: 'search', size: 20 %}
            </span>

            <input
              id="ZaynaSearchInput"
              type="search"
              name="q"
              data-predictive-input
              data-aside-autofocus
              placeholder="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="ZaynaPredictiveResults"
              aria-expanded="false"
              class="zayna-search-input"
            >
          </div>

          <input type="hidden" name="type" value="product,page,article">

          <button
            type="submit"
            class="zayna-search-submit"
          >
            {{ 'general.search.submit' | t }}
          </button>
        </form>

        <div
          id="ZaynaPredictiveResults"
          class="zayna-search-results"
          data-predictive-results
          aria-live="polite"
          aria-atomic="false"
        >
          <p class="text-sm text-ink-soft">
            {{ 'general.search.start_typing' | t }}
          </p>
        </div>
      </div>
    {%- endcapture -%}
    {% render 'aside', type: 'search', heading: search_heading, aside_body: search_body %}

    {% style %}
      [data-aside="search"] .zayna-search-panel {
        padding: 24px 20px;
      }

      [data-aside="search"] .zayna-search-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
        width: 100%;
      }

      [data-aside="search"] .zayna-search-field {
        display: flex;
        min-width: 0;
        min-height: 50px;
        align-items: center;
        gap: 12px;
        border-bottom: 2px solid rgba(42, 37, 32, 0.18);
        transition: border-color 180ms ease;
      }

      [data-aside="search"] .zayna-search-field:focus-within {
        border-color: #b5651d;
      }

      [data-aside="search"] .zayna-search-icon {
        display: inline-flex;
        flex: 0 0 auto;
        color: #8f877f;
        transition: color 180ms ease;
      }

      [data-aside="search"] .zayna-search-field:focus-within .zayna-search-icon {
        color: #b5651d;
      }

      [data-aside="search"] .zayna-search-input {
        width: 100%;
        min-width: 0;
        min-height: 48px;
        padding: 12px 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: #2a2520;
        font-size: 16px;
        line-height: 1.4;
        -webkit-appearance: none;
        appearance: none;
      }

      [data-aside="search"] .zayna-search-input::placeholder {
        color: #78716c;
        opacity: 1;
      }

      [data-aside="search"] .zayna-search-submit {
        display: inline-flex;
        width: 100%;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        padding: 0 22px;
        border: 1px solid #2a2520;
        background: #2a2520;
        color: #ffffff;
        font-size: 11px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          background-color 180ms ease,
          border-color 180ms ease,
          color 180ms ease;
      }

      [data-aside="search"] .zayna-search-submit:hover {
        border-color: #b5651d;
        background: #b5651d;
      }

      [data-aside="search"] .zayna-search-submit:focus-visible {
        outline: 2px solid #b5651d;
        outline-offset: 3px;
      }

      [data-aside="search"] .zayna-search-results {
        margin-top: 24px;
      }

      [data-aside="search"] .zayna-search-results a {
        cursor: pointer;
      }

      [data-aside="search"] .zayna-search-results a:focus-visible {
        outline: 2px solid #9b5f35;
        outline-offset: 3px;
      }

      @media (min-width: 480px) {
        [data-aside="search"] .zayna-search-panel {
          padding-right: 24px;
          padding-left: 24px;
        }

        [data-aside="search"] .zayna-search-form {
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: end;
        }

        [data-aside="search"] .zayna-search-submit {
          width: auto;
          min-width: 112px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        [data-aside="search"] .zayna-search-field,
        [data-aside="search"] .zayna-search-icon,
        [data-aside="search"] .zayna-search-submit {
          transition: none;
        }
      }
    {% endstyle %}

    <script src="{{ 'search.js' | asset_url | append: '?zh=4' }}" defer></script>

    {% section 'cart-drawer' %}
  </body>
</html>