        font-family: var(--font-sans, system-ui, sans-serif);
        font-size: 0.56rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.07em;
        text-transform: uppercase;
      }

      body.zh-shipping-policy .zh-shipping-eyebrow::before {
        content: "";
