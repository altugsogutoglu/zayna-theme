<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FAF5F2">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CX2JJ95DZC"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CX2JJ95DZC');
    </script>

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {%- comment -%} SEO: self-referential hreflang (single-locale store) {%- endcomment -%}
    <link rel="alternate" hreflang="nl-nl" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    {%- comment -%} SEO: noindex thin tag-filtered collection pages (canonical still follows) {%- endcomment -%}
    {%- if template.name == 'collection' and current_tags != blank -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

    {%- comment -%} SEO: complete Open Graph product namespace (Shopify emits og:image only) {%- endcomment -%}
    {%- if template.name == 'product' and product -%}
      {%- assign og_variant = product.selected_or_first_available_variant -%}
      <meta property="og:type" content="product">
      <meta property="og:title" content="{{ product.title | escape }}">
      <meta property="og:description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
      <meta property="og:url" content="{{ canonical_url }}">
      <meta property="product:price:amount" content="{{ og_variant.price | divided_by: 100.0 }}">
      <meta property="product:price:currency" content="{{ shop.currency }}">
      <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
      {%- if product.featured_image -%}
        <link rel="preload" as="image" fetchpriority="high" href="{{ product.featured_image | image_url: width: 1200, format: 'webp' | prepend: 'https:' }}">
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} SEO: Organization + WebSite SearchAction (homepage only) {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}{% if shop.brand.logo %},
        "logo": {{ shop.brand.logo | image_url: width: 400 | prepend: 'https:' | json }}{% endif %}
      }
      </script>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
      </script>
    {%- endif -%}

    <link rel="stylesheet" href="{{ 'tailwind.css' | asset_url }}">

    {% style %}
      :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
        outline: 2px solid #a66a3f;
        outline-offset: 3px;
      }

      :where([inert]) {
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html:focus-within {
          scroll-behavior: auto;
        }
      }


      /* Fase 5J — Zayna Home shipping policy, custom render polish */
      body.zh-shipping-policy {
        --zh-ship-bg: #faf5f2;
        --zh-ship-ink: #2a2520;
        --zh-ship-soft: #5a5149;
        --zh-ship-muted: #81766d;
        --zh-ship-clay: #7f563e;
        --zh-ship-clay-soft: rgba(127, 86, 62, 0.20);
        --zh-ship-line: rgba(42, 37, 32, 0.082);
        --zh-ship-line-soft: rgba(42, 37, 32, 0.050);
      }

      body.zh-shipping-policy .zh-shipping-page,
      body.zh-shipping-policy .zh-shipping-page * {
        box-sizing: border-box;
      }

      body.zh-shipping-policy .zh-shipping-page {
        background: var(--zh-ship-bg);
        color: var(--zh-ship-soft);
      }

      body.zh-shipping-policy .zh-shipping-page__inner {
        width: min(100%, 880px);
        margin-inline: auto;
        padding: clamp(2.25rem, 4.6vw, 4.05rem) clamp(1.35rem, 5vw, 4.2rem) clamp(5.4rem, 8vw, 7.4rem);
        text-align: left;
        overflow-wrap: normal;
        word-break: normal;
        hyphens: none;
      }

      body.zh-shipping-policy .zh-shipping-page a {
        color: #72513a;
        text-decoration: underline;
        text-decoration-color: rgba(114, 81, 58, 0.30);
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        transition: color 180ms ease, text-decoration-color 180ms ease;
      }

      body.zh-shipping-policy .zh-shipping-page a:hover {
        color: var(--zh-ship-ink);
        text-decoration-color: rgba(42, 37, 32, 0.42);
      }

      body.zh-shipping-policy .zh-shipping-header,
      body.zh-shipping-policy .zh-shipping-summary,
      body.zh-shipping-policy .zh-shipping-sections,
      body.zh-shipping-policy .zh-shipping-closing {
        max-width: 760px;
      }

      body.zh-shipping-policy .zh-shipping-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.62rem;
        margin: 0 0 0.68rem;
        color: var(--zh-ship-clay);
        font-family: var(--font-sans, system-ui, sans-serif);
        font-size: 0.57rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.078em;
        text-transform: uppercase;
      }

      body.zh-shipping-policy .zh-shipping-eyebrow::before {
        content: "";
        display: inline-block;
        width: 22px;
        height: 1px;
        background: var(--zh-ship-clay-soft);
      }

      body.zh-shipping-policy .zh-shipping-title {
        margin: 0;
        color: var(--zh-ship-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: clamp(1.78rem, 2.05vw, 2.04rem);
        font-weight: 400;
        line-height: 1.15;
        letter-spacing: -0.014em;
        text-wrap: balance;
      }

      body.zh-shipping-policy .zh-shipping-intro {
        max-width: 66ch;
        margin: 1.06rem 0 0;
        color: var(--zh-ship-soft);
        font-size: 1rem;
        line-height: 1.94;
        letter-spacing: 0.001em;
        text-wrap: pretty;
      }

      body.zh-shipping-policy .zh-shipping-intro + .zh-shipping-intro {
        margin-top: 0.42rem;
      }

      body.zh-shipping-policy .zh-shipping-summary {
        margin: clamp(2.25rem, 3.4vw, 2.95rem) 0 0;
        padding: clamp(1.18rem, 2.2vw, 1.48rem) 0;
        border-top: 1px solid var(--zh-ship-line);
        border-bottom: 1px solid var(--zh-ship-line);
      }

      body.zh-shipping-policy .zh-shipping-summary dl {
        display: grid;
        gap: 0;
        margin: 0;
      }

      body.zh-shipping-policy .zh-shipping-summary__row {
        display: grid;
        grid-template-columns: 10.2rem minmax(0, 1fr);
        gap: clamp(1.4rem, 2.5vw, 2.15rem);
        align-items: baseline;
        padding: 0.94rem 0;
        border-top: 1px solid var(--zh-ship-line-soft);
      }

      body.zh-shipping-policy .zh-shipping-summary__row:first-child {
        padding-top: 0;
        border-top: 0;
      }

      body.zh-shipping-policy .zh-shipping-summary__row:last-child {
        padding-bottom: 0;
      }

      body.zh-shipping-policy .zh-shipping-summary dt {
        margin: 0;
        color: #765640;
        font-family: var(--font-sans, system-ui, sans-serif);
        font-size: 0.755rem;
        font-weight: 500;
        line-height: 1.36;
        letter-spacing: 0.03em;
      }

      body.zh-shipping-policy .zh-shipping-summary dd {
        margin: 0;
        color: var(--zh-ship-soft);
        font-size: 0.965rem;
        line-height: 1.76;
        text-wrap: pretty;
      }

      body.zh-shipping-policy .zh-shipping-sections {
        margin-top: clamp(2.85rem, 4vw, 3.9rem);
      }

      body.zh-shipping-policy .zh-shipping-section {
        padding: clamp(2rem, 3vw, 2.7rem) 0;
        border-top: 1px solid var(--zh-ship-line-soft);
      }

      body.zh-shipping-policy .zh-shipping-section:first-child {
        padding-top: 0;
        border-top: 0;
      }

      body.zh-shipping-policy .zh-shipping-section h2 {
        margin: 0 0 1rem;
        color: var(--zh-ship-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: clamp(1.06rem, 1.16vw, 1.17rem);
        font-weight: 400;
        line-height: 1.38;
        letter-spacing: -0.006em;
        text-wrap: balance;
      }

      body.zh-shipping-policy .zh-shipping-section p,
      body.zh-shipping-policy .zh-shipping-closing {
        max-width: 70ch;
        margin: 0;
        color: var(--zh-ship-soft);
        font-size: 0.995rem;
        line-height: 2.02;
        letter-spacing: 0.001em;
        text-wrap: pretty;
      }

      body.zh-shipping-policy .zh-shipping-section p + p {
        margin-top: 1.16rem;
      }

      body.zh-shipping-policy .zh-shipping-closing {
        margin-top: 0.55rem;
        padding-top: clamp(2rem, 3vw, 2.55rem);
        border-top: 1px solid var(--zh-ship-line);
      }

      @media (max-width: 959px) {
        body.zh-shipping-policy .zh-shipping-page__inner {
          width: min(100%, 760px);
          padding-top: clamp(1.85rem, 4.5vw, 2.6rem);
          padding-bottom: clamp(4.9rem, 7.8vw, 6.25rem);
        }

        body.zh-shipping-policy .zh-shipping-title {
          font-size: clamp(1.62rem, 4.2vw, 1.86rem);
        }

        body.zh-shipping-policy .zh-shipping-summary__row {
          grid-template-columns: 9.2rem minmax(0, 1fr);
          gap: 1.35rem;
        }
      }

      @media (max-width: 639px) {
        body.zh-shipping-policy .zh-shipping-page__inner {
          padding-top: 1.55rem;
          padding-inline: 1.25rem;
          padding-bottom: 5rem;
        }

        body.zh-shipping-policy .zh-shipping-eyebrow {
          gap: 0.54rem;
          margin-bottom: 0.6rem;
          font-size: 0.545rem;
          letter-spacing: 0.07em;
        }

        body.zh-shipping-policy .zh-shipping-eyebrow::before {
          width: 18px;
        }

        body.zh-shipping-policy .zh-shipping-title {
          font-size: clamp(1.46rem, 5.7vw, 1.62rem);
          line-height: 1.17;
        }

        body.zh-shipping-policy .zh-shipping-intro,
        body.zh-shipping-policy .zh-shipping-section p,
        body.zh-shipping-policy .zh-shipping-closing {
          font-size: 0.93rem;
          line-height: 1.96;
        }

        body.zh-shipping-policy .zh-shipping-intro {
          margin-top: 0.96rem;
        }

        body.zh-shipping-policy .zh-shipping-intro + .zh-shipping-intro {
          margin-top: 0.38rem;
        }

        body.zh-shipping-policy .zh-shipping-summary {
          margin-top: 1.95rem;
          padding: 1.18rem 0;
        }

        body.zh-shipping-policy .zh-shipping-summary__row {
          display: block;
          padding: 0.9rem 0;
        }

        body.zh-shipping-policy .zh-shipping-summary dt {
          margin-bottom: 0.3rem;
          font-size: 0.725rem;
          line-height: 1.3;
        }

        body.zh-shipping-policy .zh-shipping-summary dd {
          font-size: 0.91rem;
          line-height: 1.78;
        }

        body.zh-shipping-policy .zh-shipping-sections {
          margin-top: 2.38rem;
        }

        body.zh-shipping-policy .zh-shipping-section {
          padding: 1.82rem 0;
        }

        body.zh-shipping-policy .zh-shipping-section h2 {
          margin-bottom: 0.84rem;
          font-size: 1.02rem;
          line-height: 1.36;
        }

        body.zh-shipping-policy .zh-shipping-section p + p {
          margin-top: 1.04rem;
        }

        body.zh-shipping-policy .zh-shipping-closing {
          padding-top: 2rem;
        }
      }


    {% endstyle %}

    <script src="{{ 'theme.js' | asset_url | append: '?zh=5' }}" defer></script>
  </head>
  <body class="min-h-dvh font-sans text-ink antialiased{% if request.path contains '/policies/shipping-policy' %} zh-shipping-policy{% endif %}">
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-ink focus:shadow" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {%- if request.path contains '/policies/shipping-policy' -%}
        <article class="zh-shipping-page" aria-labelledby="zh-shipping-title">
          <div class="zh-shipping-page__inner">
            <header class="zh-shipping-header">
              <p class="zh-shipping-eyebrow">Klantenservice</p>
              <h1 id="zh-shipping-title" class="zh-shipping-title">Verzending</h1>
              <p class="zh-shipping-intro">
                We verzenden je bestelling vanuit Nederland en verpakken deze met zorg.
              </p>
              <p class="zh-shipping-intro">
                Hieronder lees je wat je kunt verwachten over levertijd, verzendkosten en schade bij ontvangst.
              </p>
            </header>

            <section class="zh-shipping-summary" aria-label="Verzending in het kort">
              <dl>
                <div class="zh-shipping-summary__row">
                  <dt>Levertijd</dt>
                  <dd>Meestal 1–3 werkdagen.</dd>
                </div>
                <div class="zh-shipping-summary__row">
                  <dt>Gratis verzending</dt>
                  <dd>In Nederland vanaf €100.</dd>
                </div>
                <div class="zh-shipping-summary__row">
                  <dt>Verzendgebied</dt>
                  <dd>Nederland, België, Duitsland en Frankrijk.</dd>
                </div>
                <div class="zh-shipping-summary__row">
                  <dt>Track &amp; trace</dt>
                  <dd>Je ontvangt een code zodra je bestelling is verzonden.</dd>
                </div>
              </dl>
            </section>

            <div class="zh-shipping-sections">
              <section class="zh-shipping-section">
                <h2>Verzendkosten</h2>
                <p>
                  De verzendkosten worden automatisch berekend tijdens het afrekenen. Je ziet het bedrag altijd voordat je de bestelling definitief plaatst.
                </p>
                <p>
                  Binnen Nederland verzenden we gratis vanaf een bestelbedrag van €100. Voor België, Duitsland en Frankrijk kunnen andere verzendtarieven gelden. Deze worden vooraf zichtbaar gemaakt in de checkout.
                </p>
              </section>

              <section class="zh-shipping-section">
                <h2>Levertijd en bezorging</h2>
                <p>
                  We verwerken bestellingen zorgvuldig. De verwachte levertijd is meestal 1–3 werkdagen. Zodra je pakket is verzonden, ontvang je een track &amp; trace-code.
                </p>
                <p>
                  Soms ontstaat vertraging bij de vervoerder. We kijken dan graag met je mee.
                </p>
              </section>

              <section class="zh-shipping-section">
                <h2>Adresgegevens</h2>
                <p>
                  Controleer je adresgegevens goed voordat je bestelt. Zo kunnen we je pakket zonder vertraging verzenden.
                </p>
                <p>
                  Komt een pakket retour door een fout adres of doordat het niet op tijd wordt opgehaald, dan kunnen extra verzendkosten in rekening worden gebracht.
                </p>
              </section>

              <section class="zh-shipping-section">
                <h2>Schade of breuk</h2>
                <p>
                  Veel producten van Zayna Home zijn breekbaar. We verpakken je bestelling daarom zo zorgvuldig mogelijk.
                </p>
                <p>
                  Is je bestelling beschadigd aangekomen? Mail ons bij voorkeur binnen 48 uur via <a href="mailto:info@zaynahome.nl">info@zaynahome.nl</a>. Voeg duidelijke foto’s toe van de verpakking, het verzendlabel en het beschadigde product.
                </p>
                <p>
                  Bewaar de verpakking totdat we je melding hebben bekeken. Een latere melding wordt niet automatisch afgewezen, maar kan de beoordeling wel lastiger maken.
                </p>
              </section>
            </div>

            <p class="zh-shipping-closing">
              Twijfel je over je levering of is er iets misgegaan? Mail ons gerust via <a href="mailto:info@zaynahome.nl">info@zaynahome.nl</a>, dan kijken we met je mee.
            </p>
          </div>
        </article>
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}

    {%- capture mobile_body -%}{% render 'mobile-menu' %}{%- endcapture -%}
    {% render 'aside', type: 'mobile', heading: shop.name, aside_body: mobile_body %}

    {%- capture search_heading -%}{{ 'general.search.title' | t }}{%- endcapture -%}
    {%- capture search_body -%}
      <div class="zayna-search-panel">
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="zayna-search-form"
          data-predictive-form
          data-predictive-url="{{ routes.predictive_search_url }}"
          data-min-chars="2"
        >
          <label class="sr-only" for="ZaynaSearchInput">
            {{ 'general.search.title' | t }}
          </label>

          <div class="zayna-search-field">
            <span
              aria-hidden="true"
              class="zayna-search-icon"
            >
              {% render 'icon', name: 'search', size: 20 %}
            </span>

            <input
              id="ZaynaSearchInput"
              type="search"
              name="q"
              data-predictive-input
              data-aside-autofocus
              placeholder="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="ZaynaPredictiveResults"
              aria-expanded="false"
              class="zayna-search-input"
            >
          </div>

          <input type="hidden" name="type" value="product,page,article">

          <button
            type="submit"
            class="zayna-search-submit"
          >
            {{ 'general.search.submit' | t }}
          </button>
        </form>

        <div
          id="ZaynaPredictiveResults"
          class="zayna-search-results"
          data-predictive-results
          aria-live="polite"
          aria-atomic="false"
        >
          <p class="text-sm text-ink-soft">
            {{ 'general.search.start_typing' | t }}
          </p>
        </div>
      </div>
    {%- endcapture -%}
    {% render 'aside', type: 'search', heading: search_heading, aside_body: search_body %}

    {% style %}
      [data-aside="search"] {
        --zh-search-bg: #fffdfb;
        --zh-search-ink: #2a2520;
        --zh-search-soft: #625951;
        --zh-search-muted: #857a71;
        --zh-search-border: rgba(42, 37, 32, 0.10);
        --zh-search-border-strong: rgba(42, 37, 32, 0.16);
        --zh-search-cream: #f3ece4;
        --zh-search-clay: #96613f;
        --zh-search-added: #efe5dc;
      }

      [data-aside="search"] .zayna-search-panel {
        padding: 16px 18px 26px;
      }

      [data-aside="search"] .zayna-search-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        width: 100%;
      }

      [data-aside="search"] .zayna-search-field {
        display: flex;
        min-width: 0;
        min-height: 48px;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--zh-search-border-strong);
        transition: border-color 180ms ease;
      }

      [data-aside="search"] .zayna-search-field:focus-within {
        border-color: var(--zh-search-clay);
      }

      [data-aside="search"] .zayna-search-icon {
        display: inline-flex;
        flex: 0 0 auto;
        color: var(--zh-search-muted);
        transition: color 180ms ease;
      }

      [data-aside="search"] .zayna-search-field:focus-within .zayna-search-icon {
        color: var(--zh-search-clay);
      }

      [data-aside="search"] .zayna-search-input {
        width: 100%;
        min-width: 0;
        min-height: 46px;
        padding: 11px 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--zh-search-ink);
        font-size: 16px;
        line-height: 1.4;
        -webkit-appearance: none;
        appearance: none;
      }

      [data-aside="search"] .zayna-search-input::placeholder {
        color: #81776f;
        opacity: 1;
      }

      [data-aside="search"] .zayna-search-submit {
        display: none;
        width: 100%;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: 1px solid var(--zh-search-border-strong);
        background: transparent;
        color: var(--zh-search-ink);
        font-size: 10px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          background-color 180ms ease,
          border-color 180ms ease,
          color 180ms ease;
      }

      [data-aside="search"] .zayna-search-submit:hover {
        border-color: rgba(42, 37, 32, 0.30);
        background: rgba(42, 37, 32, 0.92);
        color: #fffdfb;
      }

      [data-aside="search"] .zayna-search-submit:focus-visible {
        outline: 2px solid var(--zh-search-clay);
        outline-offset: 3px;
      }

      [data-aside="search"] .zayna-search-results {
        margin-top: 15px;
      }

      [data-aside="search"] .zayna-search-results.is-refreshing .zh-predictive-results {
        opacity: 0.58;
        transition: opacity 140ms ease;
      }

      [data-aside="search"] .zayna-search-results a,
      [data-aside="search"] .zayna-search-results button {
        -webkit-tap-highlight-color: transparent;
      }

      [data-aside="search"] .zayna-search-results a {
        cursor: pointer;
      }

      [data-aside="search"] .zayna-search-results a:focus-visible,
      [data-aside="search"] .zayna-search-results button:focus-visible {
        outline: 2px solid var(--zh-search-clay);
        outline-offset: 3px;
      }

      [data-aside="search"] .zh-predictive-results__stack {
        display: grid;
        gap: 18px;
      }

      [data-aside="search"] .zh-search-section__heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 7px;
      }

      [data-aside="search"] .zh-search-section__heading span:first-child {
        color: #90867d;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.20em;
        line-height: 1;
        text-transform: uppercase;
      }

      [data-aside="search"] .zh-search-section__heading span:last-child {
        height: 1px;
        flex: 1 1 auto;
        background: var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-products,
      [data-aside="search"] .zh-search-link-list {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-product__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 9px;
        padding: 9px 0;
        border-bottom: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-product__main {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 10px;
        color: inherit;
        text-decoration: none;
      }

      [data-aside="search"] .zh-search-product__image-wrap,
      [data-aside="search"] .zh-search-link-row__image-wrap {
        display: block;
        flex: 0 0 auto;
        overflow: hidden;
        background: var(--zh-search-cream);
      }

      [data-aside="search"] .zh-search-product__image-wrap {
        width: 58px;
        height: 58px;
        border: 1px solid rgba(42, 37, 32, 0.055);
      }

      [data-aside="search"] .zh-search-product__image,
      [data-aside="search"] .zh-search-link-row__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      [data-aside="search"] .zh-search-product__copy {
        display: grid;
        min-width: 0;
        gap: 3px;
      }

      [data-aside="search"] .zh-search-product__title {
        display: -webkit-box;
        overflow: hidden;
        color: var(--zh-search-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: 14.25px;
        line-height: 1.18;
        letter-spacing: -0.012em;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        transition: color 180ms ease;
      }

      [data-aside="search"] .zh-search-product__main:hover .zh-search-product__title {
        color: var(--zh-search-clay);
      }

      [data-aside="search"] .zh-search-product__price {
        color: var(--zh-search-soft);
        font-size: 12.25px;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
      }

      [data-aside="search"] .zh-search-product__status {
        color: var(--zh-search-muted);
        font-size: 11.5px;
        line-height: 1.25;
      }

      [data-aside="search"] .zh-search-product__action {
        display: flex;
        justify-content: flex-end;
      }

      [data-aside="search"] .zh-search-product__form {
        margin: 0;
      }

      [data-aside="search"] .zh-search-product__button {
        display: inline-flex;
        min-width: 74px;
        min-height: 31px;
        align-items: center;
        justify-content: center;
        gap: 0;
        padding: 0 10px;
        border: 1px solid rgba(42, 37, 32, 0.13);
        background: rgba(255, 253, 251, 0.62);
        color: var(--zh-search-ink);
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.01em;
        line-height: 1;
        text-align: center;
        text-decoration: none;
        text-transform: none;
        white-space: nowrap;
        cursor: pointer;
        transition:
          background-color 180ms ease,
          border-color 180ms ease,
          color 180ms ease,
          opacity 180ms ease;
      }

      [data-aside="search"] .zh-search-product__button:hover {
        border-color: rgba(150, 97, 63, 0.24);
        background: rgba(244, 238, 232, 0.72);
        color: #2a2520;
      }

      [data-aside="search"] .zh-search-product__button[disabled] {
        cursor: wait;
        opacity: 0.72;
      }

      [data-aside="search"] .zh-search-product__button.is-added {
        border-color: rgba(159, 99, 61, 0.26);
        background: var(--zh-search-added);
        color: #5f554d;
      }

      [data-aside="search"] .zh-search-product__button.is-error {
        border-color: rgba(178, 58, 72, 0.28);
        background: rgba(178, 58, 72, 0.06);
        color: #8c3c43;
      }

      [data-aside="search"] .zh-search-product__button--option {
        border-color: rgba(150, 97, 63, 0.20);
        color: #704a33;
      }

      [data-aside="search"] .zh-search-product__button--sold {
        justify-content: center;
        border-color: rgba(42, 37, 32, 0.10);
        color: #9a8f85;
        cursor: default;
      }

      [data-aside="search"] .zh-search-product__button--sold:hover {
        border-color: rgba(42, 37, 32, 0.10);
        background: transparent;
        color: #9a8f85;
      }

      [data-aside="search"] .zh-search-link-row {
        display: flex;
        min-height: 64px;
        align-items: center;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--zh-search-border);
        color: inherit;
        text-decoration: none;
      }

      [data-aside="search"] .zh-search-link-row--text {
        min-height: 48px;
      }

      [data-aside="search"] .zh-search-link-row__image-wrap {
        width: 56px;
        height: 56px;
      }

      [data-aside="search"] .zh-search-link-row__title {
        min-width: 0;
        flex: 1 1 auto;
        overflow: hidden;
        color: var(--zh-search-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: 14.5px;
        line-height: 1.22;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 180ms ease;
      }

      [data-aside="search"] .zh-search-link-row:hover .zh-search-link-row__title {
        color: var(--zh-search-clay);
      }

      [data-aside="search"] .zh-search-link-row__arrow {
        flex: 0 0 auto;
        color: #9d9288;
        font-size: 13px;
      }

      [data-aside="search"] .zh-search-view-all,
      [data-aside="search"] .zh-search-empty-state__link {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 15px;
        border: 1px solid rgba(159, 99, 61, 0.24);
        background: rgba(244, 238, 232, 0.60);
        color: #704a33;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.14em;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
      }

      [data-aside="search"] .zh-search-view-all {
        width: 100%;
      }

      [data-aside="search"] .zh-search-empty-state,
      [data-aside="search"] .zh-search-message,
      [data-aside="search"] .zh-search-status {
        padding: 28px 8px;
        text-align: center;
      }

      [data-aside="search"] .zh-search-empty-state__title,
      [data-aside="search"] .zh-search-message__title {
        margin: 0;
        color: var(--zh-search-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: 18.5px;
        line-height: 1.18;
      }

      [data-aside="search"] .zh-search-empty-state__text,
      [data-aside="search"] .zh-search-message__text,
      [data-aside="search"] .zh-search-status {
        margin: 8px auto 0;
        max-width: 32ch;
        color: var(--zh-search-soft);
        font-size: 14px;
        line-height: 1.58;
      }

      [data-aside="search"] .zh-search-empty-state__link {
        margin-top: 15px;
      }

      [data-aside="search"] .zh-search-empty-state__choices {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        width: min(100%, 310px);
        margin: 18px auto 0;
      }

      [data-aside="search"] .zh-search-empty-state__choice {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        justify-content: center;
        padding: 0 14px;
        border: 1px solid rgba(150, 97, 63, 0.22);
        background: rgba(244, 238, 232, 0.58);
        color: #704a33;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.12em;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
      }

      [data-aside="search"] .zh-search-empty-state__choice:hover {
        border-color: rgba(42, 37, 32, 0.30);
        background: rgba(42, 37, 32, 0.92);
        color: #fffdfb;
      }

      [data-aside="search"] .zh-search-skeleton {
        display: grid;
        gap: 12px;
      }

      [data-aside="search"] .zh-search-skeleton__label {
        display: block;
        width: 112px;
        height: 10px;
        background: rgba(42, 37, 32, 0.08);
      }

      [data-aside="search"] .zh-search-skeleton ul {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-skeleton__row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-skeleton__image {
        width: 58px;
        height: 58px;
        flex: 0 0 auto;
        background: rgba(42, 37, 32, 0.07);
      }

      [data-aside="search"] .zh-search-skeleton__copy {
        display: grid;
        flex: 1 1 auto;
        gap: 9px;
      }

      [data-aside="search"] .zh-search-skeleton__line {
        display: block;
        height: 10px;
        background: rgba(42, 37, 32, 0.07);
      }

      [data-aside="search"] .zh-search-skeleton__line--wide {
        width: 78%;
      }

      [data-aside="search"] .zh-search-skeleton__line--short {
        width: 42%;
      }

      [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__label,
      [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__image,
      [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__line {
        animation: zhSearchPulse 1.45s ease-in-out infinite;
      }

      @keyframes zhSearchPulse {
        0%, 100% { opacity: 0.34; }
        50% { opacity: 0.62; }
      }

      @media (max-width: 374px) {
        [data-aside="search"] .zh-search-product__inner {
          grid-template-columns: minmax(0, 1fr);
        }

        [data-aside="search"] .zh-search-product__action {
          justify-content: stretch;
          padding-left: 70px;
        }

        [data-aside="search"] .zh-search-product__button,
        [data-aside="search"] .zh-search-product__form {
          width: 100%;
        }
      }

      @media (max-width: 759px) {
        [data-aside="search"] .zayna-search-submit {
          display: none !important;
        }

        [data-aside="search"] .zayna-search-form {
          gap: 0;
        }

        [data-aside="search"] .zh-search-product__button:hover {
          border-color: rgba(42, 37, 32, 0.13);
          background: rgba(255, 253, 251, 0.62);
          color: var(--zh-search-ink);
        }

        [data-aside="search"] .zh-search-product__button.is-added:hover {
          border-color: rgba(159, 99, 61, 0.26);
          background: var(--zh-search-added);
          color: #5f554d;
        }
      }

      @media (min-width: 760px) {
        [data-aside="search"] .zayna-search-panel {
          padding-right: 24px;
          padding-left: 24px;
        }

        [data-aside="search"] .zayna-search-form {
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: end;
        }

        [data-aside="search"] .zayna-search-submit {
          display: inline-flex;
          width: auto;
          min-width: 112px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        [data-aside="search"] .zayna-search-field,
        [data-aside="search"] .zayna-search-icon,
        [data-aside="search"] .zayna-search-submit,
        [data-aside="search"] .zh-search-product__button,
        [data-aside="search"] .zh-search-link-row__title,
        [data-aside="search"] .zh-search-product__title {
          transition: none;
        }

        [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__label,
        [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__image,
        [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__line {
          animation: none;
        }
      }
    {% endstyle %}

    <script src="{{ 'search.js' | asset_url | append: '?zh=8' }}" defer></script>

    {% section 'cart-drawer' %}
  </body>
</html>