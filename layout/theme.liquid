<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FAF5F2">

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-CX2JJ95DZC"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-CX2JJ95DZC');
    </script>

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    {%- comment -%} SEO: self-referential hreflang (single-locale store) {%- endcomment -%}
    <link rel="alternate" hreflang="nl-nl" href="{{ canonical_url }}">
    <link rel="alternate" hreflang="x-default" href="{{ canonical_url }}">

    {%- comment -%} SEO: noindex thin tag-filtered collection pages (canonical still follows) {%- endcomment -%}
    {%- if template.name == 'collection' and current_tags != blank -%}
      <meta name="robots" content="noindex,follow">
    {%- endif -%}

    {%- comment -%} SEO: complete Open Graph product namespace (Shopify emits og:image only) {%- endcomment -%}
    {%- if template.name == 'product' and product -%}
      {%- assign og_variant = product.selected_or_first_available_variant -%}
      <meta property="og:type" content="product">
      <meta property="og:title" content="{{ product.title | escape }}">
      <meta property="og:description" content="{{ product.description | strip_html | truncate: 200 | escape }}">
      <meta property="og:url" content="{{ canonical_url }}">
      <meta property="product:price:amount" content="{{ og_variant.price | divided_by: 100.0 }}">
      <meta property="product:price:currency" content="{{ shop.currency }}">
      <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
      {%- if product.featured_image -%}
        <link rel="preload" as="image" fetchpriority="high" href="{{ product.featured_image | image_url: width: 1200, format: 'webp' | prepend: 'https:' }}">
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} SEO: Organization + WebSite SearchAction (homepage only) {%- endcomment -%}
    {%- if template.name == 'index' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Organization",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }}{% if shop.brand.logo %},
        "logo": {{ shop.brand.logo | image_url: width: 400 | prepend: 'https:' | json }}{% endif %}
      }
      </script>
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "WebSite",
        "name": {{ shop.name | json }},
        "url": {{ shop.url | json }},
        "potentialAction": {
          "@type": "SearchAction",
          "target": { "@type": "EntryPoint", "urlTemplate": "{{ shop.url }}/search?q={search_term_string}" },
          "query-input": "required name=search_term_string"
        }
      }
      </script>
    {%- endif -%}

    <link rel="stylesheet" href="{{ 'tailwind.css' | asset_url }}">

    {% style %}
      :where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
        outline: 2px solid #a66a3f;
        outline-offset: 3px;
      }

      :where([inert]) {
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html:focus-within {
          scroll-behavior: auto;
        }
      }


      /* Fase 5C — Zayna Home shipping policy custom layout */
      body.zh-shipping-policy {
        --zh-policy-bg: #faf5f2;
        --zh-policy-ink: #2a2520;
        --zh-policy-soft: #5e554d;
        --zh-policy-muted: #82766d;
        --zh-policy-faint: #9a8f86;
        --zh-policy-line: rgba(42, 37, 32, 0.095);
        --zh-policy-line-soft: rgba(42, 37, 32, 0.06);
        --zh-policy-surface: rgba(255, 253, 251, 0.42);
        --zh-policy-cream: rgba(240, 235, 230, 0.46);
        --zh-policy-clay: #8b5b3f;
        --zh-policy-clay-soft: rgba(139, 91, 63, 0.18);
      }

      body.zh-shipping-policy .shopify-policy__container {
        width: min(100%, 1120px);
        max-width: none;
        margin-inline: auto;
        padding: clamp(2.25rem, 4.2vw, 4rem) clamp(1.125rem, 4.6vw, 3.75rem) clamp(4.75rem, 7vw, 6.5rem);
      }

      body.zh-shipping-policy .shopify-policy__title {
        display: none;
      }

      body.zh-shipping-policy .shopify-policy__body {
        max-width: none;
        margin: 0;
      }

      body.zh-shipping-policy .shopify-policy__body .rte {
        color: var(--zh-policy-soft);
        font-size: 1rem;
        line-height: 1.72;
        overflow-wrap: normal;
        word-break: normal;
        hyphens: none;
      }

      body.zh-shipping-policy .shopify-policy__body .rte > * {
        max-width: none;
      }

      body.zh-shipping-policy .shopify-policy__body .rte > * + * {
        margin-top: 0;
      }

      body.zh-shipping-policy .shopify-policy__body .rte a {
        color: #765139;
        text-decoration: underline;
        text-decoration-color: rgba(118, 81, 57, 0.27);
        text-decoration-thickness: 1px;
        text-underline-offset: 4px;
        transition: color 180ms ease, text-decoration-color 180ms ease;
      }

      body.zh-shipping-policy .shopify-policy__body .rte a:hover {
        color: var(--zh-policy-ink);
        text-decoration-color: rgba(42, 37, 32, 0.38);
      }

      body.zh-shipping-policy .zh-ship-page,
      body.zh-shipping-policy .zh-ship-page * {
        box-sizing: border-box;
      }

      body.zh-shipping-policy .zh-ship-page {
        width: 100%;
        color: var(--zh-policy-soft);
      }

      body.zh-shipping-policy .zh-ship-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(270px, 360px);
        align-items: start;
        gap: clamp(2.25rem, 5vw, 4.75rem);
        padding-bottom: clamp(2.05rem, 3.4vw, 3rem);
        border-bottom: 1px solid var(--zh-policy-line-soft);
      }

      body.zh-shipping-policy .zh-ship-eyebrow {
        display: flex;
        align-items: center;
        gap: 0.82rem;
        margin: 0 0 0.95rem;
        color: var(--zh-policy-clay);
        font-size: 0.64rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.135em;
        text-transform: uppercase;
      }

      body.zh-shipping-policy .zh-ship-eyebrow::before {
        content: "";
        display: inline-block;
        width: 34px;
        height: 1px;
        background: var(--zh-policy-clay-soft);
      }

      body.zh-shipping-policy .zh-ship-title {
        max-width: 12ch;
        margin: 0;
        color: var(--zh-policy-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: clamp(2.25rem, 4.2vw, 3.35rem);
        font-weight: 400;
        line-height: 1.04;
        letter-spacing: -0.025em;
      }

      body.zh-shipping-policy .zh-ship-intro {
        max-width: 560px;
        margin: clamp(1rem, 1.8vw, 1.35rem) 0 0;
        color: var(--zh-policy-soft);
        font-size: clamp(1rem, 0.35vw + 0.95rem, 1.12rem);
        line-height: 1.68;
      }

      body.zh-shipping-policy .zh-ship-summary {
        width: 100%;
        margin-top: 0.22rem;
        padding: clamp(1.2rem, 2vw, 1.45rem) 0 0;
        border-top: 1px solid var(--zh-policy-line);
      }

      body.zh-shipping-policy .zh-ship-summary h2 {
        margin: 0 0 0.92rem;
        color: #80563d;
        font-family: var(--font-sans, system-ui, sans-serif);
        font-size: 0.66rem;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      body.zh-shipping-policy .zh-ship-summary dl {
        display: grid;
        gap: 0;
        margin: 0;
      }

      body.zh-shipping-policy .zh-ship-summary-row {
        display: grid;
        grid-template-columns: minmax(95px, 0.42fr) minmax(0, 1fr);
        gap: 1rem;
        padding: 0.74rem 0;
        border-top: 1px solid var(--zh-policy-line-soft);
      }

      body.zh-shipping-policy .zh-ship-summary-row:first-of-type {
        border-top: 0;
        padding-top: 0;
      }

      body.zh-shipping-policy .zh-ship-summary dt {
        margin: 0;
        color: var(--zh-policy-ink);
        font-size: 0.79rem;
        font-weight: 500;
        line-height: 1.35;
      }

      body.zh-shipping-policy .zh-ship-summary dd {
        margin: 0;
        color: var(--zh-policy-soft);
        font-size: 0.92rem;
        line-height: 1.45;
      }

      body.zh-shipping-policy .zh-ship-sections {
        margin-top: clamp(1.7rem, 3vw, 2.65rem);
      }

      body.zh-shipping-policy .zh-ship-section {
        display: grid;
        grid-template-columns: minmax(170px, 230px) minmax(0, 1fr);
        gap: clamp(1.6rem, 4.2vw, 3.8rem);
        padding: clamp(1.55rem, 2.8vw, 2.35rem) 0;
        border-top: 1px solid var(--zh-policy-line-soft);
      }

      body.zh-shipping-policy .zh-ship-section:first-child {
        border-top: 0;
        padding-top: 0;
      }

      body.zh-shipping-policy .zh-ship-section h2 {
        margin: 0;
        color: var(--zh-policy-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: clamp(1.25rem, 1.4vw, 1.55rem);
        font-weight: 400;
        line-height: 1.18;
        letter-spacing: -0.012em;
      }

      body.zh-shipping-policy .zh-ship-section-body {
        max-width: 700px;
        color: var(--zh-policy-soft);
      }

      body.zh-shipping-policy .zh-ship-section-body > * + * {
        margin-top: 0.85rem;
      }

      body.zh-shipping-policy .zh-ship-section-body p {
        margin: 0;
        font-size: 0.99rem;
        line-height: 1.72;
      }

      body.zh-shipping-policy .zh-ship-note {
        margin-top: 1.08rem;
        padding-top: 0.95rem;
        border-top: 1px solid var(--zh-policy-line-soft);
        color: #6f6259;
        font-size: 0.95rem;
        line-height: 1.68;
      }

      body.zh-shipping-policy .zh-ship-steps {
        display: grid;
        gap: 0;
        margin: 1.05rem 0 0;
        padding: 0;
        list-style: none;
        counter-reset: zh-ship-step;
        border-block: 1px solid var(--zh-policy-line-soft);
      }

      body.zh-shipping-policy .zh-ship-steps li {
        display: grid;
        grid-template-columns: 1.8rem minmax(0, 1fr);
        gap: 0.78rem;
        align-items: start;
        margin: 0;
        padding: 0.88rem 0;
        border-top: 1px solid var(--zh-policy-line-soft);
        color: var(--zh-policy-soft);
        font-size: 0.96rem;
        line-height: 1.62;
        counter-increment: zh-ship-step;
      }

      body.zh-shipping-policy .zh-ship-steps li:first-child {
        border-top: 0;
      }

      body.zh-shipping-policy .zh-ship-steps li::before {
        content: counter(zh-ship-step, decimal-leading-zero);
        color: var(--zh-policy-clay);
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        line-height: 1.75;
      }

      body.zh-shipping-policy .zh-ship-help {
        max-width: 700px;
        margin: clamp(0.4rem, 1vw, 0.7rem) 0 0 auto;
        padding-top: clamp(1.05rem, 2vw, 1.4rem);
        border-top: 1px solid var(--zh-policy-line-soft);
        color: #665b53;
        font-size: 0.98rem;
        line-height: 1.72;
      }

      @media (max-width: 899px) {
        body.zh-shipping-policy .shopify-policy__container {
          width: min(100%, 780px);
          padding-top: clamp(2.1rem, 5.8vw, 3.05rem);
          padding-bottom: clamp(4.4rem, 8vw, 5.7rem);
        }

        body.zh-shipping-policy .zh-ship-hero {
          grid-template-columns: 1fr;
          gap: clamp(1.45rem, 4vw, 2.1rem);
          padding-bottom: clamp(1.55rem, 4vw, 2.15rem);
        }

        body.zh-shipping-policy .zh-ship-title {
          max-width: 12ch;
          font-size: clamp(2.05rem, 7.4vw, 2.7rem);
        }

        body.zh-shipping-policy .zh-ship-intro {
          max-width: 620px;
          font-size: 1rem;
          line-height: 1.66;
        }

        body.zh-shipping-policy .zh-ship-summary {
          max-width: 640px;
          margin-top: 0;
          padding-top: 1rem;
        }

        body.zh-shipping-policy .zh-ship-summary-row {
          grid-template-columns: minmax(110px, 0.36fr) minmax(0, 1fr);
          padding: 0.68rem 0;
        }

        body.zh-shipping-policy .zh-ship-section {
          grid-template-columns: 1fr;
          gap: 0.75rem;
          padding: clamp(1.45rem, 4vw, 2rem) 0;
        }

        body.zh-shipping-policy .zh-ship-section h2 {
          max-width: 16ch;
          font-size: clamp(1.22rem, 3.4vw, 1.42rem);
        }

        body.zh-shipping-policy .zh-ship-section-body {
          max-width: 650px;
        }

        body.zh-shipping-policy .zh-ship-help {
          margin-left: 0;
        }
      }

      @media (max-width: 639px) {
        body.zh-shipping-policy .shopify-policy__container {
          padding-top: 2rem;
          padding-inline: 1.15rem;
        }

        body.zh-shipping-policy .zh-ship-eyebrow {
          gap: 0.72rem;
          margin-bottom: 0.82rem;
          font-size: 0.6rem;
          letter-spacing: 0.12em;
        }

        body.zh-shipping-policy .zh-ship-eyebrow::before {
          width: 28px;
        }

        body.zh-shipping-policy .zh-ship-title {
          font-size: clamp(1.98rem, 10.2vw, 2.42rem);
          line-height: 1.06;
        }

        body.zh-shipping-policy .zh-ship-intro {
          margin-top: 0.92rem;
          font-size: 0.965rem;
          line-height: 1.65;
        }

        body.zh-shipping-policy .zh-ship-summary {
          padding-top: 0.95rem;
        }

        body.zh-shipping-policy .zh-ship-summary h2 {
          margin-bottom: 0.72rem;
          font-size: 0.62rem;
          letter-spacing: 0.13em;
        }

        body.zh-shipping-policy .zh-ship-summary-row {
          grid-template-columns: 1fr;
          gap: 0.16rem;
          padding: 0.72rem 0;
        }

        body.zh-shipping-policy .zh-ship-summary dt {
          font-size: 0.77rem;
        }

        body.zh-shipping-policy .zh-ship-summary dd {
          font-size: 0.91rem;
        }

        body.zh-shipping-policy .zh-ship-sections {
          margin-top: 1.35rem;
        }

        body.zh-shipping-policy .zh-ship-section {
          padding: 1.42rem 0;
        }

        body.zh-shipping-policy .zh-ship-section h2 {
          font-size: 1.2rem;
        }

        body.zh-shipping-policy .zh-ship-section-body p,
        body.zh-shipping-policy .zh-ship-steps li,
        body.zh-shipping-policy .zh-ship-help {
          font-size: 0.94rem;
          line-height: 1.66;
        }

        body.zh-shipping-policy .zh-ship-steps li {
          grid-template-columns: 1.55rem minmax(0, 1fr);
          gap: 0.62rem;
          padding: 0.8rem 0;
        }
      }

      @media (min-width: 900px) and (max-width: 1120px) {
        body.zh-shipping-policy .shopify-policy__container {
          width: min(100%, 980px);
          padding-inline: clamp(1.75rem, 4.2vw, 3rem);
        }

        body.zh-shipping-policy .zh-ship-hero {
          grid-template-columns: minmax(0, 1fr) minmax(260px, 330px);
          gap: clamp(2rem, 4vw, 3.25rem);
        }

        body.zh-shipping-policy .zh-ship-title {
          font-size: clamp(2.4rem, 4.3vw, 3rem);
        }

        body.zh-shipping-policy .zh-ship-section {
          grid-template-columns: minmax(160px, 205px) minmax(0, 1fr);
          gap: clamp(1.4rem, 3.2vw, 2.45rem);
        }
      }
    {% endstyle %}

    <script src="{{ 'theme.js' | asset_url | append: '?zh=5' }}" defer></script>
  </head>
  <body class="min-h-dvh font-sans text-ink antialiased{% if request.path contains '/policies/shipping-policy' %} zh-shipping-policy{% endif %}">
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-4 focus:py-2 focus:text-ink focus:shadow" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- capture mobile_body -%}{% render 'mobile-menu' %}{%- endcapture -%}
    {% render 'aside', type: 'mobile', heading: shop.name, aside_body: mobile_body %}

    {%- capture search_heading -%}{{ 'general.search.title' | t }}{%- endcapture -%}
    {%- capture search_body -%}
      <div class="zayna-search-panel">
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="zayna-search-form"
          data-predictive-form
          data-predictive-url="{{ routes.predictive_search_url }}"
          data-min-chars="2"
        >
          <label class="sr-only" for="ZaynaSearchInput">
            {{ 'general.search.title' | t }}
          </label>

          <div class="zayna-search-field">
            <span
              aria-hidden="true"
              class="zayna-search-icon"
            >
              {% render 'icon', name: 'search', size: 20 %}
            </span>

            <input
              id="ZaynaSearchInput"
              type="search"
              name="q"
              data-predictive-input
              data-aside-autofocus
              placeholder="{{ 'general.search.placeholder' | t }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
              enterkeyhint="search"
              role="combobox"
              aria-autocomplete="list"
              aria-controls="ZaynaPredictiveResults"
              aria-expanded="false"
              class="zayna-search-input"
            >
          </div>

          <input type="hidden" name="type" value="product,page,article">

          <button
            type="submit"
            class="zayna-search-submit"
          >
            {{ 'general.search.submit' | t }}
          </button>
        </form>

        <div
          id="ZaynaPredictiveResults"
          class="zayna-search-results"
          data-predictive-results
          aria-live="polite"
          aria-atomic="false"
        >
          <p class="text-sm text-ink-soft">
            {{ 'general.search.start_typing' | t }}
          </p>
        </div>
      </div>
    {%- endcapture -%}
    {% render 'aside', type: 'search', heading: search_heading, aside_body: search_body %}

    {% style %}
      [data-aside="search"] {
        --zh-search-bg: #fffdfb;
        --zh-search-ink: #2a2520;
        --zh-search-soft: #625951;
        --zh-search-muted: #857a71;
        --zh-search-border: rgba(42, 37, 32, 0.10);
        --zh-search-border-strong: rgba(42, 37, 32, 0.16);
        --zh-search-cream: #f3ece4;
        --zh-search-clay: #96613f;
        --zh-search-added: #efe5dc;
      }

      [data-aside="search"] .zayna-search-panel {
        padding: 16px 18px 26px;
      }

      [data-aside="search"] .zayna-search-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 10px;
        width: 100%;
      }

      [data-aside="search"] .zayna-search-field {
        display: flex;
        min-width: 0;
        min-height: 48px;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--zh-search-border-strong);
        transition: border-color 180ms ease;
      }

      [data-aside="search"] .zayna-search-field:focus-within {
        border-color: var(--zh-search-clay);
      }

      [data-aside="search"] .zayna-search-icon {
        display: inline-flex;
        flex: 0 0 auto;
        color: var(--zh-search-muted);
        transition: color 180ms ease;
      }

      [data-aside="search"] .zayna-search-field:focus-within .zayna-search-icon {
        color: var(--zh-search-clay);
      }

      [data-aside="search"] .zayna-search-input {
        width: 100%;
        min-width: 0;
        min-height: 46px;
        padding: 11px 0;
        border: 0;
        outline: 0;
        background: transparent;
        color: var(--zh-search-ink);
        font-size: 16px;
        line-height: 1.4;
        -webkit-appearance: none;
        appearance: none;
      }

      [data-aside="search"] .zayna-search-input::placeholder {
        color: #81776f;
        opacity: 1;
      }

      [data-aside="search"] .zayna-search-submit {
        display: none;
        width: 100%;
        min-height: 42px;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: 1px solid var(--zh-search-border-strong);
        background: transparent;
        color: var(--zh-search-ink);
        font-size: 10px;
        font-weight: 500;
        line-height: 1;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        cursor: pointer;
        transition:
          background-color 180ms ease,
          border-color 180ms ease,
          color 180ms ease;
      }

      [data-aside="search"] .zayna-search-submit:hover {
        border-color: rgba(42, 37, 32, 0.30);
        background: rgba(42, 37, 32, 0.92);
        color: #fffdfb;
      }

      [data-aside="search"] .zayna-search-submit:focus-visible {
        outline: 2px solid var(--zh-search-clay);
        outline-offset: 3px;
      }

      [data-aside="search"] .zayna-search-results {
        margin-top: 15px;
      }

      [data-aside="search"] .zayna-search-results.is-refreshing .zh-predictive-results {
        opacity: 0.58;
        transition: opacity 140ms ease;
      }

      [data-aside="search"] .zayna-search-results a,
      [data-aside="search"] .zayna-search-results button {
        -webkit-tap-highlight-color: transparent;
      }

      [data-aside="search"] .zayna-search-results a {
        cursor: pointer;
      }

      [data-aside="search"] .zayna-search-results a:focus-visible,
      [data-aside="search"] .zayna-search-results button:focus-visible {
        outline: 2px solid var(--zh-search-clay);
        outline-offset: 3px;
      }

      [data-aside="search"] .zh-predictive-results__stack {
        display: grid;
        gap: 18px;
      }

      [data-aside="search"] .zh-search-section__heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 7px;
      }

      [data-aside="search"] .zh-search-section__heading span:first-child {
        color: #90867d;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.20em;
        line-height: 1;
        text-transform: uppercase;
      }

      [data-aside="search"] .zh-search-section__heading span:last-child {
        height: 1px;
        flex: 1 1 auto;
        background: var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-products,
      [data-aside="search"] .zh-search-link-list {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-product__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: center;
        gap: 9px;
        padding: 9px 0;
        border-bottom: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-product__main {
        display: flex;
        min-width: 0;
        align-items: center;
        gap: 10px;
        color: inherit;
        text-decoration: none;
      }

      [data-aside="search"] .zh-search-product__image-wrap,
      [data-aside="search"] .zh-search-link-row__image-wrap {
        display: block;
        flex: 0 0 auto;
        overflow: hidden;
        background: var(--zh-search-cream);
      }

      [data-aside="search"] .zh-search-product__image-wrap {
        width: 58px;
        height: 58px;
        border: 1px solid rgba(42, 37, 32, 0.055);
      }

      [data-aside="search"] .zh-search-product__image,
      [data-aside="search"] .zh-search-link-row__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      [data-aside="search"] .zh-search-product__copy {
        display: grid;
        min-width: 0;
        gap: 3px;
      }

      [data-aside="search"] .zh-search-product__title {
        display: -webkit-box;
        overflow: hidden;
        color: var(--zh-search-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: 14.25px;
        line-height: 1.18;
        letter-spacing: -0.012em;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        transition: color 180ms ease;
      }

      [data-aside="search"] .zh-search-product__main:hover .zh-search-product__title {
        color: var(--zh-search-clay);
      }

      [data-aside="search"] .zh-search-product__price {
        color: var(--zh-search-soft);
        font-size: 12.25px;
        font-variant-numeric: tabular-nums;
        line-height: 1.2;
      }

      [data-aside="search"] .zh-search-product__status {
        color: var(--zh-search-muted);
        font-size: 11.5px;
        line-height: 1.25;
      }

      [data-aside="search"] .zh-search-product__action {
        display: flex;
        justify-content: flex-end;
      }

      [data-aside="search"] .zh-search-product__form {
        margin: 0;
      }

      [data-aside="search"] .zh-search-product__button {
        display: inline-flex;
        min-width: 74px;
        min-height: 31px;
        align-items: center;
        justify-content: center;
        gap: 0;
        padding: 0 10px;
        border: 1px solid rgba(42, 37, 32, 0.13);
        background: rgba(255, 253, 251, 0.62);
        color: var(--zh-search-ink);
        font-size: 11px;
        font-weight: 400;
        letter-spacing: 0.01em;
        line-height: 1;
        text-align: center;
        text-decoration: none;
        text-transform: none;
        white-space: nowrap;
        cursor: pointer;
        transition:
          background-color 180ms ease,
          border-color 180ms ease,
          color 180ms ease,
          opacity 180ms ease;
      }

      [data-aside="search"] .zh-search-product__button:hover {
        border-color: rgba(150, 97, 63, 0.24);
        background: rgba(244, 238, 232, 0.72);
        color: #2a2520;
      }

      [data-aside="search"] .zh-search-product__button[disabled] {
        cursor: wait;
        opacity: 0.72;
      }

      [data-aside="search"] .zh-search-product__button.is-added {
        border-color: rgba(159, 99, 61, 0.26);
        background: var(--zh-search-added);
        color: #5f554d;
      }

      [data-aside="search"] .zh-search-product__button.is-error {
        border-color: rgba(178, 58, 72, 0.28);
        background: rgba(178, 58, 72, 0.06);
        color: #8c3c43;
      }

      [data-aside="search"] .zh-search-product__button--option {
        border-color: rgba(150, 97, 63, 0.20);
        color: #704a33;
      }

      [data-aside="search"] .zh-search-product__button--sold {
        justify-content: center;
        border-color: rgba(42, 37, 32, 0.10);
        color: #9a8f85;
        cursor: default;
      }

      [data-aside="search"] .zh-search-product__button--sold:hover {
        border-color: rgba(42, 37, 32, 0.10);
        background: transparent;
        color: #9a8f85;
      }

      [data-aside="search"] .zh-search-link-row {
        display: flex;
        min-height: 64px;
        align-items: center;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid var(--zh-search-border);
        color: inherit;
        text-decoration: none;
      }

      [data-aside="search"] .zh-search-link-row--text {
        min-height: 48px;
      }

      [data-aside="search"] .zh-search-link-row__image-wrap {
        width: 56px;
        height: 56px;
      }

      [data-aside="search"] .zh-search-link-row__title {
        min-width: 0;
        flex: 1 1 auto;
        overflow: hidden;
        color: var(--zh-search-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: 14.5px;
        line-height: 1.22;
        text-overflow: ellipsis;
        white-space: nowrap;
        transition: color 180ms ease;
      }

      [data-aside="search"] .zh-search-link-row:hover .zh-search-link-row__title {
        color: var(--zh-search-clay);
      }

      [data-aside="search"] .zh-search-link-row__arrow {
        flex: 0 0 auto;
        color: #9d9288;
        font-size: 13px;
      }

      [data-aside="search"] .zh-search-view-all,
      [data-aside="search"] .zh-search-empty-state__link {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 0 15px;
        border: 1px solid rgba(159, 99, 61, 0.24);
        background: rgba(244, 238, 232, 0.60);
        color: #704a33;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.14em;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
      }

      [data-aside="search"] .zh-search-view-all {
        width: 100%;
      }

      [data-aside="search"] .zh-search-empty-state,
      [data-aside="search"] .zh-search-message,
      [data-aside="search"] .zh-search-status {
        padding: 28px 8px;
        text-align: center;
      }

      [data-aside="search"] .zh-search-empty-state__title,
      [data-aside="search"] .zh-search-message__title {
        margin: 0;
        color: var(--zh-search-ink);
        font-family: var(--font-display, Georgia, serif);
        font-size: 18.5px;
        line-height: 1.18;
      }

      [data-aside="search"] .zh-search-empty-state__text,
      [data-aside="search"] .zh-search-message__text,
      [data-aside="search"] .zh-search-status {
        margin: 8px auto 0;
        max-width: 32ch;
        color: var(--zh-search-soft);
        font-size: 14px;
        line-height: 1.58;
      }

      [data-aside="search"] .zh-search-empty-state__link {
        margin-top: 15px;
      }

      [data-aside="search"] .zh-search-empty-state__choices {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
        width: min(100%, 310px);
        margin: 18px auto 0;
      }

      [data-aside="search"] .zh-search-empty-state__choice {
        display: inline-flex;
        min-height: 40px;
        align-items: center;
        justify-content: center;
        padding: 0 14px;
        border: 1px solid rgba(150, 97, 63, 0.22);
        background: rgba(244, 238, 232, 0.58);
        color: #704a33;
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.12em;
        line-height: 1;
        text-decoration: none;
        text-transform: uppercase;
      }

      [data-aside="search"] .zh-search-empty-state__choice:hover {
        border-color: rgba(42, 37, 32, 0.30);
        background: rgba(42, 37, 32, 0.92);
        color: #fffdfb;
      }

      [data-aside="search"] .zh-search-skeleton {
        display: grid;
        gap: 12px;
      }

      [data-aside="search"] .zh-search-skeleton__label {
        display: block;
        width: 112px;
        height: 10px;
        background: rgba(42, 37, 32, 0.08);
      }

      [data-aside="search"] .zh-search-skeleton ul {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
        border-top: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-skeleton__row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 0;
        border-bottom: 1px solid var(--zh-search-border);
      }

      [data-aside="search"] .zh-search-skeleton__image {
        width: 58px;
        height: 58px;
        flex: 0 0 auto;
        background: rgba(42, 37, 32, 0.07);
      }

      [data-aside="search"] .zh-search-skeleton__copy {
        display: grid;
        flex: 1 1 auto;
        gap: 9px;
      }

      [data-aside="search"] .zh-search-skeleton__line {
        display: block;
        height: 10px;
        background: rgba(42, 37, 32, 0.07);
      }

      [data-aside="search"] .zh-search-skeleton__line--wide {
        width: 78%;
      }

      [data-aside="search"] .zh-search-skeleton__line--short {
        width: 42%;
      }

      [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__label,
      [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__image,
      [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__line {
        animation: zhSearchPulse 1.45s ease-in-out infinite;
      }

      @keyframes zhSearchPulse {
        0%, 100% { opacity: 0.34; }
        50% { opacity: 0.62; }
      }

      @media (max-width: 374px) {
        [data-aside="search"] .zh-search-product__inner {
          grid-template-columns: minmax(0, 1fr);
        }

        [data-aside="search"] .zh-search-product__action {
          justify-content: stretch;
          padding-left: 70px;
        }

        [data-aside="search"] .zh-search-product__button,
        [data-aside="search"] .zh-search-product__form {
          width: 100%;
        }
      }

      @media (max-width: 759px) {
        [data-aside="search"] .zayna-search-submit {
          display: none !important;
        }

        [data-aside="search"] .zayna-search-form {
          gap: 0;
        }

        [data-aside="search"] .zh-search-product__button:hover {
          border-color: rgba(42, 37, 32, 0.13);
          background: rgba(255, 253, 251, 0.62);
          color: var(--zh-search-ink);
        }

        [data-aside="search"] .zh-search-product__button.is-added:hover {
          border-color: rgba(159, 99, 61, 0.26);
          background: var(--zh-search-added);
          color: #5f554d;
        }
      }

      @media (min-width: 760px) {
        [data-aside="search"] .zayna-search-panel {
          padding-right: 24px;
          padding-left: 24px;
        }

        [data-aside="search"] .zayna-search-form {
          grid-template-columns: minmax(0, 1fr) auto;
          align-items: end;
        }

        [data-aside="search"] .zayna-search-submit {
          display: inline-flex;
          width: auto;
          min-width: 112px;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        [data-aside="search"] .zayna-search-field,
        [data-aside="search"] .zayna-search-icon,
        [data-aside="search"] .zayna-search-submit,
        [data-aside="search"] .zh-search-product__button,
        [data-aside="search"] .zh-search-link-row__title,
        [data-aside="search"] .zh-search-product__title {
          transition: none;
        }

        [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__label,
        [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__image,
        [data-aside="search"] .zh-search-skeleton.is-animated .zh-search-skeleton__line {
          animation: none;
        }
      }
    {% endstyle %}

    <script src="{{ 'search.js' | asset_url | append: '?zh=8' }}" defer></script>

    {% section 'cart-drawer' %}
  </body>
</html>