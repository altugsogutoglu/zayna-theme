<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#FAF5F2">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    <title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'tailwind.css' | asset_url }}">
  </head>
  <body class="min-h-dvh font-sans text-ink antialiased">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
