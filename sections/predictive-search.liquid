{%- liquid
  assign res = predictive_search.resources
  assign products = res.products
  assign collections = res.collections
  assign pages = res.pages
  assign articles = res.articles
  assign term = predictive_search.terms
  assign total = 0
  assign total = total | plus: products.size | plus: collections.size | plus: pages.size | plus: articles.size
-%}
<div data-predictive-results-list class="zh-predictive-results">
  {%- if predictive_search.performed and total == 0 -%}
    <div class="zh-search-empty-state">
      <p class="zh-search-empty-state__title">{{ 'general.search.no_results' | t }}</p>
      <p class="zh-search-empty-state__text">We vonden niets voor &ldquo;{{ term }}&rdquo;. Probeer een andere zoekterm, zoals glas, potten of olieflessen.</p>
      <a href="{{ routes.all_products_collection_url }}" class="zh-search-empty-state__link">
        Bekijk alle producten
      </a>
    </div>
  {%- else -%}
    <div class="zh-predictive-results__stack">
      {%- if products.size > 0 -%}
        <section class="zh-search-section" aria-label="Producten">
          <div class="zh-search-section__heading">
            <span>{{ 'general.search.products' | t }}</span>
            <span aria-hidden="true"></span>
          </div>

          <ul class="zh-search-products">
            {%- for product in products -%}
              {%- liquid
                assign quick_variant = product.selected_or_first_available_variant
                assign can_search_add = false

                if product.available and product.has_only_default_variant and quick_variant != blank and quick_variant.available
                  assign can_search_add = true
                endif

                assign price_label = ''
                if product.price_varies and product.price_min > 0
                  capture price_label
                    echo 'Vanaf '
                    echo product.price_min | money
                  endcapture
                elsif product.price and product.price > 0
                  capture price_label
                    echo product.price | money
                  endcapture
                elsif product.price_min and product.price_min > 0
                  capture price_label
                    echo product.price_min | money
                  endcapture
                endif

                assign product_status = ''
                unless product.available
                  assign product_status = 'Tijdelijk niet beschikbaar'
                endunless
              -%}

              <li class="zh-search-product">
                <div class="zh-search-product__inner">
                  <a
                    href="{{ product.url }}"
                    data-predictive-link
                    class="zh-search-product__main"
                    aria-label="Bekijk {{ product.title | escape }}"
                  >
                    <span class="zh-search-product__image-wrap">
                      {%- if product.featured_image -%}
                        {%- assign p_alt = product.featured_image.alt | default: product.title -%}
                        {{ product.featured_image | image_url: width: 160, format: 'webp' | image_tag: loading: 'lazy', width: 64, height: 64, alt: p_alt, class: 'zh-search-product__image' }}
                      {%- endif -%}
                    </span>

                    <span class="zh-search-product__copy">
                      <span class="zh-search-product__title">
                        {{ product.title }}
                      </span>

                      {%- if price_label != blank -%}
                        <span class="zh-search-product__price">
                          {{ price_label | strip }}
                        </span>
                      {%- endif -%}

                      {%- if product_status != blank -%}
                        <span class="zh-search-product__status">
                          {{ product_status }}
                        </span>
                      {%- endif -%}
                    </span>
                  </a>

                  <div class="zh-search-product__action">
                    {%- if can_search_add -%}
                      <form
                        method="post"
                        action="{{ routes.cart_add_url }}"
                        data-cart-add-form
                        data-search-add
                        data-cart-add-behavior="silent"
                        data-product-title="{{ product.title | escape }}"
                        class="zh-search-product__form"
                      >
                        <input type="hidden" name="id" value="{{ quick_variant.id }}">
                        <input type="hidden" name="quantity" value="1">

                        <button
                          type="submit"
                          class="zh-search-product__button"
                          data-cart-add-button
                          aria-label="Voeg {{ product.title | escape }} toe aan je winkelmand"
                        >
                          <span data-cart-add-label>Toevoegen</span>
                        </button>
                      </form>
                    {%- elsif product.available -%}
                      <a
                        href="{{ product.url }}"
                        class="zh-search-product__button zh-search-product__button--option"
                        aria-label="Kies optie voor {{ product.title | escape }}"
                      >
                        <span>Kies optie</span>
                      </a>
                    {%- else -%}
                      <span
                        class="zh-search-product__button zh-search-product__button--sold"
                        aria-disabled="true"
                      >
                        Uitverkocht
                      </span>
                    {%- endif -%}
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if collections.size > 0 -%}
        <section class="zh-search-section" aria-label="Collecties">
          <div class="zh-search-section__heading">
            <span>{{ 'general.search.collections' | t }}</span>
            <span aria-hidden="true"></span>
          </div>
          <ul class="zh-search-link-list">
            {%- for collection in collections -%}
              <li>
                <a href="{{ collection.url }}" data-predictive-link class="zh-search-link-row">
                  <span class="zh-search-link-row__image-wrap">
                    {%- if collection.featured_image -%}
                      {%- assign c_alt = collection.featured_image.alt | default: collection.title -%}
                      {{ collection.featured_image | image_url: width: 128, format: 'webp' | image_tag: loading: 'lazy', width: 56, height: 56, alt: c_alt, class: 'zh-search-link-row__image' }}
                    {%- endif -%}
                  </span>
                  <span class="zh-search-link-row__title">{{ collection.title }}</span>
                  <span class="zh-search-link-row__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if pages.size > 0 -%}
        <section class="zh-search-section" aria-label="Pagina’s">
          <div class="zh-search-section__heading">
            <span>{{ 'general.search.pages' | t }}</span>
            <span aria-hidden="true"></span>
          </div>
          <ul class="zh-search-link-list">
            {%- for page in pages -%}
              <li>
                <a href="{{ page.url }}" data-predictive-link class="zh-search-link-row zh-search-link-row--text">
                  <span class="zh-search-link-row__title">{{ page.title }}</span>
                  <span class="zh-search-link-row__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if articles.size > 0 -%}
        <section class="zh-search-section" aria-label="Artikelen">
          <div class="zh-search-section__heading">
            <span>{{ 'general.search.articles' | t }}</span>
            <span aria-hidden="true"></span>
          </div>
          <ul class="zh-search-link-list">
            {%- for article in articles -%}
              <li>
                <a href="{{ article.url }}" data-predictive-link class="zh-search-link-row">
                  <span class="zh-search-link-row__image-wrap">
                    {%- if article.image -%}
                      {%- assign a_alt = article.image.alt | default: article.title -%}
                      {{ article.image | image_url: width: 128, format: 'webp' | image_tag: loading: 'lazy', width: 56, height: 56, alt: a_alt, class: 'zh-search-link-row__image' }}
                    {%- endif -%}
                  </span>
                  <span class="zh-search-link-row__title">{{ article.title }}</span>
                  <span class="zh-search-link-row__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </section>
      {%- endif -%}

      {%- if total > 0 and term != blank -%}
        <a href="{{ routes.search_url }}?q={{ term | url_encode }}&type=product,page,article" class="zh-search-view-all">
          <span>Bekijk alle resultaten</span>
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Predictive Search",
  "settings": []
}
{% endschema %}
