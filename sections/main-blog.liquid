{%- paginate blog.articles by: 12 -%}
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-10 py-16">
    <header class="mb-12">
      <p class="text-label text-clay mb-3">{{ section.settings.eyebrow }}</p>
      <h1 class="font-display text-h1">{{ blog.title }}</h1>
    </header>

    {%- if blog.articles.size > 0 -%}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        {%- for article in blog.articles -%}
          {%- liquid
            assign a_alt = article.title
            if article.image.alt != blank
              assign a_alt = article.image.alt
            endif
            assign loading = 'lazy'
            if forloop.index <= 2
              assign loading = 'eager'
            endif
          -%}
          <a href="{{ article.url }}" class="group block transition-soft active:scale-[0.98] focus-visible:outline-none">
            <div class="relative aspect-[3/2] overflow-hidden bg-cream">
              {%- if article.image -%}
                {{ article.image | image_url: width: 900 | image_tag: loading: loading, sizes: '(min-width:768px) 50vw, 100vw', alt: a_alt, class: 'h-full w-full object-cover transition-soft group-hover:scale-[1.02]' }}
              {%- endif -%}
            </div>
            <p class="mt-4 text-label text-ink-soft">{{ article.published_at | date: '%-d %B %Y' }}</p>
            <h2 class="mt-2 font-display text-h2">{{ article.title }}</h2>
            {%- if article.excerpt != blank -%}
              <p class="mt-3 text-ink-soft line-clamp-3">{{ article.excerpt | strip_html }}</p>
            {%- endif -%}
          </a>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="mt-16 flex items-center justify-between border-t border-border-soft pt-8 text-xs uppercase tracking-[0.16em] text-ink-soft" aria-label="{{ section.settings.eyebrow }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="inline-flex items-center gap-2 hover:text-ink transition-colors">
              {% render 'icon', name: 'chevron-left', size: 16 %}{{ section.settings.previous_label }}
            </a>
          {%- else -%}
            <span></span>
          {%- endif -%}
          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="inline-flex items-center gap-2 hover:text-ink transition-colors">
              {{ section.settings.next_label }}{% render 'icon', name: 'chevron-right', size: 16 %}
            </a>
          {%- else -%}
            <span></span>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- else -%}
      <p class="text-ink-soft">{{ section.settings.empty_text }}</p>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog posts",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "previous_label", "label": "Previous label", "default": "Vorige" },
    { "type": "text", "id": "next_label", "label": "Next label", "default": "Volgende" },
    { "type": "text", "id": "empty_text", "label": "Empty state", "default": "Er zijn nog geen artikelen." }
  ]
}
{% endschema %}
