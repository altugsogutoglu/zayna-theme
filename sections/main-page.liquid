{%- liquid
  assign is_about = false
  assign normalized_title = page.title | downcase

  if page.handle == 'about' or page.handle == 'over-ons' or page.template_suffix == 'about' or page.template_suffix == 'over-ons'
    assign is_about = true
  endif

  if normalized_title contains 'over ons'
    assign is_about = true
  endif

  assign eyebrow = section.settings.eyebrow
-%}

{%- if is_about -%}
  {%- liquid
    assign about_title = section.settings.about_title
    if about_title == blank
      assign about_title = page.title
    endif

    assign cta_link = section.settings.cta_link
    if cta_link == blank
      assign cta_link = '/collections'
    endif
  -%}

  <section id="zh-about-{{ section.id }}" class="zh-about" aria-labelledby="zh-about-title-{{ section.id }}">
    <div class="zh-about__shell">
      <header class="zh-about__hero">
        {%- if section.settings.about_eyebrow != blank -%}
          <p class="zh-about__eyebrow">{{ section.settings.about_eyebrow }}</p>
        {%- endif -%}

        <h1 id="zh-about-title-{{ section.id }}" class="zh-about__title font-display">{{ about_title }}</h1>

        {%- if section.settings.about_intro != blank -%}
          <p class="zh-about__lead">{{ section.settings.about_intro }}</p>
        {%- endif -%}
      </header>

      <div class="zh-about__body">
        <div class="zh-about__story">
          {%- if section.settings.story_title != blank -%}
            <h2 class="font-display">{{ section.settings.story_title }}</h2>
          {%- endif -%}

          <div class="zh-about__copy">
            {%- if section.settings.story_text_1 != blank -%}
              <p>{{ section.settings.story_text_1 }}</p>
            {%- endif -%}

            {%- if section.settings.story_text_2 != blank -%}
              <p>{{ section.settings.story_text_2 }}</p>
            {%- endif -%}
          </div>
        </div>

        <aside class="zh-about__notes" aria-labelledby="zh-about-notes-title-{{ section.id }}">
          {%- if section.settings.notes_title != blank -%}
            <h2 id="zh-about-notes-title-{{ section.id }}">{{ section.settings.notes_title }}</h2>
          {%- endif -%}

          <ul class="zh-about__list" role="list">
            {%- if section.settings.note_1_title != blank or section.settings.note_1_text != blank -%}
              <li>
                <span>{{ section.settings.note_1_title }}</span>
                <p>{{ section.settings.note_1_text }}</p>
              </li>
            {%- endif -%}

            {%- if section.settings.note_2_title != blank or section.settings.note_2_text != blank -%}
              <li>
                <span>{{ section.settings.note_2_title }}</span>
                <p>{{ section.settings.note_2_text }}</p>
              </li>
            {%- endif -%}

            {%- if section.settings.note_3_title != blank or section.settings.note_3_text != blank -%}
              <li>
                <span>{{ section.settings.note_3_title }}</span>
                <p>{{ section.settings.note_3_text }}</p>
              </li>
            {%- endif -%}

            {%- if section.settings.note_4_title != blank or section.settings.note_4_text != blank -%}
              <li>
                <span>{{ section.settings.note_4_title }}</span>
                <p>{{ section.settings.note_4_text }}</p>
              </li>
            {%- endif -%}
          </ul>
        </aside>
      </div>

      <footer class="zh-about__closing">
        {%- if section.settings.closing_text != blank -%}
          <p>{{ section.settings.closing_text }}</p>
        {%- endif -%}

        {%- if section.settings.cta_text != blank -%}
          <a href="{{ cta_link }}" class="zh-about__cta">{{ section.settings.cta_text }}</a>
        {%- endif -%}
      </footer>
    </div>
  </section>

  <style>
    #zh-about-{{ section.id }} {
      padding: clamp(3.1rem, 7vw, 6.25rem) 0 clamp(4rem, 8vw, 7rem);
    }

    #zh-about-{{ section.id }} .zh-about__shell {
      width: min(100%, 72rem);
      margin: 0 auto;
      padding: 0 clamp(1.25rem, 4vw, 4rem);
    }

    #zh-about-{{ section.id }} .zh-about__hero {
      max-width: 46rem;
    }

    #zh-about-{{ section.id }} .zh-about__eyebrow {
      margin: 0 0 1rem;
      color: rgba(39, 33, 29, 0.52);
      font-size: 0.68rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    #zh-about-{{ section.id }} .zh-about__title {
      margin: 0;
      color: #27211d;
      font-size: clamp(2.35rem, 7vw, 4.55rem);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.045em;
    }

    #zh-about-{{ section.id }} .zh-about__lead {
      max-width: 40rem;
      margin: 1.3rem 0 0;
      color: rgba(39, 33, 29, 0.72);
      font-size: clamp(1.02rem, 1.28vw, 1.18rem);
      line-height: 1.78;
      letter-spacing: 0.001em;
    }

    #zh-about-{{ section.id }} .zh-about__body {
      display: grid;
      gap: clamp(2.65rem, 5vw, 4.7rem);
      margin-top: clamp(3.25rem, 6vw, 5.4rem);
      padding-top: clamp(2.35rem, 4vw, 3.35rem);
      border-top: 1px solid rgba(39, 33, 29, 0.1);
    }

    #zh-about-{{ section.id }} .zh-about__story h2 {
      max-width: 35rem;
      margin: 0;
      color: #27211d;
      font-size: clamp(1.72rem, 3vw, 2.55rem);
      font-weight: 400;
      line-height: 1.06;
      letter-spacing: -0.035em;
    }

    #zh-about-{{ section.id }} .zh-about__copy {
      max-width: 39.5rem;
      margin-top: 1.45rem;
    }

    #zh-about-{{ section.id }} .zh-about__copy p,
    #zh-about-{{ section.id }} .zh-about__closing p {
      margin: 0;
      color: rgba(39, 33, 29, 0.7);
      font-size: 0.98rem;
      line-height: 1.82;
    }

    #zh-about-{{ section.id }} .zh-about__copy p + p {
      margin-top: 1rem;
    }

    #zh-about-{{ section.id }} .zh-about__notes {
      max-width: 32rem;
    }

    #zh-about-{{ section.id }} .zh-about__notes h2 {
      margin: 0 0 0.15rem;
      color: rgba(39, 33, 29, 0.58);
      font-size: 0.72rem;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    #zh-about-{{ section.id }} .zh-about__list {
      margin: 1.15rem 0 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid rgba(39, 33, 29, 0.09);
    }

    #zh-about-{{ section.id }} .zh-about__list li {
      display: grid;
      gap: 0.45rem;
      padding: 1rem 0 1.05rem;
      border-bottom: 1px solid rgba(39, 33, 29, 0.09);
    }

    #zh-about-{{ section.id }} .zh-about__list span {
      color: #27211d;
      font-size: 0.96rem;
      font-weight: 500;
      line-height: 1.35;
    }

    #zh-about-{{ section.id }} .zh-about__list p {
      margin: 0;
      color: rgba(39, 33, 29, 0.62);
      font-size: 0.92rem;
      line-height: 1.68;
    }

    #zh-about-{{ section.id }} .zh-about__closing {
      max-width: 40rem;
      margin-top: clamp(2.8rem, 5.2vw, 4.65rem);
    }

    #zh-about-{{ section.id }} .zh-about__cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      margin-top: 1.35rem;
      padding: 0.78rem 1.02rem;
      border: 1px solid rgba(39, 33, 29, 0.16);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.22);
      color: #27211d;
      font-size: 0.9rem;
      line-height: 1.2;
      text-decoration: none;
      transition: border-color 180ms ease, background-color 180ms ease, opacity 180ms ease;
    }

    #zh-about-{{ section.id }} .zh-about__cta:hover {
      border-color: rgba(39, 33, 29, 0.28);
      background: rgba(255, 255, 255, 0.36);
      opacity: 0.88;
    }

    @media screen and (min-width: 750px) {
      #zh-about-{{ section.id }} .zh-about__lead {
        margin-top: 1.45rem;
      }

      #zh-about-{{ section.id }} .zh-about__list li {
        grid-template-columns: minmax(9.5rem, 0.7fr) minmax(0, 1.3fr);
        gap: 1.2rem;
        align-items: start;
      }
    }

    @media screen and (min-width: 990px) {
      #zh-about-{{ section.id }} .zh-about__body {
        grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.72fr);
        align-items: start;
        gap: clamp(4rem, 7vw, 7.25rem);
      }

      #zh-about-{{ section.id }} .zh-about__notes {
        max-width: none;
        padding-left: clamp(2rem, 3.2vw, 3.4rem);
        border-left: 1px solid rgba(39, 33, 29, 0.09);
      }

      #zh-about-{{ section.id }} .zh-about__list li {
        grid-template-columns: 1fr;
        gap: 0.45rem;
      }
    }

    @media screen and (min-width: 1200px) {
      #zh-about-{{ section.id }} .zh-about__hero {
        max-width: 48rem;
      }
    }
  </style>
{%- else -%}
  <article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-10 py-16">
    <header class="mb-12">
      {%- if eyebrow != blank -%}
        <p class="text-label text-clay mb-3">{{ eyebrow }}</p>
      {%- endif -%}
      <h1 class="font-display text-h1">{{ page.title }}</h1>
    </header>

    <div class="rich-text">{{ page.content }}</div>
  </article>
{%- endif -%}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow voor gewone pagina's",
      "default": "Pagina"
    },
    {
      "type": "text",
      "id": "about_eyebrow",
      "label": "Over ons label",
      "default": "Zayna Home"
    },
    {
      "type": "text",
      "id": "about_title",
      "label": "Over ons titel",
      "default": "Over ons"
    },
    {
      "type": "textarea",
      "id": "about_intro",
      "label": "Over ons intro",
      "default": "Zayna Home is er voor keuken- en woonproducten die rust brengen in het dagelijks gebruik. Praktisch, zorgvuldig gekozen en mooi genoeg om zichtbaar neer te zetten."
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Verhaaltitel",
      "default": "Mooi wonen begint bij wat je elke dag gebruikt."
    },
    {
      "type": "textarea",
      "id": "story_text_1",
      "label": "Verhaaltekst 1",
      "default": "We geloven dat een huis niet vol hoeft te staan om verzorgd te voelen. Juist de kleine dingen die je dagelijks gebruikt — een glas, voorraadpot, koffiekopje of olieflessen — bepalen de rust in je keuken en op tafel."
    },
    {
      "type": "textarea",
      "id": "story_text_2",
      "label": "Verhaaltekst 2",
      "default": "Daarom kiezen we items met zachte vormen, neutrale tinten en een functionele basis. Niet opvallend om het opvallend zijn, maar rustig genoeg om vanzelf mee te doen in huis."
    },
    {
      "type": "text",
      "id": "notes_title",
      "label": "Lijsttitel",
      "default": "Waar we op letten"
    },
    {
      "type": "text",
      "id": "note_1_title",
      "label": "Punt 1 titel",
      "default": "Rustige uitstraling"
    },
    {
      "type": "textarea",
      "id": "note_1_text",
      "label": "Punt 1 tekst",
      "default": "Zachte vormen, neutrale tinten en materialen die eenvoudig combineren."
    },
    {
      "type": "text",
      "id": "note_2_title",
      "label": "Punt 2 titel",
      "default": "Praktisch in gebruik"
    },
    {
      "type": "textarea",
      "id": "note_2_text",
      "label": "Punt 2 tekst",
      "default": "Producten die logisch voelen in je dagelijkse routine."
    },
    {
      "type": "text",
      "id": "note_3_title",
      "label": "Punt 3 titel",
      "default": "Heldere informatie"
    },
    {
      "type": "textarea",
      "id": "note_3_text",
      "label": "Punt 3 tekst",
      "default": "Duidelijke productdetails zonder overdreven claims."
    },
    {
      "type": "text",
      "id": "note_4_title",
      "label": "Punt 4 titel",
      "default": "Zorgvuldige verzending"
    },
    {
      "type": "textarea",
      "id": "note_4_text",
      "label": "Punt 4 tekst",
      "default": "Verzonden vanuit Nederland, met een nette en beschermende verpakking."
    },
    {
      "type": "textarea",
      "id": "closing_text",
      "label": "Afsluitende tekst",
      "default": "Zo helpt Zayna Home je stap voor stap bouwen aan een rustige basis voor je keuken, tafel en interieur."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Linktekst",
      "default": "Bekijk het assortiment"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Link URL",
      "default": "/collections"
    }
  ]
}
{% endschema %}
