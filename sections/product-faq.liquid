{%- liquid
  assign faqs = product.metafields.custom.goed_om_te_weten.value
  assign visible_faq_count = 0
  assign seen_faq_questions = ''
  assign faq_heading = section.settings.heading | strip

  if faq_heading == blank or faq_heading == 'Veelgestelde vragen'
    assign faq_heading = 'Goed om te weten'
  endif

  if faqs != blank
    for faq in faqs limit: 4
      assign faq_question = faq.vraag.value | strip
      assign faq_answer = faq.antwoord.value | strip
      assign skip_faq = false

      if faq_question == blank or faq_answer == blank
        assign skip_faq = true
      endif

      unless skip_faq
        assign faq_question_key = faq_question | strip_html | downcase | strip | replace: '  ', ' ' | replace: '  ', ' ' | replace: '  ', ' '
        assign faq_question_token = faq_question_key | prepend: '||' | append: '||'

        if seen_faq_questions contains faq_question_token
          assign skip_faq = true
        else
          assign seen_faq_questions = seen_faq_questions | append: faq_question_token
        endif
      endunless

      unless skip_faq
        assign visible_faq_count = visible_faq_count | plus: 1
      endunless
    endfor
  endif
-%}

{%- if visible_faq_count > 0 -%}
  {% style %}
    .zh-product-faq {
      background: #fcfaf7;
    }

    .zh-product-faq__inner {
      width: 100%;
      max-width: 80rem;
      margin: 0 auto;
      padding: 2.75rem 1rem 0;
    }

    .zh-product-faq__content {
      max-width: 58rem;
    }

    .zh-product-faq__eyebrow {
      margin: 0 0 .55rem;
      color: #9b5f35;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .11em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .zh-product-faq__heading {
      margin: 0 0 1.25rem;
      color: #2a2520;
      font-size: clamp(1.25rem, 3.3vw, 1.55rem);
      font-weight: 400;
      line-height: 1.2;
    }

    .zh-product-faq__list {
      border-top: 1px solid #ded5cc;
      border-bottom: 1px solid #ded5cc;
    }

    .zh-product-faq__item {
      border: 0;
    }

    .zh-product-faq__item + .zh-product-faq__item {
      border-top: 1px solid #ded5cc;
    }

    .zh-product-faq__item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 3.25rem;
      padding: .68rem 0;
      color: #2a2520;
      font-size: 1rem;
      line-height: 1.4;
      list-style: none;
      cursor: pointer;
    }

    .zh-product-faq__item summary::-webkit-details-marker {
      display: none;
    }

    .zh-product-faq__item summary {
      cursor: default;
      -webkit-user-select: none;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .zh-product-faq__item summary > * {
      pointer-events: none;
    }

    .zh-product-faq__answer,
    .zh-product-faq__answer * {
      cursor: default;
      -webkit-user-select: none;
      user-select: none;
    }

    .zh-product-faq__item summary:focus-visible {
      outline: 2px solid #9b5f35;
      outline-offset: 3px;
    }

    .zh-product-faq__icon {
      flex: 0 0 auto;
      color: #625a53;
      transition: transform 180ms ease;
    }

    .zh-product-faq__item[open] .zh-product-faq__icon {
      transform: rotate(180deg);
    }

    .zh-product-faq__answer {
      max-width: 45rem;
      padding: 0 2.2rem 1.1rem 0;
      color: #625a53;
      font-size: .9rem;
      line-height: 1.75;
    }

    .zh-product-faq__answer p {
      margin: 0;
      white-space: pre-line;
    }

    @media (min-width: 640px) {
      .zh-product-faq__inner {
        padding: 3rem 1.5rem 0;
      }
    }

    @media (min-width: 1024px) {
      .zh-product-faq__inner {
        padding-right: 2.5rem;
        padding-left: 2.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .zh-product-faq__icon {
        transition: none;
      }
    }
  {% endstyle %}

  <section aria-labelledby="product-faq-heading-{{ section.id }}" class="zh-product-faq">
    <div class="zh-product-faq__inner">
      <div class="zh-product-faq__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zh-product-faq__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 id="product-faq-heading-{{ section.id }}" class="zh-product-faq__heading font-display">
          {{ faq_heading }}
        </h2>

        <div class="zh-product-faq__list">
          {%- assign rendered_faq_count = 0 -%}
          {%- assign rendered_faq_questions = '' -%}

          {%- for faq in faqs limit: 4 -%}
            {%- liquid
              assign faq_question = faq.vraag.value | strip
              assign faq_answer = faq.antwoord.value | strip
              assign skip_faq = false

              if faq_question == blank or faq_answer == blank
                assign skip_faq = true
              endif

              unless skip_faq
                assign faq_question_key = faq_question | strip_html | downcase | strip | replace: '  ', ' ' | replace: '  ', ' ' | replace: '  ', ' '
                assign faq_question_token = faq_question_key | prepend: '||' | append: '||'

                if rendered_faq_questions contains faq_question_token
                  assign skip_faq = true
                else
                  assign rendered_faq_questions = rendered_faq_questions | append: faq_question_token
                endif
              endunless
            -%}

            {%- unless skip_faq -%}
              <details class="zh-product-faq__item">
                <summary class="font-display">
                  <span>{{ faq_question }}</span>
                  {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product-faq__icon' %}
                </summary>

                <div class="zh-product-faq__answer">
                  <p>{{ faq_answer }}</p>
                </div>
              </details>

              {%- assign rendered_faq_count = rendered_faq_count | plus: 1 -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Goed om te weten" }
  ],
  "presets": [{ "name": "Product FAQ" }]
}
{% endschema %}

