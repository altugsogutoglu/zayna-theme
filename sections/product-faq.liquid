{%- liquid
  assign faqs = product.metafields.custom.faqs.value
  assign visible_faq_count = 0
  assign suppress_product_faq = false

  if product.handle == 'set-van-12-vierkante-kruidenpotten-120-ml-incl-labels-trechter-borosilicaat-glas'
    assign suppress_product_faq = true
  endif

  if suppress_product_faq == false and faqs != blank
    for faq in faqs
      assign faq_question = faq.question | downcase | strip
      assign skip_faq = false

      if faq_question contains 'materiaal' or faq_question contains 'waarvan is' or faq_question contains 'inhoud' or faq_question contains 'hoeveel ml' or faq_question contains 'hoeveel liter' or faq_question contains 'afmeting' or faq_question contains 'afmetingen' or faq_question contains 'hoe groot' or faq_question contains 'vaatwasser' or faq_question contains 'magnetron' or faq_question contains 'vriezer' or faq_question contains 'warme en koude' or faq_question contains 'warme dranken' or faq_question contains 'koude dranken' or faq_question contains 'hoeveel stuks' or faq_question contains 'wat wordt meegeleverd' or faq_question contains 'wat zit erbij'
        assign skip_faq = true
      endif

      unless skip_faq
        if visible_faq_count < 4
          assign visible_faq_count = visible_faq_count | plus: 1
        endif
      endunless
    endfor
  endif
-%}

{%- if visible_faq_count > 0 -%}
  {% style %}
    .zh-product-faq {
      background: #fcfaf7;
    }

    .zh-product-faq__inner {
      width: 100%;
      max-width: 80rem;
      margin: 0 auto;
      padding: 2.75rem 1rem 0;
    }

    .zh-product-faq__content {
      max-width: 58rem;
    }

    .zh-product-faq__eyebrow {
      margin: 0 0 .55rem;
      color: #9b5f35;
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .11em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .zh-product-faq__heading {
      margin: 0 0 1.25rem;
      color: #2a2520;
      font-size: clamp(1.45rem, 4vw, 1.9rem);
      font-weight: 400;
      line-height: 1.2;
    }

    .zh-product-faq__list {
      border-top: 1px solid #ded5cc;
      border-bottom: 1px solid #ded5cc;
    }

    .zh-product-faq__item {
      border: 0;
    }

    .zh-product-faq__item + .zh-product-faq__item {
      border-top: 1px solid #ded5cc;
    }

    .zh-product-faq__item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 3.75rem;
      padding: .85rem 0;
      color: #2a2520;
      font-size: 1rem;
      line-height: 1.4;
      list-style: none;
      cursor: pointer;
    }

    .zh-product-faq__item summary::-webkit-details-marker {
      display: none;
    }

    .zh-product-faq__item summary:focus-visible {
      outline: 2px solid #9b5f35;
      outline-offset: 3px;
    }

    .zh-product-faq__icon {
      flex: 0 0 auto;
      color: #625a53;
      transition: transform 180ms ease;
    }

    .zh-product-faq__item[open] .zh-product-faq__icon {
      transform: rotate(180deg);
    }

    .zh-product-faq__answer {
      max-width: 45rem;
      padding: 0 2.2rem 1.1rem 0;
      color: #625a53;
      font-size: .9rem;
      line-height: 1.75;
    }

    .zh-product-faq__answer p {
      margin: 0;
      white-space: pre-line;
    }

    @media (min-width: 640px) {
      .zh-product-faq__inner {
        padding: 3rem 1.5rem 0;
      }
    }


    @media (min-width: 1024px) {
      .zh-product-faq__inner {
        padding-right: 2.5rem;
        padding-left: 2.5rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .zh-product-faq__icon {
        transition: none;
      }
    }
  {% endstyle %}

  <section aria-labelledby="product-faq-heading-{{ section.id }}" class="zh-product-faq">
    <div class="zh-product-faq__inner">
      <div class="zh-product-faq__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zh-product-faq__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 id="product-faq-heading-{{ section.id }}" class="zh-product-faq__heading font-display">{{ section.settings.heading }}</h2>

      <div class="zh-product-faq__list">
        {%- assign rendered_faq_count = 0 -%}
        {%- for faq in faqs -%}
          {%- liquid
            assign faq_question = faq.question | downcase | strip
            assign skip_faq = false
            if faq_question contains 'materiaal' or faq_question contains 'waarvan is' or faq_question contains 'inhoud' or faq_question contains 'hoeveel ml' or faq_question contains 'hoeveel liter' or faq_question contains 'afmeting' or faq_question contains 'afmetingen' or faq_question contains 'hoe groot' or faq_question contains 'vaatwasser' or faq_question contains 'magnetron' or faq_question contains 'vriezer' or faq_question contains 'warme en koude' or faq_question contains 'warme dranken' or faq_question contains 'koude dranken' or faq_question contains 'hoeveel stuks' or faq_question contains 'wat wordt meegeleverd' or faq_question contains 'wat zit erbij'
              assign skip_faq = true
            endif
          -%}
          {%- unless skip_faq -%}
            {%- if rendered_faq_count < 4 -%}
              <details class="zh-product-faq__item">
                <summary class="font-display">
                  <span>{{ faq.question }}</span>
                  {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product-faq__icon' %}
                </summary>
                <div class="zh-product-faq__answer">
                  <p>{{ faq.answer }}</p>
                </div>
              </details>
              {%- assign rendered_faq_count = rendered_faq_count | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign emitted_faqs = 0 -%}
        {%- for faq in faqs -%}
          {%- liquid
            assign faq_question = faq.question | downcase | strip
            assign skip_faq = false
            if faq_question contains 'materiaal' or faq_question contains 'waarvan is' or faq_question contains 'inhoud' or faq_question contains 'hoeveel ml' or faq_question contains 'hoeveel liter' or faq_question contains 'afmeting' or faq_question contains 'afmetingen' or faq_question contains 'hoe groot' or faq_question contains 'vaatwasser' or faq_question contains 'magnetron' or faq_question contains 'vriezer' or faq_question contains 'warme en koude' or faq_question contains 'warme dranken' or faq_question contains 'koude dranken' or faq_question contains 'hoeveel stuks' or faq_question contains 'wat wordt meegeleverd' or faq_question contains 'wat zit erbij'
              assign skip_faq = true
            endif
          -%}
          {%- unless skip_faq -%}
            {%- if emitted_faqs < 4 -%}
              {%- if emitted_faqs > 0 -%},{%- endif -%}
              {
                "@type": "Question",
                "name": {{ faq.question | strip_html | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ faq.answer | strip_html | json }}
                }
              }
              {%- assign emitted_faqs = emitted_faqs | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Veelgestelde vragen" }
  ],
  "presets": [{ "name": "Product FAQ" }]
}
{% endschema %}
