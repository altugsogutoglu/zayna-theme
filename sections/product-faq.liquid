{%- liquid
  assign faqs = product.metafields.custom.faqs.value
-%}

{%- if faqs != blank and faqs.size > 0 -%}
  {% style %}
    .zh-product-faq {
      border-top: 1px solid rgb(42 37 32 / 12%);
      background: var(--color-surface, #fffdfb);
    }

    .zh-product-faq__inner {
      max-width: 54rem;
      margin: 0 auto;
      padding: 3rem 1rem;
    }

    .zh-product-faq__eyebrow {
      margin: 0 0 .65rem;
      color: var(--color-clay, #955c39);
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .12em;
      line-height: 1.4;
      text-align: center;
      text-transform: uppercase;
    }

    .zh-product-faq__heading {
      margin: 0 0 1.6rem;
      color: var(--color-ink, #2a2520);
      font-size: clamp(1.55rem, 4vw, 2rem);
      font-weight: 400;
      line-height: 1.2;
      text-align: center;
    }

    .zh-product-faq__list {
      border-top: 1px solid rgb(42 37 32 / 12%);
    }

    .zh-product-faq__item {
      border-bottom: 1px solid rgb(42 37 32 / 12%);
    }

    .zh-product-faq__item summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 1.05rem 0;
      color: var(--color-ink, #2a2520);
      font-size: 1rem;
      line-height: 1.4;
      list-style: none;
      cursor: pointer;
    }

    .zh-product-faq__item summary::-webkit-details-marker {
      display: none;
    }

    .zh-product-faq__item summary:focus-visible {
      outline: 2px solid var(--color-clay, #955c39);
      outline-offset: 3px;
    }

    .zh-product-faq__icon {
      flex: 0 0 auto;
      color: rgb(42 37 32 / 65%);
      transition: transform 180ms ease;
    }

    .zh-product-faq__item[open] .zh-product-faq__icon {
      transform: rotate(180deg);
    }

    .zh-product-faq__answer {
      max-width: 45rem;
      padding: 0 2.2rem 1.15rem 0;
      color: rgb(42 37 32 / 68%);
      font-size: .88rem;
      line-height: 1.75;
    }

    .zh-product-faq__answer p {
      margin: 0;
      white-space: pre-line;
    }

    @media (min-width: 640px) {
      .zh-product-faq__inner {
        padding: 4rem 1.5rem;
      }

      .zh-product-faq__heading {
        margin-bottom: 2rem;
      }

      .zh-product-faq__item summary {
        font-size: 1.08rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .zh-product-faq__icon {
        transition-duration: .01ms !important;
      }
    }
  {% endstyle %}

  <section aria-labelledby="product-faq-heading-{{ section.id }}" class="zh-product-faq">
    <div class="zh-product-faq__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zh-product-faq__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 id="product-faq-heading-{{ section.id }}" class="zh-product-faq__heading font-display">{{ section.settings.heading }}</h2>

      <div class="zh-product-faq__list">
        {%- for faq in faqs -%}
          <details class="zh-product-faq__item">
            <summary class="font-display">
              <span>{{ faq.question }}</span>
              {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product-faq__icon' %}
            </summary>
            <div class="zh-product-faq__answer">
              <p>{{ faq.answer }}</p>
            </div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in faqs -%}
          {
            "@type": "Question",
            "name": {{ faq.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ faq.answer | strip_html | json }}
            }
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Bovenkop", "default": "Goed om te weten" },
    { "type": "text", "id": "heading", "label": "Titel", "default": "Veelgestelde vragen" }
  ],
  "presets": [{ "name": "Product FAQ" }]
}
{% endschema %}
