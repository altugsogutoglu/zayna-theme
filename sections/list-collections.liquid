{%- comment -%}
  Zayna Home — collectie-overzicht (/collections)

  - Twee compacte kolommen op mobiel.
  - Drie compacte kolommen vanaf 560 px, zodat split-screen altijd goed uitlijnt.
  - Beeldverhouding 5:4: compacter dan vroeger, maar met minder afsnijding.
  - Bij een oneven aantal wordt de laatste kaart op mobiel/tablet gecentreerd.
  - Geen productaantallen of intro: de kaarten krijgen direct de aandacht.
  - Mobiele touchfeedback blijft kort zichtbaar vóór navigatie.
  - collection.image is primair; de eerste productafbeelding is fallback.
{%- endcomment -%}

{%- liquid
  assign cols = section.settings.collection_list

  if cols == blank or cols.size == 0
    assign cols = collections
  endif

  assign visible_count = 0

  for collection_item in cols
    unless collection_item.handle == 'all' or collection_item.handle == 'frontpage'
      assign visible_count = visible_count | plus: 1
    endunless
  endfor

  assign heading = section.settings.heading

  assign last_character = heading | slice: -1
  assign title_main = heading
  assign title_punctuation = ''

  if last_character == '.'
    assign heading_length = heading.size | minus: 1
    assign title_main = heading | slice: 0, heading_length
    assign title_punctuation = '.'
  endif

  assign section_heading_id = 'ZaynaCollectionsHeading-' | append: section.id
-%}

<section
  id="ZaynaCollectionsIndex-{{ section.id }}"
  class="zayna-collections-index"
  aria-labelledby="{{ section_heading_id }}"
>
  <div class="zayna-collections-index__inner">
    <header class="zayna-collections-index__header">

      {%- if section.settings.eyebrow != blank -%}
        <p class="zayna-collections-index__eyebrow">
          <span aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      <div class="zayna-collections-index__heading-layout">
        {%- if heading != blank -%}
          <h1
            id="{{ section_heading_id }}"
            class="zayna-collections-index__title"
          >
            {{ title_main | escape }}
            {%- if title_punctuation != blank -%}
              <span>{{ title_punctuation }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

      </div>

      {%- if visible_count > 0 -%}
        <span class="sr-only">
          {{ visible_count }}
          {% if visible_count == 1 %}
            collectie
          {% else %}
            collecties
          {% endif %}
        </span>
      {%- endif -%}
    </header>

    {%- if visible_count > 0 -%}
      <ul class="zayna-collections-grid">
        {%- assign card_index = 0 -%}

        {%- for collection_item in cols -%}
          {%- if collection_item.handle == 'all' or collection_item.handle == 'frontpage' -%}
            {%- continue -%}
          {%- endif -%}

          {%- liquid
            assign card_index = card_index | plus: 1
            assign card_image = collection_item.image

            if card_image == blank and collection_item.products_count > 0
              assign first_product = collection_item.products | first
              assign card_image = first_product.featured_image
            endif

            assign image_loading = 'lazy'
            if card_index <= 3
              assign image_loading = 'eager'
            endif

            assign image_sizes = '(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 50vw'
          -%}

          <li class="zayna-collection-card">
            <a
              href="{{ collection_item.url }}"
              class="zayna-collection-card__link"
            >
              <div class="zayna-collection-card__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: image_loading,
                      sizes: image_sizes,
                      widths: '360, 480, 640, 800, 1000, 1200, 1400',
                      alt: card_image.alt | default: collection_item.title,
                      class: 'zayna-collection-card__image'
                  }}
                {%- else -%}
                  <div
                    class="zayna-collection-card__placeholder"
                    aria-label="{{ collection_item.title | escape }}"
                  >
                    <span class="zayna-collection-card__placeholder-index">
                      {{ card_index | prepend: '0' | slice: -2, 2 }}
                    </span>

                    <span class="zayna-collection-card__placeholder-title">
                      {{ collection_item.title | escape }}
                    </span>

                    <span
                      class="zayna-collection-card__placeholder-line"
                      aria-hidden="true"
                    ></span>
                  </div>
                {%- endif -%}
              </div>

              <div class="zayna-collection-card__content">
                <div class="zayna-collection-card__title-row">
                  <h2 class="zayna-collection-card__title">
                    {{ collection_item.title | escape }}
                  </h2>

                  <span
                    class="zayna-collection-card__arrow"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="zayna-collections-index__empty">
        <p>Er zijn nog geen collecties.</p>
        <span>Kom snel terug — we vullen de collecties aan.</span>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #ZaynaCollectionsIndex-{{ section.id }} {
    --zh-collections-bg: var(--color-bg, #faf5f2);
    --zh-collections-ink: var(--color-ink, #2a2520);
    --zh-collections-soft: var(--color-ink-soft, #564e47);
    --zh-collections-stone: var(--color-stone, #78716c);
    --zh-collections-clay: var(--color-clay, #b5651d);
    --zh-collections-cream: var(--color-cream, #f0ebe6);
    --zh-collections-border: rgba(42, 37, 32, 0.07);
    --zh-collections-border-hover: rgba(181, 101, 29, 0.30);
    --zh-collections-caption: rgba(250, 245, 242, 0.84);

    background: var(--zh-collections-bg);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 0 16px 56px;
    container-name: zh-collections-layout;
    container-type: inline-size;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__header {
    max-width: none;
    padding: 12px 0 18px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__heading-layout {
    display: block;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 7px;
    color: var(--zh-collections-clay);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__eyebrow > span {
    width: 26px;
    height: 1px;
    background: rgba(181, 101, 29, 0.58);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__title {
    max-width: 11ch;
    margin: 0;
    color: var(--zh-collections-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(1.9rem, 6.2vw, 2.1rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__title > span {
    color: rgba(181, 101, 29, 0.82);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card {
    min-width: 0;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__link {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--zh-collections-border);
    background: rgba(250, 245, 242, 0.32);
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    cursor: pointer;
    transform-origin: center;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      transform 120ms ease;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__link:focus-visible {
    outline: 2px solid var(--zh-collections-clay);
    outline-offset: 3px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__media {
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--zh-collections-cream);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 18px;
    text-align: center;
    background:
      radial-gradient(
        75% 85% at 28% 18%,
        rgba(181, 101, 29, 0.1),
        transparent 66%
      ),
      linear-gradient(180deg, #f4ece5, #ede4dc);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder-index {
    margin-bottom: 9px;
    color: rgba(42, 37, 32, 0.58);
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder-title {
    max-width: 15ch;
    color: rgba(42, 37, 32, 0.72);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 16px;
    font-style: italic;
    line-height: 1.2;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder-line {
    width: 26px;
    height: 1px;
    margin-top: 12px;
    background: rgba(42, 37, 32, 0.18);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__content {
    display: flex;
    min-height: 40px;
    flex: 1 0 auto;
    align-items: center;
    margin: 0;
    padding: 7px 10px;
    border-top: 1px solid var(--zh-collections-border);
    background: var(--zh-collections-caption);
    transition: background-color 180ms ease;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__title-row {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__title {
    display: -webkit-box;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--zh-collections-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.01em;
    transition: color 220ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__arrow {
    flex: 0 0 auto;
    color: rgba(42, 37, 32, 0.68);
    font-size: 14px;
    line-height: 1;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__empty {
    padding: 72px 20px;
    border-top: 1px solid var(--zh-collections-border);
    text-align: center;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__empty p {
    margin: 0;
    color: var(--zh-collections-stone);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 24px;
    font-style: italic;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__empty span {
    display: block;
    margin-top: 10px;
    color: var(--zh-collections-soft);
    font-size: 14px;
  }

  @media (max-width: 559px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 640px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__inner {
      padding-right: 24px;
      padding-bottom: 64px;
      padding-left: 24px;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__inner {
      padding-right: 40px;
      padding-bottom: 68px;
      padding-left: 40px;
    }
  }

  /*
   * Container queries respond to the real content width, not the
   * browser window. Split screen, browser zoom and side panels are
   * therefore handled much more reliably.
   */
  @container zh-collections-layout (min-width: 560px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__header {
      max-width: none;
      padding-top: 16px;
      padding-bottom: 20px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__eyebrow {
      margin-bottom: 10px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__title {
      max-width: none;
      font-size: clamp(2.05rem, 3.8cqi, 2.35rem);
      line-height: 1.03;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 14px;
      row-gap: 22px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__media {
      aspect-ratio: 5 / 4;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__image:not([style*="object-position"]) {
      object-position: center 57%;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      min-height: 40px;
      padding: 7px 10px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      font-size: 14px;
      line-height: 1.16;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      font-size: 15px;
    }
  }

  @container zh-collections-layout (min-width: 1040px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__header {
      padding-top: 20px;
      padding-bottom: 24px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__eyebrow {
      margin-bottom: 13px;
      font-size: 10px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__title {
      font-size: clamp(2.4rem, 3.1cqi, 2.7rem);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      column-gap: 27px;
      row-gap: 31px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      min-height: 42px;
      padding: 8px 11px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      font-size: 16px;
      line-height: 1.16;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      font-size: 16px;
    }
  }

  /*
   * Hard responsive fallback: split-screen widths must show
   * three compact columns so captions remain visible immediately.
   */
  @media (min-width: 560px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 16px;
      row-gap: 22px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__media {
      aspect-ratio: 5 / 4;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__image:not([style*="object-position"]) {
      object-position: center 57%;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      min-height: 40px;
      padding: 7px 10px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      font-size: 14px;
      line-height: 1.16;
    }
  }

  /*
   * Fallback for browsers without container-query support.
   */
  @supports not (container-type: inline-size) {
    @media (min-width: 900px) {

      #ZaynaCollectionsIndex-{{ section.id }}
        .zayna-collections-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        column-gap: 16px;
      }

      #ZaynaCollectionsIndex-{{ section.id }}
        .zayna-collection-card__media {
        aspect-ratio: 5 / 4;
      }
    }
  }

  @media (min-width: 1180px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      min-height: 42px;
      padding: 8px 11px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      font-size: 16px;
      line-height: 1.16;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover {
      border-color: var(--zh-collections-border-hover);
      background: rgba(250, 245, 242, 0.56);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__content {
      background: rgba(242, 232, 223, 0.94);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:active,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link.is-touch-active {
      border-color: rgba(181, 101, 29, 0.36);
      background: rgba(242, 232, 223, 0.72);
      transform: scale(0.997);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link.is-touch-active
      .zayna-collection-card__content {
      background: rgba(242, 232, 223, 0.96);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link.is-touch-active
      .zayna-collection-card__title,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link.is-touch-active
      .zayna-collection-card__arrow {
      color: var(--zh-collections-clay);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link.is-touch-active
      .zayna-collection-card__arrow {
      transform: translateX(2px);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__image {
      transform: scale(1.018);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__title {
      color: var(--zh-collections-clay);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__arrow {
      color: var(--zh-collections-clay);
      transform: translateX(2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__image,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      transition: none;
    }
  }
{% endstyle %}

<script>
  (() => {
    const section = document.getElementById(
      'ZaynaCollectionsIndex-{{ section.id }}'
    );

    if (!section || section.dataset.touchFeedbackReady === 'true') {
      return;
    }

    section.dataset.touchFeedbackReady = 'true';

    section.querySelectorAll(
      '.zayna-collection-card__link'
    ).forEach((card) => {
      let lastPointerWasTouch = false;
      let resetTimer = null;

      const clearResetTimer = () => {
        if (resetTimer) {
          window.clearTimeout(resetTimer);
          resetTimer = null;
        }
      };

      const activate = () => {
        clearResetTimer();
        card.classList.add('is-touch-active');
      };

      const deactivate = (delay = 180) => {
        clearResetTimer();

        resetTimer = window.setTimeout(() => {
          card.classList.remove('is-touch-active');
          lastPointerWasTouch = false;
        }, delay);
      };

      card.addEventListener(
        'pointerdown',
        (event) => {
          if (event.pointerType !== 'touch') return;

          lastPointerWasTouch = true;
          activate();
        },
        { passive: true }
      );

      card.addEventListener(
        'pointercancel',
        (event) => {
          if (event.pointerType !== 'touch') return;
          deactivate(0);
        },
        { passive: true }
      );

      card.addEventListener(
        'pointerleave',
        (event) => {
          if (event.pointerType !== 'touch') return;
          deactivate(0);
        },
        { passive: true }
      );

      card.addEventListener('click', (event) => {
        if (!lastPointerWasTouch) return;

        const modified =
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey;

        const sameWindow =
          !card.target || card.target === '_self';

        if (modified || !sameWindow) return;

        event.preventDefault();

        const destination = card.href;

        activate();

        window.setTimeout(() => {
          window.location.assign(destination);
        }, 120);
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "info": "Kies en rangschik de collecties. Alle collecties worden gelijkwaardig weergegeven.",
      "limit": 50
    },
    {
      "type": "header",
      "content": "Teksten"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collecties"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Voor elke hoek van je huis."
    }
  ],
  "presets": [
    {
      "name": "Collections list"
    }
  ]
}
{% endschema %}