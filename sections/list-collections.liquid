{%- comment -%}
  Zayna Home — collectie-overzicht (/collections)

  - Twee gelijkwaardige kolommen op mobiel en gesplitst scherm.
  - Drie gelijkwaardige kolommen op desktop.
  - Bij een oneven aantal wordt de laatste kaart op mobiel/tablet gecentreerd.
  - Geen productaantallen: die horen op de individuele collectiepagina.
  - collection.image is primair; de eerste productafbeelding is fallback.
{%- endcomment -%}

{%- liquid
  assign cols = section.settings.collection_list

  if cols == blank or cols.size == 0
    assign cols = collections
  endif

  assign visible_count = 0

  for collection_item in cols
    unless collection_item.handle == 'all' or collection_item.handle == 'frontpage'
      assign visible_count = visible_count | plus: 1
    endunless
  endfor

  assign heading = section.settings.heading
  assign intro_text = section.settings.intro

  if intro_text == 'Ontdek onze collecties met stijlvolle keuken- en woonproducten voor een rustig, verzorgd en praktisch thuis.'
    assign intro_text = 'Bekijk de collecties van Zayna Home — zorgvuldig gekozen voor een rustig en verzorgd thuis.'
  endif

  assign last_character = heading | slice: -1
  assign title_main = heading
  assign title_punctuation = ''

  if last_character == '.'
    assign heading_length = heading.size | minus: 1
    assign title_main = heading | slice: 0, heading_length
    assign title_punctuation = '.'
  endif

  assign section_heading_id = 'ZaynaCollectionsHeading-' | append: section.id
-%}

<section
  id="ZaynaCollectionsIndex-{{ section.id }}"
  class="zayna-collections-index"
  aria-labelledby="{{ section_heading_id }}"
>
  <div class="zayna-collections-index__inner">
    <header class="zayna-collections-index__header">

      {%- if section.settings.eyebrow != blank -%}
        <p class="zayna-collections-index__eyebrow">
          <span aria-hidden="true"></span>
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      <div class="zayna-collections-index__heading-layout">
        {%- if heading != blank -%}
          <h1
            id="{{ section_heading_id }}"
            class="zayna-collections-index__title"
          >
            {{ title_main | escape }}
            {%- if title_punctuation != blank -%}
              <span>{{ title_punctuation }}</span>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if intro_text != blank -%}
          <p class="zayna-collections-index__intro">
            {{ intro_text | escape }}
          </p>
        {%- endif -%}
      </div>

      {%- if visible_count > 0 -%}
        <span class="sr-only">
          {{ visible_count }}
          {% if visible_count == 1 %}
            collectie
          {% else %}
            collecties
          {% endif %}
        </span>
      {%- endif -%}
    </header>

    {%- if visible_count > 0 -%}
      <ul class="zayna-collections-grid">
        {%- assign card_index = 0 -%}

        {%- for collection_item in cols -%}
          {%- if collection_item.handle == 'all' or collection_item.handle == 'frontpage' -%}
            {%- continue -%}
          {%- endif -%}

          {%- liquid
            assign card_index = card_index | plus: 1
            assign card_image = collection_item.image

            if card_image == blank and collection_item.products_count > 0
              assign first_product = collection_item.products | first
              assign card_image = first_product.featured_image
            endif

            assign image_loading = 'lazy'
            if card_index <= 3
              assign image_loading = 'eager'
            endif

            assign image_sizes = '(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 50vw'
          -%}

          <li class="zayna-collection-card">
            <a
              href="{{ collection_item.url }}"
              class="zayna-collection-card__link"
            >
              <div class="zayna-collection-card__media">
                {%- if card_image != blank -%}
                  {{
                    card_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: image_loading,
                      sizes: image_sizes,
                      widths: '360, 480, 640, 800, 1000, 1200, 1400',
                      alt: card_image.alt | default: collection_item.title,
                      class: 'zayna-collection-card__image'
                  }}
                {%- else -%}
                  <div
                    class="zayna-collection-card__placeholder"
                    aria-label="{{ collection_item.title | escape }}"
                  >
                    <span class="zayna-collection-card__placeholder-index">
                      {{ card_index | prepend: '0' | slice: -2, 2 }}
                    </span>

                    <span class="zayna-collection-card__placeholder-title">
                      {{ collection_item.title | escape }}
                    </span>

                    <span
                      class="zayna-collection-card__placeholder-line"
                      aria-hidden="true"
                    ></span>
                  </div>
                {%- endif -%}
              </div>

              <div class="zayna-collection-card__content">
                <div class="zayna-collection-card__title-row">
                  <h2 class="zayna-collection-card__title">
                    {{ collection_item.title | escape }}
                  </h2>

                  <span
                    class="zayna-collection-card__arrow"
                    aria-hidden="true"
                  >
                    →
                  </span>
                </div>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <div class="zayna-collections-index__empty">
        <p>Er zijn nog geen collecties.</p>
        <span>Kom snel terug — we vullen de collecties aan.</span>
      </div>
    {%- endif -%}
  </div>
</section>

{% style %}
  #ZaynaCollectionsIndex-{{ section.id }} {
    --zh-collections-bg: var(--color-bg, #faf5f2);
    --zh-collections-ink: var(--color-ink, #2a2520);
    --zh-collections-soft: var(--color-ink-soft, #564e47);
    --zh-collections-stone: var(--color-stone, #78716c);
    --zh-collections-stone-soft: var(--color-stone-soft, #a8a29e);
    --zh-collections-clay: var(--color-clay, #b5651d);
    --zh-collections-cream: var(--color-cream, #f0ebe6);
    --zh-collections-border: var(--color-border-soft, #e8e1da);

    background: var(--zh-collections-bg);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 0 16px 82px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__header {
    max-width: 680px;
    padding: 18px 0 22px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__heading-layout {
    display: block;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 8px;
    color: var(--zh-collections-clay);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__eyebrow > span {
    width: 26px;
    height: 1px;
    background: rgba(181, 101, 29, 0.56);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__title {
    max-width: 11ch;
    margin: 0;
    color: var(--zh-collections-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(2rem, 7.2vw, 2.25rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__title > span {
    color: rgba(181, 101, 29, 0.8);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__intro {
    max-width: 52ch;
    margin: 10px 0 0;
    color: var(--zh-collections-soft);
    font-size: 13.5px;
    line-height: 1.58;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 12px;
    row-gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card {
    min-width: 0;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__link {
    display: block;
    color: inherit;
    text-decoration: none;
    touch-action: manipulation;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__link:focus-visible {
    outline: 2px solid var(--zh-collections-clay);
    outline-offset: 4px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--zh-collections-cream);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    padding: 18px;
    text-align: center;
    background:
      radial-gradient(
        75% 85% at 28% 18%,
        rgba(181, 101, 29, 0.1),
        transparent 66%
      ),
      linear-gradient(180deg, #f4ece5, #ede4dc);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder-index {
    margin-bottom: 9px;
    color: var(--zh-collections-stone);
    font-size: 8px;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder-title {
    max-width: 15ch;
    color: rgba(42, 37, 32, 0.72);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 16px;
    font-style: italic;
    line-height: 1.2;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__placeholder-line {
    width: 26px;
    height: 1px;
    margin-top: 12px;
    background: var(--zh-collections-stone-soft);
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__content {
    margin-top: 8px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__title-row {
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    gap: 6px;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__title {
    display: -webkit-box;
    min-width: 0;
    max-width: calc(100% - 22px);
    min-height: 2.5em;
    margin: 0;
    overflow: hidden;
    color: var(--zh-collections-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 14px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.01em;
    transition: color 220ms ease;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collection-card__arrow {
    flex: 0 0 auto;
    padding-top: 1px;
    color: var(--zh-collections-stone);
    font-size: 14px;
    line-height: 1;
    transition:
      color 220ms ease,
      transform 220ms ease;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__empty {
    padding: 72px 20px;
    border-top: 1px solid var(--zh-collections-border);
    text-align: center;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__empty p {
    margin: 0;
    color: var(--zh-collections-stone);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 24px;
    font-style: italic;
  }

  #ZaynaCollectionsIndex-{{ section.id }}
    .zayna-collections-index__empty span {
    display: block;
    margin-top: 10px;
    color: var(--zh-collections-soft);
    font-size: 14px;
  }

  @media (min-width: 640px) and (max-width: 899px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__inner {
      padding-right: 24px;
      padding-bottom: 90px;
      padding-left: 24px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__header {
      max-width: 620px;
      padding-top: 21px;
      padding-bottom: 24px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__title {
      max-width: 14ch;
      font-size: clamp(2.1rem, 4.2vw, 2.35rem);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__intro {
      max-width: 48ch;
      margin-top: 10px;
      font-size: 14px;
      line-height: 1.58;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      column-gap: 18px;
      row-gap: 28px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__media {
      aspect-ratio: 5 / 4;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__image {
      object-position: center 56%;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      margin-top: 10px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      max-width: calc(100% - 24px);
      font-size: 17px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      font-size: 15px;
    }
  }

  @media (min-width: 900px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__inner {
      padding-right: 28px;
      padding-bottom: 92px;
      padding-left: 28px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__header {
      max-width: none;
      padding-top: 22px;
      padding-bottom: 24px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__eyebrow {
      margin-bottom: 11px;
      font-size: 9px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__heading-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.28fr) minmax(260px, 0.72fr);
      align-items: end;
      gap: 30px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__title {
      max-width: none;
      font-size: clamp(2.25rem, 3.15vw, 2.75rem);
      line-height: 1.02;
      white-space: nowrap;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__intro {
      max-width: 41ch;
      margin: 0 0 2px;
      font-size: 13.5px;
      line-height: 1.6;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 20px;
      row-gap: 30px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__media {
      aspect-ratio: 5 / 4;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__image {
      object-position: center 56%;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      margin-top: 8px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title-row {
      gap: 6px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      max-width: calc(100% - 22px);
      min-height: 2.35em;
      font-size: 17px;
      line-height: 1.18;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      padding-top: 0;
      font-size: 15px;
    }
  }

  @media (min-width: 900px) and (max-width: 1039px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__heading-layout {
      grid-template-columns: minmax(0, 1.2fr) minmax(235px, 0.8fr);
      gap: 24px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__title {
      font-size: 2.2rem;
      white-space: normal;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__intro {
      font-size: 13px;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__inner {
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__header {
      padding-top: 28px;
      padding-bottom: 28px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__heading-layout {
      grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.6fr);
      gap: 44px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__title {
      font-size: clamp(2.55rem, 3.3vw, 3rem);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-index__intro {
      font-size: 14px;
      line-height: 1.64;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collections-grid {
      column-gap: 28px;
      row-gap: 34px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__content {
      margin-top: 9px;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title {
      max-width: calc(100% - 24px);
      font-size: 19px;
      line-height: 1.2;
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      font-size: 16px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__image {
      transform: scale(1.018);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__title {
      color: var(--zh-collections-clay);
    }

    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__link:hover
      .zayna-collection-card__arrow {
      color: var(--zh-collections-clay);
      transform: translateX(3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__image,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__title,
    #ZaynaCollectionsIndex-{{ section.id }}
      .zayna-collection-card__arrow {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collections list",
  "tag": "section",
  "settings": [
    {
      "type": "collection_list",
      "id": "collection_list",
      "label": "Collections",
      "info": "Kies en rangschik de collecties. De eerste collectie wordt op mobiel en tablet uitgelicht.",
      "limit": 50
    },
    {
      "type": "header",
      "content": "Teksten"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collecties"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Voor elke hoek van je huis."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Bekijk de collecties van Zayna Home — zorgvuldig gekozen voor een rustig en verzorgd thuis."
    }
  ],
  "presets": [
    {
      "name": "Collections list"
    }
  ]
}
{% endschema %}