{%- comment -%}
  Zayna Home — compacte collectieheader.
  De collectie blijft herkenbaar, terwijl het productgrid sneller in beeld komt.
{%- endcomment -%}

{%- liquid
  assign is_all = false
  if collection.handle == 'all'
    assign is_all = true
  endif

  assign eyebrow = section.settings.eyebrow | default: 'Collectie'
  if is_all and section.settings.all_eyebrow != blank
    assign eyebrow = section.settings.all_eyebrow
  endif

  assign hero_title = collection.title
  if is_all and section.settings.all_title != blank
    assign hero_title = section.settings.all_title
  endif

  assign intro = collection.description | strip_html | strip
  if intro == blank
    assign intro = section.settings.intro_fallback
  endif

  if is_all and section.settings.all_intro != blank
    assign intro = section.settings.all_intro
  endif

  assign heading_id = 'ZaynaCollectionTitle-' | append: section.id
-%}

<header
  id="ZaynaCollectionHero-{{ section.id }}"
  class="zh-collection-hero"
  aria-labelledby="{{ heading_id }}"
>
  <div class="zh-collection-hero__inner">
    <div class="zh-collection-hero__heading">
      <p class="zh-collection-hero__eyebrow">
        <span aria-hidden="true"></span>
        {{ eyebrow | escape }}
      </p>

      <h1
        id="{{ heading_id }}"
        class="zh-collection-hero__title"
      >
        {{ hero_title | escape }}
      </h1>
    </div>

    {%- if intro != blank -%}
      <p class="zh-collection-hero__intro">
        {{ intro | escape }}
      </p>
    {%- endif -%}
  </div>
</header>

{% style %}
  #ZaynaCollectionHero-{{ section.id }} {
    background: var(--color-bg, #faf5f2);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 17px 16px 18px;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 7px;
    color: #9a6039;
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow > span {
    width: 25px;
    height: 1px;
    background: rgba(166, 106, 63, 0.54);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__title {
    max-width: 17ch;
    margin: 0;
    color: #2a2520;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(2rem, 8.4vw, 2.2rem);
    font-weight: 400;
    line-height: 1.045;
    letter-spacing: -0.026em;
    text-wrap: balance;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__intro {
    display: -webkit-box;
    max-width: 52ch;
    margin: 10px 0 0;
    overflow: hidden;
    color: #625a53;
    font-size: 13px;
    line-height: 1.52;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (min-width: 640px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 22px 24px 22px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: 18ch;
      font-size: clamp(2.25rem, 5vw, 2.65rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 58ch;
      margin-top: 11px;
      font-size: 13.5px;
    }
  }

  @media (min-width: 900px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
      align-items: end;
      gap: 48px;
      padding: 25px 40px 26px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: 19ch;
      font-size: clamp(2.55rem, 3.4vw, 2.95rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 42ch;
      margin: 0 0 3px;
      font-size: 14px;
      line-height: 1.58;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collectie"
    },
    {
      "type": "textarea",
      "id": "intro_fallback",
      "label": "Intro fallback",
      "default": "Geselecteerd op design, kwaliteit en functie."
    },
    {
      "type": "header",
      "content": "Alle producten"
    },
    {
      "type": "text",
      "id": "all_eyebrow",
      "label": "Eyebrow",
      "default": "De collectie"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Titel",
      "default": "Alle producten"
    },
    {
      "type": "textarea",
      "id": "all_intro",
      "label": "Intro",
      "default": "Bekijk de complete collectie van Zayna Home, zorgvuldig geselecteerd op design, kwaliteit en functie."
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}