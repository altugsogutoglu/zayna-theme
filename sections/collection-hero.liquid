{%- comment -%}
  Zayna Home — compacte collectieheader.
  De titel en korte beschrijving ondersteunen het productgrid,
  zonder zich als een tweede homepage-hero te gedragen.
{%- endcomment -%}

{%- liquid
  assign is_all = false
  if collection.handle == 'all'
    assign is_all = true
  endif

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'Collectie'
  endif

  if is_all and section.settings.all_eyebrow != blank
    assign eyebrow = section.settings.all_eyebrow
  endif

  assign hero_title = collection.title
  if is_all and section.settings.all_title != blank
    assign hero_title = section.settings.all_title
  endif

  assign intro = collection.description | strip_html | strip
  if intro == blank
    assign intro = section.settings.intro_fallback
  endif

  if is_all and section.settings.all_intro != blank
    assign intro = section.settings.all_intro
  endif

  assign last_char = hero_title | slice: -1
  assign title_main = hero_title
  assign trailing = ''

  if last_char == '.'
    assign cut = hero_title.size | minus: 1
    assign title_main = hero_title | slice: 0, cut
    assign trailing = '.'
  endif

  assign heading_id = 'ZaynaCollectionTitle-' | append: section.id
-%}

<header
  id="ZaynaCollectionHero-{{ section.id }}"
  class="zh-collection-hero"
  aria-labelledby="{{ heading_id }}"
>
  <div class="zh-collection-hero__inner">
    <p class="zh-collection-hero__eyebrow">
      <span aria-hidden="true"></span>
      {{ eyebrow | escape }}
    </p>

    <h1
      id="{{ heading_id }}"
      class="zh-collection-hero__title"
    >
      {{ title_main | escape }}
      {%- if trailing != blank -%}
        <span>{{ trailing }}</span>
      {%- endif -%}
    </h1>

    {%- if intro != blank -%}
      <p class="zh-collection-hero__intro">
        {{ intro | escape }}
      </p>
    {%- endif -%}
  </div>
</header>

{% style %}
  #ZaynaCollectionHero-{{ section.id }} {
    background: var(--color-bg, #faf5f2);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 18px 16px 24px;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 9px;
    color: var(--color-clay, #a66a3f);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow > span {
    width: 28px;
    height: 1px;
    background: rgba(166, 106, 63, 0.58);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__title {
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(2.15rem, 8vw, 2.55rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__title > span {
    color: rgba(166, 106, 63, 0.82);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__intro {
    display: -webkit-box;
    max-width: 58ch;
    margin: 12px 0 0;
    overflow: hidden;
    color: var(--color-ink-soft, #564e47);
    font-size: 14px;
    line-height: 1.62;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  @media (min-width: 640px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 24px 24px 28px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      font-size: clamp(2.5rem, 5vw, 3rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 64ch;
      margin-top: 13px;
      font-size: 14.5px;
      -webkit-line-clamp: 2;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 28px 40px 30px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__eyebrow {
      margin-bottom: 11px;
      font-size: 10px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: none;
      font-size: clamp(2.75rem, 3.7vw, 3.35rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      margin-top: 14px;
      font-size: 15px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collectie"
    },
    {
      "type": "textarea",
      "id": "intro_fallback",
      "label": "Intro fallback",
      "info": "Wordt gebruikt wanneer de collectie geen beschrijving heeft.",
      "default": "Geselecteerd op design, kwaliteit en functie."
    },
    {
      "type": "header",
      "content": "Alle producten"
    },
    {
      "type": "text",
      "id": "all_eyebrow",
      "label": "Eyebrow",
      "default": "De collectie"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Titel",
      "default": "Alle producten."
    },
    {
      "type": "textarea",
      "id": "all_intro",
      "label": "Intro",
      "default": "Bekijk de complete collectie van Zayna Home — zorgvuldig geselecteerd op design, kwaliteit en functie."
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}