{%- comment -%}
  Zayna Home — collectieheader, fase 2R.
  Compacte collectie-intro met subtiele teruglink links onder de intro.
{%- endcomment -%}

{%- liquid
  assign is_all = false
  if collection.handle == 'all'
    assign is_all = true
  endif

  assign eyebrow = section.settings.eyebrow | default: 'Collectie'
  if is_all and section.settings.all_eyebrow != blank
    assign eyebrow = section.settings.all_eyebrow
  endif

  assign hero_title = collection.title
  if is_all and section.settings.all_title != blank
    assign hero_title = section.settings.all_title
  endif

  assign title_key = hero_title | downcase
  assign intro = collection.description | strip_html | strip

  if intro == blank
    if is_all
      assign intro = section.settings.all_intro | default: 'Een rustige selectie keuken- en woonproducten die praktisch zijn én zichtbaar mooi blijven.'
    elsif title_key contains 'drinkglazen' or title_key contains 'bekers'
      assign intro = 'Glaswerk voor dagelijks gebruik en een rustig gedekte tafel.'
    elsif title_key contains 'voorraad' or title_key contains 'bewaren'
      assign intro = 'Voorraadpotten die bewaren praktisch maken en zichtbaar mooi blijven.'
    elsif title_key contains 'koffie' or title_key contains 'thee'
      assign intro = 'Rustige items voor koffie- en theemomenten, van glaswerk tot serveerdetails.'
    elsif title_key contains 'kruiden'
      assign intro = 'Voor een overzichtelijke kruidenlade of voorraadkast, rustig en praktisch ingedeeld.'
    elsif title_key contains 'bestek' or title_key contains 'lepels'
      assign intro = 'Bestek en lepels met een verzorgde uitstraling voor dagelijks gebruik en mooie tafelmomenten.'
    elsif title_key contains 'keukenhulpen' or title_key contains 'dispensers'
      assign intro = 'Functionele details voor een rustig, verzorgd en praktisch aanrecht.'
    elsif title_key contains 'kookaccessoires'
      assign intro = 'Kleine accessoires die koken, serveren en opruimen overzichtelijker maken.'
    elsif title_key contains 'keukentextiel'
      assign intro = 'Zacht keukentextiel en accessoires die je keuken rustig en verzorgd laten aanvoelen.'
    elsif title_key contains 'rietjes'
      assign intro = 'Herbruikbare glazen rietjes voor warme en koude dranken, subtiel en stijlvol in gebruik.'
    else
      assign intro = section.settings.intro_fallback | default: 'Rustige keuken- en woonproducten, zorgvuldig geselecteerd voor dagelijks gebruik.'
    endif
  endif

  assign title_class = 'zh-collection-hero__title'
  if hero_title.size > 20
    assign title_class = title_class | append: ' is-long'
  endif

  assign heading_id = 'ZaynaCollectionTitle-' | append: section.id
-%}

<header
  id="ZaynaCollectionHero-{{ section.id }}"
  class="zh-collection-hero"
  aria-labelledby="{{ heading_id }}"
>
  <div class="zh-collection-hero__inner">
    <div class="zh-collection-hero__layout">
      <div class="zh-collection-hero__copy">
        <p class="zh-collection-hero__eyebrow">
          <span aria-hidden="true"></span>
          {{ eyebrow | escape }}
        </p>

        <h1
          id="{{ heading_id }}"
          class="{{ title_class }}"
        >
          {{ hero_title | escape }}
        </h1>

        {%- if intro != blank -%}
          <p class="zh-collection-hero__intro">
            {{ intro | escape }}
          </p>
        {%- endif -%}

        <a
          href="{{ routes.collections_url }}"
          class="zh-collection-hero__all-link"
        >
          Alle collecties
        </a>
      </div>
    </div>
  </div>
</header>

{% style %}
  #ZaynaCollectionHero-{{ section.id }} {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(
        180deg,
        rgba(255, 253, 251, 0.22),
        rgba(255, 253, 251, 0)
      ),
      var(--color-bg, #faf5f2);
  }

  #ZaynaCollectionHero-{{ section.id }}::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: rgba(42, 37, 32, 0.045);
    content: '';
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__inner {
    position: relative;
    z-index: 1;
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 22px 16px 9px;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__layout {
    display: block;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__copy {
    max-width: 760px;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: #9a6039;
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow > span {
    width: 24px;
    height: 1px;
    background: rgba(166, 106, 63, 0.50);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__title {
    max-width: 22ch;
    margin: 0;
    color: #2a2520;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(1.84rem, 6.85vw, 2.04rem);
    font-weight: 400;
    line-height: 1.045;
    letter-spacing: -0.026em;
    text-wrap: balance;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__title.is-long {
    max-width: 24ch;
    font-size: clamp(1.68rem, 5.95vw, 1.90rem);
    line-height: 1.055;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__intro {
    max-width: 62ch;
    margin: 9px 0 0;
    overflow: hidden;
    color: rgba(42, 37, 32, 0.67);
    font-size: 13px;
    line-height: 1.54;
    text-wrap: pretty;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__all-link {
    display: inline-flex;
    width: fit-content;
    margin-top: 13px;
    color: rgba(42, 37, 32, 0.56);
    font-size: 11px;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: rgba(42, 37, 32, 0.22);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__all-link:focus-visible {
    outline: 2px solid rgba(166, 106, 63, 0.48);
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 27px 24px 11px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: 24ch;
      font-size: clamp(2.08rem, 3.85vw, 2.48rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title.is-long {
      max-width: 27ch;
      font-size: clamp(1.88rem, 3.35vw, 2.18rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 66ch;
      margin-top: 10px;
      font-size: 13.8px;
      line-height: 1.58;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 39px 40px 12px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__copy {
      max-width: 780px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__all-link {
      margin-top: 14px;
      font-size: 11.2px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: 25ch;
      font-size: clamp(2.54rem, 2.78vw, 3.10rem);
      line-height: 1.01;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title.is-long {
      max-width: 28ch;
      font-size: clamp(2.12rem, 2.22vw, 2.56rem);
      line-height: 1.025;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 68ch;
      margin-top: 13px;
      font-size: 14.2px;
      line-height: 1.62;
    }
  }


  @media (hover: hover) and (pointer: fine) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__all-link:hover {
      color: #8f5a39;
      text-decoration-color: rgba(143, 90, 57, 0.46);
    }
  }

{% endstyle %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collectie"
    },
    {
      "type": "textarea",
      "id": "intro_fallback",
      "label": "Intro fallback",
      "default": "Geselecteerd op design, kwaliteit en functie."
    },
    {
      "type": "header",
      "content": "Alle producten"
    },
    {
      "type": "text",
      "id": "all_eyebrow",
      "label": "Eyebrow",
      "default": "De collectie"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Titel",
      "default": "Alle producten"
    },
    {
      "type": "textarea",
      "id": "all_intro",
      "label": "Intro",
      "default": "Een rustige selectie keuken- en woonproducten die praktisch zijn én zichtbaar mooi blijven."
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}
