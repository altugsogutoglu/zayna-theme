{%- comment -%}
  Zayna Home — verfijnde collectieheader.
  Compact, specifiek per collectie en zonder losse desktop-kolom rechts.
{%- endcomment -%}

{%- liquid
  assign is_all = false
  if collection.handle == 'all'
    assign is_all = true
  endif

  assign eyebrow = section.settings.eyebrow | default: 'Collectie'
  if is_all and section.settings.all_eyebrow != blank
    assign eyebrow = section.settings.all_eyebrow
  endif

  assign hero_title = collection.title
  if is_all and section.settings.all_title != blank
    assign hero_title = section.settings.all_title
  endif

  assign title_key = hero_title | downcase
  assign intro = collection.description | strip_html | strip

  if intro == blank
    if is_all
      assign intro = section.settings.all_intro | default: 'De complete selectie van Zayna Home: rustige keuken- en woonproducten voor dagelijks gebruik.'
    elsif title_key contains 'drinkglazen' or title_key contains 'bekers'
      assign intro = 'Glaswerk voor dagelijks gebruik en een rustig gedekte tafel.'
    elsif title_key contains 'voorraad' or title_key contains 'bewaren'
      assign intro = 'Voorraadpotten die bewaren praktisch en zichtbaar mooi maken.'
    elsif title_key contains 'koffie' or title_key contains 'thee'
      assign intro = 'Rustige items voor koffie- en theemomenten, van glas tot serveeraccessoires.'
    elsif title_key contains 'kruiden'
      assign intro = 'Voor een overzichtelijke kruidenlade of voorraadkast, rustig en praktisch ingedeeld.'
    elsif title_key contains 'bestek' or title_key contains 'lepels'
      assign intro = 'Bestek en lepels met een verzorgde uitstraling voor elke tafel.'
    elsif title_key contains 'keukenhulpen' or title_key contains 'dispensers'
      assign intro = 'Praktische keukenhulpen die op het aanrecht rustig mogen blijven staan.'
    elsif title_key contains 'kookaccessoires'
      assign intro = 'Kleine accessoires die koken en serveren overzichtelijker maken.'
    elsif title_key contains 'keukentextiel'
      assign intro = 'Zacht keukentextiel en accessoires voor een verzorgde keuken.'
    elsif title_key contains 'rietjes'
      assign intro = 'Herbruikbare glazen rietjes voor warme en koude dranken.'
    else
      assign intro = section.settings.intro_fallback | default: 'Rustige keuken- en woonproducten, zorgvuldig geselecteerd voor dagelijks gebruik.'
    endif
  endif

  assign heading_id = 'ZaynaCollectionTitle-' | append: section.id
-%}

<header
  id="ZaynaCollectionHero-{{ section.id }}"
  class="zh-collection-hero"
  aria-labelledby="{{ heading_id }}"
>
  <div class="zh-collection-hero__inner">
    <p class="zh-collection-hero__eyebrow">
      <span aria-hidden="true"></span>
      {{ eyebrow | escape }}
    </p>

    <h1
      id="{{ heading_id }}"
      class="zh-collection-hero__title"
    >
      {{ hero_title | escape }}
    </h1>

    {%- if intro != blank -%}
      <p class="zh-collection-hero__intro">
        {{ intro | escape }}
      </p>
    {%- endif -%}
  </div>
</header>

{% style %}
  #ZaynaCollectionHero-{{ section.id }} {
    background: var(--color-bg, #faf5f2);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 18px 16px 13px;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 8px;
    color: #9a6039;
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__eyebrow > span {
    width: 24px;
    height: 1px;
    background: rgba(166, 106, 63, 0.50);
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__title {
    max-width: 21ch;
    margin: 0;
    color: #2a2520;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(2rem, 8vw, 2.18rem);
    font-weight: 400;
    line-height: 1.045;
    letter-spacing: -0.026em;
    text-wrap: balance;
  }

  #ZaynaCollectionHero-{{ section.id }}
    .zh-collection-hero__intro {
    max-width: 58ch;
    margin: 10px 0 0;
    overflow: hidden;
    color: rgba(42, 37, 32, 0.66);
    font-size: 13px;
    line-height: 1.54;
    text-wrap: pretty;
  }

  @media (min-width: 640px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 22px 24px 15px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: 23ch;
      font-size: clamp(2.18rem, 4.35vw, 2.55rem);
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 62ch;
      margin-top: 11px;
      font-size: 13.5px;
      line-height: 1.58;
    }
  }

  @media (min-width: 900px) {
    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__inner {
      padding: 28px 40px 16px;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__title {
      max-width: 24ch;
      font-size: clamp(2.35rem, 2.72vw, 2.95rem);
      line-height: 1.02;
    }

    #ZaynaCollectionHero-{{ section.id }}
      .zh-collection-hero__intro {
      max-width: 64ch;
      margin-top: 12px;
      font-size: 14px;
      line-height: 1.6;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collectie"
    },
    {
      "type": "textarea",
      "id": "intro_fallback",
      "label": "Intro fallback",
      "default": "Geselecteerd op design, kwaliteit en functie."
    },
    {
      "type": "header",
      "content": "Alle producten"
    },
    {
      "type": "text",
      "id": "all_eyebrow",
      "label": "Eyebrow",
      "default": "De collectie"
    },
    {
      "type": "text",
      "id": "all_title",
      "label": "Titel",
      "default": "Alle producten"
    },
    {
      "type": "textarea",
      "id": "all_intro",
      "label": "Intro",
      "default": "Bekijk de complete collectie van Zayna Home, zorgvuldig geselecteerd op design, kwaliteit en functie."
    }
  ],
  "presets": [
    {
      "name": "Collection hero"
    }
  ]
}
{% endschema %}