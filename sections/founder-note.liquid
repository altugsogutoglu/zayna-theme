{%- liquid
  assign s = section.settings

  assign story_eyebrow = s.story_eyebrow | default: 'Over Zayna Home'
  assign story_heading = s.story_heading | default: 'Rust zit in de kleine details.'
  assign story_link_label = s.story_link_label | default: 'Lees ons verhaal'
  assign story_link_url = s.story_link_url | default: '/pages/over-ons'
  assign welcome_line = s.welcome_line | default: 'Fijn dat je er bent.'

  assign image_alt = s.image.alt | default: 'De rustige stijl van Zayna Home'
  assign image_focal_point = s.image.presentation.focal_point | default: 'center'
  assign image_style = 'object-position: ' | append: image_focal_point | append: ';'
-%}

<section
  id="ZaynaFounderNote-{{ section.id }}"
  class="zayna-founder-note"
  aria-labelledby="ZaynaFounderHeading-{{ section.id }}"
>
  <div class="zayna-founder-note__inner">
    <div class="zayna-founder-note__media">
      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 1180px) 500px, (min-width: 760px) 43vw, 100vw',
            widths: '480, 720, 960, 1200, 1600',
            alt: image_alt,
            class: 'zayna-founder-note__image',
            style: image_style
        }}
      {%- else -%}
        <div
          class="zayna-founder-note__placeholder"
          aria-hidden="true"
        >
          <span>Zayna Home</span>
        </div>
      {%- endif -%}
    </div>

    <div class="zayna-founder-note__content">
      <p class="zayna-founder-note__eyebrow">
        <span aria-hidden="true"></span>
        {{ story_eyebrow | escape }}
      </p>

      <h2
        id="ZaynaFounderHeading-{{ section.id }}"
        class="zayna-founder-note__heading"
      >
        {{ story_heading | escape }}
      </h2>

      <div class="zayna-founder-note__body">
        {%- if s.story_body != blank -%}
          {{ s.story_body }}
        {%- else -%}
          <p>
            Zayna Home is ontstaan vanuit liefde voor een rustig, verzorgd
            huis. We kiezen producten die mooi ogen, prettig zijn in gebruik
            en moeiteloos een plek vinden in het dagelijks leven.
          </p>

          <p>
            Geen overdaad, maar een zorgvuldig gekozen collectie met aandacht
            voor eenvoud, functie en de details die een huis eigen maken.
          </p>
        {%- endif -%}
      </div>

      {%- if story_link_label != blank -%}
        <a
          href="{{ story_link_url }}"
          class="zayna-founder-note__link"
        >
          <span>{{ story_link_label | escape }}</span>
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}

      <p class="zayna-founder-note__closing">
        {{ welcome_line | escape }}
      </p>
    </div>
  </div>
</section>

{% style %}
  #ZaynaFounderNote-{{ section.id }} {
    --zayna-founder-bg: #f7f1ec;
    --zayna-founder-ink: #2a2520;
    --zayna-founder-soft: #6f665e;
    --zayna-founder-accent: #a66a3f;
    --zayna-founder-border: #e5d9cf;

    overflow: hidden;
    padding: 38px 0 40px;
    background: var(--zayna-founder-bg);
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__inner {
    display: grid;
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 0 20px;
    gap: 21px;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__media {
    position: relative;
    width: 100%;
    max-height: none;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #eee4dc;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__placeholder {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    background:
      radial-gradient(
        80% 100% at 25% 10%,
        rgba(166, 106, 63, 0.09),
        transparent 70%
      ),
      #eee4dc;
    color: rgba(42, 37, 32, 0.56);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 22px;
    font-style: italic;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__content {
    min-width: 0;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    color: var(--zayna-founder-accent);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.21em;
    text-transform: uppercase;
  }

  #ZaynaFounderNote-{{ section.id }}
    .zayna-founder-note__eyebrow
    > span {
    display: block;
    width: 27px;
    height: 1px;
    flex: 0 0 27px;
    background: rgba(166, 106, 63, 0.62);
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__heading {
    max-width: 15ch;
    margin: 0;
    color: var(--zayna-founder-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(30px, 8vw, 34px);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -0.027em;
    text-wrap: balance;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__body {
    max-width: 54ch;
    margin-top: 17px;
    color: var(--zayna-founder-soft);
    font-size: 14px;
    line-height: 1.64;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__body p {
    margin: 0 0 11px;
  }

  #ZaynaFounderNote-{{ section.id }}
    .zayna-founder-note__body
    p:last-child {
    margin-bottom: 0;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    margin-top: 15px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--zayna-founder-border);
    color: #5f564e;
    font-size: 10px;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  #ZaynaFounderNote-{{ section.id }}
    .zayna-founder-note__link
    span:last-child {
    transition: transform 180ms ease;
  }

  #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__closing {
    margin: 17px 0 0;
    color: var(--zayna-founder-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 15px;
    font-style: italic;
    line-height: 1.45;
  }

  #ZaynaFounderNote-{{ section.id }}
    .zayna-founder-note__link:focus-visible {
    outline: 2px solid var(--zayna-founder-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaFounderNote-{{ section.id }}
      .zayna-founder-note__link:hover {
      border-color: var(--zayna-founder-accent);
      color: var(--zayna-founder-accent);
    }

    #ZaynaFounderNote-{{ section.id }}
      .zayna-founder-note__link:hover
      span:last-child {
      transform: translateX(3px);
    }
  }

  @media (max-width: 389px) {
    #ZaynaFounderNote-{{ section.id }} {
      padding-top: 36px;
      padding-bottom: 39px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__inner {
      padding-right: 18px;
      padding-left: 18px;
      gap: 20px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__heading {
      font-size: 29px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__body {
      font-size: 13.5px;
    }
  }

  @media (min-width: 760px) {
    #ZaynaFounderNote-{{ section.id }} {
      padding-top: 54px;
      padding-bottom: 58px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__inner {
      grid-template-columns: minmax(0, 0.43fr) minmax(0, 0.57fr);
      align-items: center;
      gap: clamp(32px, 4.4vw, 52px);
      padding-right: 32px;
      padding-left: 32px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__media {
      max-height: 310px;
      aspect-ratio: 4 / 3;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__heading {
      max-width: 14ch;
      font-size: clamp(31px, 3.8vw, 36px);
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__body {
      margin-top: 16px;
      font-size: 14px;
      line-height: 1.62;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__link {
      margin-top: 13px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__closing {
      margin-top: 15px;
    }
  }

  @media (min-width: 980px) {
    #ZaynaFounderNote-{{ section.id }} {
      padding-top: 58px;
      padding-bottom: 60px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__inner {
      grid-template-columns: minmax(0, 0.46fr) minmax(0, 0.54fr);
      gap: clamp(48px, 5.5vw, 70px);
      padding-right: 36px;
      padding-left: 36px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__media {
      max-height: 340px;
      aspect-ratio: 3 / 2;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__heading {
      font-size: clamp(36px, 3.5vw, 40px);
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__body {
      font-size: 14.5px;
      line-height: 1.65;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaFounderNote-{{ section.id }} {
      padding-top: 62px;
      padding-bottom: 64px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__inner {
      grid-template-columns: minmax(0, 500px) minmax(0, 1fr);
      gap: 72px;
      padding-right: 0;
      padding-left: 0;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__media {
      max-height: 335px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__content {
      max-width: 510px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__heading {
      font-size: 41px;
    }

    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__body {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaFounderNote-{{ section.id }} .zayna-founder-note__link,
    #ZaynaFounderNote-{{ section.id }}
      .zayna-founder-note__link
      span:last-child {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Founder note",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Afbeelding"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Kleine bovenregel",
      "default": "Over Zayna Home"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Titel",
      "default": "Rust zit in de kleine details."
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Tekst",
      "default": "<p>Zayna Home is ontstaan vanuit liefde voor een rustig, verzorgd huis. We kiezen producten die mooi ogen, prettig zijn in gebruik en moeiteloos een plek vinden in het dagelijks leven.</p><p>Geen overdaad, maar een zorgvuldig gekozen collectie met aandacht voor eenvoud, functie en de details die een huis eigen maken.</p>"
    },
    {
      "type": "text",
      "id": "story_link_label",
      "label": "Linktekst",
      "default": "Lees ons verhaal"
    },
    {
      "type": "url",
      "id": "story_link_url",
      "label": "Link naar Over ons"
    },
    {
      "type": "text",
      "id": "welcome_line",
      "label": "Afsluitende zin",
      "default": "Fijn dat je er bent."
    }
  ],
  "presets": [
    {
      "name": "Founder note"
    }
  ]
}
{% endschema %}