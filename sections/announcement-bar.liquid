{%- if section.blocks.size > 0 -%}
  <section
    class="zayna-announcement"
    aria-label="Winkelmededelingen"
    style="--zayna-announcement-speed: {{ section.settings.speed | default: 42 }}s;"
  >
    <div class="zayna-announcement__viewport">
      <div class="zayna-announcement__track" aria-hidden="true">
        {%- for group in (1..2) -%}
          <div class="zayna-announcement__group">
            {%- for repetition in (1..2) -%}
              {%- for block in section.blocks -%}
                {%- liquid
          assign announcement_text = block.settings.text
          assign announcement_text_normalized = announcement_text | downcase
          if announcement_text_normalized contains 'levertijd'
            assign announcement_text = 'Verwachte levertijd 1–3 werkdagen'
          endif
        -%}
                <span
                  class="zayna-announcement__item"
                  {% if group == 1 and repetition == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  <span class="zayna-announcement__text">
                    {{ announcement_text | escape }}
                  </span>

                  <span
                    class="zayna-announcement__separator"
                    aria-hidden="true"
                  ></span>
                </span>
              {%- endfor -%}
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <ul class="sr-only">
      {%- for block in section.blocks -%}
        {%- liquid
          assign announcement_text = block.settings.text
          assign announcement_text = announcement_text | replace: 'Verwachte levertijd 1–3 werkdagen', 'Verwachte levertijd 1–3 werkdagen'
          assign announcement_text = announcement_text | replace: 'Verwachte levertijd 1–3 werkdagen', 'Verwachte levertijd 1–3 werkdagen'
          assign announcement_text = announcement_text | replace: 'VERWACHTE LEVERTIJD 1–3 WERKDAGEN', 'VERWACHTE LEVERTIJD 1–3 WERKDAGEN'
          assign announcement_text = announcement_text | replace: 'VERWACHTE LEVERTIJD 1–3 WERKDAGEN', 'VERWACHTE LEVERTIJD 1–3 WERKDAGEN'
        -%}
        <li>{{ announcement_text }}</li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% style %}
  #shopify-section-{{ section.id }} .zayna-announcement {
    position: relative;
    z-index: 1;
    width: 100%;
    overflow: hidden;
    background: #302923;
    color: #fbf7f2;
  }

  #shopify-section-{{ section.id }} .zayna-announcement__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
    mask-image: linear-gradient(
      90deg,
      transparent 0,
      #000 7%,
      #000 93%,
      transparent 100%
    );
  }

  #shopify-section-{{ section.id }} .zayna-announcement__track {
    display: flex;
    width: max-content;
    min-width: 100%;
    will-change: transform;
    animation:
      zayna-announcement-scroll
      var(--zayna-announcement-speed, 42s)
      linear
      infinite;
  }

  #shopify-section-{{ section.id }} .zayna-announcement__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .zayna-announcement__item {
    display: inline-flex;
    min-height: 34px;
    flex: 0 0 auto;
    align-items: center;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .zayna-announcement__text {
    display: inline-block;
    padding-right: clamp(20px, 4.5vw, 42px);
    padding-left: clamp(20px, 4.5vw, 42px);
    font-size: 10.7px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.055em;
    text-transform: none;
  }

  #shopify-section-{{ section.id }} .zayna-announcement__separator {
    display: block;
    width: 4px;
    height: 4px;
    flex: 0 0 4px;
    margin-right: clamp(2px, 0.8vw, 6px);
    margin-left: clamp(2px, 0.8vw, 6px);
    border-radius: 999px;
    background: rgba(205, 173, 143, 0.54);
  }

  @keyframes zayna-announcement-scroll {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  #shopify-section-{{ section.id }} .zayna-announcement:focus-within .zayna-announcement__track {
    animation-play-state: paused;
  }

  @media (min-width: 750px) {
    #shopify-section-{{ section.id }} .zayna-announcement__viewport {
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0,
        #000 3%,
        #000 97%,
        transparent 100%
      );
      mask-image: linear-gradient(
        90deg,
        transparent 0,
        #000 3%,
        #000 97%,
        transparent 100%
      );
    }

    #shopify-section-{{ section.id }} .zayna-announcement__item {
      min-height: 36px;
    }

    #shopify-section-{{ section.id }} .zayna-announcement__text {
      font-size: 11.1px;
      letter-spacing: 0.06em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .zayna-announcement__viewport {
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-mask-image: none;
      mask-image: none;
    }

    #shopify-section-{{ section.id }}
      .zayna-announcement__viewport::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .zayna-announcement__track {
      animation: none;
      transform: none;
      will-change: auto;
    }

    #shopify-section-{{ section.id }}
      .zayna-announcement__group:nth-child(2) {
      display: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 25,
      "max": 70,
      "step": 1,
      "unit": "s",
      "label": "Animatieduur",
      "info": "Een hoger getal laat de teksten langzamer bewegen.",
      "default": 42
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Gratis verzending vanaf €100"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        {
          "type": "message",
          "settings": {
            "text": "Gratis verzending vanaf €100"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Verwachte levertijd 1–3 werkdagen"
          }
        },
        {
          "type": "message",
          "settings": {
            "text": "Met zorg ingepakt vanuit Nederland"
          }
        }
      ]
    }
  ]
}
{% endschema %}