{%- comment -%}
  Zayna Home — collectie navigatie.
  Mobiel: één compacte keuzeknop.
  Vanaf tablet: sleepbare rail met dynamische fades, pijlen en toetsenbordbediening.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false

  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif

  assign all_active = false
  if collection.handle == 'all' or request.path == routes.all_products_collection_url
    assign all_active = true
  endif

  assign current_label = collection.title
  if all_active
    assign current_label = 'Alle producten'
  endif
-%}

<nav
  id="ZaynaCategoryPills-{{ section.id }}"
  class="zh-category-navigation"
  aria-label="Bladeren per collectie"
>
  <details class="zh-category-mobile" data-category-mobile>
    <summary class="zh-category-mobile__summary">
      <span class="zh-category-mobile__summary-label">
        Andere collecties
      </span>

      <span
        class="zh-category-mobile__chevron"
        aria-hidden="true"
      >
        {% render 'icon', name: 'chevron-down', size: 15 %}
      </span>
    </summary>

    <button
      type="button"
      class="zh-category-mobile__backdrop"
      data-category-backdrop
      aria-label="Collectiemenu sluiten"
    ></button>

    <div
      class="zh-category-mobile__menu"
      role="dialog"
      aria-modal="true"
      aria-label="Andere collecties"
    >
      <div class="zh-category-mobile__menu-header">
        <span>Andere collecties</span>

        <button
          type="button"
          class="zh-category-mobile__close"
          data-category-close
          aria-label="Collectiemenu sluiten"
        >
          {% render 'icon', name: 'x', size: 20 %}
        </button>
      </div>
      <a
        href="{{ routes.all_products_collection_url }}"
        class="zh-category-mobile__link{% if all_active %} is-active{% endif %}"
        {% if all_active %}aria-current="page"{% endif %}
      >
        <span>Alle producten</span>
        {%- if all_active -%}
          {% render 'icon', name: 'check', size: 14 %}
        {%- endif -%}
      </a>

      {%- if use_menu -%}
        {%- for link in menu.links -%}
          {%- assign is_active = false -%}
          {%- if link.url == collection.url -%}
            {%- assign is_active = true -%}
          {%- endif -%}

          <a
            href="{{ link.url }}"
            class="zh-category-mobile__link{% if is_active %} is-active{% endif %}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            <span>{{ link.title | escape }}</span>
            {%- if is_active -%}
              {% render 'icon', name: 'check', size: 14 %}
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for collection_item in collections -%}
          {%- if collection_item.handle == 'all' or collection_item.handle == 'frontpage' -%}
            {%- continue -%}
          {%- endif -%}

          {%- assign is_active = false -%}
          {%- if collection_item.handle == collection.handle -%}
            {%- assign is_active = true -%}
          {%- endif -%}

          <a
            href="{{ collection_item.url }}"
            class="zh-category-mobile__link{% if is_active %} is-active{% endif %}"
            {% if is_active %}aria-current="page"{% endif %}
          >
            <span>{{ collection_item.title | escape }}</span>
            {%- if is_active -%}
              {% render 'icon', name: 'check', size: 14 %}
            {%- endif -%}
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </details>

  <div class="zh-category-rail" data-category-rail>
    <button
      type="button"
      class="zh-category-rail__control zh-category-rail__control--prev"
      data-pills-prev
      aria-label="Vorige collecties"
      disabled
    >
      <span aria-hidden="true">←</span>
    </button>

    <div
      class="zh-category-rail__viewport"
      data-pills-embla
      role="group"
      aria-label="Collecties. Gebruik de linker- en rechterpijltjestoets om tussen collecties te navigeren."
      tabindex="-1"
    >
      <ul class="zh-category-rail__list">
        <li class="zh-category-rail__item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="zh-category-pill{% if all_active %} is-active{% endif %}"
            {% if all_active %}aria-current="page"{% endif %}
          >
            Alle
          </a>
        </li>

        {%- if use_menu -%}
          {%- for link in menu.links -%}
            {%- assign is_active = false -%}
            {%- if link.url == collection.url -%}
              {%- assign is_active = true -%}
            {%- endif -%}

            <li class="zh-category-rail__item">
              <a
                href="{{ link.url }}"
                class="zh-category-pill{% if is_active %} is-active{% endif %}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for collection_item in collections -%}
            {%- if collection_item.handle == 'all' or collection_item.handle == 'frontpage' -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign is_active = false -%}
            {%- if collection_item.handle == collection.handle -%}
              {%- assign is_active = true -%}
            {%- endif -%}

            <li class="zh-category-rail__item">
              <a
                href="{{ collection_item.url }}"
                class="zh-category-pill{% if is_active %} is-active{% endif %}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                {{ collection_item.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>

    <button
      type="button"
      class="zh-category-rail__control zh-category-rail__control--next"
      data-pills-next
      aria-label="Volgende collecties"
      disabled
    >
      <span aria-hidden="true">→</span>
    </button>

    <span
      class="zh-category-rail__fade zh-category-rail__fade--left"
      data-pills-fade-left
      aria-hidden="true"
    ></span>

    <span
      class="zh-category-rail__fade zh-category-rail__fade--right"
      data-pills-fade-right
      aria-hidden="true"
    ></span>
  </div>
</nav>

{% style %}
  #ZaynaCategoryPills-{{ section.id }} {
    position: relative;
    width: min(100%, 1280px);
    margin: 0 auto 13px;
    padding: 0 16px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile {
    position: relative;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__summary {
    display: flex;
    min-height: 38px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 0 11px;
    border: 0;
    border-bottom: 1px solid rgba(42, 37, 32, 0.11);
    background: transparent;
    color: #2a2520;
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__summary::-webkit-details-marker {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__summary-label {
    color: rgba(42, 37, 32, 0.70);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__chevron {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: rgba(42, 37, 32, 0.58);
    transition: transform 180ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile[open]
    .zh-category-mobile__chevron {
    transform: rotate(180deg);
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__backdrop {
    position: fixed;
    inset: 0;
    z-index: 48;
    display: none;
    border: 0;
    background: rgba(56, 46, 40, 0.22);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__menu {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 49;
    display: none;
    max-height: min(76dvh, 620px);
    overflow-y: auto;
    padding: 0 10px calc(12px + env(safe-area-inset-bottom));
    border-top: 1px solid rgba(42, 37, 32, 0.10);
    background: #fffdfb;
    box-shadow: 0 -20px 56px -34px rgba(42, 37, 32, 0.48);
    overscroll-behavior: contain;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile[open]
    .zh-category-mobile__backdrop,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile[open]
    .zh-category-mobile__menu {
    display: block;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__menu-header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 4px 0 8px;
    border-bottom: 1px solid rgba(42, 37, 32, 0.08);
    background: rgba(255, 253, 251, 0.97);
    color: #2a2520;
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 18px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__close {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #2a2520;
    cursor: pointer;
  }

  html.zh-category-menu-open {
    overflow: hidden;
  }

  html.zh-category-menu-open .marquee__track {
    animation-play-state: paused !important;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__link {
    display: flex;
    min-height: 42px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 0 11px;
    color: rgba(42, 37, 32, 0.70);
    font-size: 13px;
    text-decoration: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__link.is-active {
    background: rgba(242, 232, 223, 0.72);
    color: #875235;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__summary:focus-visible,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-mobile__link:focus-visible,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-pill:focus-visible,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__control:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 3px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail {
    position: relative;
    display: none;
    grid-template-columns: 34px minmax(0, 1fr) 34px;
    align-items: center;
    gap: 7px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport {
    min-width: 0;
    overflow: hidden;
    cursor: grab;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport:active {
    cursor: grabbing;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport.is-native-scroll {
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport.is-native-scroll::-webkit-scrollbar {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__list {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 1px 0;
    list-style: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__item {
    flex: 0 0 auto;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-pill {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border: 1px solid rgba(42, 37, 32, 0.085);
    border-radius: 999px;
    background: rgba(255, 253, 251, 0.38);
    color: rgba(42, 37, 32, 0.64);
    font-size: 11px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 120ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-pill.is-active {
    border-color: rgba(166, 106, 63, 0.34);
    background: rgba(242, 232, 223, 0.90);
    color: #825034;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__control {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    border: 1px solid rgba(42, 37, 32, 0.085);
    border-radius: 999px;
    background: rgba(255, 253, 251, 0.50);
    color: #655e58;
    font-size: 14px;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      border-color 160ms ease,
      color 160ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail.has-overflow
    .zh-category-rail__control {
    opacity: 1;
    pointer-events: auto;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__control:disabled {
    visibility: hidden;
    cursor: default;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__fade {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 22px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__fade--left {
    left: 41px;
    background: linear-gradient(
      90deg,
      #faf5f2 12%,
      rgba(250, 245, 242, 0)
    );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__fade--right {
    right: 41px;
    background: linear-gradient(
      270deg,
      #faf5f2 12%,
      rgba(250, 245, 242, 0)
    );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail.can-scroll-prev
    .zh-category-rail__fade--left,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail.can-scroll-next
    .zh-category-rail__fade--right {
    opacity: 1;
  }

  @media (min-width: 640px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 17px;
      padding-right: 24px;
      padding-left: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-mobile {
      display: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail {
      display: grid;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCategoryPills-{{ section.id }} {
      padding-right: 40px;
      padding-left: 40px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-pill:hover {
      border-color: rgba(166, 106, 63, 0.25);
      background: rgba(242, 232, 223, 0.56);
      color: #955c39;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__control:not(:disabled):hover {
      border-color: rgba(166, 106, 63, 0.30);
      color: #955c39;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-mobile__link:hover {
      background: rgba(242, 232, 223, 0.48);
      color: #955c39;
    }
  }
{% endstyle %}

<script src="{{ 'embla-carousel.umd.js' | asset_url }}" defer="defer"></script>
<script>
  (() => {
    const SECTION_ID = 'ZaynaCategoryPills-{{ section.id }}';

    const initCategoryNavigation = (section) => {
      if (
        !section ||
        section.dataset.categoryNavigationReady === 'true'
      ) {
        return;
      }

      section.dataset.categoryNavigationReady = 'true';

      /*
       * Mobile menu.
       */
      const mobileDetails = section.querySelector(
        '[data-category-mobile]'
      );

      const closeMobileMenu = () => {
        if (!mobileDetails?.open) return;

        mobileDetails.removeAttribute('open');

        document.documentElement.classList.remove(
          'zh-category-menu-open'
        );
      };

      mobileDetails?.addEventListener('toggle', () => {
        document.documentElement.classList.toggle(
          'zh-category-menu-open',
          mobileDetails.open
        );
      });

      section
        .querySelector('[data-category-close]')
        ?.addEventListener('click', closeMobileMenu);

      section
        .querySelector('[data-category-backdrop]')
        ?.addEventListener('click', closeMobileMenu);

      mobileDetails?.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;

        event.preventDefault();
        closeMobileMenu();
        mobileDetails.querySelector('summary')?.focus();
      });

      /*
       * Desktop and split-screen rail.
       *
       * Every visible pill remains a normal link in the natural Tab
       * order. JavaScript only adds ArrowLeft, ArrowRight, Home and End.
       * If JavaScript fails, Tab and Enter still work normally.
       */
      const rail = section.querySelector(
        '[data-category-rail]'
      );

      const viewport = section.querySelector(
        '[data-pills-embla]'
      );

      const previousButton = section.querySelector(
        '[data-pills-prev]'
      );

      const nextButton = section.querySelector(
        '[data-pills-next]'
      );

      if (!rail || !viewport) return;

      const links = Array.from(
        viewport.querySelectorAll('.zh-category-pill')
      );

      if (!links.length) return;

      /*
       * Undo any tabindex values left behind by an older theme version.
       */
      links.forEach((link) => {
        link.removeAttribute('tabindex');
      });

      const activeIndex = Math.max(
        0,
        links.findIndex((link) => {
          return link.getAttribute('aria-current') === 'page';
        })
      );

      let embla = null;

      const revealLink = (link, index) => {
        if (embla) {
          embla.scrollTo(index, false);
          return;
        }

        link.scrollIntoView({
          behavior: 'smooth',
          block: 'nearest',
          inline: 'center'
        });
      };

      const focusLink = (index) => {
        const safeIndex = Math.max(
          0,
          Math.min(index, links.length - 1)
        );

        const target = links[safeIndex];

        target.focus({
          preventScroll: true
        });

        revealLink(target, safeIndex);
      };

      const getNativeScrollState = () => {
        const tolerance = 2;

        return {
          canScrollPrevious:
            viewport.scrollLeft > tolerance,

          canScrollNext:
            viewport.scrollLeft +
              viewport.clientWidth <
            viewport.scrollWidth - tolerance
        };
      };

      const updateRailState = () => {
        const state = embla
          ? {
              canScrollPrevious: embla.canScrollPrev(),
              canScrollNext: embla.canScrollNext()
            }
          : getNativeScrollState();

        const hasOverflow =
          state.canScrollPrevious ||
          state.canScrollNext;

        rail.classList.toggle(
          'has-overflow',
          hasOverflow
        );

        rail.classList.toggle(
          'can-scroll-prev',
          state.canScrollPrevious
        );

        rail.classList.toggle(
          'can-scroll-next',
          state.canScrollNext
        );

        if (previousButton) {
          previousButton.disabled =
            !state.canScrollPrevious;
        }

        if (nextButton) {
          nextButton.disabled =
            !state.canScrollNext;
        }
      };

      viewport.addEventListener('keydown', (event) => {
        const focusedLink = event.target.closest(
          '.zh-category-pill'
        );

        if (!focusedLink) return;

        const focusedIndex = links.indexOf(focusedLink);

        if (focusedIndex < 0) return;

        let destination = null;

        switch (event.key) {
          case 'ArrowRight':
          case 'Right':
            destination = Math.min(
              focusedIndex + 1,
              links.length - 1
            );
            break;

          case 'ArrowLeft':
          case 'Left':
            destination = Math.max(
              focusedIndex - 1,
              0
            );
            break;

          case 'Home':
            destination = 0;
            break;

          case 'End':
            destination = links.length - 1;
            break;

          default:
            return;
        }

        event.preventDefault();
        event.stopPropagation();

        focusLink(destination);
      });

      links.forEach((link, index) => {
        link.addEventListener('focus', () => {
          revealLink(link, index);
        });
      });

      previousButton?.addEventListener('click', () => {
        if (embla) {
          embla.scrollPrev();
          return;
        }

        viewport.scrollBy({
          left: -viewport.clientWidth * 0.72,
          behavior: 'smooth'
        });
      });

      nextButton?.addEventListener('click', () => {
        if (embla) {
          embla.scrollNext();
          return;
        }

        viewport.scrollBy({
          left: viewport.clientWidth * 0.72,
          behavior: 'smooth'
        });
      });

      /*
       * Embla improves dragging, but keyboard navigation does not
       * depend on it.
       */
      if (window.EmblaCarousel) {
        embla = window.EmblaCarousel(viewport, {
          align: 'start',
          dragFree: true,
          containScroll: 'trimSnaps',
          skipSnaps: true
        });

        embla.on('select', updateRailState);
        embla.on('scroll', updateRailState);
        embla.on('reInit', updateRailState);

        embla.scrollTo(activeIndex, true);
      } else {
        viewport.classList.add('is-native-scroll');

        links[activeIndex]?.scrollIntoView({
          behavior: 'auto',
          block: 'nearest',
          inline: 'center'
        });

        viewport.addEventListener(
          'scroll',
          updateRailState,
          { passive: true }
        );
      }

      if ('ResizeObserver' in window) {
        const observer = new ResizeObserver(() => {
          embla?.reInit();
          updateRailState();
        });

        observer.observe(viewport);
      }

      window.addEventListener(
        'resize',
        updateRailState,
        { passive: true }
      );

      updateRailState();
    };

    const initialise = () => {
      initCategoryNavigation(
        document.getElementById(SECTION_ID)
      );
    };

    if (document.readyState === 'loading') {
      document.addEventListener(
        'DOMContentLoaded',
        initialise,
        { once: true }
      );
    } else {
      initialise();
    }

    document.addEventListener(
      'shopify:section:load',
      (event) => {
        const section =
          event.target?.id === SECTION_ID
            ? event.target
            : event.target?.querySelector?.(
                `#${SECTION_ID}`
              );

        initCategoryNavigation(section);
      }
    );
  })();
</script>

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Collectiemenu",
