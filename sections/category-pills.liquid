{%- comment -%}
  Zayna Home — Editorial Homeware category pills, fase 2J.
  Premium typografische collectie-navigatie zonder iconen.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false

  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif

  assign all_active = false
  if collection.handle == 'all' or request.path == routes.all_products_collection_url
    assign all_active = true
  endif

  assign preferred_titles_string = 'Drinkglazen & bekers|Voorraadpotten & bewaren|Koffie & thee|Kruidenpotten & labels|Bestek & lepels|Keukenhulpen & dispensers|Kookaccessoires|Keukentextiel & accessoires|Glazen rietjes'
  assign preferred_titles = preferred_titles_string | split: '|'
-%}

<nav
  id="ZaynaCategoryPills-{{ section.id }}"
  class="zh-category-editorial"
  aria-label="Collecties"
>
  <div class="zh-category-editorial__viewport-wrap">
    <div
      class="zh-category-editorial__viewport"
      data-category-editorial-viewport
      tabindex="0"
      aria-label="Blader door collecties"
    >
      <ul class="zh-category-editorial__list">
        <li class="zh-category-editorial__item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="zh-category-editorial__pill{% if all_active %} is-active{% endif %}"
            aria-label="Alle producten"
            {% if all_active %}aria-current="page"{% endif %}
          >
            <span class="zh-category-editorial__label zh-category-editorial__label--mobile">Alle</span>
            <span class="zh-category-editorial__label zh-category-editorial__label--desktop">Alle producten</span>
          </a>
        </li>

        {%- if use_menu -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign is_active = false
              if link.url == collection.url
                assign is_active = true
              endif

              assign full_label = link.title
              assign mobile_label = full_label
              assign label_key = full_label | downcase

              if label_key contains 'drinkglazen' or label_key contains 'bekers'
                assign mobile_label = 'Glaswerk'
              elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                assign mobile_label = 'Voorraad'
              elsif label_key contains 'koffie' or label_key contains 'thee'
                assign mobile_label = 'Koffie & thee'
              elsif label_key contains 'kruiden'
                assign mobile_label = 'Kruiden'
              elsif label_key contains 'bestek' or label_key contains 'lepels'
                assign mobile_label = 'Bestek'
              elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                assign mobile_label = 'Keukenhulpen'
              elsif label_key contains 'kookaccessoires'
                assign mobile_label = 'Koken'
              elsif label_key contains 'keukentextiel'
                assign mobile_label = 'Textiel'
              elsif label_key contains 'rietjes'
                assign mobile_label = 'Rietjes'
              endif
            -%}

            <li class="zh-category-editorial__item">
              <a
                href="{{ link.url }}"
                class="zh-category-editorial__pill{% if is_active %} is-active{% endif %}"
                aria-label="{{ full_label | escape }}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                <span class="zh-category-editorial__label zh-category-editorial__label--mobile">{{ mobile_label | escape }}</span>
                <span class="zh-category-editorial__label zh-category-editorial__label--desktop">{{ full_label | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for preferred_title in preferred_titles -%}
            {%- for collection_item in collections -%}
              {%- if collection_item.title != preferred_title -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign is_active = false
                if collection_item.handle == collection.handle
                  assign is_active = true
                endif

                assign full_label = collection_item.title
                assign mobile_label = full_label
                assign label_key = full_label | downcase

                if label_key contains 'drinkglazen' or label_key contains 'bekers'
                  assign mobile_label = 'Glaswerk'
                elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                  assign mobile_label = 'Voorraad'
                elsif label_key contains 'koffie' or label_key contains 'thee'
                  assign mobile_label = 'Koffie & thee'
                elsif label_key contains 'kruiden'
                  assign mobile_label = 'Kruiden'
                elsif label_key contains 'bestek' or label_key contains 'lepels'
                  assign mobile_label = 'Bestek'
                elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                  assign mobile_label = 'Keukenhulpen'
                elsif label_key contains 'kookaccessoires'
                  assign mobile_label = 'Koken'
                elsif label_key contains 'keukentextiel'
                  assign mobile_label = 'Textiel'
                elsif label_key contains 'rietjes'
                  assign mobile_label = 'Rietjes'
                endif
              -%}

              <li class="zh-category-editorial__item">
                <a
                  href="{{ collection_item.url }}"
                  class="zh-category-editorial__pill{% if is_active %} is-active{% endif %}"
                  aria-label="{{ full_label | escape }}"
                  {% if is_active %}aria-current="page"{% endif %}
                >
                  <span class="zh-category-editorial__label zh-category-editorial__label--mobile">{{ mobile_label | escape }}</span>
                  <span class="zh-category-editorial__label zh-category-editorial__label--desktop">{{ full_label | escape }}</span>
                </a>
              </li>

              {%- break -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</nav>

<script>
  (() => {
    const root = document.getElementById('ZaynaCategoryPills-{{ section.id }}');
    if (!root || root.dataset.editorialPillsReady === 'true') return;

    root.dataset.editorialPillsReady = 'true';

    const viewport = root.querySelector('[data-category-editorial-viewport]');
    const activePill = root.querySelector('.zh-category-editorial__pill.is-active');
    const mediaDesktop = window.matchMedia('(min-width: 1024px)');
    let frame = 0;

    const updateFade = () => {
      if (!viewport) return;

      window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(() => {
        const canScrollNext = viewport.scrollLeft + viewport.clientWidth < viewport.scrollWidth - 2;
        root.classList.toggle('has-scroll-next', canScrollNext && !mediaDesktop.matches);
      });
    };

    const revealActivePill = () => {
      if (!viewport || !activePill || mediaDesktop.matches) return;

      const targetLeft = activePill.offsetLeft - ((viewport.clientWidth - activePill.offsetWidth) / 2);

      viewport.scrollTo({
        left: Math.max(0, targetLeft),
        top: 0,
        behavior: 'auto'
      });
    };

    root.querySelectorAll('.zh-category-editorial__pill').forEach((pill) => {
      pill.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          pill.target === '_blank' ||
          pill.getAttribute('aria-current') === 'page'
        ) {
          return;
        }

        root.classList.add('is-navigating');
        pill.classList.add('is-pending');
        root.setAttribute('aria-busy', 'true');
      });
    });

    viewport?.addEventListener('scroll', updateFade, { passive: true });
    window.addEventListener('resize', updateFade, { passive: true });

    if (mediaDesktop.addEventListener) {
      mediaDesktop.addEventListener('change', () => {
        revealActivePill();
        updateFade();
      });
    }

    if ('ResizeObserver' in window && viewport) {
      new ResizeObserver(updateFade).observe(viewport);
    }

    window.requestAnimationFrame(() => {
      revealActivePill();
      updateFade();
    });
  })();
</script>

{% style %}
  #ZaynaCategoryPills-{{ section.id }} {
    --zh-category-bg: #FAF9F8;
    --zh-category-border: #E0DEDC;
    --zh-category-text: #595959;
    --zh-category-hover-border: #CFCAC4;
    --zh-category-accent: #A96B56;
    --zh-category-active-bg: #FFF8F0;
    --zh-category-active-border: #E8E0D8;

    position: relative;
    width: min(100%, 1280px);
    margin: 40px auto 32px;
    padding: 0 16px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__viewport-wrap {
    position: relative;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__viewport-wrap::after {
    position: absolute;
    top: 0;
    right: -1px;
    bottom: 0;
    z-index: 2;
    width: 54px;
    background: linear-gradient(
      90deg,
      rgba(250, 245, 242, 0),
      var(--color-bg, #FAF9F8) 78%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease-in-out;
  }

  #ZaynaCategoryPills-{{ section.id }}.has-scroll-next
    .zh-category-editorial__viewport-wrap::after {
    opacity: 1;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__viewport {
    min-width: 0;
    margin: 0 -16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 16px;
    scroll-padding: 16px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__viewport::-webkit-scrollbar {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__list {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__pill {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 1px solid var(--zh-category-border);
    border-radius: 50px;
    background: var(--zh-category-bg);
    color: var(--zh-category-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 13px;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.2s ease-in-out,
      background-color 0.2s ease-in-out,
      color 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out,
      opacity 0.2s ease-in-out,
      transform 0.2s ease-in-out;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__pill.is-active {
    border-color: var(--zh-category-active-border);
    background: var(--zh-category-active-bg);
    color: var(--zh-category-accent);
    font-weight: 500;
    pointer-events: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__pill:active:not(.is-active) {
    transform: scale(0.98);
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__pill:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(169, 107, 86, 0.20);
  }

  #ZaynaCategoryPills-{{ section.id }}.is-navigating
    .zh-category-editorial__pill:not(.is-pending):not(.is-active) {
    opacity: 0.48;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__pill.is-pending {
    border-color: var(--zh-category-active-border);
    background: var(--zh-category-active-bg);
    color: var(--zh-category-accent);
    transform: scale(0.98);
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-editorial__label--desktop {
    display: none;
  }

  @media (min-width: 640px) {
    #ZaynaCategoryPills-{{ section.id }} {
      padding-right: 24px;
      padding-left: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__viewport {
      margin-right: -24px;
      margin-left: -24px;
      padding-right: 24px;
      padding-left: 24px;
      scroll-padding: 24px;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCategoryPills-{{ section.id }} {
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__viewport-wrap::after {
      display: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__viewport {
      margin: 0;
      overflow: visible;
      padding: 0;
      scroll-padding: 0;
      scroll-snap-type: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__list {
      width: auto;
      flex-wrap: wrap;
      gap: 16px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__pill {
      min-height: 44px;
      padding: 12px 24px;
      font-size: 14px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__label--mobile {
      display: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__label--desktop {
      display: inline;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__pill:hover:not(.is-active) {
      border-color: var(--zh-category-hover-border);
      color: var(--zh-category-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__viewport {
      scroll-behavior: auto;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__viewport-wrap::after,
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-editorial__pill {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Collectiemenu",
      "info": "Selecteer bij voorkeur één centraal Zayna Home-collectiemenu. De menuvolgorde wordt exact overgenomen. Zonder menu gebruikt de sectie automatisch de vaste Zayna Home-volgorde."
    }
  ],
  "presets": [
    {
      "name": "Category pills"
    }
  ]
}
{% endschema %}