{%- comment -%}
  Zayna Home — collectie navigatie, fase 2D.
  Geen dropdown meer: de collecties vormen een direct zichtbare winkelroute.
  Mobiel en splitscreen gebruiken een zachte horizontale rail; desktop een rustige tab-rij.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false

  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif

  assign all_active = false
  if collection.handle == 'all' or request.path == routes.all_products_collection_url
    assign all_active = true
  endif

  assign preferred_titles_string = 'Drinkglazen & bekers|Voorraadpotten & bewaren|Koffie & thee|Kruidenpotten & labels|Bestek & lepels|Keukenhulpen & dispensers|Kookaccessoires|Keukentextiel & accessoires|Glazen rietjes'
  assign preferred_titles = preferred_titles_string | split: '|'
-%}

<nav
  id="ZaynaCategoryPills-{{ section.id }}"
  class="zh-category-navigation"
  aria-label="Collecties"
>
  <div class="zh-category-rail">
    <div
      class="zh-category-rail__viewport"
      data-category-visible-viewport
      role="group"
      aria-label="Wissel tussen collecties"
    >
      <ul class="zh-category-rail__list">
        <li class="zh-category-rail__item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="zh-category-link{% if all_active %} is-active{% endif %}"
            {% if all_active %}aria-current="page"{% endif %}
          >
            Alle producten
          </a>
        </li>

        {%- if use_menu -%}
          {%- for link in menu.links -%}
            {%- assign is_active = false -%}

            {%- if link.url == collection.url -%}
              {%- assign is_active = true -%}
            {%- endif -%}

            <li class="zh-category-rail__item">
              <a
                href="{{ link.url }}"
                class="zh-category-link{% if is_active %} is-active{% endif %}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for preferred_title in preferred_titles -%}
            {%- for collection_item in collections -%}
              {%- if collection_item.title != preferred_title -%}
                {%- continue -%}
              {%- endif -%}

              {%- assign is_active = false -%}

              {%- if collection_item.handle == collection.handle -%}
                {%- assign is_active = true -%}
              {%- endif -%}

              <li class="zh-category-rail__item">
                <a
                  href="{{ collection_item.url }}"
                  class="zh-category-link{% if is_active %} is-active{% endif %}"
                  {% if is_active %}aria-current="page"{% endif %}
                >
                  {{ collection_item.title | escape }}
                </a>
              </li>

              {%- break -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</nav>


<script>
  (() => {
    const root = document.getElementById('ZaynaCategoryPills-{{ section.id }}');
    const viewport = root?.querySelector('[data-category-visible-viewport]');
    const active = root?.querySelector('.zh-category-link.is-active');

    if (!viewport || !active) return;

    window.requestAnimationFrame(() => {
      const targetLeft = active.offsetLeft - ((viewport.clientWidth - active.offsetWidth) / 2);

      viewport.scrollTo({
        left: Math.max(0, targetLeft),
        top: 0,
        behavior: 'auto'
      });
    });
  })();
</script>

{% style %}
  #ZaynaCategoryPills-{{ section.id }} {
    position: relative;
    width: min(100%, 1180px);
    margin: 0 auto 10px;
    padding: 0 16px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail {
    position: relative;
    padding: 7px 0 12px;
    border-bottom: 1px solid rgba(42, 37, 32, 0.06);
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::before,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::after {
    position: absolute;
    top: 0;
    bottom: 1px;
    z-index: 2;
    width: 22px;
    content: '';
    pointer-events: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::before {
    left: 0;
    background: linear-gradient(
      90deg,
      var(--color-bg, #faf5f2) 10%,
      rgba(250, 245, 242, 0)
    );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::after {
    right: 0;
    background: linear-gradient(
      270deg,
      var(--color-bg, #faf5f2) 10%,
      rgba(250, 245, 242, 0)
    );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport {
    min-width: 0;
    margin: 0 -16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 16px;
    scroll-padding: 16px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport::-webkit-scrollbar {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__list {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 1px 0 3px;
    list-style: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link {
    position: relative;
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    padding: 0 12px;
    border: 1px solid rgba(42, 37, 32, 0.075);
    border-radius: 999px;
    background: rgba(255, 253, 251, 0.32);
    color: rgba(42, 37, 32, 0.70);
    font-size: 12.2px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link.is-active {
    border-color: rgba(166, 106, 63, 0.30);
    background: rgba(242, 232, 223, 0.64);
    box-shadow: inset 0 -1px 0 rgba(166, 106, 63, 0.24);
    color: #7a4a30;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 12px;
      padding-right: 24px;
      padding-left: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail {
      padding-top: 9px;
      padding-bottom: 13px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__viewport {
      margin-right: -24px;
      margin-left: -24px;
      padding-right: 24px;
      padding-left: 24px;
      scroll-padding: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__list {
      gap: 10px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link {
      min-height: 36px;
      padding-right: 14px;
      padding-left: 14px;
      font-size: 12.8px;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 13px;
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail {
      padding: 13px 0 15px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail::before,
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail::after {
      width: 30px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__viewport {
      margin-right: -40px;
      margin-left: -40px;
      padding-right: 40px;
      padding-left: 40px;
      scroll-padding: 40px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__list {
      gap: 30px;
      padding-bottom: 4px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link {
      min-height: 37px;
      padding: 0 1px;
      border: 0;
      border-radius: 0;
      background: transparent;
      box-shadow: none;
      color: rgba(42, 37, 32, 0.68);
      font-size: 14.2px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 2px;
      background: rgba(166, 106, 63, 0.58);
      content: '';
      opacity: 0;
      transform: scaleX(0.72);
      transform-origin: center;
      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link.is-active {
      color: #74482f;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link.is-active::after {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link:hover:not(.is-active) {
      border-color: rgba(166, 106, 63, 0.18);
      background: rgba(242, 232, 223, 0.22);
      color: #8f5a39;
    }

    @media (min-width: 1024px) {
      #ZaynaCategoryPills-{{ section.id }}
        .zh-category-link:hover:not(.is-active) {
        background: transparent;
      }

      #ZaynaCategoryPills-{{ section.id }}
        .zh-category-link:hover:not(.is-active)::after {
        opacity: 0.35;
        transform: scaleX(0.86);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link,
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Collectiemenu",
      "info": "Selecteer bij voorkeur één centraal Zayna Home-collectiemenu. De menuvolgorde wordt exact overgenomen. Zonder menu gebruikt de sectie automatisch de vaste Zayna Home-volgorde."
    }
  ],
  "presets": [
    {
      "name": "Category pills"
    }
  ]
}
{% endschema %}
