{%- comment -%}
  Zayna Home — Fase 2K: Editorial category navigation.
  Premium typografische collectie-navigatie zonder iconen.

  Desktop:
  - editorial wordmark navigation, geen standaard pill/filterchip-gevoel;
  - korte labels voor rust, aria-labels behouden volledige collectienamen;
  - directe klikfeedback + lichte prefetch.

  Mobiel / splitscreen:
  - zachte swipebare scroll-pills met korte labels;
  - scroll snap, verborgen scrollbar, subtiele rechter fade alleen wanneer er meer te scrollen is.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false

  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif

  assign all_active = false
  if collection.handle == 'all' or request.path == routes.all_products_collection_url
    assign all_active = true
  endif

  assign preferred_titles_string = 'Drinkglazen & bekers|Voorraadpotten & bewaren|Koffie & thee|Kruidenpotten & labels|Bestek & lepels|Keukenhulpen & dispensers|Kookaccessoires|Keukentextiel & accessoires|Glazen rietjes'
  assign preferred_titles = preferred_titles_string | split: '|'
-%}

<nav
  id="ZaynaCategoryNav-{{ section.id }}"
  class="zh-category-nav"
  data-category-nav
  aria-label="Collecties"
>
  <div class="zh-category-nav__viewport-wrap">
    <div
      class="zh-category-nav__viewport"
      data-category-nav-viewport
    >
      <ul class="zh-category-nav__list" role="list">
        <li class="zh-category-nav__item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="zh-category-nav__link{% if all_active %} is-active{% endif %}"
            aria-label="Alle producten"
            data-category-nav-link
            {% if all_active %}aria-current="page"{% endif %}
          >
            <span class="zh-category-nav__label zh-category-nav__label--short">Alle</span>
            <span class="zh-category-nav__label zh-category-nav__label--long">Alle producten</span>
          </a>
        </li>

        {%- if use_menu -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign is_active = false
              if link.url == collection.url
                assign is_active = true
              endif

              assign full_label = link.title
              assign short_label = full_label
              assign label_key = full_label | downcase

              if label_key contains 'drinkglazen' or label_key contains 'bekers'
                assign short_label = 'Glaswerk'
              elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                assign short_label = 'Voorraad'
              elsif label_key contains 'koffie' or label_key contains 'thee'
                assign short_label = 'Koffie & thee'
              elsif label_key contains 'kruiden'
                assign short_label = 'Kruiden'
              elsif label_key contains 'bestek' or label_key contains 'lepels'
                assign short_label = 'Bestek'
              elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                assign short_label = 'Keukenhulpen'
              elsif label_key contains 'kookaccessoires'
                assign short_label = 'Koken'
              elsif label_key contains 'keukentextiel'
                assign short_label = 'Textiel'
              elsif label_key contains 'rietjes'
                assign short_label = 'Rietjes'
              endif
            -%}

            <li class="zh-category-nav__item">
              <a
                href="{{ link.url }}"
                class="zh-category-nav__link{% if is_active %} is-active{% endif %}"
                aria-label="{{ full_label | escape }}"
                data-category-nav-link
                {% if is_active %}aria-current="page"{% endif %}
              >
                <span class="zh-category-nav__label zh-category-nav__label--short">{{ short_label | escape }}</span>
                <span class="zh-category-nav__label zh-category-nav__label--long">{{ full_label | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for preferred_title in preferred_titles -%}
            {%- for collection_item in collections -%}
              {%- if collection_item.title != preferred_title -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign is_active = false
                if collection_item.handle == collection.handle
                  assign is_active = true
                endif

                assign full_label = collection_item.title
                assign short_label = full_label
                assign label_key = full_label | downcase

                if label_key contains 'drinkglazen' or label_key contains 'bekers'
                  assign short_label = 'Glaswerk'
                elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                  assign short_label = 'Voorraad'
                elsif label_key contains 'koffie' or label_key contains 'thee'
                  assign short_label = 'Koffie & thee'
                elsif label_key contains 'kruiden'
                  assign short_label = 'Kruiden'
                elsif label_key contains 'bestek' or label_key contains 'lepels'
                  assign short_label = 'Bestek'
                elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                  assign short_label = 'Keukenhulpen'
                elsif label_key contains 'kookaccessoires'
                  assign short_label = 'Koken'
                elsif label_key contains 'keukentextiel'
                  assign short_label = 'Textiel'
                elsif label_key contains 'rietjes'
                  assign short_label = 'Rietjes'
                endif
              -%}

              <li class="zh-category-nav__item">
                <a
                  href="{{ collection_item.url }}"
                  class="zh-category-nav__link{% if is_active %} is-active{% endif %}"
                  aria-label="{{ full_label | escape }}"
                  data-category-nav-link
                  {% if is_active %}aria-current="page"{% endif %}
                >
                  <span class="zh-category-nav__label zh-category-nav__label--short">{{ short_label | escape }}</span>
                  <span class="zh-category-nav__label zh-category-nav__label--long">{{ full_label | escape }}</span>
                </a>
              </li>

              {%- break -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</nav>

<script>
  (() => {
    const root = document.getElementById('ZaynaCategoryNav-{{ section.id }}');
    if (!root || root.dataset.categoryNavReady === 'true') return;

    root.dataset.categoryNavReady = 'true';

    const viewport = root.querySelector('[data-category-nav-viewport]');
    const links = Array.from(root.querySelectorAll('[data-category-nav-link]'));
    const activeLink = root.querySelector('[data-category-nav-link][aria-current="page"]');
    const desktopQuery = window.matchMedia('(min-width: 1024px)');
    const prefetched = new Set();
    let frame = 0;

    const prefetch = (url) => {
      if (!url || prefetched.has(url)) return;
      if (url === window.location.pathname || url === window.location.href) return;

      prefetched.add(url);

      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url;
      link.as = 'document';
      document.head.appendChild(link);
    };

    const setScrollState = () => {
      if (!viewport) return;

      window.cancelAnimationFrame(frame);
      frame = window.requestAnimationFrame(() => {
        const canScrollNext = viewport.scrollLeft + viewport.clientWidth < viewport.scrollWidth - 3;
        root.classList.toggle('has-scroll-next', canScrollNext && !desktopQuery.matches);
      });
    };

    const revealActive = () => {
      if (!viewport || !activeLink || desktopQuery.matches) return;

      const targetLeft = activeLink.offsetLeft - ((viewport.clientWidth - activeLink.offsetWidth) / 2);

      viewport.scrollTo({
        left: Math.max(0, targetLeft),
        top: 0,
        behavior: 'auto'
      });
    };

    links.forEach((link) => {
      const href = link.getAttribute('href');
      const isCurrent = link.getAttribute('aria-current') === 'page';

      link.addEventListener('pointerenter', () => prefetch(href), { passive: true });
      link.addEventListener('focus', () => prefetch(href));
      link.addEventListener('touchstart', () => prefetch(href), { passive: true });

      link.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          isCurrent ||
          link.target === '_blank'
        ) {
          return;
        }

        root.classList.add('is-navigating');
        root.setAttribute('aria-busy', 'true');
        link.classList.add('is-pending');
      });
    });

    viewport?.addEventListener('scroll', setScrollState, { passive: true });
    window.addEventListener('resize', setScrollState, { passive: true });

    if (desktopQuery.addEventListener) {
      desktopQuery.addEventListener('change', () => {
        revealActive();
        setScrollState();
      });
    } else if (desktopQuery.addListener) {
      desktopQuery.addListener(() => {
        revealActive();
        setScrollState();
      });
    }

    if ('ResizeObserver' in window && viewport) {
      new ResizeObserver(setScrollState).observe(viewport);
    }

    window.requestAnimationFrame(() => {
      revealActive();
      setScrollState();
    });
  })();
</script>

{% style %}
  #ZaynaCategoryNav-{{ section.id }} {
    --zh-category-bg: #FAF9F8;
    --zh-category-border: #E0DEDC;
    --zh-category-text: #595959;
    --zh-category-muted: rgba(42, 37, 32, 0.56);
    --zh-category-hover-border: #CFCAC4;
    --zh-category-accent: #A96B56;
    --zh-category-active-bg: #FFF8F0;
    --zh-category-active-border: #E8E0D8;
    --zh-category-page-bg: var(--color-bg, #faf5f2);

    position: relative;
    width: min(100%, 1180px);
    margin: 34px auto 24px;
    padding: 0 16px;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__viewport-wrap {
    position: relative;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__viewport-wrap::after {
    position: absolute;
    top: 0;
    right: -1px;
    bottom: 0;
    z-index: 2;
    width: 44px;
    background: linear-gradient(
      90deg,
      rgba(250, 245, 242, 0),
      var(--zh-category-page-bg) 88%
    );
    content: '';
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease-in-out;
  }

  #ZaynaCategoryNav-{{ section.id }}.has-scroll-next
    .zh-category-nav__viewport-wrap::after {
    opacity: 0.94;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__viewport {
    min-width: 0;
    margin: 0 -16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 16px 1px;
    scroll-padding: 16px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__viewport::-webkit-scrollbar {
    display: none;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__list {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__link {
    position: relative;
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    justify-content: center;
    padding: 10px 20px;
    border: 1px solid var(--zh-category-border);
    border-radius: 50px;
    background: var(--zh-category-bg);
    color: var(--zh-category-text);
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 13px;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 0.2s ease-in-out,
      background-color 0.2s ease-in-out,
      color 0.2s ease-in-out,
      box-shadow 0.2s ease-in-out,
      opacity 0.2s ease-in-out,
      transform 0.2s ease-in-out;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__link.is-active {
    border-color: var(--zh-category-active-border);
    background: var(--zh-category-active-bg);
    color: var(--zh-category-accent);
    font-weight: 500;
    pointer-events: none;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__link:active:not(.is-active) {
    transform: scale(0.98);
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__link:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(169, 107, 86, 0.20);
  }

  #ZaynaCategoryNav-{{ section.id }}.is-navigating
    .zh-category-nav__link:not(.is-active):not(.is-pending) {
    opacity: 0.46;
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__link.is-pending {
    border-color: var(--zh-category-active-border);
    background: var(--zh-category-active-bg);
    color: var(--zh-category-accent);
    transform: scale(0.98);
  }

  #ZaynaCategoryNav-{{ section.id }}
    .zh-category-nav__label--long {
    display: none;
  }

  @media (min-width: 640px) {
    #ZaynaCategoryNav-{{ section.id }} {
      margin-top: 36px;
      margin-bottom: 26px;
      padding-right: 24px;
      padding-left: 24px;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__viewport {
      margin-right: -24px;
      margin-left: -24px;
      padding-right: 24px;
      padding-left: 24px;
      scroll-padding: 24px;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCategoryNav-{{ section.id }} {
      margin-top: 36px;
      margin-bottom: 28px;
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__viewport-wrap::after {
      display: none;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__viewport {
      margin: 0;
      overflow: visible;
      padding: 0;
      scroll-padding: 0;
      scroll-snap-type: none;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__list {
      width: auto;
      flex-wrap: wrap;
      column-gap: 30px;
      row-gap: 13px;
      align-items: baseline;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__item {
      scroll-snap-align: none;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link {
      min-height: 34px;
      padding: 0 1px 8px;
      border: 0;
      border-radius: 0;
      background: transparent;
      color: var(--zh-category-muted);
      font-size: 14px;
      line-height: 1.1;
      transition:
        color 0.2s ease-in-out,
        opacity 0.2s ease-in-out,
        transform 0.2s ease-in-out;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link::after {
      position: absolute;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      background: rgba(169, 107, 86, 0.58);
      content: '';
      opacity: 0;
      transform: scaleX(0.58);
      transform-origin: left center;
      transition:
        opacity 0.2s ease-in-out,
        transform 0.2s ease-in-out;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link.is-active {
      background: transparent;
      color: var(--zh-category-accent);
      font-weight: 500;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link.is-active::after,
    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link.is-pending::after {
      opacity: 1;
      transform: scaleX(1);
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link.is-pending {
      color: var(--zh-category-accent);
      transform: translateY(1px);
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link:active:not(.is-active) {
      transform: translateY(1px);
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link:focus-visible {
      border-radius: 4px;
      box-shadow: 0 0 0 3px rgba(169, 107, 86, 0.18);
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__label--short {
      display: none;
    }

    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__label--long {
      display: inline;
    }
  }

  @media (min-width: 1280px) {
    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__list {
      column-gap: 34px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link:hover:not(.is-active) {
      border-color: var(--zh-category-hover-border);
      color: var(--zh-category-accent);
    }

    @media (min-width: 1024px) {
      #ZaynaCategoryNav-{{ section.id }}
        .zh-category-nav__link:hover:not(.is-active)::after {
        opacity: 0.44;
        transform: scaleX(1);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__viewport-wrap::after,
    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link,
    #ZaynaCategoryNav-{{ section.id }}
      .zh-category-nav__link::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Collectiemenu",
      "info": "Selecteer bij voorkeur één centraal Zayna Home-collectiemenu. De menuvolgorde wordt exact overgenomen. Zonder menu gebruikt de sectie automatisch de vaste Zayna Home-volgorde."
    }
  ],
  "presets": [
    {
      "name": "Category pills"
    }
  ]
}
{% endschema %}