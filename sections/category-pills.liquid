{%- comment -%}
  Zayna Home — collectie navigatie, fase 2E.
  Desktop: rustige collectie-index in meerdere regels.
  Mobiel/splitscreen: korte, swipebare labels zodat de winkelroute licht blijft.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false

  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif

  assign all_active = false
  if collection.handle == 'all' or request.path == routes.all_products_collection_url
    assign all_active = true
  endif

  assign preferred_titles_string = 'Drinkglazen & bekers|Voorraadpotten & bewaren|Koffie & thee|Kruidenpotten & labels|Bestek & lepels|Keukenhulpen & dispensers|Kookaccessoires|Keukentextiel & accessoires|Glazen rietjes'
  assign preferred_titles = preferred_titles_string | split: '|'
-%}

<nav
  id="ZaynaCategoryPills-{{ section.id }}"
  class="zh-category-navigation"
  aria-label="Collecties"
>
  <div class="zh-category-rail">
    <div
      class="zh-category-rail__viewport"
      data-category-visible-viewport
      role="group"
      aria-label="Wissel tussen collecties"
    >
      <ul class="zh-category-rail__list">
        <li class="zh-category-rail__item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="zh-category-link{% if all_active %} is-active{% endif %}"
            aria-label="Alle producten"
            {% if all_active %}aria-current="page"{% endif %}
          >
            <span class="zh-category-link__short">Alle</span>
            <span class="zh-category-link__full">Alle producten</span>
          </a>
        </li>

        {%- if use_menu -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign is_active = false
              if link.url == collection.url
                assign is_active = true
              endif

              assign full_label = link.title
              assign short_label = full_label
              assign label_key = full_label | downcase

              if label_key contains 'drinkglazen' or label_key contains 'bekers'
                assign short_label = 'Glaswerk'
              elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                assign short_label = 'Voorraad'
              elsif label_key contains 'koffie' or label_key contains 'thee'
                assign short_label = 'Koffie & thee'
              elsif label_key contains 'kruiden'
                assign short_label = 'Kruiden'
              elsif label_key contains 'bestek' or label_key contains 'lepels'
                assign short_label = 'Bestek'
              elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                assign short_label = 'Keukenhulpen'
              elsif label_key contains 'kookaccessoires'
                assign short_label = 'Koken'
              elsif label_key contains 'keukentextiel'
                assign short_label = 'Textiel'
              elsif label_key contains 'rietjes'
                assign short_label = 'Rietjes'
              endif
            -%}

            <li class="zh-category-rail__item">
              <a
                href="{{ link.url }}"
                class="zh-category-link{% if is_active %} is-active{% endif %}"
                aria-label="{{ full_label | escape }}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                <span class="zh-category-link__short">{{ short_label | escape }}</span>
                <span class="zh-category-link__full">{{ full_label | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for preferred_title in preferred_titles -%}
            {%- for collection_item in collections -%}
              {%- if collection_item.title != preferred_title -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign is_active = false
                if collection_item.handle == collection.handle
                  assign is_active = true
                endif

                assign full_label = collection_item.title
                assign short_label = full_label
                assign label_key = full_label | downcase

                if label_key contains 'drinkglazen' or label_key contains 'bekers'
                  assign short_label = 'Glaswerk'
                elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                  assign short_label = 'Voorraad'
                elsif label_key contains 'koffie' or label_key contains 'thee'
                  assign short_label = 'Koffie & thee'
                elsif label_key contains 'kruiden'
                  assign short_label = 'Kruiden'
                elsif label_key contains 'bestek' or label_key contains 'lepels'
                  assign short_label = 'Bestek'
                elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                  assign short_label = 'Keukenhulpen'
                elsif label_key contains 'kookaccessoires'
                  assign short_label = 'Koken'
                elsif label_key contains 'keukentextiel'
                  assign short_label = 'Textiel'
                elsif label_key contains 'rietjes'
                  assign short_label = 'Rietjes'
                endif
              -%}

              <li class="zh-category-rail__item">
                <a
                  href="{{ collection_item.url }}"
                  class="zh-category-link{% if is_active %} is-active{% endif %}"
                  aria-label="{{ full_label | escape }}"
                  {% if is_active %}aria-current="page"{% endif %}
                >
                  <span class="zh-category-link__short">{{ short_label | escape }}</span>
                  <span class="zh-category-link__full">{{ full_label | escape }}</span>
                </a>
              </li>

              {%- break -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</nav>

<script>
  (() => {
    const root = document.getElementById('ZaynaCategoryPills-{{ section.id }}');
    const viewport = root?.querySelector('[data-category-visible-viewport]');
    const active = root?.querySelector('.zh-category-link.is-active');

    if (!viewport || !active) return;

    window.requestAnimationFrame(() => {
      if (window.matchMedia('(min-width: 1024px)').matches) return;

      const targetLeft = active.offsetLeft - ((viewport.clientWidth - active.offsetWidth) / 2);

      viewport.scrollTo({
        left: Math.max(0, targetLeft),
        top: 0,
        behavior: 'auto'
      });
    });
  })();
</script>

{% style %}
  #ZaynaCategoryPills-{{ section.id }} {
    position: relative;
    width: min(100%, 1180px);
    margin: 0 auto 11px;
    padding: 0 16px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail {
    position: relative;
    padding: 8px 0 13px;
    border-top: 1px solid rgba(42, 37, 32, 0.045);
    border-bottom: 1px solid rgba(42, 37, 32, 0.055);
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::before,
  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::after {
    position: absolute;
    top: 0;
    bottom: 1px;
    z-index: 2;
    width: 22px;
    content: '';
    pointer-events: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::before {
    left: 0;
    background: linear-gradient(
      90deg,
      var(--color-bg, #faf5f2) 10%,
      rgba(250, 245, 242, 0)
    );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail::after {
    right: 0;
    background: linear-gradient(
      270deg,
      var(--color-bg, #faf5f2) 10%,
      rgba(250, 245, 242, 0)
    );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport {
    min-width: 0;
    margin: 0 -16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 16px;
    scroll-padding: 16px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__viewport::-webkit-scrollbar {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__list {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 7px;
    margin: 0;
    padding: 1px 0 3px;
    list-style: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-rail__item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link {
    position: relative;
    display: inline-flex;
    min-height: 33px;
    align-items: center;
    justify-content: center;
    padding: 0 11px;
    border: 1px solid rgba(42, 37, 32, 0.07);
    border-radius: 999px;
    background: rgba(255, 253, 251, 0.30);
    color: rgba(42, 37, 32, 0.70);
    font-size: 12.3px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link__full {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link.is-active {
    border-color: rgba(166, 106, 63, 0.30);
    background: rgba(242, 232, 223, 0.68);
    box-shadow: inset 0 -1px 0 rgba(166, 106, 63, 0.28);
    color: #74482f;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 12px;
      padding-right: 24px;
      padding-left: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail {
      padding-top: 9px;
      padding-bottom: 14px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__viewport {
      margin-right: -24px;
      margin-left: -24px;
      padding-right: 24px;
      padding-left: 24px;
      scroll-padding: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__list {
      gap: 9px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link {
      min-height: 34px;
      padding-right: 12px;
      padding-left: 12px;
      font-size: 12.6px;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 14px;
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail {
      padding: 15px 0 17px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail::before,
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail::after {
      display: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__viewport {
      margin: 0;
      overflow: visible;
      padding: 0;
      scroll-padding: 0;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-rail__list {
      display: flex;
      width: min(100%, 1040px);
      flex-wrap: wrap;
      align-items: center;
      gap: 10px 18px;
      padding: 0;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link {
      min-height: 36px;
      padding: 0 10px;
      border-color: transparent;
      border-radius: 12px;
      background: transparent;
      box-shadow: none;
      color: rgba(42, 37, 32, 0.66);
      font-size: 13.6px;
      line-height: 1.08;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link__short {
      display: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link__full {
      display: inline;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link::after {
      position: absolute;
      right: 10px;
      bottom: 4px;
      left: 10px;
      height: 1px;
      background: rgba(166, 106, 63, 0.56);
      content: '';
      opacity: 0;
      transform: scaleX(0.72);
      transform-origin: center;
      transition:
        opacity 180ms ease,
        transform 180ms ease;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link.is-active {
      border-color: rgba(166, 106, 63, 0.12);
      background: rgba(242, 232, 223, 0.42);
      box-shadow: inset 0 -1px 0 rgba(166, 106, 63, 0.16);
      color: #74482f;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link.is-active::after {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link:hover:not(.is-active) {
      border-color: rgba(166, 106, 63, 0.18);
      background: rgba(242, 232, 223, 0.22);
      color: #8f5a39;
    }

    @media (min-width: 1024px) {
      #ZaynaCategoryPills-{{ section.id }}
        .zh-category-link:hover:not(.is-active) {
        border-color: transparent;
        background: rgba(242, 232, 223, 0.20);
      }

      #ZaynaCategoryPills-{{ section.id }}
        .zh-category-link:hover:not(.is-active)::after {
        opacity: 0.32;
        transform: scaleX(0.86);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link,
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Collectiemenu",
      "info": "Selecteer bij voorkeur één centraal Zayna Home-collectiemenu. De menuvolgorde wordt exact overgenomen. Zonder menu gebruikt de sectie automatisch de vaste Zayna Home-volgorde."
    }
  ],
  "presets": [
    {
      "name": "Category pills"
    }
  ]
}
{% endschema %}
