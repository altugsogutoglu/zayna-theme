{%- comment -%}
  Zayna Home — collectie navigatie, fase 2G.
  Zachte collectie-strip: geen pills, geen fades, directe winkelroute.
{%- endcomment -%}

{%- liquid
  assign menu = section.settings.menu
  assign use_menu = false

  if menu != blank and menu.links.size > 0
    assign use_menu = true
  endif

  assign all_active = false
  if collection.handle == 'all' or request.path == routes.all_products_collection_url
    assign all_active = true
  endif

  assign preferred_titles_string = 'Drinkglazen & bekers|Voorraadpotten & bewaren|Koffie & thee|Kruidenpotten & labels|Bestek & lepels|Keukenhulpen & dispensers|Kookaccessoires|Keukentextiel & accessoires|Glazen rietjes'
  assign preferred_titles = preferred_titles_string | split: '|'
-%}

<nav
  id="ZaynaCategoryPills-{{ section.id }}"
  class="zh-category-navigation"
  aria-label="Collecties"
>
  <div class="zh-category-strip">
    <div class="zh-category-strip__label" aria-hidden="true">
      <span></span>
      Collecties
    </div>

    <div
      class="zh-category-strip__viewport"
      data-category-visible-viewport
      role="group"
      aria-label="Wissel tussen collecties"
    >
      <ul class="zh-category-strip__list">
        <li class="zh-category-strip__item">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="zh-category-link{% if all_active %} is-active{% endif %}"
            aria-label="Alle producten"
            {% if all_active %}aria-current="page"{% endif %}
          >
            <span class="zh-category-link__short">Alle</span>
            <span class="zh-category-link__full">Alle producten</span>
          </a>
        </li>

        {%- if use_menu -%}
          {%- for link in menu.links -%}
            {%- liquid
              assign is_active = false
              if link.url == collection.url
                assign is_active = true
              endif

              assign full_label = link.title
              assign short_label = full_label
              assign label_key = full_label | downcase

              if label_key contains 'drinkglazen' or label_key contains 'bekers'
                assign short_label = 'Glaswerk'
              elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                assign short_label = 'Voorraad'
              elsif label_key contains 'koffie' or label_key contains 'thee'
                assign short_label = 'Koffie & thee'
              elsif label_key contains 'kruiden'
                assign short_label = 'Kruiden'
              elsif label_key contains 'bestek' or label_key contains 'lepels'
                assign short_label = 'Bestek'
              elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                assign short_label = 'Keukenhulpen'
              elsif label_key contains 'kookaccessoires'
                assign short_label = 'Koken'
              elsif label_key contains 'keukentextiel'
                assign short_label = 'Textiel'
              elsif label_key contains 'rietjes'
                assign short_label = 'Rietjes'
              endif
            -%}

            <li class="zh-category-strip__item">
              <a
                href="{{ link.url }}"
                class="zh-category-link{% if is_active %} is-active{% endif %}"
                aria-label="{{ full_label | escape }}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                <span class="zh-category-link__short">{{ short_label | escape }}</span>
                <span class="zh-category-link__full">{{ full_label | escape }}</span>
              </a>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for preferred_title in preferred_titles -%}
            {%- for collection_item in collections -%}
              {%- if collection_item.title != preferred_title -%}
                {%- continue -%}
              {%- endif -%}

              {%- liquid
                assign is_active = false
                if collection_item.handle == collection.handle
                  assign is_active = true
                endif

                assign full_label = collection_item.title
                assign short_label = full_label
                assign label_key = full_label | downcase

                if label_key contains 'drinkglazen' or label_key contains 'bekers'
                  assign short_label = 'Glaswerk'
                elsif label_key contains 'voorraad' or label_key contains 'bewaren'
                  assign short_label = 'Voorraad'
                elsif label_key contains 'koffie' or label_key contains 'thee'
                  assign short_label = 'Koffie & thee'
                elsif label_key contains 'kruiden'
                  assign short_label = 'Kruiden'
                elsif label_key contains 'bestek' or label_key contains 'lepels'
                  assign short_label = 'Bestek'
                elsif label_key contains 'keukenhulpen' or label_key contains 'dispensers'
                  assign short_label = 'Keukenhulpen'
                elsif label_key contains 'kookaccessoires'
                  assign short_label = 'Koken'
                elsif label_key contains 'keukentextiel'
                  assign short_label = 'Textiel'
                elsif label_key contains 'rietjes'
                  assign short_label = 'Rietjes'
                endif
              -%}

              <li class="zh-category-strip__item">
                <a
                  href="{{ collection_item.url }}"
                  class="zh-category-link{% if is_active %} is-active{% endif %}"
                  aria-label="{{ full_label | escape }}"
                  {% if is_active %}aria-current="page"{% endif %}
                >
                  <span class="zh-category-link__short">{{ short_label | escape }}</span>
                  <span class="zh-category-link__full">{{ full_label | escape }}</span>
                </a>
              </li>

              {%- break -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
</nav>

<script>
  (() => {
    const root = document.getElementById('ZaynaCategoryPills-{{ section.id }}');
    if (!root) return;

    const viewport = root.querySelector('[data-category-visible-viewport]');
    const active = root.querySelector('.zh-category-link.is-active');
    const prefetched = new Set();

    const scrollActiveIntoView = () => {
      if (!viewport || !active) return;
      if (window.matchMedia('(min-width: 1024px)').matches) return;

      const targetLeft = active.offsetLeft - ((viewport.clientWidth - active.offsetWidth) / 2);

      viewport.scrollTo({
        left: Math.max(0, targetLeft),
        top: 0,
        behavior: 'auto'
      });
    };

    const prefetch = (anchor) => {
      const href = anchor?.getAttribute('href');
      if (!href || prefetched.has(href)) return;

      const url = new URL(href, window.location.origin);
      if (url.origin !== window.location.origin) return;

      prefetched.add(href);

      const link = document.createElement('link');
      link.rel = 'prefetch';
      link.href = url.href;
      document.head.appendChild(link);
    };

    root.querySelectorAll('.zh-category-link').forEach((anchor) => {
      anchor.addEventListener('pointerenter', () => prefetch(anchor));
      anchor.addEventListener('focus', () => prefetch(anchor));
      anchor.addEventListener('touchstart', () => prefetch(anchor), { passive: true });

      anchor.addEventListener('click', (event) => {
        if (
          event.defaultPrevented ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          anchor.target === '_blank' ||
          anchor.getAttribute('aria-current') === 'page'
        ) {
          return;
        }

        root.classList.add('is-navigating');
        anchor.classList.add('is-navigating');
        root.setAttribute('aria-busy', 'true');
      });
    });

    window.requestAnimationFrame(scrollActiveIntoView);
  })();
</script>

{% style %}
  #ZaynaCategoryPills-{{ section.id }} {
    position: relative;
    width: min(100%, 1180px);
    margin: 0 auto 16px;
    padding: 0 16px;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-strip {
    position: relative;
    padding: 13px 0 12px;
    border-top: 1px solid rgba(42, 37, 32, 0.052);
    border-bottom: 1px solid rgba(42, 37, 32, 0.052);
    background:
      linear-gradient(
        180deg,
        rgba(255, 253, 251, 0.42),
        rgba(250, 247, 243, 0.24)
      );
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-strip__label {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-strip__viewport {
    min-width: 0;
    margin: 0 -16px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0 16px;
    scroll-padding: 16px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-strip__viewport::-webkit-scrollbar {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-strip__list {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 18px;
    margin: 0;
    padding: 1px 0 2px;
    list-style: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-strip__item {
    flex: 0 0 auto;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link {
    position: relative;
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    justify-content: center;
    padding: 0 2px 7px;
    color: rgba(42, 37, 32, 0.60);
    font-size: 13.4px;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 150ms ease,
      opacity 150ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link::after {
    position: absolute;
    right: 0;
    bottom: 3px;
    left: 0;
    height: 2px;
    border-radius: 99px;
    background: rgba(150, 90, 52, 0.68);
    content: '';
    opacity: 0;
    transform: scaleX(0.56);
    transform-origin: center;
    transition:
      opacity 150ms ease,
      transform 150ms ease;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link__full {
    display: none;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link.is-active {
    color: #5f3d2c;
    font-weight: 500;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link.is-active::after {
    opacity: 1;
    transform: scaleX(1);
  }

  #ZaynaCategoryPills-{{ section.id }}.is-navigating
    .zh-category-link:not(.is-navigating) {
    opacity: 0.46;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link.is-navigating {
    color: #74482f;
  }

  #ZaynaCategoryPills-{{ section.id }}
    .zh-category-link:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 5px;
  }

  @media (min-width: 640px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 18px;
      padding-right: 24px;
      padding-left: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip {
      padding-top: 14px;
      padding-bottom: 13px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip__viewport {
      margin-right: -24px;
      margin-left: -24px;
      padding-right: 24px;
      padding-left: 24px;
      scroll-padding: 24px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip__list {
      gap: 22px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link {
      min-height: 35px;
      font-size: 13.8px;
    }
  }

  @media (min-width: 1024px) {
    #ZaynaCategoryPills-{{ section.id }} {
      margin-bottom: 22px;
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip {
      display: grid;
      grid-template-columns: 120px minmax(0, 1fr);
      align-items: start;
      column-gap: 34px;
      padding: 18px 0 17px;
      background:
        linear-gradient(
          180deg,
          rgba(255, 253, 251, 0.48),
          rgba(250, 247, 243, 0.30)
        );
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip__label {
      display: flex;
      align-items: center;
      gap: 9px;
      padding-top: 10px;
      color: #9a6039;
      font-size: 9px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.19em;
      text-transform: uppercase;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip__label > span {
      width: 23px;
      height: 1px;
      background: rgba(166, 106, 63, 0.50);
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip__viewport {
      margin: 0;
      overflow: visible;
      padding: 0;
      scroll-padding: 0;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-strip__list {
      display: flex;
      width: min(100%, 940px);
      flex-wrap: wrap;
      align-items: center;
      gap: 12px 28px;
      padding: 0;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link {
      min-height: 34px;
      padding: 0 0 7px;
      color: rgba(42, 37, 32, 0.64);
      font-size: 14.6px;
      line-height: 1.12;
      letter-spacing: -0.01em;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link__short {
      display: none;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link__full {
      display: inline;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link.is-active {
      color: #5f3d2c;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link:hover:not(.is-active) {
      color: #8f5a39;
    }

    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link:hover:not(.is-active)::after {
      opacity: 0.28;
      transform: scaleX(0.72);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link,
    #ZaynaCategoryPills-{{ section.id }}
      .zh-category-link::after {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Collectiemenu",
      "info": "Selecteer bij voorkeur één centraal Zayna Home-collectiemenu. De menuvolgorde wordt exact overgenomen. Zonder menu gebruikt de sectie automatisch de vaste Zayna Home-volgorde."
    }
  ],
  "presets": [
    {
      "name": "Category pills"
    }
  ]
}
{% endschema %}
