{%- liquid
  assign s = section.settings

  assign brand_name = s.brand_name | default: shop.name
  assign brand_blurb = s.brand_blurb_v2 | default: 'Rustige keuken- en woonproducten voor een warm, verzorgd huis.'

  assign service_heading = 'Klantenservice'
  assign legal_heading = 'Juridisch'
  assign contact_heading = 'Contact'

  assign shipping_url = s.shipping_url | default: '/policies/shipping-policy'
  assign returns_url = s.returns_url | default: '/policies/refund-policy'
  assign return_request_url = s.return_request_url | default: '/pages/retour-aanmelden'
  assign terms_url = s.terms_url | default: '/policies/terms-of-service'
  assign privacy_url = s.privacy_url | default: '/policies/privacy-policy'

  assign footer_service_links = linklists[s.service_menu].links

  assign has_shipping = false
  assign has_returns = false
  assign has_return_request = false

  assign footer_logo_width = s.logo_width | default: 150
  assign footer_logo_style = 'max-width:' | append: footer_logo_width | append: 'px;'
-%}

<footer
  id="ZaynaFooter-{{ section.id }}"
  class="zayna-footer"
>
  <div class="zayna-footer__main">
    <div class="zayna-footer__brand">
      <a
        href="{{ routes.root_url }}"
        class="zayna-footer__brand-link"
        aria-label="{{ brand_name | escape }}"
      >
        {%- if s.logo != blank -%}
          {{
            s.logo
            | image_url: width: 720
            | image_tag:
              loading: 'lazy',
              widths: '140, 220, 320, 480, 720',
              sizes: '(min-width: 960px) 180px, 160px',
              class: 'zayna-footer__logo',
              style: footer_logo_style,
              alt: brand_name
          }}
        {%- else -%}
          <span class="zayna-footer__wordmark">
            {{ brand_name | escape }}
          </span>
        {%- endif -%}
      </a>

      <p class="zayna-footer__blurb">
        {{ brand_blurb | escape }}
      </p>
    </div>

    <div class="zayna-footer__groups">
      <details class="zayna-footer__group">
        <summary class="zayna-footer__summary">
          <span class="zayna-footer__summary-label">
            <span aria-hidden="true"></span>
            {{ service_heading }}
          </span>

          <svg
            class="zayna-footer__chevron"
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
          >
            <path
              d="M3.5 6L8 10.5L12.5 6"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>

        <nav
          class="zayna-footer__content"
          aria-label="{{ service_heading }}"
        >
          <ul class="zayna-footer__links">
            {%- for link in footer_service_links -%}
              {%- liquid
                assign footer_link_title = link.title | downcase
                assign footer_link_url = link.url | downcase

                assign skip_footer_link = false
                assign footer_link_label = link.title
                assign is_return_request_link = false

                if footer_link_title contains 'zoek' or footer_link_url contains '/search'
                  assign skip_footer_link = true
                endif

                if footer_link_title contains 'contact' or footer_link_url contains '/contact'
                  assign skip_footer_link = true
                endif

                if footer_link_url contains 'terms-of-service' or footer_link_url contains 'privacy-policy'
                  assign skip_footer_link = true
                endif

                if footer_link_title contains 'algemene voorwaarden' or footer_link_title contains 'privacy'
                  assign skip_footer_link = true
                endif

                if footer_link_title contains 'track' or footer_link_title contains 'bestelling volgen' or footer_link_url contains 'track-order'
                  assign skip_footer_link = true
                endif

                if footer_link_title contains 'retour aanmelden' or footer_link_url contains 'retour-aanmelden'
                  assign has_return_request = true
                  assign is_return_request_link = true
                  assign footer_link_label = 'Retour aanmelden'
                endif

                if footer_link_title contains 'verzend' or footer_link_url contains 'shipping-policy'
                  assign has_shipping = true
                  assign footer_link_label = 'Verzending'
                endif

                if is_return_request_link == false
                  if footer_link_title contains 'retour' or footer_link_url contains 'refund-policy'
                    assign has_returns = true
                    assign footer_link_label = 'Retourneren'
                  endif
                endif
              -%}

              {%- unless skip_footer_link -%}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="zayna-footer__link"
                    {% if link.url contains 'http' %}
                      target="_blank"
                      rel="noopener noreferrer"
                    {% endif %}
                  >
                    <span>{{ footer_link_label | escape }}</span>
                  </a>
                </li>
              {%- endunless -%}
            {%- endfor -%}

            {%- unless has_shipping -%}
              <li>
                <a
                  href="{{ shipping_url }}"
                  class="zayna-footer__link"
                >
                  <span>Verzending</span>
                </a>
              </li>
            {%- endunless -%}

            {%- unless has_returns -%}
              <li>
                <a
                  href="{{ returns_url }}"
                  class="zayna-footer__link"
                >
                  <span>Retourneren</span>
                </a>
              </li>
            {%- endunless -%}

            {%- unless has_return_request -%}
              <li>
                <a
                  href="{{ return_request_url }}"
                  class="zayna-footer__link"
                >
                  <span>Retour aanmelden</span>
                </a>
              </li>
            {%- endunless -%}
          </ul>
        </nav>
      </details>

      <details class="zayna-footer__group">
        <summary class="zayna-footer__summary">
          <span class="zayna-footer__summary-label">
            <span aria-hidden="true"></span>
            {{ legal_heading }}
          </span>

          <svg
            class="zayna-footer__chevron"
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
          >
            <path
              d="M3.5 6L8 10.5L12.5 6"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>

        <nav
          class="zayna-footer__content"
          aria-label="{{ legal_heading }}"
        >
          <ul class="zayna-footer__links">
            <li>
              <a
                href="{{ terms_url }}"
                class="zayna-footer__link"
              >
                <span>Algemene voorwaarden</span>
              </a>
            </li>

            <li>
              <a
                href="{{ privacy_url }}"
                class="zayna-footer__link"
              >
                <span>Privacybeleid</span>
              </a>
            </li>
          </ul>
        </nav>
      </details>

      <details class="zayna-footer__group">
        <summary class="zayna-footer__summary">
          <span class="zayna-footer__summary-label">
            <span aria-hidden="true"></span>
            {{ contact_heading }}
          </span>

          <svg
            class="zayna-footer__chevron"
            aria-hidden="true"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
          >
            <path
              d="M3.5 6L8 10.5L12.5 6"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </summary>

        <div class="zayna-footer__content">
          <ul class="zayna-footer__links">
            {%- if s.contact_email_label != blank -%}
              <li>
                <a
                  href="{{ s.contact_email_url | default: 'mailto:info@zaynahome.nl' }}"
                  class="zayna-footer__link"
                >
                  <span>{{ s.contact_email_label | escape }}</span>
                </a>
              </li>
            {%- endif -%}

            {%- if s.instagram_url != blank -%}
              <li>
                <a
                  href="{{ s.instagram_url }}"
                  class="zayna-footer__link zayna-footer__link--social"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {% render 'icon', name: 'instagram', size: 17 %}
                  <span>Instagram</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        </div>
      </details>
    </div>
  </div>

  <div class="zayna-footer__bottom">
    <div class="zayna-footer__bottom-inner">
      <div class="zayna-footer__payments">
        <p class="zayna-footer__meta-label">
          Betaalmethoden
        </p>

        {% render 'payment-icons' %}
      </div>

      <dl class="zayna-footer__business">
        {%- if s.kvk != blank -%}
          <div>
            <dt>KvK</dt>
            <dd>{{ s.kvk | escape }}</dd>
          </div>
        {%- endif -%}

        {%- if s.btw != blank -%}
          <div>
            <dt>BTW</dt>
            <dd>{{ s.btw | escape }}</dd>
          </div>
        {%- endif -%}
      </dl>

      <div class="zayna-footer__closing">
        <span>
          © {{ 'now' | date: '%Y' }} {{ brand_name | escape }}
        </span>

        {% render 'localization-form' %}
      </div>
    </div>
  </div>
</footer>


<script>
  (() => {
    const footer = document.getElementById(
      'ZaynaFooter-{{ section.id }}'
    );

    if (!footer) return;

    const groups = Array.from(
      footer.querySelectorAll('.zayna-footer__group')
    );
    const desktopQuery = window.matchMedia('(min-width: 960px)');
    const reducedMotionQuery = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

    const runningAnimations = new WeakMap();
    const animationDuration = 230;
    const animationEasing = 'cubic-bezier(0.22, 1, 0.36, 1)';

    const getSummary = (group) =>
      group.querySelector('.zayna-footer__summary');

    const setExpandedState = (group, isOpen) => {
      const summary = getSummary(group);

      if (summary) {
        summary.setAttribute(
          'aria-expanded',
          isOpen ? 'true' : 'false'
        );
      }
    };

    const cancelGroupAnimation = (group) => {
      const animation = runningAnimations.get(group);

      if (animation) {
        animation.cancel();
        runningAnimations.delete(group);
      }

      group.style.removeProperty('height');
      group.style.removeProperty('overflow');
    };

    const setGroupImmediately = (group, isOpen) => {
      cancelGroupAnimation(group);
      group.open = isOpen;
      setExpandedState(group, isOpen);
    };

    const animateGroup = (group, shouldOpen) => {
      cancelGroupAnimation(group);

      const summary = getSummary(group);

      if (!summary) {
        setGroupImmediately(group, shouldOpen);
        return Promise.resolve();
      }

      if (reducedMotionQuery.matches) {
        setGroupImmediately(group, shouldOpen);
        return Promise.resolve();
      }

      const startHeight = group.getBoundingClientRect().height;

      if (shouldOpen) {
        group.open = true;
      }

      setExpandedState(group, shouldOpen);

      const endHeight = shouldOpen
        ? group.scrollHeight
        : summary.getBoundingClientRect().height;

      group.style.height = `${startHeight}px`;
      group.style.overflow = 'clip';

      const animation = group.animate(
        [
          { height: `${startHeight}px` },
          { height: `${endHeight}px` }
        ],
        {
          duration: animationDuration,
          easing: animationEasing
        }
      );

      runningAnimations.set(group, animation);

      return new Promise((resolve) => {
        const finish = () => {
          if (runningAnimations.get(group) !== animation) {
            resolve();
            return;
          }

          runningAnimations.delete(group);

          if (!shouldOpen) {
            group.open = false;
          }

          group.style.removeProperty('height');
          group.style.removeProperty('overflow');
          setExpandedState(group, shouldOpen);
          resolve();
        };

        animation.addEventListener('finish', finish, { once: true });
        animation.addEventListener(
          'cancel',
          () => resolve(),
          { once: true }
        );
      });
    };

    const keepAnchorStable = async (summary, animations) => {
      const initialTop = summary.getBoundingClientRect().top;

      if (reducedMotionQuery.matches) {
        await Promise.all(animations);

        const finalDifference =
          summary.getBoundingClientRect().top - initialTop;

        if (Math.abs(finalDifference) > 0.5) {
          window.scrollBy(0, finalDifference);
        }

        return;
      }

      let active = true;
      let frameId = 0;

      const stabilise = () => {
        if (!active) return;

        const difference =
          summary.getBoundingClientRect().top - initialTop;

        if (Math.abs(difference) > 0.5) {
          window.scrollBy(0, difference);
        }

        frameId = window.requestAnimationFrame(stabilise);
      };

      frameId = window.requestAnimationFrame(stabilise);

      await Promise.all(animations);

      active = false;
      window.cancelAnimationFrame(frameId);

      const finalDifference =
        summary.getBoundingClientRect().top - initialTop;

      if (Math.abs(finalDifference) > 0.5) {
        window.scrollBy(0, finalDifference);
      }
    };

    const syncFooterGroups = (isDesktop) => {
      groups.forEach((group) => {
        const summary = getSummary(group);

        setGroupImmediately(group, isDesktop);

        if (isDesktop) {
          summary?.setAttribute('aria-disabled', 'true');
          summary?.setAttribute('tabindex', '-1');
        } else {
          summary?.removeAttribute('aria-disabled');
          summary?.removeAttribute('tabindex');
        }
      });
    };

    groups.forEach((group) => {
      const summary = getSummary(group);

      if (!summary) return;

      summary.addEventListener('click', async (event) => {
        if (desktopQuery.matches) {
          event.preventDefault();
          return;
        }

        event.preventDefault();

        const shouldOpen = !group.open;
        const animations = [];

        if (shouldOpen) {
          groups.forEach((otherGroup) => {
            if (otherGroup !== group && otherGroup.open) {
              animations.push(
                animateGroup(otherGroup, false)
              );
            }
          });
        }

        animations.push(
          animateGroup(group, shouldOpen)
        );

        await keepAnchorStable(summary, animations);
      });
    });

    syncFooterGroups(desktopQuery.matches);

    const handleDesktopChange = (event) => {
      syncFooterGroups(event.matches);
    };

    if (typeof desktopQuery.addEventListener === 'function') {
      desktopQuery.addEventListener(
        'change',
        handleDesktopChange
      );
    } else {
      desktopQuery.addListener(handleDesktopChange);
    }
  })();
</script>

{% style %}
  #ZaynaFooter-{{ section.id }} {
    --zayna-footer-bg: #f4efe9;
    --zayna-footer-ink: #2b2622;
    --zayna-footer-soft: #6f665e;
    --zayna-footer-muted: #8c8178;
    --zayna-footer-accent: #ad7044;
    --zayna-footer-border: #dfd4ca;

    border-top: 1px solid var(--zayna-footer-border);
    background: var(--zayna-footer-bg);
    color: var(--zayna-footer-ink);
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__main {
    display: grid;
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 38px 20px 34px;
    gap: 28px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__brand {
    max-width: 420px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__brand-link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__logo {
    display: block;
    width: auto;
    height: auto;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__wordmark {
    display: block;
    font-family:
      var(
        --font-signature,
        var(
          --font-display,
          var(--font-heading-family, Georgia, serif)
        )
      );
    font-size: 32px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__blurb {
    max-width: 36ch;
    margin: 13px 0 0;
    color: var(--zayna-footer-soft);
    font-size: 14px;
    line-height: 1.62;
    text-wrap: pretty;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__groups {
    border-top: 1px solid var(--zayna-footer-border);
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__group {
    border-bottom: 1px solid var(--zayna-footer-border);
    overflow-anchor: none;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__summary {
    display: flex;
    width: 100%;
    min-height: 52px;
    align-items: center;
    justify-content: flex-start;
    gap: 18px;
    padding: 0;
    color: var(--zayna-footer-ink);
    cursor: pointer;
    list-style: none;
    -webkit-tap-highlight-color: transparent;
  }

  #ZaynaFooter-{{ section.id }}
    .zayna-footer__summary::-webkit-details-marker {
    display: none;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__summary-label {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #ZaynaFooter-{{ section.id }}
    .zayna-footer__summary-label
    > span {
    display: block;
    width: 22px;
    height: 1px;
    flex: 0 0 22px;
    background: rgba(173, 112, 68, 0.72);
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__chevron {
    margin-left: auto;
    flex: 0 0 auto;
    color: var(--zayna-footer-soft);
    transition:
      color 180ms ease,
      transform 220ms ease;
  }

  #ZaynaFooter-{{ section.id }}
    .zayna-footer__group[open]
    .zayna-footer__chevron {
    color: var(--zayna-footer-accent);
    transform: rotate(180deg);
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__content {
    padding: 1px 0 12px 32px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__links {
    display: grid;
    margin: 0;
    padding: 0;
    gap: 1px;
    list-style: none;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__link {
    display: flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    justify-content: space-between;
    color: var(--zayna-footer-soft);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 16px;
    line-height: 1.35;
    text-decoration: none;
    transition: color 180ms ease;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__link--social {
    justify-content: flex-start;
  }

  #ZaynaFooter-{{ section.id }}
    .zayna-footer__summary:focus-visible,
  #ZaynaFooter-{{ section.id }}
    .zayna-footer__brand-link:focus-visible,
  #ZaynaFooter-{{ section.id }}
    .zayna-footer__link:focus-visible {
    outline: 2px solid var(--zayna-footer-accent);
    outline-offset: 3px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__bottom {
    border-top: 1px solid var(--zayna-footer-border);
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__bottom-inner {
    display: grid;
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 23px 20px 25px;
    gap: 20px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__payments {
    display: grid;
    justify-items: start;
    gap: 9px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__meta-label {
    margin: 0;
    color: var(--zayna-footer-muted);
    font-size: 9.5px;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__business {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    gap: 10px 18px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__business > div {
    display: flex;
    align-items: baseline;
    gap: 7px;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__business dt {
    color: var(--zayna-footer-muted);
    font-size: 9.5px;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__business dd {
    margin: 0;
    color: #756b62;
    font-size: 13px;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }

  #ZaynaFooter-{{ section.id }} .zayna-footer__closing {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 13px 18px;
    color: #756b62;
    font-size: 13px;
    line-height: 1.45;
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaFooter-{{ section.id }} .zayna-footer__summary:hover {
      color: var(--zayna-footer-accent);
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__link:hover {
      color: var(--zayna-footer-ink);
    }

  }

  @media (max-width: 389px) {
    #ZaynaFooter-{{ section.id }} .zayna-footer__main {
      padding: 32px 18px 30px;
      gap: 24px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__wordmark {
      font-size: 30px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__blurb {
      font-size: 13.5px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__bottom-inner {
      padding-right: 18px;
      padding-left: 18px;
    }
  }

  @media (min-width: 700px) and (max-width: 959px) {
    #ZaynaFooter-{{ section.id }} .zayna-footer__wordmark {
      font-size: 31px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__main {
      padding-right: 28px;
      padding-left: 28px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__brand {
      max-width: 460px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__bottom-inner {
      padding-right: 28px;
      padding-left: 28px;
    }
  }


  /*
    Op een gesplitst laptopvenster blijven de rijen compact,
    terwijl echte touchscreens de ruimere tikhoogtes behouden.
  */
  @media (hover: hover) and (pointer: fine) and (min-width: 560px) and (max-width: 959px) {
    #ZaynaFooter-{{ section.id }} .zayna-footer__main {
      padding-top: 32px;
      padding-bottom: 28px;
      gap: 22px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__summary {
      min-height: 48px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__content {
      padding: 0 0 6px 24px;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__links {
      gap: 0;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__link {
      min-height: 34px;
      font-size: 15px;
      line-height: 1.28;
    }

    #ZaynaFooter-{{ section.id }} .zayna-footer__bottom-inner {
      padding-top: 20px;
