{%- liquid
  assign cv = product.selected_or_first_available_variant
  assign coll = product.collections.first
  assign is_sold = true
  if cv.available
    assign is_sold = false
  endif

  assign cond_raw = product.metafields.custom.condition.value | downcase | strip
  assign cond_label = ''
  assign cond_style = ''
  case cond_raw
    when 'new'
      assign cond_label = 'Nieuw'
      assign cond_style = 'is-positive'
    when 'new without tags', 'nieuw zonder prijskaartje'
      assign cond_label = 'Nieuw zonder prijskaartje'
      assign cond_style = 'is-positive'
    when 'very good', 'heel goed'
      assign cond_label = 'Zeer goede staat'
      assign cond_style = 'is-neutral'
    when 'good', 'goed'
      assign cond_label = 'Goede staat'
      assign cond_style = 'is-neutral'
  endcase

  assign lbl_add = 'In winkelmand'
  assign lbl_sold = 'Uitverkocht'
  assign lbl_in_stock = 'Op voorraad'
  assign lbl_delivery = 'Indicatieve levering binnen 1–3 werkdagen'
  assign lbl_unavailable = 'Deze combinatie is niet beschikbaar'
  assign lbl_price_on_request = section.settings.price_on_request | default: 'Prijs op aanvraag'

  for b in section.blocks
    if b.type == 'buy_buttons'
      assign lbl_add = b.settings.add_label
      assign lbl_sold = b.settings.sold_label
    endif
    if b.type == 'info'
      assign lbl_in_stock = b.settings.in_stock_text
      assign lbl_delivery = b.settings.delivery_text
      assign lbl_sold = b.settings.sold_text
      assign lbl_unavailable = b.settings.unavailable_text
      assign lbl_price_on_request = b.settings.price_on_request
    endif
  endfor

  assign compare_visible = false
  if cv.compare_at_price and cv.compare_at_price > cv.price
    assign compare_visible = true
  endif

  assign selected_min = cv.quantity_rule.min | default: 1
  assign selected_increment = cv.quantity_rule.increment | default: 1
  assign selected_max = cv.quantity_rule.max
  if selected_max == blank and cv.inventory_management != blank and cv.inventory_policy == 'deny'
    assign selected_max = cv.inventory_quantity
  endif
  if selected_max != blank and selected_max < selected_min
    assign selected_max = selected_min
  endif

  assign similar_url = routes.all_products_collection_url
  if coll
    assign similar_url = coll.url
  endif
-%}

{% style %}
  .zh-product {
    --zh-product-border: rgb(42 37 32 / 12%);
    --zh-product-muted: rgb(42 37 32 / 68%);
    position: relative;
  }

  .zh-product__breadcrumb {
    padding-top: 1rem;
  }

  .zh-product__breadcrumb ol {
    display: flex;
    align-items: center;
    gap: .55rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: .72rem;
    line-height: 1.4;
    color: var(--zh-product-muted);
  }

  .zh-product__breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .zh-product__breadcrumb a:hover,
  .zh-product__breadcrumb a:focus-visible {
    color: var(--color-clay, #955c39);
  }

  .zh-product__purchase {
    display: grid;
    gap: 2rem;
    padding-top: 1.25rem;
    padding-bottom: 3rem;
  }

  .zh-product__gallery-column,
  .zh-product__buy-column {
    min-width: 0;
  }

  .zh-product__buy-column {
    align-self: start;
  }

  .zh-product__collection-link {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    margin-bottom: 1rem;
    color: var(--color-clay, #955c39);
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .12em;
    line-height: 1.4;
    text-decoration: none;
    text-transform: uppercase;
  }

  .zh-product__collection-link::before {
    width: 1.7rem;
    height: 1px;
    background: currentColor;
    content: '';
    opacity: .55;
  }

  .zh-product__title {
    max-width: 24ch;
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-size: clamp(1.85rem, 7vw, 2.35rem);
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: 1.08;
  }

  .zh-product__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .7rem;
    margin-top: 1rem;
  }

  .zh-product__price {
    color: var(--color-ink, #2a2520);
    font-size: 1.55rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .zh-product__compare-price {
    color: var(--zh-product-muted);
    font-size: .85rem;
    text-decoration: line-through;
  }

  .zh-product__status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .65rem 1rem;
    margin-top: 1.1rem;
  }

  .zh-product__condition {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: .25rem .65rem;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .zh-product__condition.is-positive {
    background: rgb(111 132 104 / 12%);
    color: #61745b;
  }

  .zh-product__condition.is-neutral {
    background: rgb(118 110 103 / 10%);
    color: #6d655f;
  }

  .zh-product__availability {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .42rem;
    min-width: 0;
    color: var(--zh-product-muted);
    font-size: .82rem;
    line-height: 1.5;
  }

  .zh-product__availability.is-sold {
    color: var(--color-sold, #9b4c43);
  }

  .zh-product__availability-dot {
    width: .45rem;
    height: .45rem;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--color-sage, #71826d);
  }

  .zh-product__availability.is-sold .zh-product__availability-dot {
    background: var(--color-sold, #9b4c43);
  }

  .zh-product__availability-main {
    color: var(--color-ink, #2a2520);
    font-weight: 600;
  }

  .zh-product__availability.is-sold .zh-product__availability-main {
    color: inherit;
  }

  .zh-product__availability-separator {
    opacity: .45;
  }

  .zh-product__intro {
    max-width: 58ch;
    margin: 1.25rem 0 0;
    color: var(--zh-product-muted);
    font-size: .96rem;
    line-height: 1.75;
  }

  .zh-product__form-wrap {
    margin-top: 1.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--zh-product-border);
  }

  .zh-product__options {
    display: grid;
    gap: 1.35rem;
    margin-bottom: 1.4rem;
  }

  .zh-product__option-fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .zh-product__option-legend {
    margin-bottom: .65rem;
    color: var(--zh-product-muted);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .zh-product__option-list {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
  }

  .zh-product__option-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    min-height: 2.65rem;
    padding: .55rem .9rem;
    border: 1px solid var(--zh-product-border);
    background: transparent;
    color: var(--zh-product-muted);
    font: inherit;
    font-size: .86rem;
    line-height: 1.2;
    cursor: pointer;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }

  .zh-product__option-button:hover:not(:disabled) {
    border-color: rgb(149 92 57 / 45%);
    color: var(--color-ink, #2a2520);
  }

  .zh-product__option-button[aria-checked='true'] {
    border-color: var(--color-clay, #955c39);
    background: rgb(149 92 57 / 7%);
    color: var(--color-ink, #2a2520);
  }

  .zh-product__option-button:disabled {
    cursor: not-allowed;
    opacity: .38;
    text-decoration: line-through;
  }

  .zh-product__option-button:focus-visible,
  .zh-product__qty-button:focus-visible,
  .zh-product__add-button:focus-visible,
  .zh-product__sold-link:focus-visible,
  .zh-product__accordion summary:focus-visible {
    outline: 2px solid var(--color-clay, #955c39);
    outline-offset: 3px;
  }

  .zh-product__swatch {
    width: 1rem;
    height: 1rem;
    overflow: hidden;
    border: 1px solid var(--zh-product-border);
    border-radius: 999px;
  }

  .zh-product__actions {
    display: flex;
    align-items: stretch;
    gap: .7rem;
  }

  .zh-product__qty {
    display: inline-grid;
    grid-template-columns: 2.6rem 2.7rem 2.6rem;
    align-items: stretch;
    height: 3.35rem;
    flex: 0 0 auto;
    border: 1px solid var(--zh-product-border);
    background: var(--color-surface, #fffdfb);
  }

  .zh-product__qty-button {
    display: grid;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--zh-product-muted);
    cursor: pointer;
    transition: color 160ms ease, opacity 160ms ease;
  }

  .zh-product__qty-button:hover:not(:disabled) {
    color: var(--color-clay, #955c39);
  }

  .zh-product__qty-button:disabled {
    cursor: default;
    opacity: .28;
  }

  .zh-product__qty-value {
    display: grid;
    place-items: center;
    color: var(--color-ink, #2a2520);
    font-size: .95rem;
    font-variant-numeric: tabular-nums;
  }

  .zh-product__add-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    width: 100%;
    min-height: 3.35rem;
    padding: .8rem 1rem;
    border: 1px solid var(--color-ink, #2a2520);
    background: var(--color-ink, #2a2520);
    color: #fff;
    font: inherit;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .12em;
    line-height: 1.2;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease, opacity 160ms ease;
  }

  .zh-product__add-button:hover:not(:disabled) {
    border-color: var(--color-clay, #955c39);
    background: var(--color-clay, #955c39);
  }

  .zh-product__add-button:disabled {
    cursor: not-allowed;
    opacity: .55;
  }

  .zh-product__sold-state {
    display: grid;
    gap: .8rem;
    padding: 1rem 0 0;
  }

  .zh-product__sold-message {
    margin: 0;
    color: var(--color-sold, #9b4c43);
    font-size: .9rem;
    line-height: 1.55;
  }

  .zh-product__sold-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.2rem;
    padding: .75rem 1rem;
    border: 1px solid var(--zh-product-border);
    color: var(--color-ink, #2a2520);
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .08em;
    line-height: 1.3;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color 160ms ease, color 160ms ease, background-color 160ms ease;
  }

  .zh-product__sold-link:hover {
    border-color: rgb(149 92 57 / 45%);
    background: rgb(149 92 57 / 5%);
    color: var(--color-clay, #955c39);
  }

  .zh-product__trust {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--zh-product-border);
  }

  .zh-product__trust-list {
    display: flex;
    flex-wrap: wrap;
    gap: .6rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zh-product__trust-item {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--zh-product-muted);
    font-size: .77rem;
    line-height: 1.4;
  }

  .zh-product__trust-item svg {
    color: var(--color-clay, #955c39);
  }

  .zh-product__payments {
    margin-top: .8rem;
  }

  .zh-product__features {
    margin-top: 1.25rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--zh-product-border);
  }

  .zh-product__feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .7rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zh-product__details {
    border-top: 1px solid var(--zh-product-border);
    padding-top: 2.75rem;
    padding-bottom: 3rem;
  }

  .zh-product__details-grid {
    display: grid;
    gap: 2.5rem;
  }

  .zh-product__section-eyebrow {
    margin: 0 0 .65rem;
    color: var(--color-clay, #955c39);
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .zh-product__section-title {
    margin: 0 0 1.15rem;
    color: var(--color-ink, #2a2520);
    font-size: clamp(1.55rem, 4vw, 2rem);
    font-weight: 400;
    line-height: 1.18;
  }

  .zh-product__description {
    max-width: 68ch;
    color: var(--zh-product-muted);
    font-size: .94rem;
    line-height: 1.8;
  }

  .zh-product__description > :first-child {
    margin-top: 0;
  }

  .zh-product__description > :last-child {
    margin-bottom: 0;
  }

  .zh-product__description h2,
  .zh-product__description h3,
  .zh-product__description h4 {
    margin: 1.6rem 0 .7rem;
    color: var(--color-ink, #2a2520);
    font-weight: 400;
    line-height: 1.25;
  }

  .zh-product__description h3 {
    font-size: 1.2rem;
  }

  .zh-product__description ul,
  .zh-product__description ol {
    padding-left: 1.15rem;
  }

  .zh-product__specs {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--zh-product-border);
  }

  .zh-product__spec-row {
    display: grid;
    grid-template-columns: minmax(6.5rem, .8fr) minmax(0, 1.4fr);
    gap: 1rem;
    padding: .85rem 0;
    border-bottom: 1px solid var(--zh-product-border);
    font-size: .86rem;
    line-height: 1.55;
  }

  .zh-product__spec-row dt {
    color: var(--zh-product-muted);
  }

  .zh-product__spec-row dd {
    margin: 0;
    color: var(--color-ink, #2a2520);
  }

  .zh-product__note {
    margin-top: 1.8rem;
    padding-left: 1rem;
    border-left: 2px solid rgb(149 92 57 / 50%);
  }

  .zh-product__note blockquote {
    margin: 0;
    color: var(--zh-product-muted);
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.5;
  }

  .zh-product__note figcaption {
    margin-top: .65rem;
    color: var(--color-ink, #2a2520);
    font-size: .8rem;
  }

  .zh-product__accordions {
    margin-top: 2.5rem;
    border-top: 1px solid var(--zh-product-border);
  }

  .zh-product__accordion {
    border-bottom: 1px solid var(--zh-product-border);
  }

  .zh-product__accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    color: var(--color-ink, #2a2520);
    font-size: 1.05rem;
    line-height: 1.35;
    list-style: none;
    cursor: pointer;
  }

  .zh-product__accordion summary::-webkit-details-marker {
    display: none;
  }

  .zh-product__accordion-icon {
    flex: 0 0 auto;
    color: var(--zh-product-muted);
    transition: transform 180ms ease;
  }

  .zh-product__accordion[open] .zh-product__accordion-icon {
    transform: rotate(180deg);
  }

  .zh-product__accordion-body {
    max-width: 68ch;
    padding: 0 2.2rem 1.2rem 0;
    color: var(--zh-product-muted);
    font-size: .88rem;
    line-height: 1.75;
  }

  .zh-product__accordion-body > :first-child {
    margin-top: 0;
  }

  .zh-product__accordion-body > :last-child {
    margin-bottom: 0;
  }

  .zh-sticky-atc {
    display: none;
  }

  .zh-visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  [hidden] {
    display: none !important;
  }

  @media (min-width: 700px) {
    .zh-product__feature-list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 880px) {
    .zh-product__breadcrumb {
      padding-top: 1.35rem;
    }

    .zh-product__purchase {
      grid-template-columns: minmax(0, .88fr) minmax(22rem, 1.12fr);
      gap: clamp(2.5rem, 5vw, 4.75rem);
      padding-top: 1.75rem;
      padding-bottom: 4rem;
    }

    .zh-product__gallery-column {
      position: sticky;
      top: 6.5rem;
      align-self: start;
    }

    .zh-product__buy-column {
      padding-top: .35rem;
    }

    .zh-product__title {
      max-width: 20ch;
      font-size: clamp(2.05rem, 3.4vw, 2.65rem);
    }

    .zh-product__details {
      padding-top: 3.5rem;
      padding-bottom: 4rem;
    }

    .zh-product__details-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(17rem, .8fr);
      gap: clamp(3rem, 7vw, 6.5rem);
      align-items: start;
    }

    .zh-product__accordions {
      max-width: 58rem;
      margin-top: 3rem;
    }
  }

  @media (min-width: 1180px) {
    .zh-product__purchase {
      grid-template-columns: minmax(0, 1fr) minmax(26rem, .83fr);
    }
  }

  @media (max-width: 767px) {
    .zh-sticky-atc {
      position: fixed;
      z-index: 45;
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      padding: .65rem 1rem calc(.65rem + env(safe-area-inset-bottom));
      border-top: 1px solid var(--zh-product-border);
      background: rgb(255 253 251 / 96%);
      box-shadow: 0 -8px 28px rgb(42 37 32 / 8%);
      backdrop-filter: blur(12px);
      transform: translateY(110%);
      transition: transform 220ms ease;
    }

    .zh-sticky-atc.is-visible {
      transform: translateY(0);
    }

    .zh-sticky-atc__inner {
      display: grid;
      grid-template-columns: minmax(4.75rem, auto) minmax(0, 1fr);
      gap: .7rem;
      align-items: center;
    }

    .zh-sticky-atc__price {
      color: var(--color-ink, #2a2520);
        font-size: 1rem;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .zh-sticky-atc .zh-product__add-button {
      min-height: 3rem;
    }

    body.zh-product-sticky-visible {
      padding-bottom: var(--zh-sticky-atc-height, 4.6rem);
    }
  }

  @media (max-width: 420px) {
    .zh-product__actions {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
    }

    .zh-product__qty {
      grid-template-columns: 2.35rem 2.45rem 2.35rem;
    }

    .zh-product__trust-list {
      display: grid;
      gap: .55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-product *,
    .zh-sticky-atc {
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
{% endstyle %}

<section data-product-root data-current-available="{% if cv.available %}true{% else %}false{% endif %}" class="zh-product">
  <nav aria-label="Kruimelpad" class="zh-product__breadcrumb mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <ol>
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- if coll -%}
        <li aria-hidden="true">/</li>
        <li><a href="{{ coll.url }}">{{ coll.title }}</a></li>
      {%- endif -%}
    </ol>
  </nav>

  <div class="zh-product__purchase mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
    <div class="zh-product__gallery-column">
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery' -%}
          <div {{ block.shopify_attributes }}>
            {% render 'product-gallery', product: product, is_sold: is_sold %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="zh-product__buy-column">
      {%- for block in section.blocks -%}
        {%- if block.type == 'info' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.show_collection and coll -%}
              <a href="{{ coll.url }}" class="zh-product__collection-link">{{ coll.title }}</a>
            {%- endif -%}

            <h1 class="zh-product__title font-display">{{ product.title }}</h1>

            <div class="zh-product__price-row">
              <span data-price class="zh-product__price font-display">
                {%- if cv.price and cv.price > 0 -%}
                  {{ cv.price | money }}
                {%- else -%}
                  {{ block.settings.price_on_request }}
                {%- endif -%}
              </span>
              <span data-compare-price class="zh-product__compare-price"{% unless compare_visible %} hidden{% endunless %}>
                {%- if compare_visible -%}{{ cv.compare_at_price | money }}{%- endif -%}
              </span>
            </div>

            <div class="zh-product__status-row">
              {%- if cond_label != blank -%}
                <span class="zh-product__condition {{ cond_style }}">{{ cond_label }}</span>
              {%- endif -%}

              <span data-availability class="zh-product__availability{% if is_sold %} is-sold{% endif %}" aria-live="polite">
                <span aria-hidden="true" data-availability-dot class="zh-product__availability-dot"></span>
                <span data-availability-text class="zh-product__availability-main">{% if is_sold %}{{ block.settings.sold_text }}{% else %}{{ block.settings.in_stock_text }}{% endif %}</span>
                <span data-delivery-separator class="zh-product__availability-separator"{% if is_sold or block.settings.delivery_text == blank %} hidden{% endif %}>·</span>
                <span data-delivery-text{% if is_sold or block.settings.delivery_text == blank %} hidden{% endif %}>{{ block.settings.delivery_text }}</span>
              </span>
            </div>

            {%- assign intro = product.metafields.custom.intro.value -%}
            {%- if intro != blank -%}
              <p class="zh-product__intro">{{ intro }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'buy_buttons' -%}
          <div {{ block.shopify_attributes }} class="zh-product__form-wrap">
            <div data-product-form>
              {%- form 'product', product, class: 'zh-product__form', novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>

                {%- unless product.has_only_default_variant -%}
                  <div class="zh-product__options">
                    {%- for option in product.options_with_values -%}
                      {%- if option.values.size > 1 -%}
                        <fieldset class="zh-product__option-fieldset" data-option-group data-option-position="{{ option.position }}">
                          <legend class="zh-product__option-legend">{{ option.name }}</legend>
                          <div class="zh-product__option-list" role="radiogroup" aria-label="{{ option.name | escape }}">
                            {%- assign opt_idx = option.position | minus: 1 -%}
                            {%- for value in option.values -%}
                              {%- assign is_sel = false -%}
                              {%- if option.selected_value == value -%}
                                {%- assign is_sel = true -%}
                              {%- endif -%}
                              {%- assign val_available = false -%}
                              {%- for pv in product.variants -%}
                                {%- if pv.available and pv.options[opt_idx] == value -%}
                                  {%- assign val_available = true -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                              <button
                                type="button"
                                role="radio"
                                aria-checked="{% if is_sel %}true{% else %}false{% endif %}"
                                data-option-button
                                data-option-position="{{ option.position }}"
                                data-value="{{ value | escape }}"
                                data-selected="{% if is_sel %}true{% else %}false{% endif %}"
                                data-available="{{ val_available }}"
                                class="zh-product__option-button"
                                {% unless val_available or is_sel %}disabled{% endunless %}
                              >
                                {%- if value.swatch.color or value.swatch.image -%}
                                  <span aria-hidden="true" class="zh-product__swatch" style="background-color: {{ value.swatch.color | default: 'transparent' }};">
                                    {%- if value.swatch.image -%}
                                      {{ value.swatch.image | image_url: width: 32 | image_tag: alt: '', class: 'h-full w-full object-cover' }}
                                    {%- endif -%}
                                  </span>
                                {%- endif -%}
                                <span>{{ value }}</span>
                              </button>
                            {%- endfor -%}
                          </div>
                        </fieldset>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endunless -%}

                <div data-buy-available{% if is_sold %} hidden{% endif %}>
                  <div class="zh-product__actions">
                    <div data-quantity-wrap class="zh-product__qty" role="group" aria-label="Aantal">
                      <button type="button" data-qty-dec class="zh-product__qty-button" aria-label="Aantal verlagen" disabled>
                        {% render 'icon', name: 'minus', size: 15 %}
                      </button>
                      <span aria-live="polite" data-qty-value class="zh-product__qty-value font-display">{{ selected_min }}</span>
                      <input
                        type="hidden"
                        name="quantity"
                        value="{{ selected_min }}"
                        data-qty-input
                        data-qty-min="{{ selected_min }}"
                        data-qty-step="{{ selected_increment }}"
                        {% if selected_max != blank %}data-qty-max="{{ selected_max }}"{% endif %}
                      >
                      <button type="button" data-qty-inc class="zh-product__qty-button" aria-label="Aantal verhogen"{% if selected_max != blank and selected_min >= selected_max %} disabled{% endif %}>
                        {% render 'icon', name: 'plus', size: 15 %}
                      </button>
                    </div>

                    <button
                      id="product-add-to-cart"
                      type="submit"
                      data-add-button
                      data-cart-add-button
                      class="zh-product__add-button"
                    >
                      <span data-cart-add-label aria-live="polite">{{ block.settings.add_label }}</span>
                      <span data-cart-add-icon aria-hidden="true">+</span>
                    </button>
                  </div>
                </div>

                <div data-buy-sold class="zh-product__sold-state"{% unless is_sold %} hidden{% endunless %}>
                  <p data-sold-message class="zh-product__sold-message">{{ block.settings.sold_label }}</p>
                  <a href="{{ similar_url }}" class="zh-product__sold-link">Bekijk vergelijkbare producten</a>
                </div>
              {%- endform -%}
            </div>

            {%- if block.settings.show_trust -%}
              <div class="zh-product__trust">
                <ul class="zh-product__trust-list" aria-label="Bestelinformatie">
                  {%- if block.settings.trust_1 != blank -%}
                    <li class="zh-product__trust-item">{% render 'icon', name: 'lock', size: 16 %}<span>{{ block.settings.trust_1 }}</span></li>
                  {%- endif -%}
                  {%- if block.settings.trust_2 != blank -%}
                    <li class="zh-product__trust-item">{% render 'icon', name: 'truck', size: 16 %}<span>{{ block.settings.trust_2 }}</span></li>
                  {%- endif -%}
                  {%- if block.settings.trust_3 != blank -%}
                    <li class="zh-product__trust-item">{% render 'icon', name: 'package-check', size: 16 %}<span>{{ block.settings.trust_3 }}</span></li>
                  {%- endif -%}
                </ul>
                <div class="zh-product__payments">{% render 'payment-icons', compact: true %}</div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'features' -%}
          {%- liquid
            assign feats = product.metafields.custom.features.value
            if feats.first == blank
              assign feats_str = product.metafields.custom.features.value | remove: '[' | remove: ']' | remove: '"'
              assign feats = feats_str | split: ','
            endif
          -%}
          {%- if feats.size > 0 -%}
            <div {{ block.shopify_attributes }} class="zh-product__features">
              <ul class="zh-product__feature-list">
                {%- for key in feats limit: 4 -%}
                  {%- assign fkey = key | strip | downcase -%}
                  {% render 'product-feature', key: fkey %}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <section class="zh-product__details mx-auto max-w-7xl px-4 sm:px-6 lg:px-10" aria-label="Productinformatie">
    <div class="zh-product__details-grid">
      <div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'description' and product.description != blank -%}
            <div {{ block.shopify_attributes }}>
              <p class="zh-product__section-eyebrow">Productinformatie</p>
              <h2 id="product-information-heading" class="zh-product__section-title font-display">Over dit product</h2>
              <div class="zh-product__description rte rich-text">{{ product.description }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'zayna_note' -%}
            {%- assign note = product.metafields.custom.zayna_note.value -%}
            {%- if note != blank -%}
              <figure {{ block.shopify_attributes }} class="zh-product__note">
                <blockquote class="font-display">&ldquo;{{ note }}&rdquo;</blockquote>
                <figcaption>— {{ block.settings.signature }}</figcaption>
              </figure>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'specs' -%}
            {%- liquid
              assign size_note = product.metafields.custom.size_note.value
              assign materials = product.metafields.custom.materials.value
              assign dimensions = product.metafields.custom.dimensions.value
              assign sku = cv.sku
              assign has_specs = false
              if size_note != blank or materials != blank or dimensions != blank or product.type != blank or sku != blank
                assign has_specs = true
              endif
            -%}
            {%- if has_specs -%}
              <div {{ block.shopify_attributes }}>
                <p class="zh-product__section-eyebrow">In één oogopslag</p>
                <h2 class="zh-product__section-title font-display">Specificaties</h2>
                <dl class="zh-product__specs">
                  {%- if product.type != blank -%}
                    <div class="zh-product__spec-row"><dt>{{ block.settings.label_category }}</dt><dd>{{ product.type }}</dd></div>
                  {%- endif -%}
                  {%- if size_note != blank -%}
                    <div class="zh-product__spec-row"><dt>{{ block.settings.label_size }}</dt><dd>{{ size_note }}</dd></div>
                  {%- endif -%}
                  {%- if materials != blank -%}
                    <div class="zh-product__spec-row"><dt>{{ block.settings.label_material }}</dt><dd>{{ materials }}</dd></div>
                  {%- endif -%}
                  {%- if dimensions != blank -%}
                    <div class="zh-product__spec-row"><dt>{{ block.settings.label_dimensions }}</dt><dd>{{ dimensions }}</dd></div>
                  {%- endif -%}
                  {%- if sku != blank -%}
                    <div class="zh-product__spec-row"><dt>{{ block.settings.label_sku }}</dt><dd data-sku>{{ sku }}</dd></div>
                  {%- endif -%}
                </dl>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'care_shipping' -%}
        <div {{ block.shopify_attributes }} class="zh-product__accordions">
          {%- for i in (1..3) -%}
            {%- assign t_key = 'row' | append: i | append: '_title' -%}
            {%- assign b_key = 'row' | append: i | append: '_body' -%}
            {%- assign row_title = block.settings[t_key] -%}
            {%- assign row_body = block.settings[b_key] -%}
            {%- if row_title != blank and row_body != blank -%}
              <details class="zh-product__accordion">
                <summary class="font-display">
                  <span>{{ row_title }}</span>
                  {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
                </summary>
                <div class="zh-product__accordion-body rich-text">{{ row_body }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </section>

  {%- if product.available -%}
    <div data-sticky-atc data-observe="product-add-to-cart" inert class="zh-sticky-atc" aria-hidden="true">
      <div class="zh-sticky-atc__inner">
        <span data-sticky-price class="zh-sticky-atc__price font-display">
          {%- if cv.price and cv.price > 0 -%}{{ cv.price | money }}{%- else -%}{{ lbl_price_on_request }}{%- endif -%}
        </span>
        <form method="post" action="{{ routes.cart_add_url }}" data-sticky-form>
          <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>
          <input type="hidden" name="quantity" value="{{ selected_min }}" data-sticky-qty>
          <button type="submit" data-add-button data-cart-add-button class="zh-product__add-button">
            <span data-cart-add-label aria-live="polite">{{ lbl_add }}</span>
            <span data-cart-add-icon aria-hidden="true">+</span>
          </button>
        </form>
      </div>
    </div>
  {%- endif -%}

  <script type="application/json" data-product-json>
    {
      "selected_variant_id": {{ cv.id | json }},
      "labels": {
        "add": {{ lbl_add | json }},
        "sold": {{ lbl_sold | json }},
        "adding": "Toevoegen…",
        "in_stock": {{ lbl_in_stock | json }},
        "delivery": {{ lbl_delivery | json }},
        "unavailable": {{ lbl_unavailable | json }},
        "price_on_request": {{ lbl_price_on_request | json }}
      },
      "variants": [
        {%- for v in product.variants -%}
          {%- liquid
            assign featured_image_index = nil
            if v.featured_image
              for image in product.images
                if image.id == v.featured_image.id
                  assign featured_image_index = forloop.index0
                  break
                endif
              endfor
            endif
            assign qty_min = v.quantity_rule.min | default: 1
            assign qty_increment = v.quantity_rule.increment | default: 1
            assign qty_max = v.quantity_rule.max
            if qty_max == blank and v.inventory_management != blank and v.inventory_policy == 'deny'
              assign qty_max = v.inventory_quantity
            endif
            if qty_max != blank and qty_max < qty_min
              assign qty_max = qty_min
            endif
          -%}
          {
            "id": {{ v.id | json }},
            "available": {{ v.available | json }},
            "price": {{ v.price | json }},
            "price_formatted": {{ v.price | money | json }},
            "compare_at_price": {{ v.compare_at_price | default: 0 | json }},
            "compare_at_formatted": {% if v.compare_at_price and v.compare_at_price > 0 %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "options": {{ v.options | json }},
            "sku": {{ v.sku | json }},
            "featured_image_index": {% if featured_image_index != nil %}{{ featured_image_index }}{% else %}null{% endif %},
            "quantity_min": {{ qty_min | json }},
            "quantity_increment": {{ qty_increment | json }},
            "quantity_max": {% if qty_max != blank %}{{ qty_max | json }}{% else %}null{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
  <script src="{{ 'product.js' | asset_url }}" defer></script>

  {% render 'product-structured-data', product: product %}
</section>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "price_on_request", "label": "Tekst voor prijs op aanvraag", "default": "Prijs op aanvraag" }
  ],
  "blocks": [
    { "type": "gallery", "name": "Galerij", "limit": 1, "settings": [] },
    {
      "type": "info",
      "name": "Titel, prijs en intro",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_collection", "label": "Collectienaam tonen", "default": true },
        { "type": "text", "id": "in_stock_text", "label": "Tekst op voorraad", "default": "Op voorraad" },
        { "type": "text", "id": "delivery_text", "label": "Levertijdtekst", "default": "Indicatieve levering binnen 1–3 werkdagen" },
        { "type": "text", "id": "sold_text", "label": "Tekst uitverkocht", "default": "Uitverkocht" },
        { "type": "text", "id": "unavailable_text", "label": "Tekst onbeschikbare combinatie", "default": "Deze combinatie is niet beschikbaar" },
        { "type": "text", "id": "price_on_request", "label": "Tekst prijs op aanvraag", "default": "Prijs op aanvraag" }
      ]
    },
    { "type": "features", "name": "Productkenmerken", "limit": 1, "settings": [] },
    {
      "type": "specs",
      "name": "Specificaties",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_category", "label": "Label categorie", "default": "Categorie" },
        { "type": "text", "id": "label_size", "label": "Label maat", "default": "Maat" },
        { "type": "text", "id": "label_material", "label": "Label materiaal", "default": "Materiaal" },
        { "type": "text", "id": "label_dimensions", "label": "Label afmetingen", "default": "Afmetingen" },
        { "type": "text", "id": "label_sku", "label": "Label artikelnummer", "default": "Artikelnr." }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Koopknop en vertrouwen",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_label", "label": "Tekst winkelmandknop", "default": "In winkelmand" },
        { "type": "text", "id": "sold_label", "label": "Tekst uitverkocht", "default": "Uitverkocht" },
        { "type": "header", "content": "Vertrouwensinformatie" },
        { "type": "checkbox", "id": "show_trust", "label": "Vertrouwensinformatie tonen", "default": true },
        { "type": "text", "id": "trust_1", "label": "Punt 1", "default": "Veilig betalen" },
        { "type": "text", "id": "trust_2", "label": "Punt 2", "default": "Levering 1–3 werkdagen" },
        { "type": "text", "id": "trust_3", "label": "Punt 3", "default": "Verzonden vanuit NL" }
      ]
    },
    { "type": "description", "name": "Productomschrijving", "limit": 1, "settings": [] },
    {
      "type": "zayna_note",
      "name": "Zayna-notitie",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "signature", "label": "Ondertekening", "default": "Zayna" }
      ]
    },
    {
      "type": "care_shipping",
      "name": "Verzending en retourneren",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "row1_title", "label": "Rij 1 titel" },
        { "type": "richtext", "id": "row1_body", "label": "Rij 1 tekst" },
        { "type": "text", "id": "row2_title", "label": "Rij 2 titel", "default": "Verzending" },
        { "type": "richtext", "id": "row2_body", "label": "Rij 2 tekst", "default": "<p>Nederland: thuisbezorging €7,95 of een servicepunt voor €6,95. Gratis verzending vanaf €100. De indicatieve levertijd is 1–3 werkdagen en je ontvangt track & trace.</p>" },
        { "type": "text", "id": "row3_title", "label": "Rij 3 titel", "default": "Retourneren" },
        { "type": "richtext", "id": "row3_body", "label": "Rij 3 tekst", "default": "<p>Je hebt 14 dagen na ontvangst om je retour aan te melden. Daarna heb je nog 14 dagen om het product terug te sturen. Retourkosten zijn voor eigen rekening, tenzij wettelijk anders.</p>" }
      ]
    }
  ]
}
{% endschema %}
