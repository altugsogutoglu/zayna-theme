{%- liquid
  assign cv = product.selected_or_first_available_variant
  assign coll = product.collections.first
  assign is_sold = true
  if cv.available
    assign is_sold = false
  endif

  assign cond_raw = product.metafields.custom.condition.value | downcase | strip
  assign cond_label = ''
  assign cond_style = ''
  case cond_raw
    when 'new'
      assign cond_label = 'Nieuw'
      assign cond_style = 'is-positive'
    when 'new without tags', 'nieuw zonder prijskaartje'
      assign cond_label = 'Nieuw zonder prijskaartje'
      assign cond_style = 'is-positive'
    when 'very good', 'heel goed'
      assign cond_label = 'Zeer goede staat'
      assign cond_style = 'is-neutral'
    when 'good', 'goed'
      assign cond_label = 'Goede staat'
      assign cond_style = 'is-neutral'
  endcase

  assign lbl_add = 'In winkelmand'
  assign lbl_sold = 'Uitverkocht'
  assign lbl_in_stock = 'Op voorraad'
  assign lbl_unavailable = 'Deze combinatie is niet beschikbaar'
  assign lbl_price_on_request = section.settings.price_on_request | default: 'Prijs op aanvraag'

  for b in section.blocks
    if b.type == 'buy_buttons'
      assign lbl_add = b.settings.add_label
      assign lbl_sold = b.settings.sold_label
    endif
    if b.type == 'info'
      assign lbl_in_stock = b.settings.in_stock_text
      assign lbl_sold = b.settings.sold_text
      assign lbl_unavailable = b.settings.unavailable_text
      assign lbl_price_on_request = b.settings.price_on_request
    endif
  endfor

  assign compare_visible = false
  if cv.compare_at_price and cv.compare_at_price > cv.price
    assign compare_visible = true
  endif

  assign selected_min = cv.quantity_rule.min | default: 1
  assign selected_increment = cv.quantity_rule.increment | default: 1
  assign selected_max = cv.quantity_rule.max
  if selected_max == blank and cv.inventory_management != blank and cv.inventory_policy == 'deny'
    assign selected_max = cv.inventory_quantity
  endif
  if selected_max != blank and selected_max < selected_min
    assign selected_max = selected_min
  endif

  assign similar_url = routes.all_products_collection_url
  if coll
    assign similar_url = coll.url
  endif


  assign care_display_text = product.metafields.custom.onderhoud_weergavetekst.value | strip

  assign is_ux_prototype_v3 = false
  assign display_product_title = product.title
  assign display_product_meta = ''

  case product.handle
    when 'voorraadpot-600ml-borosilicaatglas'
      assign is_ux_prototype_v3 = true
      assign display_product_title = 'Glazen voorraadpot – 600&nbsp;ml'
      assign display_product_meta = 'Borosilicaatglas · Luchtdicht'
    when 'digitale-weeglepel-500g-0-1g'
      assign is_ux_prototype_v3 = true
      assign display_product_title = 'Digitale weeglepel'
      assign display_product_meta = 'Tot 500 g · nauwkeurig tot 0,1 g'
  endcase
-%}

{% style %}
  .zh-product-page,
  .zh-product {
    background: #fcfaf7;
  }

  .zh-product {
    --zh-border: #ded5cc;
    --zh-muted: #625a53;
    position: relative;
  }

  .zh-product__breadcrumb {
    padding-top: .9rem;
  }

  .zh-product__breadcrumb-mobile {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    color: var(--zh-muted);
    font-size: .82rem;
    line-height: 1.4;
    text-decoration: none;
  }

  .zh-product__breadcrumb-desktop {
    display: none;
    align-items: center;
    gap: .5rem;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--zh-muted);
    font-size: .76rem;
    line-height: 1.4;
  }

  .zh-product__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .zh-product__breadcrumb a:hover,
  .zh-product__breadcrumb a:focus-visible {
    color: var(--color-clay, #a66a3f);
  }

  .zh-product__purchase {
    display: grid;
    gap: 1.75rem;
    padding-top: 1rem;
    padding-bottom: 2.25rem;
  }

  .zh-product__gallery-column,
  .zh-product__buy-column {
    min-width: 0;
  }

  .zh-product__buy-column {
    align-self: start;
  }

  .zh-product__title {
    max-width: 25ch;
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-size: clamp(1.75rem, 7vw, 1.95rem);
    font-weight: 400;
    letter-spacing: -.02em;
    line-height: 1.14;
  }

  .zh-product__meta-line {
    margin: .48rem 0 0;
    color: #7b6a5d;
    font-size: .78rem;
    font-weight: 500;
    letter-spacing: .035em;
    line-height: 1.45;
  }

  .zh-product__price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: .8rem;
    margin-top: .65rem;
  }

  .zh-product__price {
    color: var(--color-ink, #2a2520);
    font-family: var(--font-sans, sans-serif);
    font-size: 1.3rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .zh-product__compare-price {
    color: var(--zh-muted);
    font-size: .86rem;
    text-decoration: line-through;
  }

  .zh-product__status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem 1rem;
    margin-top: .85rem;
  }

  .zh-product__condition {
    display: inline-flex;
    min-height: 1.7rem;
    align-items: center;
    padding: .22rem .62rem;
    border-radius: 999px;
    font-size: .72rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .zh-product__condition.is-positive {
    background: rgb(111 132 104 / 12%);
    color: #61745b;
  }

  .zh-product__condition.is-neutral {
    background: rgb(118 110 103 / 10%);
    color: #6d655f;
  }

  .zh-product__availability {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: .48rem;
    min-width: 0;
    color: var(--zh-muted);
    font-size: .86rem;
    line-height: 1.45;
  }

  .zh-product__availability.is-sold {
    color: var(--color-sold, #9b4c43);
  }

  .zh-product__availability-dot {
    width: .45rem;
    height: .45rem;
    margin-top: .36rem;
    border-radius: 999px;
    background: var(--color-sage, #71826d);
  }

  .zh-product__availability.is-sold .zh-product__availability-dot {
    background: var(--color-sold, #9b4c43);
  }

  .zh-product__availability-copy {
    display: grid;
    gap: .08rem;
    min-width: 0;
  }

  .zh-product__availability-main {
    color: var(--color-ink, #2a2520);
    font-weight: 600;
  }

  .zh-product__availability.is-sold .zh-product__availability-main {
    color: inherit;
  }


  .zh-product__intro {
    max-width: 58ch;
    margin: 1rem 0 0;
    color: var(--zh-muted);
    font-size: .96rem;
    line-height: 1.72;
  }

  .zh-product__form-wrap {
    margin-top: 1rem;
  }

  .zh-product__options {
    display: grid;
    gap: 1.2rem;
    margin-bottom: 1.25rem;
  }

  .zh-product__option-fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .zh-product__option-legend {
    margin-bottom: .6rem;
    color: var(--zh-muted);
    font-size: .76rem;
    font-weight: 600;
    letter-spacing: .08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .zh-product__option-list {
    display: flex;
    flex-wrap: wrap;
    gap: .55rem;
  }

  .zh-product__option-button {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    gap: .45rem;
    padding: .55rem .9rem;
    border: 1px solid var(--zh-border);
    background: transparent;
    color: var(--zh-muted);
    font: inherit;
    font-size: .86rem;
    cursor: pointer;
  }

  .zh-product__option-button:hover:not(:disabled),
  .zh-product__option-button[aria-checked='true'] {
    border-color: var(--color-clay, #a66a3f);
    color: var(--color-ink, #2a2520);
  }

  .zh-product__option-button[aria-checked='true'] {
    background: rgb(166 106 63 / 7%);
  }

  .zh-product__option-button:disabled {
    cursor: not-allowed;
    opacity: .38;
    text-decoration: line-through;
  }

  .zh-product__swatch {
    width: 1rem;
    height: 1rem;
    overflow: hidden;
    border: 1px solid var(--zh-border);
    border-radius: 999px;
  }

  .zh-product__actions {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .8rem;
    align-items: stretch;
  }

  .zh-product__qty {
    display: inline-grid;
    grid-template-columns: 2.25rem 2.25rem 2.25rem;
    height: 3.35rem;
    border: 1px solid var(--zh-border);
  }

  .zh-product__qty-button,
  .zh-product__qty-value {
    display: grid;
    place-items: center;
  }

  .zh-product__qty-button {
    border: 0;
    background: transparent;
    color: var(--zh-muted);
    cursor: pointer;
  }

  .zh-product__qty-button:hover:not(:disabled) {
    color: var(--color-clay, #a66a3f);
  }

  .zh-product__qty-button:disabled {
    cursor: default;
    opacity: .42;
  }

  .zh-product__qty-value {
    color: var(--color-ink, #2a2520);
    font-size: .95rem;
    font-variant-numeric: tabular-nums;
  }

  .zh-product__add-button {
    display: inline-flex;
    width: 100%;
    min-height: 3.35rem;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    padding: .8rem 1rem;
    border: 1px solid var(--color-ink, #2a2520);
    background: var(--color-ink, #2a2520);
    color: #fff;
    font: inherit;
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .zh-product__add-button:hover:not(:disabled) {
    border-color: #3a3028;
    background: #3a3028;
  }

  .zh-product__add-button:active:not(:disabled) {
    transform: translateY(1px);
  }

  .zh-product__add-button:disabled {
    cursor: not-allowed;
    opacity: .55;
  }

  .zh-product__add-button[aria-busy='true'] {
    border-color: var(--color-ink, #2a2520);
    background: var(--color-ink, #2a2520);
    color: #fff;
    cursor: wait;
    opacity: 1;
  }

  .zh-product__add-button.is-added {
    border-color: #71826d;
    background: #71826d;
    color: #fff;
    opacity: 1;
  }

  .zh-product__add-button.is-error {
    border-color: var(--color-danger, #b23a48);
    background: var(--color-danger, #b23a48);
    color: #fff;
    opacity: 1;
  }

  .zh-product__option-button:focus-visible,
  .zh-product__qty-button:focus-visible,
  .zh-product__add-button:focus-visible,
  .zh-product__sold-link:focus-visible,
  .zh-product__accordion summary:focus-visible {
    outline: 2px solid var(--color-clay, #a66a3f);
    outline-offset: 3px;
  }

  .zh-product__sold-state {
    display: grid;
    gap: .8rem;
  }

  .zh-product__sold-message {
    margin: 0;
    color: var(--color-sold, #9b4c43);
    font-size: .9rem;
  }

  .zh-product__sold-link {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: center;
    gap: .65rem;
    padding: .75rem 1rem;
    border: 1px solid #2a2520;
    background: transparent;
    color: #2a2520;
    font-size: .78rem;
    font-weight: 600;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background-color 170ms ease, color 170ms ease, border-color 170ms ease;
  }

  .zh-product__sold-link-arrow {
    transition: transform 170ms ease;
  }

  .zh-product__sold-link:hover {
    border-color: #2a2520;
    background: #2a2520;
    color: #fff;
  }

  .zh-product__sold-link:hover .zh-product__sold-link-arrow {
    transform: translateX(3px);
  }


  .zh-product__description-panel {
    max-width: 60ch;
    margin-top: 1.9rem;
  }

  .zh-product__section-title {
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-size: 1.375rem;
    font-weight: 400;
    letter-spacing: -.01em;
    line-height: 1.25;
  }

  .zh-product__description {
    max-width: 60ch;
    margin-top: .625rem;
    color: var(--zh-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  .zh-product__description > :first-child {
    margin-top: 0;
  }

  .zh-product__description > :last-child {
    margin-bottom: 0;
  }

  .zh-product__description h2,
  .zh-product__description h3,
  .zh-product__description h4 {
    margin: 1.45rem 0 .45rem;
    color: var(--color-ink, #2a2520);
    font-size: 1.075rem;
    font-weight: 400;
    line-height: 1.3;
  }

  .zh-product__description ul,
  .zh-product__description ol {
    padding-left: 1.15rem;
  }

  .zh-product__description li {
    margin-top: .25rem;
  }

  .zh-product__note {
    max-width: 48rem;
    margin-top: 1.75rem;
    padding-left: 1rem;
    border-left: 2px solid rgb(166 106 63 / 50%);
  }

  .zh-product__note blockquote {
    margin: 0;
    color: var(--zh-muted);
    font-size: 1.15rem;
    font-style: italic;
    line-height: 1.55;
  }

  .zh-product__note figcaption {
    margin-top: .6rem;
    color: var(--color-ink, #2a2520);
    font-size: .8rem;
  }

  .zh-product__logistics {
    padding-top: 0;
    padding-bottom: 0;
  }

  .zh-product__accordions {
    width: 100%;
    max-width: none;
    border-top: 1px solid var(--zh-border);
    border-bottom: 1px solid var(--zh-border);
  }

  .zh-product__accordion {
    border: 0;
  }

  .zh-product__accordion + .zh-product__accordion {
    border-top: 1px solid var(--zh-border);
  }

  .zh-product__accordion summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
    padding: .85rem 0;
    color: var(--color-ink, #2a2520);
    font-size: 1.075rem;
    line-height: 1.4;
    list-style: none;
    cursor: pointer;
  }

  .zh-product__accordion summary::-webkit-details-marker {
    display: none;
  }

  .zh-product__accordion-icon {
    flex: 0 0 auto;
    color: var(--zh-muted);
    transition: transform 260ms cubic-bezier(.22, .61, .36, 1), opacity 180ms ease;
  }

  .zh-product__accordion[open] .zh-product__accordion-icon {
    transform: rotate(180deg);
  }

  .zh-product__accordion-body {
    max-width: 68ch;
    padding: 0 2.2rem 1.05rem 0;
    color: var(--zh-muted);
    font-size: .89rem;
    line-height: 1.7;
  }

  .zh-product__inline-logistics {
    margin-top: 1.75rem;
  }

  .zh-product__logistics-group + .zh-product__logistics-group {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(222 213 204 / 72%);
  }

  .zh-product__logistics-heading {
    margin: 0 0 .45rem;
    color: var(--color-ink, #2a2520);
    font-size: .86rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .zh-product__logistics-copy p {
    margin: 0;
    color: var(--zh-muted);
    font-size: .875rem;
    line-height: 1.65;
  }

  .zh-product__logistics-copy p + p {
    margin-top: .22rem;
  }

  .zh-product__logistics-copy strong {
    color: var(--color-ink, #2a2520);
    font-weight: 600;
  }

  .zh-product__accordion-body--editorial {
    width: 100%;
    max-width: none;
    padding: 0 0 1.05rem;
    color: #5f5851;
    font-size: .9rem;
    line-height: 1.62;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .zh-product__accordion-body--editorial p {
    margin: 0;
    text-wrap: pretty;
  }

  .zh-product__accordion-body--editorial p + p {
    margin-top: .625rem;
  }

  .zh-product__accordion-body--editorial .zh-nowrap {
    white-space: nowrap;
  }

  .zh-product__care-lines {
    display: grid;
    gap: .28rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .zh-product__care-lines li {
    margin: 0;
  }

  [hidden] {
    display: none !important;
  }



  @media (min-width: 750px) and (max-width: 1180px) {
    .zh-product--ux-prototype-v3 .zh-product__accordion summary {
      min-height: 52px;
      padding-block: 0;
    }

    .zh-product--ux-prototype-v3 .zh-product__accordion-body--editorial {
      padding-top: .12rem;
    }
  }

  @media (min-width: 640px) {
    .zh-product__purchase {
      grid-template-columns: minmax(260px, 300px) minmax(0, 1fr);
      gap: clamp(1.4rem, 3.5vw, 2.5rem);
      padding-top: 1.25rem;
      padding-bottom: 2rem;
    }

    .zh-product__gallery-column,
    .zh-product__buy-column {
      align-self: start;
    }

    .zh-product__buy-column {
      padding-top: .1rem;
    }

    .zh-product__title {
      max-width: 22ch;
      font-size: clamp(1.875rem, 3.4vw, 2rem);
    }

    .zh-product__description-panel {
      margin-top: 1.75rem;
    }
  }

  @media (min-width: 768px) {
    .zh-product__breadcrumb {
      padding-top: 1.2rem;
    }

    .zh-product__breadcrumb-mobile {
      display: none;
    }

    .zh-product__breadcrumb-desktop {
      display: flex;
    }

    .zh-product__purchase {
      grid-template-columns: minmax(300px, 38%) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.75rem);
      padding-top: 1.4rem;
      padding-bottom: 2.25rem;
    }

    .zh-product__gallery-column {
      position: static;
      top: auto;
    }

    .zh-product__title {
      font-size: clamp(2.1rem, 2.6vw, 2.375rem);
    }

    .zh-product__price {
      font-size: 1.375rem;
    }

    .zh-product__section-title {
      font-size: 1.5rem;
    }

    .zh-product__description-panel {
      margin-top: 2rem;
    }

    .zh-product__logistics {
      padding-bottom: 1.75rem;
    }
  }

  @media (min-width: 1180px) {
    .zh-product__purchase {
      grid-template-columns: minmax(0, 410px) minmax(28rem, 1fr);
    }
  }

  .zh-product__purchase {
    padding-bottom: 1.125rem;
  }

  @media (min-width: 640px) {
    .zh-product__purchase {
      padding-bottom: .875rem;
    }
  }

  @media (min-width: 768px) {
    .zh-product__purchase {
      padding-bottom: .75rem;
    }
  }

  @media (min-width: 1180px) {
    .zh-product__accordion-body--editorial {
      max-width: 64ch;
    }
  }

  .zh-product__accordion summary {
    min-height: 3.25rem;
    padding: .62rem 0;
    font-size: .98rem;
  }

  .zh-product__accordion-icon {
    width: 1rem;
    height: 1rem;
    opacity: .82;
  }


  /* -------------------------------------------------------------- */
  /* UX-prototype v13 — alleen voorraadpot 600 ml en digitale lepel */
  /* Fijnslijping: compactere hiërarchie, betere split-screen balans */
  /* -------------------------------------------------------------- */
  .zh-product--ux-prototype-v3 .zh-product__purchase {
    gap: 1.05rem;
    padding-top: .52rem;
    padding-bottom: .95rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__buy-column {
    width: 100%;
  }

  .zh-product--ux-prototype-v3 .zh-product__title {
    max-width: 21ch;
    font-size: clamp(1.72rem, 7.2vw, 2rem);
    line-height: 1.08;
    text-wrap: balance;
  }

  .zh-product--ux-prototype-v3 .zh-product__meta-line {
    margin-top: .28rem;
    color: #7a6b5f;
    font-size: .72rem;
    letter-spacing: .012em;
  }

  .zh-product--ux-prototype-v3 .zh-product__price-row {
    margin-top: .58rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__status-row {
    margin-top: .5rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__intro {
    max-width: 39ch;
    margin-top: .62rem;
    font-size: .895rem;
    line-height: 1.54;
  }

  .zh-product--ux-prototype-v3 .zh-product__form-wrap {
    margin-top: .72rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__actions {
    grid-template-columns: auto minmax(0, 1fr);
    gap: .62rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__qty {
    grid-template-columns: repeat(3, 2rem);
    height: 3.18rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__add-button {
    min-height: 3.18rem;
    letter-spacing: .065em;
  }

  .zh-product--ux-prototype-v3 .zh-product__inline-logistics {
    margin-top: 1.22rem;
  }

  .zh-product--ux-prototype-v3 .zh-product__purchase {
    padding-bottom: 2.8rem;
  }


  .zh-product--ux-prototype-v3 .zh-product__accordions {
    border-top-color: rgb(222 213 204 / 72%);
    border-bottom-color: rgb(222 213 204 / 72%);
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion + .zh-product__accordion {
    border-top-color: rgb(222 213 204 / 72%);
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion summary {
    min-height: 2.56rem;
    padding: .37rem 0;
    color: #2f2a25;
    font-family: var(--font-sans, sans-serif);
    font-size: .84rem;
    font-weight: 500;
    letter-spacing: .001em;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion-body--editorial {
    max-width: 500px;
    padding-bottom: .76rem;
    color: #625a53;
    font-size: .81rem;
    line-height: 1.56;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion-icon {
    width: .74rem;
    height: .74rem;
    opacity: .58;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion[open] > .zh-product__accordion-body {
    animation: zhAccordionSoftOpen 340ms cubic-bezier(.22, .61, .36, 1) both;
  }

  @keyframes zhAccordionSoftOpen {
    from {
      opacity: 0;
      transform: translateY(-2px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  .zh-product--ux-prototype-v3 .zh-product__accordion-body--editorial p {
    margin: 0;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion-body--editorial p + p {
    margin-top: .26rem;
  }


  .zh-product--ux-prototype-v3 .zh-product__accordion summary > * {
    pointer-events: none;
  }



  .zh-product--ux-prototype-v3 .zh-product__accordion summary {
    position: relative;
    cursor: pointer;
    transform: none;
    will-change: auto;
    transition: color 180ms ease;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion summary:hover {
    color: #2a2520;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion summary:hover .zh-product__accordion-icon {
    opacity: .66;
  }


  .zh-product--ux-prototype-v3 .zh-product__accordion summary,
  .zh-product--ux-prototype-v3 .zh-product__accordion summary:hover,
  .zh-product--ux-prototype-v3 .zh-product__accordion[open] summary {
    font-weight: 500;
  }


  /* v13: stable accordion cursor + no accidental text selection inside product accordions */
  .zh-product--ux-prototype-v3 .zh-product__accordion summary {
    cursor: pointer;
    position: relative;
    transform: none !important;
    will-change: auto !important;
    -webkit-user-select: none;
    user-select: none;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion summary > * {
    pointer-events: none;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion summary,
  .zh-product--ux-prototype-v3 .zh-product__accordion summary:hover,
  .zh-product--ux-prototype-v3 .zh-product__accordion[open] summary {
    font-weight: 500;
    padding-inline: 0;
    border: 0;
  }

  .zh-product--ux-prototype-v3 .zh-product__accordion-body {
    cursor: default;
    -webkit-user-select: none;
    user-select: none;
  }

  .zh-product__delivery-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .76rem 1.05rem;
  }

  .zh-product__delivery-item,
  .zh-product__return-block {
    min-width: 0;
  }

  .zh-product__delivery-label {
    display: block;
    margin: 0 0 .12rem;
    color: #85776b;
    font-size: .64rem;
    font-weight: 500;
    letter-spacing: .002em;
    line-height: 1.35;
    text-transform: none;
  }

  .zh-product__delivery-value {
    display: block;
    color: #34302b;
    font-size: .82rem;
    line-height: 1.43;
  }

  .zh-product__return-block {
    margin-top: .86rem;
    padding-top: .78rem;
    border-top: 1px solid rgb(222 213 204 / 64%);
  }

  .zh-product__return-copy {
    max-width: 50ch;
    margin: 0;
    color: #625a53;
    font-size: .805rem;
    line-height: 1.55;
  }

  .zh-product__return-copy + .zh-product__return-copy {
    margin-top: .22rem;
    font-size: .76rem;
    color: #7a6b5f;
  }

  @media (min-width: 640px) {
    .zh-product--ux-prototype-v3 .zh-product__purchase {
      gap: clamp(1.2rem, 3vw, 2rem);
      padding-top: .95rem;
    }

    .zh-product--ux-prototype-v3 .zh-product__title {
      max-width: 20ch;
      font-size: clamp(1.78rem, 2.8vw, 1.98rem);
    }
  }

  @media (min-width: 768px) and (max-width: 1179px) {
    .zh-product--ux-prototype-v3 .zh-product__purchase {
      grid-template-columns: minmax(270px, 41.5%) minmax(0, 58.5%);
      gap: clamp(1rem, 2.2vw, 1.55rem);
      padding-top: 1rem;
    }

    .zh-product--ux-prototype-v3 .zh-product__title {
      max-width: 18ch;
      font-size: clamp(1.62rem, 2.35vw, 1.86rem);
    }

    .zh-product--ux-prototype-v3 .zh-product__intro {
      max-width: 45ch;
      font-size: .875rem;
    }

    .zh-product--ux-prototype-v3 .zh-product__accordion summary {
      min-height: 2.48rem;
      font-size: .82rem;
    }

    .zh-product--ux-prototype-v3 .zh-product__qty {
      grid-template-columns: repeat(3, 1.9rem);
    }
  }

  @media (min-width: 1180px) {
    .zh-product--ux-prototype-v3 .zh-product__purchase {
      grid-template-columns: minmax(360px, 410px) minmax(0, 1fr);
      gap: clamp(2.2rem, 4vw, 4rem);
    }

    .zh-product--ux-prototype-v3 .zh-product__buy-column {
      max-width: 600px;
    }

    .zh-product--ux-prototype-v3 .zh-product__actions {
      max-width: 520px;
    }

    .zh-product--ux-prototype-v3 .zh-product__inline-logistics {
      max-width: 520px;
    }

    .zh-product--ux-prototype-v3 .zh-product__title {
      max-width: 19ch;
      font-size: clamp(2.05rem, 2.05vw, 2.3rem);
    }

    .zh-product--ux-prototype-v3 .zh-product__intro {
      max-width: 46ch;
    }

    .zh-product--ux-prototype-v3 .zh-product__delivery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .72rem .9rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zh-product * {
      transition-duration: .01ms !important;
      animation-duration: .01ms !important;
    }
  }
{% endstyle %}

<div class="zh-product-page">
  <section
    data-product-root
    data-current-available="{% if cv.available %}true{% else %}false{% endif %}"
    class="zh-product{% if is_ux_prototype_v3 %} zh-product--ux-prototype-v3{% endif %}"
  >
    <nav aria-label="Kruimelpad" class="zh-product__breadcrumb mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
      <a href="{% if coll %}{{ coll.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="zh-product__breadcrumb-mobile">
        <span aria-hidden="true">←</span>
        <span>{% if coll %}{{ coll.title }}{% else %}Alle producten{% endif %}</span>
      </a>

      <ol class="zh-product__breadcrumb-desktop">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        {%- if coll -%}
          <li aria-hidden="true">/</li>
          <li><a href="{{ coll.url }}">{{ coll.title }}</a></li>
        {%- endif -%}
      </ol>
    </nav>

    <div class="zh-product__purchase mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
      <div class="zh-product__gallery-column">
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery' -%}
            <div {{ block.shopify_attributes }}>
              {% render 'product-gallery', product: product, is_sold: is_sold %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="zh-product__buy-column">
        {%- for block in section.blocks -%}
          {%- if block.type == 'info' -%}
            <div {{ block.shopify_attributes }}>
              <h1 class="zh-product__title font-display">{{ display_product_title }}</h1>

              {%- if display_product_meta != blank -%}
                <p class="zh-product__meta-line">{{ display_product_meta }}</p>
              {%- endif -%}

              <div class="zh-product__price-row">
                <span data-price class="zh-product__price">
                  {%- if cv.price and cv.price > 0 -%}
                    {{ cv.price | money }}
                  {%- else -%}
                    {{ block.settings.price_on_request }}
                  {%- endif -%}
                </span>
                <span data-compare-price class="zh-product__compare-price"{% unless compare_visible %} hidden{% endunless %}>
                  {%- if compare_visible -%}{{ cv.compare_at_price | money }}{%- endif -%}
                </span>
              </div>

              <div class="zh-product__status-row">
                {%- if cond_label != blank -%}
                  <span class="zh-product__condition {{ cond_style }}">{{ cond_label }}</span>
                {%- endif -%}

                <span data-availability class="zh-product__availability{% if is_sold %} is-sold{% endif %}" aria-live="polite">
                  <span aria-hidden="true" class="zh-product__availability-dot"></span>
                  <span class="zh-product__availability-copy">
                    <span data-availability-text class="zh-product__availability-main">{% if is_sold %}{{ block.settings.sold_text }}{% else %}{{ block.settings.in_stock_text }}{% endif %}</span>
                  </span>
                </span>
              </div>

              {%- assign intro = product.metafields.custom.intro.value | strip -%}
              {%- if intro != blank -%}
                <p class="zh-product__intro">{{ intro | escape }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'buy_buttons' -%}
            <div {{ block.shopify_attributes }} class="zh-product__form-wrap">
              <div data-product-form>
                {%- form 'product', product, class: 'zh-product__form', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ cv.id }}" data-variant-id>

                  {%- unless product.has_only_default_variant -%}
                    <div class="zh-product__options">
                      {%- for option in product.options_with_values -%}
                        {%- if option.values.size > 1 -%}
                          <fieldset class="zh-product__option-fieldset" data-option-group data-option-position="{{ option.position }}">
                            <legend class="zh-product__option-legend">{{ option.name }}</legend>
                            <div class="zh-product__option-list" role="radiogroup" aria-label="{{ option.name | escape }}">
                              {%- assign option_index = option.position | minus: 1 -%}
                              {%- for value in option.values -%}
                                {%- assign selected_value = false -%}
                                {%- if option.selected_value == value -%}
                                  {%- assign selected_value = true -%}
                                {%- endif -%}
                                {%- assign value_available = false -%}
                                {%- for product_variant in product.variants -%}
                                  {%- if product_variant.available and product_variant.options[option_index] == value -%}
                                    {%- assign value_available = true -%}
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                                <button
                                  type="button"
                                  role="radio"
                                  aria-checked="{% if selected_value %}true{% else %}false{% endif %}"
                                  data-option-button
                                  data-option-position="{{ option.position }}"
                                  data-value="{{ value | escape }}"
                                  data-selected="{% if selected_value %}true{% else %}false{% endif %}"
                                  data-available="{{ value_available }}"
                                  class="zh-product__option-button"
                                  tabindex="{% if selected_value %}0{% else %}-1{% endif %}"
                                  {% unless value_available or selected_value %}disabled{% endunless %}
                                >
                                  {%- if value.swatch.color or value.swatch.image -%}
                                    <span aria-hidden="true" class="zh-product__swatch" style="background-color: {{ value.swatch.color | default: 'transparent' }};">
                                      {%- if value.swatch.image -%}
                                        {{ value.swatch.image | image_url: width: 32 | image_tag: alt: '', class: 'h-full w-full object-cover' }}
                                      {%- endif -%}
                                    </span>
                                  {%- endif -%}
                                  <span>{{ value }}</span>
                                </button>
                              {%- endfor -%}
                            </div>
                          </fieldset>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}

                  <div data-buy-available{% if is_sold %} hidden{% endif %}>
                    <div class="zh-product__actions">
                      <div class="zh-product__qty" role="group" aria-label="Aantal">
                        <button type="button" data-qty-dec class="zh-product__qty-button" aria-label="Aantal verlagen" disabled>
                          {% render 'icon', name: 'minus', size: 15 %}
                        </button>
                        <span aria-live="polite" data-qty-value class="zh-product__qty-value">{{ selected_min }}</span>
                        <input
                          type="hidden"
                          name="quantity"
                          value="{{ selected_min }}"
                          data-qty-input
                          data-qty-min="{{ selected_min }}"
                          data-qty-step="{{ selected_increment }}"
                          {% if selected_max != blank %}data-qty-max="{{ selected_max }}"{% endif %}
                        >
                        <button type="button" data-qty-inc class="zh-product__qty-button" aria-label="Aantal verhogen"{% if selected_max != blank and selected_min >= selected_max %} disabled{% endif %}>
                          {% render 'icon', name: 'plus', size: 15 %}
                        </button>
                      </div>

                      <button
                        id="product-add-to-cart"
                        type="submit"
                        data-add-button
                        data-cart-add-button
                        class="zh-product__add-button"
                      >
                        <span data-cart-add-label aria-live="polite">{{ block.settings.add_label }}</span>
                        <span data-cart-add-icon aria-hidden="true"></span>
                      </button>
                    </div>

                  </div>

                  <div data-buy-sold class="zh-product__sold-state"{% unless is_sold %} hidden{% endunless %}>
                    <p data-sold-message class="zh-product__sold-message">{{ block.settings.sold_label }}</p>
                    <a href="{{ similar_url }}" class="zh-product__sold-link">
                      <span>Bekijk vergelijkbare producten</span>
                      <span class="zh-product__sold-link-arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                {%- endform -%}
              </div>

            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'care_shipping' -%}
            <section
              class="zh-product__inline-logistics"
              aria-label="Productdetails, onderhoud, levering en retour"
            >
              <div
                {{ block.shopify_attributes }}
                class="zh-product__accordions"
                data-single-accordion
              >
                {% render 'product-details', product: product %}

                {%- if care_display_text != blank -%}
                  <details class="zh-product__accordion">
                    <summary class="font-display">
                      <span>Onderhoud</span>
                      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
                    </summary>

                    <div class="zh-product__accordion-body zh-product__accordion-body--editorial">
                      {%- assign care_lines = care_display_text | newline_to_br | split: '<br />' -%}
                      {%- for line in care_lines -%}
                        {%- assign clean_line = line | strip -%}
                        {%- if clean_line != blank -%}
                          <p>{{ clean_line | escape }}</p>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                  </details>
                {%- endif -%}

                {%- assign shipping_body = block.settings.row2_body -%}
                {%- assign return_body = block.settings.row3_body -%}
                {%- if shipping_body != blank or return_body != blank -%}
                  <details class="zh-product__accordion">
                    <summary class="font-display">
                      <span>Levering & retour</span>
                      {% render 'icon', name: 'chevron-down', size: 17, class: 'zh-product__accordion-icon' %}
                    </summary>

                    <div class="zh-product__accordion-body zh-product__accordion-body--editorial">
                      {%- if is_ux_prototype_v3 -%}
                        <div class="zh-product__delivery-grid">
                          <div class="zh-product__delivery-item">
                            <span class="zh-product__delivery-label">Verwachte levertijd</span>
                            <span class="zh-product__delivery-value">{{ block.settings.shipping_time | default: '1–3 werkdagen' }}</span>
                          </div>
                          <div class="zh-product__delivery-item">
                            <span class="zh-product__delivery-label">Gratis verzending</span>
                            <span class="zh-product__delivery-value">{{ block.settings.shipping_free | default: 'Vanaf €100' }}</span>
                          </div>
                          <div class="zh-product__delivery-item">
                            <span class="zh-product__delivery-label">Thuisbezorging</span>
                            <span class="zh-product__delivery-value">{{ block.settings.shipping_home | default: '€7,95' }}</span>
                          </div>
                          <div class="zh-product__delivery-item">
                            <span class="zh-product__delivery-label">Servicepunt</span>
                            <span class="zh-product__delivery-value">{{ block.settings.shipping_point | default: '€6,95' }}</span>
                          </div>
                        </div>

                        <div class="zh-product__return-block">
                          <span class="zh-product__delivery-label">Retour</span>
                          <p class="zh-product__return-copy">{{ block.settings.return_window | default: 'Retourneren kan binnen 14 dagen na ontvangst. Daarna heb je nog 14 dagen om het product terug te sturen. Retourkosten zijn voor eigen rekening.' }}</p>
                        </div>
                      {%- else -%}
                        {%- if shipping_body != blank -%}
                          <div class="zh-product__logistics-group">
                            <h3 class="zh-product__logistics-heading">{{ block.settings.row2_title | default: 'Verzending' }}</h3>
                            <div class="zh-product__logistics-copy rich-text">{{ shipping_body }}</div>
                          </div>
                        {%- endif -%}

                        {%- if return_body != blank -%}
                          <div class="zh-product__logistics-group">
                            <h3 class="zh-product__logistics-heading">{{ block.settings.row3_title | default: 'Retourneren' }}</h3>
                            <div class="zh-product__logistics-copy rich-text">{{ return_body }}</div>
                          </div>
                        {%- endif -%}
                      {%- endif -%}
                    </div>
                  </details>
                {%- endif -%}
              </div>
            </section>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <script type="application/json" data-product-json>
      {
        "selected_variant_id": {{ cv.id | json }},
        "labels": {
          "add": {{ lbl_add | json }},
          "sold": {{ lbl_sold | json }},
          "in_stock": {{ lbl_in_stock | json }},
          "unavailable": {{ lbl_unavailable | json }},
          "price_on_request": {{ lbl_price_on_request | json }}
        },
        "variants": [
          {%- for variant in product.variants -%}
            {%- liquid
              assign featured_image_index = nil
              if variant.featured_image
                for image in product.images
                  if image.id == variant.featured_image.id
                    assign featured_image_index = forloop.index0
                    break
                  endif
                endfor
              endif

              assign variant_min = variant.quantity_rule.min | default: 1
              assign variant_increment = variant.quantity_rule.increment | default: 1
              assign variant_max = variant.quantity_rule.max
              if variant_max == blank and variant.inventory_management != blank and variant.inventory_policy == 'deny'
                assign variant_max = variant.inventory_quantity
              endif
              if variant_max != blank and variant_max < variant_min
                assign variant_max = variant_min
              endif
            -%}
            {
              "id": {{ variant.id | json }},
              "available": {{ variant.available | json }},
              "price": {{ variant.price | json }},
              "price_formatted": {{ variant.price | money | json }},
              "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
              "compare_at_formatted": {% if variant.compare_at_price and variant.compare_at_price > 0 %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
              "options": {{ variant.options | json }},
              "featured_image_index": {% if featured_image_index != nil %}{{ featured_image_index }}{% else %}null{% endif %},
              "quantity_min": {{ variant_min | json }},
              "quantity_increment": {{ variant_increment | json }},
              "quantity_max": {% if variant_max != blank %}{{ variant_max | json }}{% else %}null{% endif %}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      }
    </script>


    <script src="{{ 'product.js' | asset_url | append: '?zh=13' }}" defer></script>
    {% render 'product-structured-data', product: product %}
  </section>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "price_on_request", "label": "Tekst voor prijs op aanvraag", "default": "Prijs op aanvraag" }
  ],
  "blocks": [
    { "type": "gallery", "name": "Galerij", "limit": 1, "settings": [] },
    {
      "type": "info",
      "name": "Titel, prijs en intro",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "in_stock_text", "label": "Tekst op voorraad", "default": "Op voorraad" },
        { "type": "text", "id": "sold_text", "label": "Tekst uitverkocht", "default": "Uitverkocht" },
        { "type": "text", "id": "unavailable_text", "label": "Tekst onbeschikbare combinatie", "default": "Deze combinatie is niet beschikbaar" },
        { "type": "text", "id": "price_on_request", "label": "Tekst prijs op aanvraag", "default": "Prijs op aanvraag" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Koopknop",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "add_label", "label": "Tekst winkelmandknop", "default": "In winkelmand" },
        { "type": "text", "id": "sold_label", "label": "Tekst uitverkocht", "default": "Uitverkocht" }
      ]
    },
    {
      "type": "care_shipping",
      "name": "Verzending en retourneren",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "row2_title", "label": "Rij 2 titel", "default": "Verzending" },
        { "type": "richtext", "id": "row2_body", "label": "Rij 2 tekst", "default": "<p><strong>Verwachte levertijd:</strong> 1–3 werkdagen</p><p><strong>Thuisbezorging:</strong> €7,95</p><p><strong>Servicepunt:</strong> €6,95</p><p><strong>Gratis verzending:</strong> vanaf €100</p>" },
        { "type": "text", "id": "row3_title", "label": "Rij 3 titel", "default": "Retourneren" },
        { "type": "richtext", "id": "row3_body", "label": "Rij 3 tekst", "default": "<p>Meld je retour binnen 14 dagen na ontvangst aan. Daarna heb je nog 14 dagen om het product terug te sturen.</p><p>Tenzij wettelijk anders is bepaald.</p>" },
        { "type": "text", "id": "shipping_time", "label": "Verwachte levertijd", "default": "1–3 werkdagen" },
        { "type": "text", "id": "shipping_home", "label": "Thuisbezorging", "default": "€7,95" },
        { "type": "text", "id": "shipping_point", "label": "Servicepunt", "default": "€6,95" },
