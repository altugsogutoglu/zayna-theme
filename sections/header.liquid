{%- liquid
  assign menu = section.settings.menu
  assign logo_width = section.settings.logo_width | default: 140
  assign logo_style = 'max-width: ' | append: logo_width | append: 'px; max-height: 48px;'
  assign logo_sizes = logo_width | append: 'px'
  assign logo_alt = section.settings.logo.alt | default: shop.name
-%}

<header
  class="sticky top-0 z-30 border-b border-border-soft bg-bg"
  data-header
>
  <div class="zayna-header-inner mx-auto flex h-[var(--header-height)] max-w-7xl items-center gap-6 px-4 sm:px-6 lg:px-10">
    <a
      href="{{ routes.root_url }}"
      class="zayna-header-logo shrink-0"
      aria-label="{{ shop.name | escape }}"
    >
      {%- if section.settings.logo != blank -%}
        {{
          section.settings.logo
          | image_url: width: 640
          | image_tag:
            loading: 'eager',
            class: 'block h-auto w-auto',
            widths: '140, 280, 420, 640',
            sizes: logo_sizes,
            style: logo_style,
            alt: logo_alt
        }}
      {%- else -%}
        <span class="font-display text-2xl tracking-tight text-ink">
          {{ shop.name | escape }}
        </span>
      {%- endif -%}
    </a>

    <nav
      aria-label="Hoofdnavigatie"
      class="zayna-header-nav hidden items-center gap-7 md:flex"
      data-nav
    >
      {%- for link in linklists[menu].links -%}
        {%- assign panel_key = link.title | downcase | strip -%}

        {%- if link.links.size > 0 -%}
          {%- capture panel_id -%}ZaynaMega-{{ section.id }}-{{ forloop.index }}{%- endcapture -%}
          <div class="zayna-header-nav-item" data-mega-item>
            <button
              type="button"
              class="zayna-header-nav-link group relative inline-flex items-center"
              aria-haspopup="true"
              aria-expanded="false"
              aria-controls="{{ panel_id }}"
              data-mega-trigger
              data-nav-primary
            >
              <span class="zayna-header-nav-label text-[11px] uppercase tracking-[0.2em] text-ink-soft transition-colors group-hover:text-ink">
                {{ link.title | escape }}
              </span>

              <span
                aria-hidden="true"
                class="absolute inset-x-0 -bottom-0.5 block h-px origin-left bg-clay transition-transform duration-300 ease-out {% if link.active %}scale-x-100{% else %}scale-x-0{% endif %}"
              ></span>
            </button>

            {%- assign panel_block = null -%}

            {%- for block in section.blocks -%}
              {%- assign block_key = block.settings.nav_title | downcase | strip -%}

              {%- if block.type == 'mega_panel' and block_key == panel_key -%}
                {%- assign panel_block = block -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if panel_block != null -%}
              <div
                id="{{ panel_id }}"
                role="region"
                aria-label="{{ link.title | escape }}"
                aria-hidden="true"
                class="zayna-mega-panel invisible absolute inset-x-0 top-full z-40 opacity-0 transition-[opacity,visibility] duration-200"
                data-mega-panel
                inert
                {{ panel_block.shopify_attributes }}
              >
                <div class="zayna-mega-surface border-y border-border-soft shadow-[0_24px_60px_-30px_rgba(42,37,32,0.35)]">
                  <div class="zayna-mega-inner mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
                    <div class="zayna-mega-intro">
                      <p class="zayna-mega-kicker">
                        <span aria-hidden="true"></span>
                        {{ panel_block.settings.eyebrow | default: link.title | escape }}
                      </p>

                      {%- if panel_block.settings.intro_copy != blank -%}
                        <p class="zayna-mega-blurb">
                          {{ panel_block.settings.intro_copy | escape }}
                        </p>
                      {%- endif -%}

                      {%- if panel_block.settings.aside_heading != blank -%}
                        <div class="zayna-mega-service">
                          <p class="zayna-mega-small-heading">
                            {{ panel_block.settings.aside_heading | escape }}
                          </p>

                          <ul class="space-y-2">
                            {%- if panel_block.settings.aside_menu != blank -%}
                              {%- for aside_link in linklists[panel_block.settings.aside_menu].links -%}
                                <li>
                                  <a
                                    href="{{ aside_link.url }}"
                                    class="zayna-mega-service-link"
                                  >
                                    {{ aside_link.title | escape }}
                                  </a>
                                </li>
                              {%- endfor -%}
                            {%- else -%}
                              <li>
                                <a
                                  href="/policies/shipping-policy"
                                  class="zayna-mega-service-link"
                                >
                                  Verzending
                                </a>
                              </li>

                              <li>
                                <a
                                  href="/policies/refund-policy"
                                  class="zayna-mega-service-link"
                                >
                                  Retourneren
                                </a>
                              </li>

                              <li>
                                <a
                                  href="/pages/contact"
                                  class="zayna-mega-service-link"
                                >
                                  Contact
                                </a>
                              </li>
                            {%- endif -%}
                          </ul>
                        </div>
                      {%- endif -%}
                    </div>

                    <div class="zayna-mega-navigation">
                      <p class="zayna-mega-small-heading">
                        {{ panel_block.settings.categories_heading | default: 'Shop per categorie' | escape }}
                      </p>

                      <ul class="zayna-mega-categories">
                        {%- if panel_block.settings.show_all_products -%}
                          <li class="min-w-0">
                            <a
                              href="{{ routes.all_products_collection_url }}"
                              class="zayna-mega-link group"
                            >
                              <span class="zayna-mega-category-title">
                                Alle producten
                              </span>

                              <span
                                aria-hidden="true"
                                class="zayna-mega-arrow"
                              >
                                →
                              </span>
                            </a>
                          </li>
                        {%- endif -%}

                        {%- for child in link.links -%}
                          <li class="min-w-0">
                            <a
                              href="{{ child.url }}"
                              class="zayna-mega-link group"
                            >
                              <span class="zayna-mega-category-title">
                                {{ child.title | escape }}
                              </span>

                              <span
                                aria-hidden="true"
                                class="zayna-mega-arrow"
                              >
                                →
                              </span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>

                      {%- if panel_block.settings.cta_label != blank -%}
                        <a
                          href="{{ routes.collections_url }}"
                          class="zayna-mega-cta group"
                        >
                          <span>
                            {{ panel_block.settings.cta_label | escape }}
                          </span>

                          <span aria-hidden="true">
                            →
                          </span>
                        </a>
                      {%- endif -%}
                    </div>

                    <div class="zayna-mega-feature">
                      {%- assign featured_collection = panel_block.settings.featured_collection -%}

                      {%- if panel_block.settings.featured_heading != blank -%}
                        <a
                          href="{% if featured_collection != blank %}{{ featured_collection.url }}{% else %}{{ routes.collections_url }}{% endif %}"
                          class="group block h-full w-full overflow-hidden bg-cream"
                        >
                          <div class="zayna-mega-feature-media">
                            {%- if featured_collection != blank and featured_collection.featured_image -%}
                              {{
                                featured_collection.featured_image
                                | image_url: width: 1000
                                | image_tag:
                                  loading: 'lazy',
                                  class: 'absolute inset-0 h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]',
                                  alt: featured_collection.title
                              }}
                            {%- else -%}
                              <span
                                aria-hidden="true"
                                class="absolute inset-0"
                                style="
                                  background:
                                    radial-gradient(
                                      70% 90% at 30% 20%,
                                      rgba(181, 101, 29, 0.15),
                                      transparent 65%
                                    ),
                                    radial-gradient(
                                      60% 70% at 80% 80%,
                                      rgba(138, 154, 123, 0.18),
                                      transparent 60%
                                    ),
                                    linear-gradient(
                                      180deg,
                                      #f4ece5,
                                      #ddd4ca
                                    );
                                "
                              ></span>
                            {%- endif -%}

                            <span
                              aria-hidden="true"
                              class="zayna-mega-feature-overlay"
                            ></span>

                            <div class="zayna-mega-feature-copy">
                              <p class="zayna-mega-feature-kicker">
                                {{ panel_block.settings.featured_kicker | default: 'Uitgelicht' | escape }}
                              </p>

                              <p class="zayna-mega-feature-title">
                                {{ panel_block.settings.featured_heading | escape }}
                              </p>

                              {%- if panel_block.settings.featured_text != blank -%}
                                <p class="zayna-mega-feature-text">
                                  {{ panel_block.settings.featured_text | escape }}
                                </p>
                              {%- endif -%}
                            </div>
                          </div>
                        </a>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <a
            href="{{ link.url }}"
            class="zayna-header-nav-link group relative inline-flex items-center"
            data-nav-primary
          >
            <span class="zayna-header-nav-label text-[11px] uppercase tracking-[0.2em] transition-colors {% if link.active %}text-ink{% else %}text-ink-soft group-hover:text-ink{% endif %}">
              {{ link.title | escape }}
            </span>

            <span
              aria-hidden="true"
              class="absolute inset-x-0 -bottom-0.5 block h-px origin-left bg-clay transition-transform duration-300 ease-out {% if link.active %}scale-x-100{% else %}scale-x-0 group-hover:scale-x-100{% endif %}"
            ></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <nav
      class="zayna-header-actions ml-auto flex items-center"
      aria-label="{{ 'general.accessibility.menu' | t }}"
    >
      <button
        type="button"
        class="zayna-header-action zayna-header-action--menu text-ink"
        aria-label="{{ 'general.accessibility.open_menu' | t }}"
        data-aside-open="mobile"
      >
        {% render 'icon', name: 'menu', size: 22 %}
      </button>

      <a
        href="{{ routes.account_url }}"
        aria-label="{{ 'layout.header.login' | t }}"
        class="zayna-header-action zayna-account-link text-ink"
      >
        {% render 'icon', name: 'user', size: 20 %}
      </a>

      <button
        type="button"
        class="zayna-header-action text-ink"
        aria-label="{{ 'general.accessibility.search' | t }}"
        data-aside-open="search"
      >
        {% render 'icon', name: 'search', size: 20 %}
      </button>

      <a
        href="{{ routes.cart_url }}"
        class="zayna-header-action zayna-header-action--cart relative text-ink"
        aria-label="{{ 'general.accessibility.cart' | t }}"
        data-aside-open="cart"
      >
        {% render 'icon', name: 'shopping-bag', size: 20 %}

        <span
          class="zayna-header-cart-count absolute flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-clay px-1 text-[10px] font-medium tabular-nums text-surface {% if cart == empty or cart.item_count == 0 %}hidden{% endif %}"
          data-cart-count
        >
          {{ cart.item_count }}
        </span>
      </a>
    </nav>
  </div>
</header>

{% style %}
  /*
    Alle desktopnavigatie-items gebruiken exact dezelfde interne box.
    Hierdoor staan gewone links en het mega-menu-item op één tekstlijn.
  */
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .zayna-header-nav {
      align-items: center;
    }

    #shopify-section-{{ section.id }} .zayna-header-nav-item {
      display: flex;
      height: 36px;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .zayna-header-nav-link {
      display: inline-flex;
      height: 36px;
      align-items: center;
      padding: 0;
      line-height: 1;
      text-decoration: none;
    }

    #shopify-section-{{ section.id }} button.zayna-header-nav-link {
      border: 0;
      background: transparent;
      cursor: pointer;
      font: inherit;
    }

    #shopify-section-{{ section.id }} .zayna-header-nav-label {
      display: block;
      line-height: 1;
    }
  }

  #shopify-section-{{ section.id }} .zayna-mega-panel {
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .zayna-header-nav-item.is-open
    .zayna-mega-panel {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
  }

  #shopify-section-{{ section.id }} .zayna-header-nav-item.is-open
    .zayna-header-nav-label {
    color: #2a2520;
  }

  #shopify-section-{{ section.id }} .zayna-header-nav-item.is-open
    .zayna-header-nav-link > span[aria-hidden="true"] {
    scale: 1 1;
  }

  #shopify-section-{{ section.id }} .zayna-header-nav-link:focus-visible,
  #shopify-section-{{ section.id }} .zayna-mega-service-link:focus-visible,
  #shopify-section-{{ section.id }} .zayna-mega-link:focus-visible,
  #shopify-section-{{ section.id }} .zayna-mega-cta:focus-visible,
  #shopify-section-{{ section.id }} .zayna-mega-feature > a:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 3px;
  }

  #shopify-section-{{ section.id }} .zayna-header-actions {
    gap: 8px;
  }

  #shopify-section-{{ section.id }} .zayna-header-action {
    display: inline-grid;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    place-items: center;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: #2a2520;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 180ms ease,
      background-color 180ms ease;
  }

  #shopify-section-{{ section.id }} .zayna-header-action svg {
    display: block;
    pointer-events: none;
  }

  #shopify-section-{{ section.id }} .zayna-account-link {
    display: none;
  }

  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .zayna-header-action--menu {
      display: none;
    }

    #shopify-section-{{ section.id }} .zayna-account-link {
      display: inline-grid;
    }
  }

  #shopify-section-{{ section.id }} .zayna-header-action:focus-visible,
  #shopify-section-{{ section.id }} .zayna-header-logo:focus-visible {
    outline: 2px solid #a66a3f;
    outline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .zayna-header-cart-count {
    top: 1px;
    right: 0;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #shopify-section-{{ section.id }} .zayna-header-action:hover {
      background: rgba(181, 101, 29, 0.08);
      color: #a66a3f;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .zayna-header-actions {
      gap: 2px;
    }

    #shopify-section-{{ section.id }} .zayna-header-inner {
      gap: 8px;
    }

    #shopify-section-{{ section.id }} .zayna-header-logo {
      min-width: 0;
      max-width: calc(100vw - 188px);
      flex-shrink: 1;
    }

    #shopify-section-{{ section.id }} .zayna-header-logo img {
      max-width: 100% !important;
    }
  }

  @media (max-width: 339px) {
    #shopify-section-{{ section.id }} .zayna-header-inner {
      gap: 4px;
      padding-right: 12px;
      padding-left: 12px;
    }

    #shopify-section-{{ section.id }} .zayna-header-actions {
      gap: 0;
    }

    #shopify-section-{{ section.id }} .zayna-header-logo {
      max-width: calc(100vw - 168px);
    }
  }

  #shopify-section-{{ section.id }} [data-mega-panel] {
    max-height: calc(100vh - var(--header-height) - 40px);
    max-height: calc(100dvh - var(--header-height) - 40px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  #shopify-section-{{ section.id }} .zayna-mega-surface {
    background: #fbf7f2;
  }

  #shopify-section-{{ section.id }} .zayna-mega-inner {
    display: grid;
    grid-template-columns:
      minmax(190px, 0.75fr)
      minmax(0, 2.25fr)
      minmax(260px, 0.95fr);
    align-items: start;
    gap: 28px;
    padding-top: 20px;
    padding-bottom: 20px;
  }

  #shopify-section-{{ section.id }} .zayna-mega-intro,
  #shopify-section-{{ section.id }} .zayna-mega-navigation,
  #shopify-section-{{ section.id }} .zayna-mega-feature {
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .zayna-mega-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    color: #a66a3f;
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .zayna-mega-kicker span {
    display: block;
    width: 32px;
    height: 1px;
    flex: 0 0 auto;
    background: rgba(166, 106, 63, 0.6);
  }

  #shopify-section-{{ section.id }} .zayna-mega-blurb {
    max-width: 30ch;
    margin: 0;
    color: #675f58;
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 13.5px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.65;
  }

  #shopify-section-{{ section.id }} .zayna-mega-service {
    margin-top: 22px;
  }

  #shopify-section-{{ section.id }} .zayna-mega-small-heading {
    margin: 0 0 13px;
    color: #9b9188;
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .zayna-mega-service-link {
    color: #5f5750;
    font-size: 13px;
    line-height: 1.45;
    text-decoration: none;
    transition: color 180ms ease;
  }

  #shopify-section-{{ section.id }} .zayna-mega-service-link:hover {
    color: #a66a3f;
  }

  #shopify-section-{{ section.id }} .zayna-mega-categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 22px;
    row-gap: 0;
    margin: 0 -9px;
  }

  #shopify-section-{{ section.id }} .zayna-mega-link {
    display: flex;
    min-width: 0;
    min-height: 42px;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    padding: 5px 9px;
    border-radius: 2px;
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease;
  }

  #shopify-section-{{ section.id }} .zayna-mega-link:hover {
    background: rgba(232, 225, 218, 0.46);
  }

  #shopify-section-{{ section.id }} .zayna-mega-category-title {
    display: block;
    min-width: 0;
    color: #2b2622;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: 15.5px;
    font-weight: 400;
    line-height: 1.22;
    transition: color 180ms ease;
  }

  #shopify-section-{{ section.id }} .zayna-mega-link:hover .zayna-mega-category-title {
    color: #a66a3f;
  }

  #shopify-section-{{ section.id }} .zayna-mega-arrow {
    flex: 0 0 auto;
    color: #9b9188;
    font-size: 14px;
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  #shopify-section-{{ section.id }} .zayna-mega-link:hover .zayna-mega-arrow {
    color: #a66a3f;
    transform: translateX(4px);
  }

  #shopify-section-{{ section.id }} .zayna-mega-cta {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    margin-top: 12px;
    padding-top: 13px;
    border-top: 1px solid #e7ddd2;
    color: #2b2622;
    font-size: 10.5px;
    line-height: 1.4;
    letter-spacing: 0.21em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  #shopify-section-{{ section.id }} .zayna-mega-cta:hover {
    color: #a66a3f;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature {
    display: flex;
    min-height: 305px;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature > a {
    min-height: 305px;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-media {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 305px;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-media img {
    object-position: center 45%;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        180deg,
        rgba(43, 38, 34, 0.01) 18%,
        rgba(43, 38, 34, 0.14) 44%,
        rgba(43, 38, 34, 0.88) 100%
      );
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-copy {
    position: absolute;
    right: 20px;
    bottom: 20px;
    left: 20px;
    z-index: 2;
    color: #fffaf5;
    text-shadow: 0 1px 8px rgba(43, 38, 34, 0.3);
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-kicker {
    margin: 0 0 6px;
    font-size: 9.5px;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-title {
    margin: 0;
    font-family: var(--font-heading-family, Georgia, serif);
    font-size: clamp(21px, 1.45vw, 27px);
    font-weight: 400;
    line-height: 1.12;
  }

  #shopify-section-{{ section.id }} .zayna-mega-feature-text {
    max-width: 28ch;
    margin: 8px 0 0;
    font-size: 12.5px;
    line-height: 1.5;
  }

  @media (min-width: 1200px) {
    #shopify-section-{{ section.id }} .zayna-mega-category-title {
      white-space: nowrap;
    }
  }

  /* Gesplitste desktopvensters en tablets */
  @media (min-width: 768px) and (max-width: 1099px) {
    #shopify-section-{{ section.id }} .zayna-header-inner {
      gap: 16px;
      padding-right: 22px;
      padding-left: 22px;
    }

    #shopify-section-{{ section.id }} .zayna-header-logo img {
      max-width: 120px !important;
    }

    #shopify-section-{{ section.id }} .zayna-header-nav {
      gap: 17px;
    }

    #shopify-section-{{ section.id }} .zayna-header-nav-label {
      font-size: 10px;
      letter-spacing: 0.16em;
    }

    #shopify-section-{{ section.id }} .zayna-header-actions {
      gap: 9px;
    }

    #shopify-section-{{ section.id }} [data-mega-panel] {
      max-height: calc(100vh - var(--header-height) - 32px);
      max-height: calc(100dvh - var(--header-height) - 32px);
    }

    #shopify-section-{{ section.id }} .zayna-mega-inner {
      grid-template-columns:
        minmax(165px, 0.7fr)
        minmax(0, 2.3fr);
      align-items: start;
      gap: 20px;
      padding-top: 17px;
      padding-bottom: 17px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-feature {
      display: none;
    }

    #shopify-section-{{ section.id }} .zayna-mega-kicker {
      gap: 10px;
      margin-bottom: 11px;
      font-size: 9px;
      letter-spacing: 0.19em;
    }

    #shopify-section-{{ section.id }} .zayna-mega-kicker span {
      width: 26px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-blurb {
      max-width: 25ch;
      font-size: 12.5px;
      line-height: 1.55;
    }

    #shopify-section-{{ section.id }} .zayna-mega-service {
      margin-top: 17px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-small-heading {
      margin-bottom: 9px;
      font-size: 9px;
      letter-spacing: 0.19em;
    }

    #shopify-section-{{ section.id }} .zayna-mega-service ul {
      display: grid;
      gap: 5px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-service-link {
      font-size: 12px;
      line-height: 1.35;
    }

    #shopify-section-{{ section.id }} .zayna-mega-categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 16px;
      row-gap: 0;
      margin: 0 -6px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-link {
      min-height: 38px;
      gap: 7px;
      padding: 4px 6px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-category-title {
      font-size: 14px;
      line-height: 1.22;
      white-space: normal;
    }

    #shopify-section-{{ section.id }} .zayna-mega-arrow {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .zayna-mega-cta {
      margin-top: 8px;
      padding-top: 10px;
      font-size: 9px;
      letter-spacing: 0.18em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .zayna-header-action,
    #shopify-section-{{ section.id }} .zayna-mega-link,
    #shopify-section-{{ section.id }} .zayna-mega-arrow,
    #shopify-section-{{ section.id }} .zayna-mega-feature img {
      transition: none;
    }
  }
{% endstyle %}

