{%- liquid
  assign s = section.settings
  assign image_fit = s.image_fit | default: 'cover'
  if image_fit == 'contain'
    assign image_fit_class = 'object-contain p-[clamp(1.75rem,5vw,3.5rem)]'
  else
    assign image_fit_class = 'object-cover'
  endif
-%}

<section class="relative -mt-[var(--header-height)] overflow-hidden bg-bg text-ink isolate max-lg:mt-0">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10" style="background:radial-gradient(54% 62% at 84% 24%, color-mix(in srgb, var(--color-clay) 12%, transparent), transparent 62%), radial-gradient(45% 54% at 12% 86%, color-mix(in srgb, var(--color-sage) 12%, transparent), transparent 70%), linear-gradient(180deg, #F4ECE5 0%, var(--color-bg) 55%, var(--color-cream) 100%);"></div>

  <div class="mx-auto grid w-[min(100%,1376px)] items-center gap-[clamp(2.125rem,6vw,5.75rem)] px-[clamp(1.125rem,5vw,2.5rem)] pt-[calc(var(--header-height)+3.375rem)] pb-16 max-lg:min-h-0 max-lg:grid-cols-1 max-lg:gap-[2.125rem] max-lg:py-[2.875rem] lg:min-h-[min(760px,calc(100dvh-36px))] lg:grid-cols-[minmax(0,0.92fr)_minmax(420px,1.08fr)]">
    <div class="max-w-[660px]">
      <div class="mb-[clamp(1.875rem,5vw,4.25rem)] flex items-center justify-between gap-[22px] whitespace-nowrap text-[10px] uppercase leading-snug tracking-[0.22em] text-stone max-lg:whitespace-normal">
        <span>{{ s.meta_left | default: 'Zayna Home · Keuken & Wonen' }}</span>
        <span class="hidden xl:inline">{{ s.meta_center | default: 'Stijlvol · Praktisch · Betaalbaar' }}</span>
        <span class="hidden xl:inline">{{ s.meta_right | default: 'Geselecteerd · Verzonden vanuit NL' }}</span>
      </div>

      {%- if s.eyebrow != blank -%}
        <p class="mb-[22px] flex items-center gap-[14px] text-[11px] uppercase leading-snug tracking-[0.24em] text-clay">
          <span aria-hidden="true" class="block h-px w-12 bg-clay/60 max-sm:w-[34px]"></span>
          {{ s.eyebrow }}
        </p>
      {%- endif -%}

      {%- if s.headline != blank -%}
        <h1 class="m-0 max-w-[11ch] font-display text-[clamp(2.625rem,12vw,3.625rem)] font-normal leading-[0.95] tracking-[-0.035em] text-ink lg:max-w-[11ch] lg:text-[clamp(3.5rem,4.6vw,5.125rem)] lg:leading-[0.98]">{{ s.headline }}</h1>
      {%- endif -%}

      {%- if s.subhead != blank -%}
        <p class="mt-7 max-w-[460px] text-[15px] leading-[1.75] text-ink-soft lg:text-base lg:leading-[1.8]">{{ s.subhead }}</p>
      {%- endif -%}

      <div class="mt-[34px] flex flex-wrap items-center gap-x-[22px] gap-y-4 max-lg:mt-7">
        {%- if s.cta_label != blank -%}
          <a href="{{ s.cta_url | default: routes.all_products_collection_url }}" class="inline-flex min-h-[46px] items-center justify-center gap-3 border border-ink bg-ink px-6 py-[15px] text-[11px] uppercase leading-none tracking-[0.18em] text-surface transition-soft hover:-translate-y-px hover:border-clay hover:bg-clay max-sm:w-full">
            {{ s.cta_label }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}

        {%- if s.secondary_cta_label != blank -%}
          <a href="{{ s.secondary_cta_url | default: routes.all_products_collection_url }}" class="inline-flex min-h-[38px] items-center justify-center border-b border-ink/40 text-[11px] uppercase leading-none tracking-[0.18em] text-ink transition-soft hover:border-clay hover:text-clay max-sm:w-full">
            {{ s.secondary_cta_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if s.trust_text != blank -%}
        <p class="mt-[26px] text-xs leading-[1.7] tracking-[0.08em] text-stone max-sm:text-[11px] max-sm:tracking-[0.06em]">{{ s.trust_text }}</p>
      {%- endif -%}
    </div>

    <div class="w-full min-w-0">
      {%- if s.image != blank -%}
        <div class="relative min-h-[360px] overflow-hidden border border-border-soft bg-cream shadow-[0_30px_80px_color-mix(in_srgb,var(--color-ink)_8%,transparent)] lg:min-h-[520px]">
          {{ s.image | image_url: width: 1800 | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 1024px) 48vw, 92vw',
            widths: '600, 900, 1200, 1500, 1800',
            alt: s.image.alt | default: s.headline,
            class: 'block h-full min-h-[360px] w-full lg:min-h-[520px] ' | append: image_fit_class }}

          {%- if s.media_caption != blank -%}
            <p class="absolute bottom-[18px] left-[22px] m-0 bg-bg/80 px-[14px] py-[10px] text-[10px] uppercase leading-snug tracking-[0.18em] text-ink-soft backdrop-blur-[10px]">{{ s.media_caption }}</p>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="relative min-h-[390px] overflow-hidden border border-border-soft shadow-[0_30px_80px_color-mix(in_srgb,var(--color-ink)_8%,transparent)] lg:min-h-[560px] max-sm:min-h-[340px]" style="background:radial-gradient(42% 36% at 62% 44%, color-mix(in srgb, var(--color-clay) 10%, transparent), transparent 70%), linear-gradient(180deg, var(--color-bg) 0%, #F1E8DF 100%);" aria-label="Zayna Home productcompositie">
          {%- render 'hero-product-card', image: s.product_image_1, label: s.product_label_1, default_label: 'Voorraadpotten', eager: true, size: 'lg', position: 'absolute bottom-[9%] left-[9%] h-[70%] w-[52%] max-lg:bottom-[8%] max-lg:left-[6%] max-lg:h-[68%] max-lg:w-[56%]' -%}
          {%- render 'hero-product-card', image: s.product_image_2, label: s.product_label_2, default_label: 'Glaswerk', eager: false, size: 'sm', position: 'absolute right-[9%] top-[10%] h-[34%] w-[34%] max-lg:right-[6%] max-lg:h-[31%] max-lg:w-[35%]' -%}
          {%- render 'hero-product-card', image: s.product_image_3, label: s.product_label_3, default_label: 'Keukentextiel', eager: false, size: 'sm', position: 'absolute bottom-[12%] right-[9%] h-[34%] w-[34%] max-lg:right-[6%] max-lg:h-[31%] max-lg:w-[35%]' -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Tekst" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Zayna Home" },
    { "type": "text", "id": "headline", "label": "Titel", "default": "Mooi wonen begint in de keuken." },
    { "type": "textarea", "id": "subhead", "label": "Subtekst", "default": "Geselecteerde keuken- en woonproducten met een rustige uitstraling. Praktisch in gebruik, zorgvuldig verpakt en betaalbaar gekozen." },
    { "type": "text", "id": "cta_label", "label": "Primaire CTA label", "default": "Bekijk de collectie" },
    { "type": "text", "id": "cta_url", "label": "Primaire CTA link", "default": "/collections/all" },
    { "type": "text", "id": "secondary_cta_label", "label": "Secundaire CTA label", "default": "Nieuw binnen" },
    { "type": "text", "id": "secondary_cta_url", "label": "Secundaire CTA link", "default": "/collections/all" },
    { "type": "textarea", "id": "trust_text", "label": "Trustregel", "default": "Verzonden vanuit Nederland · met zorg verpakt · stijlvol voor dagelijks gebruik" },
    { "type": "header", "content": "Bovenste kleine regels" },
    { "type": "text", "id": "meta_left", "label": "Meta links", "default": "Zayna Home · Keuken & Wonen" },
    { "type": "text", "id": "meta_center", "label": "Meta midden", "default": "Stijlvol · Praktisch · Betaalbaar" },
    { "type": "text", "id": "meta_right", "label": "Meta rechts", "default": "Geselecteerd · Verzonden vanuit NL" },
    { "type": "header", "content": "Hoofdbeeld rechts" },
    { "type": "image_picker", "id": "image", "label": "Hoofdafbeelding rechts", "info": "Gebruik hier bij voorkeur één rustige lifestyle/editorial compositie. Leeg = fallback productcompositie." },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Afbeelding passend maken",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "Cover — voor lifestylefoto" },
        { "value": "contain", "label": "Contain — voor losse productfoto" }
      ]
    },
    { "type": "text", "id": "media_caption", "label": "Kleine tekst op afbeelding", "default": "Keuken & wonen" },
    { "type": "header", "content": "Fallback productcompositie" },
    { "type": "paragraph", "content": "Deze beelden worden gebruikt wanneer er geen hoofdafbeelding is ingesteld." },
    { "type": "image_picker", "id": "product_image_1", "label": "Productbeeld 1 groot" },
    { "type": "text", "id": "product_label_1", "label": "Label product 1", "default": "Voorraadpotten" },
    { "type": "image_picker", "id": "product_image_2", "label": "Productbeeld 2 klein" },
    { "type": "text", "id": "product_label_2", "label": "Label product 2", "default": "Glaswerk" },
    { "type": "image_picker", "id": "product_image_3", "label": "Productbeeld 3 klein" },
    { "type": "text", "id": "product_label_3", "label": "Label product 3", "default": "Keukentextiel" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
