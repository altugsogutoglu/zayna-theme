{%- liquid
  assign s = section.settings
  assign desktop_image = s.image | default: s.mobile_image
  assign mobile_image = s.mobile_image | default: desktop_image
  assign hero_alt = desktop_image.alt | default: s.headline
  assign primary_url = s.cta_url | default: routes.all_products_collection_url

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'

  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif
-%}

<div
  id="ZaynaHero-{{ section.id }}"
  class="zayna-home-hero{% if desktop_image == blank %} zayna-home-hero--no-image{% endif %}"
>
  <div class="zayna-home-hero__content-wrap">
    <div class="zayna-home-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="zayna-home-hero__eyebrow">
          <span aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if s.headline != blank -%}
        {%- if request.page_type == 'index' -%}
          <h1 class="zayna-home-hero__title">
            {{ s.headline | escape }}
          </h1>
        {%- else -%}
          <h2 class="zayna-home-hero__title">
            {{ s.headline | escape }}
          </h2>
        {%- endif -%}
      {%- endif -%}

      {%- if s.subhead != blank -%}
        <p class="zayna-home-hero__subhead">
          {{ s.subhead | escape }}
        </p>
      {%- endif -%}

      {%- if s.cta_label != blank or s.secondary_cta_label != blank -%}
        <div class="zayna-home-hero__actions">
          {%- if s.cta_label != blank -%}
            <a
              class="zayna-home-hero__primary"
              href="{{ primary_url | escape }}"
            >
              {{ s.cta_label | escape }}
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if s.secondary_cta_label != blank and s.secondary_cta_url != blank -%}
            <a
              class="zayna-home-hero__secondary"
              href="{{ s.secondary_cta_url | escape }}"
            >
              {{ s.secondary_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if desktop_image != blank -%}
    <picture class="zayna-home-hero__picture">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 600 }} 600w,
            {{ mobile_image | image_url: width: 900 }} 900w,
            {{ mobile_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
        >
      {%- endif -%}

      {{
        desktop_image
        | image_url: width: 2200
        | image_tag:
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          sizes: '100vw',
          widths: '750, 1100, 1500, 1800, 2200',
          alt: hero_alt,
          class: 'zayna-home-hero__image'
      }}
    </picture>
  {%- endif -%}
</div>

{% style %}
  #ZaynaHero-{{ section.id }} {
    --zayna-hero-bg: #f8f3ed;
    --zayna-hero-bg-soft: #fbf7f2;
    --zayna-hero-ink: #2b2622;
    --zayna-hero-text: #675c53;
    --zayna-hero-accent: #a66a3f;
    --zayna-hero-border: #e7ddd2;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--zayna-hero-bg);
    color: var(--zayna-hero-ink);
  }

  #ZaynaHero-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        90deg,
        rgba(248, 243, 237, 0.99) 0%,
        rgba(248, 243, 237, 0.97) 28%,
        rgba(248, 243, 237, 0.78) 42%,
        rgba(248, 243, 237, 0.20) 59%,
        rgba(248, 243, 237, 0) 72%
      );
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--zayna-hero-bg);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
    display: block;
    flex: 0 0 auto;
    width: auto !important;
    max-width: none !important;
    height: 100% !important;
    object-fit: contain;
    object-position: right center;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: min(
      calc(100% - clamp(48px, 6vw, 80px)),
      1376px
    );
    margin: 0 auto;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
    min-width: 0;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--zayna-hero-accent);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.23em;
    text-transform: uppercase;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow span {
    width: 38px;
    height: 1px;
    flex: 0 0 auto;
    background: rgba(166, 106, 63, 0.66);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
    max-width: 9.5ch;
    margin: 0;
    color: var(--zayna-hero-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
    margin-bottom: 0;
    color: var(--zayna-hero-text);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px 22px;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary,
  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
    text-decoration: none;
    text-transform: uppercase;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 46px;
    padding: 13px 21px;
    border: 1px solid var(--zayna-hero-ink);
    background: var(--zayna-hero-ink);
    color: #fffaf5;
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.18em;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary:hover {
    border-color: var(--zayna-hero-accent);
    background: var(--zayna-hero-accent);
    transform: translateY(-1px);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    border-bottom: 1px solid rgba(43, 38, 34, 0.36);
    color: var(--zayna-hero-ink);
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.19em;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary:hover {
    border-color: var(--zayna-hero-accent);
    color: var(--zayna-hero-accent);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary:focus-visible,
  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary:focus-visible {
    outline: 2px solid var(--zayna-hero-accent);
    outline-offset: 4px;
  }

  #ZaynaHero-{{ section.id }}.zayna-home-hero--no-image {
    background:
      radial-gradient(
        60% 75% at 85% 20%,
        rgba(166, 106, 63, 0.10),
        transparent 65%
      ),
      linear-gradient(
        180deg,
        var(--zayna-hero-bg) 0%,
        var(--zayna-hero-bg-soft) 100%
      );
  }

  #ZaynaHero-{{ section.id }}.zayna-home-hero--no-image::after {
    display: none;
  }

  /* Grote desktop */
  @media (min-width: 1100px) {
    #ZaynaHero-{{ section.id }} {
      min-height: clamp(455px, 29vw, 485px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      min-height: clamp(455px, 29vw, 485px);
      padding-block: 24px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
      width: min(38%, 455px);
      transform: translateY(-18px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
      margin-bottom: 14px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      font-size: clamp(45px, 2.7vw, 50px);
      line-height: 0.97;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      max-width: 410px;
      margin-top: 16px;
      font-size: 14.5px;
      line-height: 1.56;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
      margin-top: 20px;
    }
  }

  /* Tablet en desktopvensters naast elkaar */
  @media (min-width: 750px) and (max-width: 1099px) {
    #ZaynaHero-{{ section.id }} {
      min-height: 450px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      width: calc(100% - 48px);
      min-height: 450px;
      padding-block: 28px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
      width: min(47%, 405px);
      transform: translateY(-10px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
      margin-bottom: 14px;
      font-size: 9.5px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow span {
      width: 32px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      font-size: clamp(39px, 5vw, 46px);
      line-height: 0.97;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      max-width: 345px;
      margin-top: 16px;
      font-size: 14px;
      line-height: 1.55;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
      margin-top: 19px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
      display: block;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
      width: 100% !important;
      max-width: 100% !important;
      height: 100% !important;
      object-fit: contain;
      object-position: right center;
    }

    #ZaynaHero-{{ section.id }}::after {
      background:
        linear-gradient(
          90deg,
          rgba(248, 243, 237, 0.99) 0%,
          rgba(248, 243, 237, 0.97) 35%,
          rgba(248, 243, 237, 0.77) 50%,
          rgba(248, 243, 237, 0.20) 66%,
          rgba(248, 243, 237, 0) 77%
        );
    }
  }

  /* Mobiel */
  @media (max-width: 749px) {
    #ZaynaHero-{{ section.id }} {
      display: flex;
      min-height: 0;
      flex-direction: column;
      background: var(--zayna-hero-bg);
    }

    #ZaynaHero-{{ section.id }}::after {
      display: none;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      order: 1;
      display: block;
      width: 100%;
      min-height: 0;
      padding: 27px 20px 23px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
      width: 100%;
      transform: none;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
      margin-bottom: 13px;
      font-size: 9.5px;
      letter-spacing: 0.21em;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow span {
      width: 30px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      max-width: 9.5ch;
      font-size: clamp(38px, 10.5vw, 45px);
      line-height: 0.96;
      letter-spacing: -0.038em;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      max-width: 38ch;
      margin-top: 16px;
      font-size: 14px;
      line-height: 1.56;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
      display: block;
      margin-top: 20px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__primary {
      width: 100%;
      min-height: 47px;
      padding: 13px 18px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
      width: fit-content;
      min-height: 34px;
      margin-top: 17px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
      position: relative;
      inset: auto;
      order: 2;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      border-top: 1px solid var(--zayna-hero-border);
      background: #efe7dd;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
      width: 100% !important;
      max-width: 100% !important;
      height: 100% !important;
      object-fit: contain;
      object-position: center center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaHero-{{ section.id }} .zayna-home-hero__primary,
    #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Afbeeldingen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop hero-afbeelding",
      "info": "Gebruik de brede Zayna Home-lifestylefoto."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobiele hero-afbeelding",
      "info": "Optioneel. Wanneer dit leeg blijft, wordt de desktopafbeelding gebruikt."
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine bovenregel",
      "default": "Keuken & wonen"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titel",
      "default": "Mooi wonen begint in de keuken."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subtekst",
      "default": "Rustige keuken- en woonproducten, zorgvuldig geselecteerd voor dagelijks gebruik en een verzorgde uitstraling."
    },
    {
      "type": "header",
      "content": "Knoppen"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primaire knoptekst",
      "default": "Bekijk het assortiment"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primaire knoplink"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secundaire linktekst",
      "default": "Nieuw binnen"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secundaire linkbestemming"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}