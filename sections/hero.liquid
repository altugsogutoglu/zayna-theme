{%- liquid
  assign s = section.settings
  assign desktop_image = s.image | default: s.mobile_image
  assign mobile_image = s.mobile_image | default: desktop_image
  assign hero_alt = desktop_image.alt | default: s.headline
  assign primary_url = s.cta_url | default: routes.all_products_collection_url
  assign heading_id = 'ZaynaHeroHeading-' | append: section.id

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'auto'
  assign image_preload = false

  if section.index == 1
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'

    if s.mobile_image == blank
      assign image_preload = true
    endif
  endif
-%}

<section
  id="ZaynaHero-{{ section.id }}"
  class="zayna-home-hero{% if desktop_image == blank %} zayna-home-hero--no-image{% endif %}"
  {% if s.headline != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  {%- if desktop_image != blank -%}
    <picture class="zayna-home-hero__picture">
      {%- if mobile_image != blank -%}
        <source
          media="(max-width: 749px)"
          srcset="
            {{ mobile_image | image_url: width: 480 }} 480w,
            {{ mobile_image | image_url: width: 750 }} 750w,
            {{ mobile_image | image_url: width: 1000 }} 1000w,
            {{ mobile_image | image_url: width: 1200 }} 1200w
          "
          sizes="100vw"
        >
      {%- endif -%}

      {{
        desktop_image
        | image_url: width: 2200
        | image_tag:
          loading: image_loading,
          fetchpriority: image_fetchpriority,
          preload: image_preload,
          decoding: 'async',
          sizes: '(min-width: 1100px) 70vw, (min-width: 750px) 68vw, 100vw',
          widths: '480, 750, 1000, 1200, 1500, 1800, 2200',
          alt: hero_alt,
          class: 'zayna-home-hero__image'
      }}
    </picture>
  {%- endif -%}

  <div class="zayna-home-hero__content-wrap">
    <div class="zayna-home-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="zayna-home-hero__eyebrow">
          <span aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if s.headline != blank -%}
        {%- if request.page_type == 'index' -%}
          <h1
            id="{{ heading_id }}"
            class="zayna-home-hero__title"
          >
            {{ s.headline | escape }}
          </h1>
        {%- else -%}
          <h2
            id="{{ heading_id }}"
            class="zayna-home-hero__title"
          >
            {{ s.headline | escape }}
          </h2>
        {%- endif -%}
      {%- endif -%}

      {%- if s.subhead != blank -%}
        <p class="zayna-home-hero__subhead">
          {{ s.subhead | escape }}
        </p>
      {%- endif -%}

      {%- if s.cta_label != blank or s.secondary_cta_label != blank -%}
        <div class="zayna-home-hero__actions">
          {%- if s.cta_label != blank -%}
            <a
              class="zayna-home-hero__primary"
              href="{{ primary_url }}"
            >
              <span>{{ s.cta_label | escape }}</span>
              <span aria-hidden="true">→</span>
            </a>
          {%- endif -%}

          {%- if s.secondary_cta_label != blank and s.secondary_cta_url != blank -%}
            <a
              class="zayna-home-hero__secondary"
              href="{{ s.secondary_cta_url }}"
            >
              {{ s.secondary_cta_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

</section>

{% style %}
  #ZaynaHero-{{ section.id }} {
    --zayna-hero-bg: #f8f3ed;
    --zayna-hero-bg-soft: #fbf7f2;
    --zayna-hero-ink: #2b2622;
    --zayna-hero-text: #675c53;
    --zayna-hero-accent: #a66a3f;
    --zayna-hero-border: #e7ddd2;
    --zayna-hero-button: #3a3029;
    --zayna-hero-button-hover: #76513d;

    position: relative;
    isolation: isolate;
    width: 100%;
    overflow: hidden;
    background: var(--zayna-hero-bg);
    color: var(--zayna-hero-ink);
  }

  #ZaynaHero-{{ section.id }}::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
    overflow: hidden;
    background: var(--zayna-hero-bg);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
    display: block;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
    position: relative;
    z-index: 2;
    margin: 0 auto;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
    min-width: 0;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    color: var(--zayna-hero-accent);
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow span {
    width: 38px;
    height: 1px;
    flex: 0 0 auto;
    background: rgba(166, 106, 63, 0.66);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
    max-width: 9.5ch;
    margin: 0;
    color: var(--zayna-hero-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-weight: 400;
    letter-spacing: -0.04em;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
    margin-bottom: 0;
    color: var(--zayna-hero-text);
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 22px;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary,
  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
    text-decoration: none;
    text-transform: uppercase;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 13px 21px;
    border: 1px solid var(--zayna-hero-button);
    background: var(--zayna-hero-button);
    color: #fffaf5;
    font-size: 10.2px;
    line-height: 1;
    letter-spacing: 0.135em;
    box-shadow: 0 15px 34px -28px rgba(43, 38, 34, 0.52);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    border-bottom: 1px solid rgba(43, 38, 34, 0.36);
    color: var(--zayna-hero-ink);
    font-size: 10.5px;
    line-height: 1;
    letter-spacing: 0.19em;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  #ZaynaHero-{{ section.id }} .zayna-home-hero__primary:focus-visible,
  #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary:focus-visible {
    outline: 2px solid var(--zayna-hero-accent);
    outline-offset: 4px;
  }

  #ZaynaHero-{{ section.id }}.zayna-home-hero--no-image {
    background:
      radial-gradient(
        60% 75% at 85% 20%,
        rgba(166, 106, 63, 0.10),
        transparent 65%
      ),
      linear-gradient(
        180deg,
        var(--zayna-hero-bg) 0%,
        var(--zayna-hero-bg-soft) 100%
      );
  }

  #ZaynaHero-{{ section.id }}.zayna-home-hero--no-image::after {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaHero-{{ section.id }} .zayna-home-hero__primary:hover {
      border-color: var(--zayna-hero-button-hover);
      background: var(--zayna-hero-button-hover);
      transform: translateY(-1px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary:hover {
      border-color: var(--zayna-hero-accent);
      color: var(--zayna-hero-accent);
    }
  }

  /* Brede desktop */
  @media (min-width: 1100px) {
    #ZaynaHero-{{ section.id }} {
      min-height: clamp(470px, 31vw, 535px);
    }

    #ZaynaHero-{{ section.id }}::after {
      background:
        linear-gradient(
          90deg,
          rgba(248, 243, 237, 1) 0%,
          rgba(248, 243, 237, 1) 31%,
          rgba(248, 243, 237, 0.94) 40%,
          rgba(248, 243, 237, 0.72) 49%,
          rgba(248, 243, 237, 0.28) 59%,
          rgba(248, 243, 237, 0) 68%
        );
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      display: flex;
      width: min(calc(100% - clamp(48px, 6vw, 80px)), 1376px);
      min-height: clamp(470px, 31vw, 535px);
      align-items: center;
      padding-block: 32px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
      width: min(39%, 480px);
      transform: translateY(-8px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
      margin-bottom: 15px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      font-size: clamp(46px, 3vw, 54px);
      line-height: 0.98;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      max-width: 420px;
      margin-top: 18px;
      font-size: 15px;
      line-height: 1.62;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
      margin-top: 24px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
      position: absolute;
      inset: 0 0 0 auto;
      z-index: 0;
      width: min(70%, 1080px);
      height: 100%;
      -webkit-mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.25) 8%,
          rgba(0, 0, 0, 0.75) 18%,
          #000 30%,
          #000 100%
        );
      mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.25) 8%,
          rgba(0, 0, 0, 0.75) 18%,
          #000 30%,
          #000 100%
        );
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      object-fit: cover;
      object-position: right center;
    }
  }

  /* Tablet en gesplitste desktopvensters */
  @media (min-width: 750px) and (max-width: 1099px) {
    #ZaynaHero-{{ section.id }} {
      min-height: 465px;
    }

    #ZaynaHero-{{ section.id }}::after {
      background:
        linear-gradient(
          90deg,
          rgba(248, 243, 237, 1) 0%,
          rgba(248, 243, 237, 0.98) 34%,
          rgba(248, 243, 237, 0.80) 47%,
          rgba(248, 243, 237, 0.34) 61%,
          rgba(248, 243, 237, 0) 74%
        );
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      display: flex;
      width: calc(100% - 48px);
      min-height: 465px;
      align-items: center;
      padding-block: 30px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
      width: min(47%, 410px);
      transform: translateY(-6px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
      margin-bottom: 14px;
      font-size: 9.5px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow span {
      width: 32px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      font-size: clamp(39px, 5vw, 47px);
      line-height: 0.98;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      max-width: 350px;
      margin-top: 17px;
      font-size: 14.5px;
      line-height: 1.58;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
      margin-top: 22px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
      position: absolute;
      inset: 0 0 0 auto;
      z-index: 0;
      width: 68%;
      height: 100%;
      -webkit-mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.32) 10%,
          rgba(0, 0, 0, 0.82) 24%,
          #000 38%,
          #000 100%
        );
      mask-image:
        linear-gradient(
          90deg,
          transparent 0%,
          rgba(0, 0, 0, 0.32) 10%,
          rgba(0, 0, 0, 0.82) 24%,
          #000 38%,
          #000 100%
        );
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
      -webkit-mask-size: 100% 100%;
      mask-size: 100% 100%;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
      width: 100% !important;
      max-width: none !important;
      height: 100% !important;
      object-fit: cover;
      object-position: right center;
    }
  }

  /* Mobiel */
  @media (max-width: 749px) {
    #ZaynaHero-{{ section.id }} {
      display: flex;
      min-height: 0;
      flex-direction: column;
      background: var(--zayna-hero-bg);
    }

    #ZaynaHero-{{ section.id }}::after {
      display: none;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      order: 1;
      display: block;
      width: 100%;
      min-height: 0;
      padding: 30px 20px 26px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__content {
      width: 100%;
      transform: none;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow {
      margin-bottom: 14px;
      font-size: 9.5px;
      letter-spacing: 0.21em;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__eyebrow span {
      width: 30px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      max-width: 9.5ch;
      font-size: clamp(40px, 11vw, 48px);
      line-height: 0.98;
      letter-spacing: -0.04em;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      max-width: 39ch;
      margin-top: 17px;
      font-size: 15px;
      line-height: 1.62;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__actions {
      display: block;
      margin-top: 22px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__primary {
      width: 100%;
      min-height: 48px;
      padding: 13px 18px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
      width: fit-content;
      margin-top: 14px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__picture {
      position: relative;
      inset: auto;
      order: 2;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 16 / 9;
      border-top: 1px solid var(--zayna-hero-border);
      background: #efe7dd;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__image {
      width: 100% !important;
      max-width: 100% !important;
      height: 100% !important;
      object-fit: contain;
      object-position: center center;
    }
  }

  @media (max-width: 359px) {
    #ZaynaHero-{{ section.id }} .zayna-home-hero__content-wrap {
      padding: 26px 18px 23px;
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__title {
      font-size: clamp(37px, 11.4vw, 41px);
    }

    #ZaynaHero-{{ section.id }} .zayna-home-hero__subhead {
      font-size: 14px;
      line-height: 1.58;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaHero-{{ section.id }} .zayna-home-hero__primary,
    #ZaynaHero-{{ section.id }} .zayna-home-hero__secondary {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Afbeeldingen"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop hero-afbeelding",
      "info": "Gebruik de brede Zayna Home-lifestylefoto."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobiele hero-afbeelding",
      "info": "Optioneel. Wanneer dit leeg blijft, wordt de desktopafbeelding gebruikt."
    },
    {
      "type": "header",
      "content": "Tekst"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine bovenregel",
      "default": "Keuken & wonen"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Titel",
      "default": "Mooi wonen begint in de keuken."
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Subtekst",
      "default": "Rustige keuken- en woonproducten, zorgvuldig geselecteerd voor dagelijks gebruik en een verzorgde uitstraling."
    },
    {
      "type": "header",
      "content": "Knoppen"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primaire knoptekst",
      "default": "Bekijk het assortiment"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Primaire knoplink"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Secundaire linktekst",
      "default": "Nieuw binnen"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secundaire linkbestemming"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}