{%- liquid
  assign s = section.settings
-%}
<section class="mx-auto flex min-h-dvh max-w-md flex-col items-center justify-center px-6 py-16 text-center">
  {%- if s.logo != blank -%}
    {%- assign logo_alt = s.logo.alt | default: shop.name -%}
    {{ s.logo | image_url: width: 480 | image_tag: alt: logo_alt, widths: '160, 320, 480', class: 'mb-8 h-auto w-40 object-contain' }}
  {%- else -%}
    <p class="mb-8 font-display text-3xl tracking-tight text-ink">{{ shop.name }}</p>
  {%- endif -%}

  <p class="text-label text-clay mb-3">{{ s.eyebrow }}</p>
  <h1 class="font-display text-h1">{{ s.heading }}</h1>
  {%- if s.text != blank -%}
    <p class="mt-4 text-ink-soft">{{ s.text }}</p>
  {%- endif -%}

  {%- form 'storefront_password', class: 'mt-8 w-full' -%}
    {%- if form.errors -%}
      <p class="mb-3 text-sm text-danger" role="alert">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
    {%- endif -%}
    <div class="flex items-center gap-3 border-b-2 border-ink/15 pb-3 transition-colors focus-within:border-clay">
      <span aria-hidden="true" class="shrink-0 text-stone-soft">{% render 'icon', name: 'lock', size: 18 %}</span>
      <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ s.input_placeholder }}" class="min-w-0 flex-1 bg-transparent text-base text-ink placeholder:text-stone-soft focus:outline-none" aria-label="{{ s.input_placeholder }}" />
      <button type="submit" class="shrink-0 bg-ink px-5 py-2.5 text-[11px] uppercase tracking-[0.22em] text-surface transition-colors hover:bg-clay focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2">{{ s.submit_label }}</button>
    </div>
  {%- endform -%}

  {%- if s.footer_note != blank -%}
    <p class="mt-10 text-xs text-stone-soft">{{ s.footer_note }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Zayna Home" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Binnenkort open." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "We leggen de laatste hand aan onze collectie. Heb je het wachtwoord? Log dan hieronder in." },
    { "type": "text", "id": "input_placeholder", "label": "Input placeholder", "default": "Wachtwoord" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Open" },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "Alleen voor genodigden." }
  ]
}
{% endschema %}
