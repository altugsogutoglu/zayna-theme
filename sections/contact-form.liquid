{%- liquid
  assign s = section.settings
-%}
<article class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-10 py-16">
  <header class="mb-10">
    <p class="text-label text-clay mb-3">{{ s.eyebrow }}</p>
    <h1 class="font-display text-h1">{{ s.heading }}</h1>
    {%- if s.intro != blank -%}
      <p class="mt-4 text-ink-soft">{{ s.intro }}</p>
    {%- endif -%}
  </header>

  <div class="grid gap-12 md:grid-cols-[2fr_1fr]">
    {%- form 'contact', class: 'space-y-5' -%}
      {%- if form.posted_successfully? -%}
        <p class="text-sm text-sage" role="status">{{ s.success_text }}</p>
      {%- elsif form.errors -%}
        <p class="text-sm text-danger" role="alert">{{ s.error_text }}</p>
      {%- endif -%}

      <div>
        <label for="ContactName" class="text-label text-ink-soft block mb-2">{{ s.label_name }}</label>
        <input id="ContactName" type="text" name="contact[name]" required autocomplete="name" value="{% if form.name %}{{ form.name }}{% endif %}" class="w-full h-11 border border-border-soft bg-surface px-3 text-sm text-ink focus:outline-none focus:border-stone">
      </div>
      <div>
        <label for="ContactEmail" class="text-label text-ink-soft block mb-2">{{ s.label_email }}</label>
        <input id="ContactEmail" type="email" name="contact[email]" required autocomplete="email" value="{% if form.email %}{{ form.email }}{% endif %}" class="w-full h-11 border border-border-soft bg-surface px-3 text-sm text-ink focus:outline-none focus:border-stone">
      </div>
      <div>
        <label for="ContactSubject" class="text-label text-ink-soft block mb-2">{{ s.label_subject }}</label>
        <select id="ContactSubject" name="contact[Onderwerp]" required class="w-full h-11 border border-border-soft bg-surface px-3 text-sm text-ink focus:outline-none focus:border-stone">
          <option value="" disabled selected>{{ s.subject_placeholder }}</option>
          {%- assign subjects = s.subjects | split: ',' -%}
          {%- for subject in subjects -%}
            {%- assign subject = subject | strip -%}
            <option value="{{ subject | escape }}">{{ subject }}</option>
          {%- endfor -%}
        </select>
      </div>
      <div>
        <label for="ContactMessage" class="text-label text-ink-soft block mb-2">{{ s.label_message }}</label>
        <textarea id="ContactMessage" name="contact[body]" rows="6" required class="w-full border border-border-soft bg-surface px-3 py-2.5 text-sm text-ink focus:outline-none focus:border-stone">{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>
      <button type="submit" class="h-12 px-7 bg-stone text-white text-sm uppercase tracking-wide hover:bg-clay transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-stone focus-visible:ring-offset-2">
        {{ s.submit_label }}
      </button>
    {%- endform -%}

    <aside class="space-y-4 text-sm">
      {%- if s.email != blank -%}
        <a href="mailto:{{ s.email }}" class="flex items-center gap-3 text-ink hover:text-clay transition-colors">
          {% render 'icon', name: 'mail', size: 18 %}{{ s.email }}
        </a>
      {%- endif -%}
      {%- if s.instagram_url != blank -%}
        <a href="{{ s.instagram_url }}" target="_blank" rel="noreferrer" class="flex items-center gap-3 text-ink hover:text-clay transition-colors">
          {% render 'icon', name: 'instagram', size: 18 %}{{ s.instagram_label }}
        </a>
      {%- endif -%}
      {%- if s.note_response != blank -%}
        <p class="text-ink-soft pt-2">{{ s.note_response }}</p>
      {%- endif -%}
      {%- if s.note_shipping != blank -%}
        <p class="text-ink-soft">{{ s.note_shipping }}</p>
      {%- endif -%}
      {%- if s.company_details != blank -%}
        <div class="border-t border-border-soft pt-4 mt-4 space-y-1 text-xs text-ink-soft">
          <p class="text-label text-ink-soft">{{ s.company_heading }}</p>
          <div class="rich-text text-xs [&>*]:mt-0 [&_p]:text-ink-soft">{{ s.company_details }}</div>
        </div>
      {%- endif -%}
    </aside>
  </div>
</article>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stuur ons een bericht." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Heb je een vraag over een product, je bestelling of iets anders? Stuur ons een bericht en we reageren zo snel mogelijk — meestal binnen 24 uur op werkdagen." },
    { "type": "header", "content": "Form labels" },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Naam" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "E-mailadres" },
    { "type": "text", "id": "label_subject", "label": "Subject label", "default": "Onderwerp" },
    { "type": "text", "id": "subject_placeholder", "label": "Subject placeholder", "default": "Kies een onderwerp" },
    { "type": "text", "id": "subjects", "label": "Subjects (comma-separated)", "default": "Vraag over een product, Vraag over een bestelling, Retour of ruil, Anders" },
    { "type": "text", "id": "label_message", "label": "Message label", "default": "Bericht" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Verstuur bericht" },
    { "type": "text", "id": "success_text", "label": "Success text", "default": "Bedankt voor je bericht. We reageren zo snel mogelijk." },
    { "type": "text", "id": "error_text", "label": "Error text", "default": "Er ging iets mis. Controleer je gegevens en probeer het opnieuw." },
    { "type": "header", "content": "Sidebar" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@zaynahome.nl" },
    { "type": "text", "id": "instagram_url", "label": "Instagram URL", "default": "https://www.instagram.com/zaynahome.nl" },
    { "type": "text", "id": "instagram_label", "label": "Instagram label", "default": "@zaynahome.nl" },
    { "type": "text", "id": "note_response", "label": "Response note", "default": "Reactietijd: binnen 24 uur op werkdagen." },
    { "type": "text", "id": "note_shipping", "label": "Shipping note", "default": "Verzending: binnen 1–3 werkdagen vanuit Nederland." },
    { "type": "text", "id": "company_heading", "label": "Company heading", "default": "Bedrijfsgegevens" },
    { "type": "richtext", "id": "company_details", "label": "Company details", "default": "<p>KvK: 97745200</p><p>BTW: NL005285507B86</p>" }
  ]
}
{% endschema %}
