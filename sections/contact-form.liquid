    },
    {
      "type": "text",
      "id": "order_hint",
      "label": "Order hint",
      "default": "Alleen nodig bij een bestelling of retour."
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Bericht"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Bericht versturen"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Bedankt voor je bericht. We reageren zo snel mogelijk."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error text",
      "default": "Er ging iets mis. Controleer je gegevens en probeer het opnieuw."
    },
    {
      "type": "header",
      "content": "Contactgegevens"
    },
    {
      "type": "text",
      "id": "support_heading",
      "label": "Support heading",
      "default": "Klantenservice"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "label": "Support text",
      "default": "Je kunt ons ook rechtstreeks bereiken via e-mail of Instagram."
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@zaynahome.nl"
    },
    {
      "type": "text",
      "id": "instagram_url",
      "label": "Instagram URL",
      "default": "https://www.instagram.com/zaynahome.nl"
    },
