{%- liquid
  assign s = section.settings
  assign subjects = s.subjects | split: ','
-%}

<section
  id="ZaynaContact-{{ section.id }}"
  class="zh-contact"
  aria-labelledby="ZaynaContactTitle-{{ section.id }}"
>
  <div class="zh-contact__inner">
    <header class="zh-contact__header">
      {%- if s.eyebrow != blank -%}
        <p class="zh-contact__eyebrow">
          <span aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </p>
      {%- endif -%}

      <h1
        id="ZaynaContactTitle-{{ section.id }}"
        class="zh-contact__title"
      >
        {{ s.heading | escape }}
      </h1>

      {%- if s.intro != blank -%}
        <div class="zh-contact__intro">
          {{ s.intro | newline_to_br }}
        </div>
      {%- endif -%}

      {%- if s.note_response != blank -%}
        <p class="zh-contact__promise">
          {{ s.note_response | escape }}
        </p>
      {%- endif -%}
    </header>

    <div class="zh-contact__layout">
      <div class="zh-contact__form-area">
        {%- form 'contact', class: 'zh-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="zh-contact-message zh-contact-message--success" role="status">
              {{ s.success_text | escape }}
            </div>
          {%- elsif form.errors -%}
            <div class="zh-contact-message zh-contact-message--error" role="alert">
              {{ s.error_text | escape }}
            </div>
          {%- endif -%}

          <div class="zh-contact-form__group">
            <p class="zh-contact-form__group-label">Je gegevens</p>

            <div class="zh-contact-form__row zh-contact-form__row--split">
              <div class="zh-contact-field">
                <label for="ContactName-{{ section.id }}" class="zh-contact-label">
                  {{ s.label_name | escape }}
                </label>

                <input
                  id="ContactName-{{ section.id }}"
                  type="text"
                  name="contact[name]"
                  required
                  autocomplete="name"
                  value="{% if form.name %}{{ form.name | escape }}{% endif %}"
                  class="zh-contact-input"
                >
              </div>

              <div class="zh-contact-field">
                <label for="ContactEmail-{{ section.id }}" class="zh-contact-label">
                  {{ s.label_email | escape }}
                </label>

                <input
                  id="ContactEmail-{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  required
                  autocomplete="email"
                  value="{% if form.email %}{{ form.email | escape }}{% endif %}"
                  class="zh-contact-input"
                >
              </div>
            </div>
          </div>

          <fieldset class="zh-contact-subjects">
            <legend class="zh-contact-form__group-label">
              {{ s.label_subject | escape }}
            </legend>

            <div class="zh-contact-subjects__list">
              {%- for subject in subjects -%}
                {%- assign subject_label = subject | strip -%}
                {%- if subject_label != blank -%}
                  <label class="zh-contact-subject">
                    <input
                      type="radio"
                      name="contact[Onderwerp]"
                      value="{{ subject_label | escape }}"
                      {% if forloop.first %}checked{% endif %}
                    >
                    <span class="zh-contact-subject__label">
                      {{ subject_label | escape }}
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="zh-contact-form__group">
            <div class="zh-contact-field zh-contact-field--soft">
              <label for="ContactOrder-{{ section.id }}" class="zh-contact-label">
                {{ s.label_order | escape }}
              </label>

              <input
                id="ContactOrder-{{ section.id }}"
                type="text"
                name="contact[Bestelnummer]"
                autocomplete="off"
                class="zh-contact-input"
              >

              {%- if s.order_hint != blank -%}
                <p class="zh-contact-help">
                  {{ s.order_hint | escape }}
                </p>
              {%- endif -%}
            </div>

            <div class="zh-contact-field">
              <label for="ContactMessage-{{ section.id }}" class="zh-contact-label">
                {{ s.label_message | escape }}
              </label>

              <textarea
                id="ContactMessage-{{ section.id }}"
                name="contact[body]"
                rows="5"
                required
                class="zh-contact-textarea"
              >{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
            </div>
          </div>

          <div class="zh-contact-form__footer">
            <button type="submit" class="zh-contact-submit">
              {{ s.submit_label | escape }}
            </button>

            {%- if s.form_hint != blank -%}
              <p class="zh-contact-form__note">
                {{ s.form_hint | escape }}
              </p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      <aside class="zh-contact-sidebar" aria-label="Klantenservice informatie">
        <div class="zh-contact-service">
          {%- if s.support_heading != blank -%}
            <h2 class="zh-contact-sidebar__heading">
              {{ s.support_heading | escape }}
            </h2>
          {%- endif -%}

          {%- if s.support_text != blank -%}
            <p class="zh-contact-sidebar__text">
              {{ s.support_text | escape }}
            </p>
          {%- endif -%}

          <div class="zh-contact-links">
            {%- if s.email != blank -%}
              <a href="mailto:{{ s.email | escape }}" class="zh-contact-link">
                <span class="zh-contact-link__label">E-mail</span>
                <span>{{ s.email | escape }}</span>
              </a>
            {%- endif -%}

            {%- if s.instagram_url != blank -%}
              <a
                href="{{ s.instagram_url }}"
                target="_blank"
                rel="noreferrer"
                class="zh-contact-link"
              >
                <span class="zh-contact-link__label">Instagram</span>
                <span>{{ s.instagram_label | escape }}</span>
              </a>
            {%- endif -%}
          </div>

          <div class="zh-contact-service__notes">
            <h2 class="zh-contact-sidebar__subheading">
              {{ s.helpful_heading | escape }}
            </h2>

            <ul class="zh-contact-notes">
              {%- if s.note_shipping != blank -%}
                <li>{{ s.note_shipping | escape }}</li>
              {%- endif -%}

              {%- if s.note_order != blank -%}
                <li>{{ s.note_order | escape }}</li>
              {%- endif -%}
            </ul>
          </div>

          <nav class="zh-contact-quicklinks" aria-label="Handige links">
            <span>Snel naar</span>
            <a href="/policies/shipping-policy">Verzending</a>
            <a href="/policies/refund-policy">Retourneren</a>
            <a href="{{ routes.collections_url }}">Collecties</a>
          </nav>

          {%- if s.company_details != blank -%}
            <div class="zh-contact-company">
              <h2 class="zh-contact-sidebar__subheading">
                {{ s.company_heading | escape }}
              </h2>

              <div class="zh-contact-company__details">
                {{ s.company_details }}
              </div>
            </div>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</section>

{% style %}
  #ZaynaContact-{{ section.id }} {
    --zh-contact-bg: var(--color-bg, #faf5f2);
    --zh-contact-ink: #2a2520;
    --zh-contact-soft: rgba(42, 37, 32, 0.66);
    --zh-contact-muted: rgba(42, 37, 32, 0.47);
    --zh-contact-faint: rgba(42, 37, 32, 0.095);
    --zh-contact-clay: #9b613d;
    --zh-contact-line: rgba(155, 97, 61, 0.30);
    --zh-contact-surface: rgba(255, 253, 251, 0.34);

    background: var(--zh-contact-bg);
    color: var(--zh-contact-ink);
  }

  #ZaynaContact-{{ section.id }} .zh-contact__inner {
    width: min(100%, 1088px);
    margin: 0 auto;
    padding: 27px 16px 68px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__header {
    max-width: 620px;
    margin-bottom: 25px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--zh-contact-clay);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__eyebrow > span {
    width: 24px;
    height: 1px;
    background: rgba(155, 97, 61, 0.48);
  }

  #ZaynaContact-{{ section.id }} .zh-contact__title {
    max-width: 17ch;
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(1.86rem, 6.9vw, 2.32rem);
    font-weight: 400;
    line-height: 1.045;
    letter-spacing: -0.028em;
    text-wrap: balance;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__intro {
    max-width: 58ch;
    margin-top: 12px;
    color: var(--zh-contact-soft);
    font-size: 13.4px;
    line-height: 1.66;
    text-wrap: pretty;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__promise {
    display: inline-block;
    margin: 13px 0 0;
    padding-bottom: 2px;
    border-bottom: 1px solid rgba(155, 97, 61, 0.22);
    color: rgba(42, 37, 32, 0.58);
    font-size: 12.4px;
    line-height: 1.5;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__layout {
    display: grid;
    gap: 34px;
    align-items: start;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form {
    display: grid;
    gap: 20px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message {
    padding: 12px 0 13px;
    border-top: 1px solid var(--zh-contact-faint);
    border-bottom: 1px solid var(--zh-contact-faint);
    font-size: 13px;
    line-height: 1.55;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message--success {
    color: #5b6d54;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message--error {
    color: #8b4c42;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__group {
    display: grid;
    gap: 16px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__group-label,
  #ZaynaContact-{{ section.id }} .zh-contact-label,
  #ZaynaContact-{{ section.id }} .zh-contact-sidebar__subheading,
  #ZaynaContact-{{ section.id }} .zh-contact-link__label,
  #ZaynaContact-{{ section.id }} .zh-contact-quicklinks > span {
    margin: 0;
    color: rgba(42, 37, 32, 0.44);
    font-size: 9.5px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__row {
    display: grid;
    gap: 15px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-field {
    display: grid;
    gap: 6px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input,
  #ZaynaContact-{{ section.id }} .zh-contact-textarea {
    width: 100%;
    min-width: 0;
    border: 0;
    border-bottom: 1px solid rgba(42, 37, 32, 0.18);
    border-radius: 0;
    outline: 0;
    background: transparent;
    color: var(--zh-contact-ink);
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 14px;
    line-height: 1.5;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
    -webkit-appearance: none;
    appearance: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input {
    min-height: 38px;
    padding: 7px 0 8px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-textarea {
    min-height: 128px;
    padding: 9px 0 10px;
    resize: vertical;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input:focus,
  #ZaynaContact-{{ section.id }} .zh-contact-textarea:focus {
    border-color: rgba(155, 97, 61, 0.74);
    background: rgba(255, 253, 251, 0.20);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-help {
    max-width: 42ch;
    margin: 0;
    color: rgba(42, 37, 32, 0.43);
    font-size: 11.6px;
    line-height: 1.48;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subjects {
    display: grid;
    gap: 10px;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 18px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject__label {
    position: relative;
    display: inline-block;
    padding-bottom: 3px;
    color: rgba(42, 37, 32, 0.62);
    font-size: 13.2px;
    line-height: 1.35;
    transition: color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject__label::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    transform: scaleX(0);
    transform-origin: left;
    background: rgba(155, 97, 61, 0.42);
    content: '';
    transition: transform 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject input:checked + .zh-contact-subject__label {
    color: #704a33;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject input:checked + .zh-contact-subject__label::after {
    transform: scaleX(1);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject input:focus-visible + .zh-contact-subject__label {
    outline: 1px solid rgba(155, 97, 61, 0.42);
    outline-offset: 4px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__footer {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding-top: 2px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-submit {
    display: inline-flex;
    min-height: 43px;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border: 1px solid rgba(42, 37, 32, 0.22);
    background: rgba(255, 253, 251, 0.24);
    color: var(--zh-contact-ink);
    font-family: var(--font-body-family, Arial, sans-serif);
    font-size: 13px;
    font-weight: 400;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-submit:focus-visible {
    outline: 2px solid rgba(155, 97, 61, 0.50);
    outline-offset: 3px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__note {
    max-width: 44ch;
    margin: 0;
    color: rgba(42, 37, 32, 0.46);
    font-size: 11.8px;
    line-height: 1.56;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-sidebar {
    min-width: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-service {
    display: grid;
    gap: 22px;
    color: var(--zh-contact-soft);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-sidebar__heading {
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 23px;
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.018em;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-sidebar__text {
    max-width: 34ch;
    margin: 7px 0 0;
    color: rgba(42, 37, 32, 0.58);
    font-size: 13px;
    line-height: 1.62;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-links {
    display: grid;
    gap: 12px;
    margin-top: 18px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-link {
    display: grid;
    gap: 3px;
    color: inherit;
    text-decoration: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-link span:last-child {
    color: var(--zh-contact-ink);
    font-size: 13.4px;
    line-height: 1.45;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-service__notes,
  #ZaynaContact-{{ section.id }} .zh-contact-company {
    padding-top: 21px;
    border-top: 1px solid rgba(42, 37, 32, 0.055);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-notes {
    display: grid;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-notes li {
    max-width: 38ch;
    color: rgba(42, 37, 32, 0.58);
    font-size: 12.7px;
    line-height: 1.58;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 12px;
    align-items: baseline;
    color: rgba(42, 37, 32, 0.46);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-quicklinks a {
    color: rgba(42, 37, 32, 0.62);
    font-size: 12.7px;
    line-height: 1.45;
    text-decoration: underline;
    text-decoration-color: rgba(42, 37, 32, 0.16);
    text-underline-offset: 4px;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-company__details {
    margin-top: 10px;
    color: rgba(42, 37, 32, 0.52);
    font-size: 12px;
    line-height: 1.55;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-company__details p {
    margin: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-company__details p + p {
    margin-top: 3px;
  }

  @media (min-width: 640px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding: 34px 24px 78px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__header {
      margin-bottom: 30px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__title {
      font-size: clamp(2.1rem, 4.1vw, 2.7rem);
    }

    #ZaynaContact-{{ section.id }} .zh-contact__intro {
      font-size: 13.8px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form__row--split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }

  @media (min-width: 960px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding: 44px 40px 90px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__header {
      margin-bottom: 36px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__title {
      font-size: clamp(2.35rem, 2.75vw, 3rem);
    }

    #ZaynaContact-{{ section.id }} .zh-contact__layout {
      grid-template-columns: minmax(0, 1.34fr) minmax(245px, 0.66fr);
      gap: 72px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__form-area {
      max-width: 680px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-sidebar {
      padding-top: 3px;
    }
  }

  @media (max-width: 459px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-top: 23px;
      padding-bottom: 58px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__header {
      margin-bottom: 22px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__title {
      font-size: clamp(1.72rem, 8vw, 2.02rem);
    }

    #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 5px 13px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-subject__label {
      font-size: 12.9px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-submit {
      width: 100%;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaContact-{{ section.id }} .zh-contact-submit:hover {
      border-color: rgba(155, 97, 61, 0.36);
      background: rgba(242, 232, 223, 0.46);
      color: #704a33;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-subject:hover .zh-contact-subject__label {
      color: #704a33;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-link:hover span:last-child,
    #ZaynaContact-{{ section.id }} .zh-contact-quicklinks a:hover {
      color: var(--zh-contact-clay);
      text-decoration-color: rgba(155, 97, 61, 0.42);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We kijken graag met je mee."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Heb je een vraag over een product, bestelling of retour? Stuur ons gerust een bericht."
    },
    {
      "type": "text",
      "id": "form_hint",
      "label": "Form hint",
      "default": "Bij vragen over je bestelling helpt een bestelnummer ons sneller meekijken."
    },
    {
      "type": "header",
      "content": "Form labels"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "Naam"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "E-mailadres"
    },
    {
      "type": "text",
      "id": "label_subject",
      "label": "Subject label",
      "default": "Waar gaat je vraag over?"
    },
    {
      "type": "text",
      "id": "subjects",
      "label": "Subjects (comma-separated)",
      "default": "Productvraag, Bestelling, Retour of ruil, Anders"
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Order number label",
