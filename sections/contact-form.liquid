{%- liquid
  assign s = section.settings
  assign subjects = s.subjects | split: ','
-%}

<section
  id="ZaynaContact-{{ section.id }}"
  class="zh-contact"
  aria-labelledby="ZaynaContactTitle-{{ section.id }}"
>
  <div class="zh-contact__inner">
    <header class="zh-contact__header">
      {%- if s.eyebrow != blank -%}
        <p class="zh-contact__eyebrow">
          <span aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </p>
      {%- endif -%}

      <h1
        id="ZaynaContactTitle-{{ section.id }}"
        class="zh-contact__title"
      >
        {{ s.heading | escape }}
      </h1>

      {%- if s.intro != blank -%}
        <div class="zh-contact__intro">
          {{ s.intro | newline_to_br }}
        </div>
      {%- endif -%}

      {%- if s.note_response != blank -%}
        <p class="zh-contact__promise">
          {{ s.note_response | escape }}
        </p>
      {%- endif -%}
    </header>

    <div class="zh-contact__content">
      <div class="zh-contact-form-card">
        {%- if s.form_heading != blank or s.form_intro != blank -%}
          <div class="zh-contact-form-card__intro">
            {%- if s.form_heading != blank -%}
              <h2>{{ s.form_heading | escape }}</h2>
            {%- endif -%}

            {%- if s.form_intro != blank -%}
              <p>{{ s.form_intro | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- form 'contact', class: 'zh-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="zh-contact-message zh-contact-message--success" role="status">
              {{ s.success_text | escape }}
            </div>
          {%- elsif form.errors -%}
            <div class="zh-contact-message zh-contact-message--error" role="alert">
              {{ s.error_text | escape }}
            </div>
          {%- endif -%}

          <div class="zh-contact-form__row zh-contact-form__row--split">
            <div class="zh-contact-field">
              <label for="ContactName-{{ section.id }}" class="zh-contact-label">
                {{ s.label_name | escape }}
              </label>

              <input
                id="ContactName-{{ section.id }}"
                type="text"
                name="contact[name]"
                required
                autocomplete="name"
                value="{% if form.name %}{{ form.name | escape }}{% endif %}"
                class="zh-contact-input"
              >
            </div>

            <div class="zh-contact-field">
              <label for="ContactEmail-{{ section.id }}" class="zh-contact-label">
                {{ s.label_email | escape }}
              </label>

              <input
                id="ContactEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                required
                autocomplete="email"
                value="{% if form.email %}{{ form.email | escape }}{% endif %}"
                class="zh-contact-input"
              >
            </div>
          </div>

          <fieldset class="zh-contact-subjects">
            <legend class="zh-contact-label">
              {{ s.label_subject | escape }}
            </legend>

            <div class="zh-contact-subjects__list">
              {%- for subject in subjects -%}
                {%- assign subject_label = subject | strip -%}
                {%- if subject_label != blank -%}
                  <label class="zh-contact-subject">
                    <input
                      type="radio"
                      name="contact[Onderwerp]"
                      value="{{ subject_label | escape }}"
                      required
                    >
                    <span class="zh-contact-subject__text">
                      {{ subject_label | escape }}
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="zh-contact-field zh-contact-field--order">
            <label for="ContactOrder-{{ section.id }}" class="zh-contact-label">
              {{ s.label_order | escape }}
            </label>

            <input
              id="ContactOrder-{{ section.id }}"
              type="text"
              name="contact[Bestelnummer]"
              autocomplete="off"
              class="zh-contact-input"
            >

            {%- if s.order_hint != blank -%}
              <p class="zh-contact-help">
                {{ s.order_hint | escape }}
              </p>
            {%- endif -%}
          </div>

          <div class="zh-contact-field">
            <label for="ContactMessage-{{ section.id }}" class="zh-contact-label">
              {{ s.label_message | escape }}
            </label>

            <textarea
              id="ContactMessage-{{ section.id }}"
              name="contact[body]"
              rows="5"
              required
              class="zh-contact-textarea"
            >{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
          </div>

          <div class="zh-contact-form__footer">
            <button type="submit" class="zh-contact-submit">
              {{ s.submit_label | escape }}
            </button>

            {%- if s.form_hint != blank -%}
              <p class="zh-contact-form__note">
                {{ s.form_hint | escape }}
              </p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>

      <aside class="zh-contact-after" aria-label="Contactgegevens">
        {%- if s.support_heading != blank -%}
          <h2 class="zh-contact-after__heading">
            {{ s.support_heading | escape }}
          </h2>
        {%- endif -%}

        {%- if s.support_text != blank -%}
          <p class="zh-contact-after__text">
            {{ s.support_text | escape }}
          </p>
        {%- endif -%}

        <div class="zh-contact-after__links">
          {%- if s.email != blank -%}
            <a href="mailto:{{ s.email | escape }}" class="zh-contact-after__link">
              <span>E-mail</span>
              <strong>{{ s.email | escape }}</strong>
            </a>
          {%- endif -%}

          {%- if s.instagram_url != blank -%}
            <a
              href="{{ s.instagram_url }}"
              target="_blank"
              rel="noreferrer"
              class="zh-contact-after__link"
            >
              <span>Instagram</span>
              <strong>{{ s.instagram_label | escape }}</strong>
            </a>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</section>

{% style %}
  #ZaynaContact-{{ section.id }} {
    --zh-contact-bg: var(--color-bg, #faf5f2);
    --zh-contact-surface: #fffdfb;
    --zh-contact-ink: #2a2520;
    --zh-contact-soft: rgba(42, 37, 32, 0.66);
    --zh-contact-muted: rgba(42, 37, 32, 0.46);
    --zh-contact-faint: rgba(42, 37, 32, 0.075);
    --zh-contact-border: rgba(42, 37, 32, 0.10);
    --zh-contact-clay: #9b613d;
    --zh-contact-warm: rgba(244, 237, 230, 0.72);

    background: var(--zh-contact-bg);
    color: var(--zh-contact-ink);
  }

  #ZaynaContact-{{ section.id }} .zh-contact__inner {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: 28px 16px 68px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__header {
    max-width: 640px;
    margin: 0 auto 24px;
    text-align: left;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 10px;
    color: var(--zh-contact-clay);
    font-size: 9.5px;
    font-weight: 500;
    letter-spacing: 0.19em;
    line-height: 1;
    text-transform: uppercase;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__eyebrow > span {
    width: 24px;
    height: 1px;
    background: rgba(155, 97, 61, 0.52);
  }

  #ZaynaContact-{{ section.id }} .zh-contact__title {
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(2.05rem, 7vw, 2.42rem);
    font-weight: 400;
    letter-spacing: -0.026em;
    line-height: 1.02;
    text-wrap: balance;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__intro {
    max-width: 58ch;
    margin-top: 12px;
    color: var(--zh-contact-soft);
    font-size: 14px;
    line-height: 1.68;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__promise {
    display: inline-flex;
    align-items: center;
    margin: 14px 0 0;
    padding-left: 13px;
    border-left: 1px solid rgba(155, 97, 61, 0.34);
    color: rgba(42, 37, 32, 0.62);
    font-size: 12.4px;
    line-height: 1.45;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__content {
    display: grid;
    gap: 28px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card {
    border: 1px solid var(--zh-contact-faint);
    background:
      linear-gradient(
        180deg,
        rgba(255, 253, 251, 0.74),
        rgba(255, 253, 251, 0.48)
      );
    box-shadow: 0 16px 46px -42px rgba(42, 37, 32, 0.34);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro {
    padding: 18px 18px 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro h2 {
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 19.5px;
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.016em;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro p {
    max-width: 44ch;
    margin: 7px 0 0;
    color: var(--zh-contact-muted);
    font-size: 12.6px;
    line-height: 1.56;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form {
    display: grid;
    gap: 15px;
    padding: 18px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__row {
    display: grid;
    gap: 15px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-field {
    min-width: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-label {
    display: block;
    margin: 0 0 7px;
    color: rgba(42, 37, 32, 0.54);
    font-size: 10.4px;
    font-weight: 500;
    letter-spacing: 0.13em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input,
  #ZaynaContact-{{ section.id }} .zh-contact-textarea {
    width: 100%;
    border: 1px solid rgba(42, 37, 32, 0.095);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background: rgba(255, 253, 251, 0.76);
    color: var(--zh-contact-ink);
    font-size: 14px;
    line-height: 1.42;
    outline: 0;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input {
    min-height: 44px;
    padding: 10px 12px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-textarea {
    min-height: 128px;
    resize: vertical;
    padding: 11px 12px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input:focus,
  #ZaynaContact-{{ section.id }} .zh-contact-textarea:focus {
    border-color: rgba(155, 97, 61, 0.46);
    background: #fffdfb;
    box-shadow: 0 0 0 1px rgba(155, 97, 61, 0.055);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-help {
    margin: 7px 0 0;
    color: rgba(42, 37, 32, 0.46);
    font-size: 11.8px;
    line-height: 1.45;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subjects {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 39px;
    align-items: center;
    padding: 0 11px;
    border: 1px solid rgba(42, 37, 32, 0.08);
    background: rgba(255, 253, 251, 0.55);
    color: rgba(42, 37, 32, 0.62);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject__text {
    min-width: 0;
    overflow: hidden;
    font-size: 12.7px;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject:has(input:checked) {
    border-color: rgba(155, 97, 61, 0.28);
    background: rgba(244, 237, 230, 0.78);
    color: #704a33;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject:has(input:focus-visible) {
    outline: 2px solid rgba(166, 106, 63, 0.45);
    outline-offset: 2px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__footer {
    display: grid;
    gap: 9px;
    align-items: center;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-submit {
    display: inline-flex;
    min-height: 44px;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid rgba(59, 48, 42, 0.88);
    border-radius: 0;
    background: #3b302a;
    color: #fffdfb;
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-submit:focus-visible {
    outline: 2px solid rgba(166, 106, 63, 0.45);
    outline-offset: 3px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__note {
    max-width: 52ch;
    margin: 0;
    color: rgba(42, 37, 32, 0.44);
    font-size: 11.8px;
    line-height: 1.48;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message {
    padding: 11px 12px;
    border: 1px solid transparent;
    font-size: 13px;
    line-height: 1.45;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message--success {
    border-color: rgba(98, 123, 93, 0.22);
    background: rgba(237, 243, 234, 0.66);
    color: #536949;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message--error {
    border-color: rgba(139, 76, 66, 0.22);
    background: rgba(139, 76, 66, 0.06);
    color: #8b4c42;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after {
    max-width: 640px;
    margin: 2px auto 0;
    padding-top: 25px;
    border-top: 1px solid rgba(42, 37, 32, 0.065);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after__heading {
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 22px;
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.14;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after__text {
    max-width: 48ch;
    margin: 7px 0 0;
    color: var(--zh-contact-soft);
    font-size: 13px;
    line-height: 1.62;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after__links {
    display: grid;
    gap: 10px;
    margin-top: 18px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after__link {
    display: grid;
    gap: 4px;
    color: var(--zh-contact-ink);
    text-decoration: none;
    transition: color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after__link span {
    color: rgba(42, 37, 32, 0.42);
    font-size: 9.7px;
    font-weight: 500;
    letter-spacing: 0.15em;
    line-height: 1;
    text-transform: uppercase;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-after__link strong {
    color: rgba(42, 37, 32, 0.72);
    font-size: 13.2px;
    font-weight: 400;
    line-height: 1.38;
  }

  @media (min-width: 640px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-right: 24px;
      padding-bottom: 78px;
      padding-left: 24px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro {
      padding: 22px 22px 0;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form {
      gap: 16px;
      padding: 22px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form__row--split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    #ZaynaContact-{{ section.id }} .zh-contact-submit {
      width: auto;
      min-width: 176px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form__footer {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 14px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-after__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 22px;
    }
  }

  @media (min-width: 900px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-top: 36px;
      padding-bottom: 86px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__header {
      margin-bottom: 28px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__title {
      font-size: clamp(2.34rem, 2.7vw, 2.74rem);
    }

    #ZaynaContact-{{ section.id }} .zh-contact__intro {
      font-size: 14.4px;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-right: 40px;
      padding-left: 40px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaContact-{{ section.id }} .zh-contact-subject:hover {
      border-color: rgba(155, 97, 61, 0.22);
      background: rgba(244, 237, 230, 0.52);
      color: #704a33;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-submit:hover {
      border-color: #7a4a2e;
      background: #7a4a2e;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-after__link:hover,
    #ZaynaContact-{{ section.id }} .zh-contact-after__link:hover strong {
      color: var(--zh-contact-clay);
    }
  }

  @supports not selector(:has(*)) {
    #ZaynaContact-{{ section.id }} .zh-contact-subject input:checked + .zh-contact-subject__text {
      color: #704a33;
      text-decoration: underline;
      text-decoration-color: rgba(155, 97, 61, 0.32);
      text-underline-offset: 4px;
    }
  }
{% endstyle %}

{% schema %}
