{%- liquid
  assign s = section.settings
  assign subjects = s.subjects | split: ','
-%}

<section
  id="ZaynaContact-{{ section.id }}"
  class="zh-contact"
  aria-labelledby="ZaynaContactTitle-{{ section.id }}"
>
  <div class="zh-contact__inner">
    <header class="zh-contact__header">
      {%- if s.eyebrow != blank -%}
        <p class="zh-contact__eyebrow">
          <span aria-hidden="true"></span>
          {{ s.eyebrow | escape }}
        </p>
      {%- endif -%}

      <h1
        id="ZaynaContactTitle-{{ section.id }}"
        class="zh-contact__title"
      >
        {{ s.heading | escape }}
      </h1>

      {%- if s.intro != blank or s.note_response != blank -%}
        <div class="zh-contact__intro-wrap">
          {%- if s.intro != blank -%}
            <div class="zh-contact__intro">
              {{ s.intro | newline_to_br }}
            </div>
          {%- endif -%}

          {%- if s.note_response != blank -%}
            <p class="zh-contact__promise">
              {{ s.note_response | escape }}
            </p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    <div class="zh-contact__content">
      <div class="zh-contact-form-card">
        {%- if s.form_heading != blank or s.form_intro != blank -%}
          <div class="zh-contact-form-card__intro">
            {%- if s.form_heading != blank -%}
              <h2>{{ s.form_heading | escape }}</h2>
            {%- endif -%}

            {%- if s.form_intro != blank -%}
              <p>{{ s.form_intro | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- form 'contact', class: 'zh-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="zh-contact-message zh-contact-message--success" role="status">
              {{ s.success_text | escape }}
            </div>
          {%- elsif form.errors -%}
            <div class="zh-contact-message zh-contact-message--error" role="alert">
              {{ s.error_text | escape }}
            </div>
          {%- endif -%}

          <div class="zh-contact-form__row zh-contact-form__row--split">
            <div class="zh-contact-field">
              <label for="ContactName-{{ section.id }}" class="zh-contact-label">
                {{ s.label_name | escape }}
              </label>

              <input
                id="ContactName-{{ section.id }}"
                type="text"
                name="contact[name]"
                required
                autocomplete="name"
                value="{% if form.name %}{{ form.name | escape }}{% endif %}"
                class="zh-contact-input"
              >
            </div>

            <div class="zh-contact-field">
              <label for="ContactEmail-{{ section.id }}" class="zh-contact-label">
                {{ s.label_email | escape }}
              </label>

              <input
                id="ContactEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                required
                autocomplete="email"
                value="{% if form.email %}{{ form.email | escape }}{% endif %}"
                class="zh-contact-input"
              >
            </div>
          </div>

          <fieldset class="zh-contact-subjects">
            <legend class="zh-contact-label">
              {{ s.label_subject | escape }}
            </legend>

            <div class="zh-contact-subjects__list">
              {%- for subject in subjects -%}
                {%- assign subject_label = subject | strip -%}
                {%- if subject_label != blank -%}
                  <label class="zh-contact-subject">
                    <input
                      type="radio"
                      name="contact[Onderwerp]"
                      value="{{ subject_label | escape }}"
                      required
                    >
                    <span class="zh-contact-subject__text">
                      {{ subject_label | escape }}
                    </span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>

          <div class="zh-contact-field zh-contact-field--order">
            <label for="ContactOrder-{{ section.id }}" class="zh-contact-label">
              {{ s.label_order | escape }}
            </label>

            <input
              id="ContactOrder-{{ section.id }}"
              type="text"
              name="contact[Bestelnummer]"
              autocomplete="off"
              class="zh-contact-input"
            >

            {%- if s.order_hint != blank -%}
              <p class="zh-contact-help">
                {{ s.order_hint | escape }}
              </p>
            {%- endif -%}
          </div>

          <div class="zh-contact-field">
            <label for="ContactMessage-{{ section.id }}" class="zh-contact-label">
              {{ s.label_message | escape }}
            </label>

            <textarea
              id="ContactMessage-{{ section.id }}"
              name="contact[body]"
              rows="5"
              required
              class="zh-contact-textarea"
            >{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
          </div>

          <div class="zh-contact-form__footer">
            <button type="submit" class="zh-contact-submit">
              {{ s.submit_label | escape }}
            </button>

            {%- if s.form_hint != blank -%}
              <p class="zh-contact-form__note">
                {{ s.form_hint | escape }}
              </p>
            {%- endif -%}
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% style %}
  #ZaynaContact-{{ section.id }} {
    --zh-contact-bg: var(--color-bg, #faf5f2);
    --zh-contact-surface: #fffdfb;
    --zh-contact-ink: #2a2520;
    --zh-contact-soft: rgba(42, 37, 32, 0.66);
    --zh-contact-muted: rgba(42, 37, 32, 0.47);
    --zh-contact-border: rgba(42, 37, 32, 0.092);
    --zh-contact-border-strong: rgba(42, 37, 32, 0.15);
    --zh-contact-clay: #9b613d;
    --zh-contact-button: #665045;
    --zh-contact-button-hover: #765746;
    --zh-contact-paper: transparent;
    --zh-contact-field: rgba(255, 251, 246, 0.90);
    --zh-contact-field-soft: rgba(250, 243, 236, 0.68);

    background: var(--zh-contact-bg);
    color: var(--zh-contact-ink);
  }

  #ZaynaContact-{{ section.id }} .zh-contact__inner {
    width: min(100%, 640px);
    margin: 0 auto;
    padding: 28px 16px 124px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__header {
    max-width: none;
    margin: 0 0 22px;
    text-align: left;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 9px;
    color: var(--zh-contact-clay);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1;
    text-transform: uppercase;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__eyebrow > span {
    width: 22px;
    height: 1px;
    background: rgba(155, 97, 61, 0.45);
  }

  #ZaynaContact-{{ section.id }} .zh-contact__title {
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(1.40rem, 4.05vw, 1.64rem);
    font-weight: 400;
    letter-spacing: -0.024em;
    line-height: 1.04;
    text-wrap: balance;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__intro-wrap {
    max-width: 51ch;
    margin: 8px 0 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__intro {
    color: var(--zh-contact-soft);
    font-size: 13.15px;
    line-height: 1.58;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__promise {
    margin: 6px 0 0;
    color: rgba(42, 37, 32, 0.48);
    font-size: 12.05px;
    line-height: 1.48;
  }

  #ZaynaContact-{{ section.id }} .zh-contact__content {
    display: grid;
    max-width: none;
    margin: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card {
    background: transparent;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro {
    padding: 18px 18px 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro h2 {
    margin: 0;
    color: var(--zh-contact-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 19px;
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.016em;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro p {
    max-width: 44ch;
    margin: 7px 0 0;
    color: var(--zh-contact-muted);
    font-size: 12.6px;
    line-height: 1.56;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form {
    display: grid;
    gap: 13px;
    padding: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__row {
    display: grid;
    gap: 12px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-field {
    min-width: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-label {
    display: block;
    margin: 0 0 6px;
    color: rgba(42, 37, 32, 0.58);
    font-size: 11.55px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.24;
    text-transform: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input,
  #ZaynaContact-{{ section.id }} .zh-contact-textarea {
    width: 100%;
    border: 1px solid rgba(42, 37, 32, 0.092);
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    background: var(--zh-contact-field);
    color: var(--zh-contact-ink);
    font-size: 13.35px;
    line-height: 1.44;
    outline: 0;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input {
    min-height: 39px;
    padding: 8px 11px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-textarea {
    min-height: 110px;
    resize: vertical;
    padding: 11px 12px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-input:focus,
  #ZaynaContact-{{ section.id }} .zh-contact-textarea:focus {
    border-color: rgba(155, 97, 61, 0.30);
    background: rgba(255, 253, 251, 0.94);
    box-shadow: 0 0 0 1px rgba(155, 97, 61, 0.045);
  }

  #ZaynaContact-{{ section.id }} .zh-contact-help {
    margin: 6px 0 0;
    color: rgba(42, 37, 32, 0.43);
    font-size: 11.25px;
    line-height: 1.45;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subjects {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 31px;
    align-items: center;
    padding: 0 10px;
    border: 1px solid rgba(42, 37, 32, 0.078);
    background: var(--zh-contact-field-soft);
    color: rgba(42, 37, 32, 0.58);
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      box-shadow 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject__text {
    min-width: 0;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.2;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject:has(input:checked) {
    border-color: rgba(155, 97, 61, 0.24);
    background: rgba(244, 234, 224, 0.70);
    box-shadow: none;
    color: #704a33;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-subject:has(input:focus-visible) {
    outline: 2px solid rgba(166, 106, 63, 0.42);
    outline-offset: 2px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__footer {
    display: grid;
    gap: 9px;
    align-items: center;
    justify-items: stretch;
    padding-top: 2px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-submit {
    display: inline-flex;
    min-height: 40px;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 0 22px;
    border: 1px solid rgba(106, 81, 68, 0.82);
    border-radius: 0;
    background: var(--zh-contact-button);
    color: #fffdfb;
    font-size: 12.15px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-submit:focus-visible {
    outline: 2px solid rgba(166, 106, 63, 0.45);
    outline-offset: 3px;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-form__note {
    max-width: 52ch;
    margin: 0;
    color: rgba(42, 37, 32, 0.44);
    font-size: 11.45px;
    line-height: 1.48;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message {
    padding: 11px 12px;
    border: 1px solid transparent;
    background: rgba(255, 253, 251, 0.62);
    font-size: 13px;
    line-height: 1.45;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message--success {
    border-color: rgba(98, 123, 93, 0.22);
    color: #536949;
  }

  #ZaynaContact-{{ section.id }} .zh-contact-message--error {
    border-color: rgba(139, 76, 66, 0.22);
    color: #8b4c42;
  }


  @media (max-width: 359px) {
    #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 560px) {
    #ZaynaContact-{{ section.id }} .zh-contact-subjects__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 640px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-right: 24px;
      padding-bottom: 130px;
      padding-left: 24px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form {
      gap: 14px;
      padding: 0;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form-card__intro {
      padding: 22px 22px 0;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form__row--split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #ZaynaContact-{{ section.id }} .zh-contact-submit {
      width: auto;
      min-width: 194px;
      justify-self: start;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-form__footer {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 14px;
    }
  }

  @media (min-width: 900px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-top: 34px;
      padding-bottom: 150px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__header {
      margin-bottom: 24px;
    }

    #ZaynaContact-{{ section.id }} .zh-contact__title {
      font-size: clamp(1.58rem, 1.42vw, 1.78rem);
    }

    #ZaynaContact-{{ section.id }} .zh-contact__intro {
      font-size: 13.35px;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaContact-{{ section.id }} .zh-contact__inner {
      padding-right: 40px;
      padding-left: 40px;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaContact-{{ section.id }} .zh-contact-subject:hover {
      border-color: rgba(155, 97, 61, 0.18);
      background: rgba(246, 238, 230, 0.56);
      color: #704a33;
    }

    #ZaynaContact-{{ section.id }} .zh-contact-submit:hover {
      border-color: var(--zh-contact-button-hover);
      background: var(--zh-contact-button-hover);
    }
  }

  @supports not selector(:has(*)) {
    #ZaynaContact-{{ section.id }} .zh-contact-subject input:checked + .zh-contact-subject__text {
      color: #704a33;
      text-decoration: underline;
      text-decoration-color: rgba(155, 97, 61, 0.32);
      text-underline-offset: 4px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Heb je een vraag over een product, bestelling of retour? Stuur ons gerust een bericht."
    },
    {
      "type": "text",
      "id": "note_response",
      "label": "Response note",
      "default": "We reageren meestal binnen 24 uur op werkdagen."
    },
    {
      "type": "header",
      "content": "Form copy"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading"
    },
    {
      "type": "textarea",
      "id": "form_intro",
      "label": "Form intro"
    },
    {
      "type": "text",
      "id": "form_hint",
      "label": "Form hint",
      "default": "Vermeld bij vragen over je bestelling indien mogelijk je bestelnummer."
    },
    {
      "type": "header",
      "content": "Form labels"
    },
    {
      "type": "text",
      "id": "label_name",
      "label": "Name label",
      "default": "Naam"
    },
    {
      "type": "text",
      "id": "label_email",
      "label": "Email label",
      "default": "E-mailadres"
    },
    {
      "type": "text",
      "id": "label_subject",
      "label": "Subject label",
      "default": "Waar gaat je vraag over?"
    },
    {
      "type": "text",
      "id": "subjects",
      "label": "Subjects (comma-separated)",
      "default": "Productvraag, Bestelling, Retour of ruil, Anders"
    },
    {
      "type": "text",
      "id": "label_order",
      "label": "Order number label",
      "default": "Bestelnummer, indien van toepassing"
    },
    {
      "type": "text",
      "id": "order_hint",
      "label": "Order hint",
      "default": "Alleen nodig bij een bestelling of retour."
    },
    {
      "type": "text",
      "id": "label_message",
      "label": "Message label",
      "default": "Bericht"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit label",
      "default": "Bericht versturen"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Bedankt voor je bericht. We reageren zo snel mogelijk."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error text",
      "default": "Er ging iets mis. Controleer je gegevens en probeer het opnieuw."
    }
  ]
}
{% endschema %}
