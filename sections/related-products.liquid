{%- liquid
  assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=4&intent=related'

  assign related_eyebrow = section.settings.eyebrow | default: 'Verder kijken'
  assign related_heading = section.settings.heading

  if related_heading == blank or related_heading == 'Misschien vind je dit ook mooi' or related_heading == 'Meer in dezelfde sfeer'
    assign related_heading = 'In dezelfde sfeer'
  endif

-%}

{% style %}
  .zh-related-products {
    background: #fcfaf7;
  }

  .zh-related-products__section {
    padding-top: 2.6rem;
    padding-bottom: 3rem;
  }

  .zh-related-products__header {
    margin-bottom: 1.05rem;
  }

  .zh-related-products__eyebrow {
    margin: 0 0 .32rem;
    color: var(--color-clay, #9b5f35);
    font-size: .67rem;
    font-weight: 600;
    letter-spacing: .14em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .zh-related-products__heading {
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-size: clamp(1.28rem, 2.1vw, 1.6rem);
    font-weight: 400;
    line-height: 1.2;
    text-wrap: balance;
  }

  .zh-related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1rem;
  }

  @media (min-width: 700px) {
    .zh-related-products__section {
      padding-top: 2.35rem;
      padding-bottom: 3.25rem;
    }

    .zh-related-products__header {
      margin-bottom: 1.15rem;
    }

    .zh-related-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.75rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .zh-related-products__section {
      padding-top: 3rem;
      padding-bottom: 2.875rem;
    }

    .zh-related-products__header {
      margin-bottom: 1.2rem;
    }

    .zh-related-products__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem 1.75rem;
    }
  }
{% endstyle %}

<div
  id="zayna-related-products"
  data-related-products
  class="zh-related-products"
  {% unless recommendations.performed %}data-url="{{ rec_url }}"{% endunless %}
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section
      aria-labelledby="related-products-heading-{{ section.id }}"
      class="zh-related-products__section mx-auto max-w-7xl px-4 sm:px-6 lg:px-10"
    >
      <header class="zh-related-products__header">
        {%- if related_eyebrow != blank -%}
          <p class="zh-related-products__eyebrow">{{ related_eyebrow }}</p>
        {%- endif -%}

        <h2 id="related-products-heading-{{ section.id }}" class="zh-related-products__heading font-display">
          {{ related_heading }}
        </h2>
      </header>

      <div class="zh-related-products__grid">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product, loading: 'lazy' %}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Gerelateerde producten",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Bovenkop",
      "default": "Verder kijken"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "In dezelfde sfeer"
    }
  ],
  "presets": [{ "name": "Gerelateerde producten" }]
}
{% endschema %}
