{%- liquid
  assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=4&intent=related'
-%}

{% style %}
  .zh-related-products {
    border-top: 1px solid rgb(42 37 32 / 12%);
    background: #fffdfb;
  }

  .zh-related-products__section {
    padding-top: 2.75rem;
    padding-bottom: 3.5rem;
  }

  .zh-related-products__heading {
    margin: 0 0 1.5rem;
    color: var(--color-ink, #2a2520);
    font-size: clamp(1.55rem, 4vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .zh-related-products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1rem;
  }

  @media (min-width: 700px) {
    .zh-related-products__section {
      padding-top: 3.5rem;
      padding-bottom: 4.25rem;
    }

    .zh-related-products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.75rem 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .zh-related-products__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 3rem 1.75rem;
    }
  }
{% endstyle %}

<div
  id="zayna-related-products"
  data-related-products
  class="zh-related-products"
  {% unless recommendations.performed %}data-url="{{ rec_url }}"{% endunless %}
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section aria-labelledby="related-products-heading-{{ section.id }}" class="zh-related-products__section mx-auto max-w-7xl px-4 sm:px-6 lg:px-10">
      <h2 id="related-products-heading-{{ section.id }}" class="zh-related-products__heading font-display">{{ section.settings.heading }}</h2>
      <div class="zh-related-products__grid">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product, loading: 'lazy' %}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Gerelateerde producten",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titel", "default": "Misschien vind je dit ook mooi" }
  ],
  "presets": [{ "name": "Gerelateerde producten" }]
}
{% endschema %}
