{%- liquid
  assign coll = section.settings.collection
  assign mobile_product_limit = 6
  assign desktop_product_limit = 8
  assign section_heading_id = 'FreshlyListedHeading-' | append: section.id

  if coll != blank
    assign products = coll.products
  else
    assign products = collections.all.products
  endif
-%}

{% style %}
  #ZaynaFreshlyListed-{{ section.id }} {
    --zayna-fresh-bg: #faf5f2;
    --zayna-fresh-ink: #2a2520;
    --zayna-fresh-soft: #675f58;
    --zayna-fresh-accent: #a66a3f;
    --zayna-fresh-border: #e7ddd2;

    background: var(--zayna-fresh-bg);
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__inner {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 48px 20px 25px;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 18px;
    margin-bottom: 26px;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__heading-group {
    min-width: 0;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__eyebrow {
    margin: 0 0 8px;
    color: var(--zayna-fresh-accent);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__title {
    margin: 0;
    color: var(--zayna-fresh-ink);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(31px, 8.2vw, 35px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    padding-bottom: 4px;
    border-bottom: 1px solid var(--zayna-fresh-border);
    color: var(--zayna-fresh-soft);
    font-size: 9px;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-align: right;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 14px;
    row-gap: 30px;
  }

  #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__item {
    min-width: 0;
  }

  #ZaynaFreshlyListed-{{ section.id }}
    .zayna-freshly-listed__item--desktop-only {
    display: none;
  }

  #ZaynaFreshlyListed-{{ section.id }}
    .zayna-freshly-listed__link:focus-visible {
    outline: 2px solid var(--zayna-fresh-accent);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaFreshlyListed-{{ section.id }}
      .zayna-freshly-listed__link:hover {
      border-color: var(--zayna-fresh-accent);
      color: var(--zayna-fresh-accent);
    }
  }

  @media (max-width: 389px) {
    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__inner {
      padding: 44px 18px 24px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__header {
      gap: 12px;
      margin-bottom: 23px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__title {
      font-size: 31px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__link {
      font-size: 8.5px;
      letter-spacing: 0.14em;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__grid {
      column-gap: 12px;
      row-gap: 28px;
    }
  }

  @media (min-width: 750px) {
    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__inner {
      padding: 62px 32px 28px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__header {
      gap: 28px;
      margin-bottom: 32px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__eyebrow {
      margin-bottom: 10px;
      font-size: 10px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__title {
      font-size: clamp(38px, 4vw, 42px);
      line-height: 1.04;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__link {
      margin-bottom: 3px;
      font-size: 10px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 22px;
      row-gap: 38px;
    }
  }

  @media (min-width: 1100px) {
    #ZaynaFreshlyListed-{{ section.id }}
      .zayna-freshly-listed__item--desktop-only {
      display: block;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__inner {
      padding: 64px 40px 30px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__header {
      margin-bottom: 30px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__title {
      font-size: 42px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__grid {
      column-gap: 28px;
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 560px) and (max-width: 749px) {
    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__inner {
      padding-top: 50px;
      padding-bottom: 24px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__header {
      margin-bottom: 25px;
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__title {
      font-size: clamp(32px, 5.4vw, 36px);
    }

    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__grid {
      column-gap: 15px;
      row-gap: 30px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaFreshlyListed-{{ section.id }} .zayna-freshly-listed__link {
      transition: none;
    }
  }
{% endstyle %}

{%- if products.size > 0 -%}
  <section
    id="ZaynaFreshlyListed-{{ section.id }}"
    class="zayna-freshly-listed"
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ section_heading_id }}"
    {% else %}
      aria-label="{{ section.settings.eyebrow | default: 'Nieuw binnen' | escape }}"
    {% endif %}
  >
    <div class="zayna-freshly-listed__inner">
      <header class="zayna-freshly-listed__header">
        <div class="zayna-freshly-listed__heading-group">
          {%- if section.settings.eyebrow != blank -%}
            <p class="zayna-freshly-listed__eyebrow">
              {{ section.settings.eyebrow | escape }}
            </p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2
              id="{{ section_heading_id }}"
              class="zayna-freshly-listed__title"
            >
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
        </div>

        {%- if section.settings.link_label != blank -%}
          <a
            href="{{ section.settings.link_url | default: routes.all_products_collection_url }}"
            class="zayna-freshly-listed__link"
          >
            <span>{{ section.settings.link_label | escape }}</span>
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </header>

      <div class="zayna-freshly-listed__grid">
        {%- for product in products limit: desktop_product_limit -%}
          <div
            class="zayna-freshly-listed__item{% if forloop.index > mobile_product_limit %} zayna-freshly-listed__item--desktop-only{% endif %}"
          >
            {% render 'product-card', product: product, loading: 'lazy', card_context: 'freshly-listed' %}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}



{% schema %}
{
  "name": "Freshly listed",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collectie",
      "info": "Wanneer dit leeg blijft, worden producten uit Alle producten gebruikt."
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 8,
      "step": 1,
      "label": "Aantal producten",
      "info": "De homepage toont 6 producten op mobiel en gesplitst scherm en 8 op brede desktop.",
      "default": 6
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine bovenregel",
      "default": "Net binnen"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titel",
      "default": "Nieuw binnen"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Linktekst",
      "default": "Bekijk alles"
    },
    {
      "type": "text",
      "id": "link_url",
      "label": "Link URL",
      "default": "/collections/all"
    }
  ],
  "presets": [
    {
      "name": "Freshly listed"
    }
  ]
}
{% endschema %}