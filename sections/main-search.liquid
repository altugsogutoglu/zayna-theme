{%- liquid
  assign per_page = section.settings.products_per_page | default: 24
  assign terms = search.terms | strip
  assign all_pages = search.results | where: 'object_type', 'page'
  assign all_articles = search.results | where: 'object_type', 'article'
  assign products_only = search.results | where: 'object_type', 'product'
  assign products_total = search.results_count | default: products_only.size
-%}

<section
  id="ZaynaSearchResults-{{ section.id }}"
  class="zh-search-page"
  data-search
  data-section-id="{{ section.id }}"
  data-search-url="{{ routes.search_url }}"
>
  <header class="zh-search-page__header">
    <p class="zh-search-page__eyebrow">
      <span aria-hidden="true"></span>
      {{ section.settings.eyebrow }}
    </p>

    <h1 class="zh-search-page__title">
      {%- if search.performed and terms != blank -%}
        Resultaten voor <span>&ldquo;{{ terms }}&rdquo;</span>
      {%- else -%}
        {{ section.settings.heading_no_term }}
      {%- endif -%}
    </h1>

    {%- if search.performed and terms != blank -%}
      <p class="zh-search-page__count">
        {%- if products_total == 1 -%}
          1 product gevonden
        {%- elsif products_total > 1 -%}
          {{ products_total }} producten gevonden
        {%- else -%}
          Geen producten gevonden
        {%- endif -%}
      </p>
    {%- endif -%}

    <form
      action="{{ routes.search_url }}"
      method="get"
      role="search"
      class="zh-search-page__form"
    >
      <label for="SearchInput-{{ section.id }}" class="sr-only">
        {{ 'general.search.title' | t }}
      </label>

      <span class="zh-search-page__form-icon" aria-hidden="true">
        {% render 'icon', name: 'search', size: 18 %}
      </span>

      <input
        id="SearchInput-{{ section.id }}"
        type="search"
        name="q"
        value="{{ terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autocomplete="off"
        class="zh-search-page__input"
        aria-label="{{ 'general.search.title' | t }}"
      >

      <input type="hidden" name="type" value="product">

      <button type="submit" class="zh-search-page__submit" aria-label="{{ 'general.search.submit' | t }}">
        <span class="zh-search-page__submit-icon" aria-hidden="true">
          {% render 'icon', name: 'search', size: 17 %}
        </span>
        <span class="zh-search-page__submit-text">
          {{ 'general.search.submit' | t }}
        </span>
      </button>
    </form>
  </header>

  {%- if search.performed == false or terms == blank -%}
    <div class="zh-search-page__state">
      <p class="zh-search-page__state-title">{{ section.settings.heading_no_term }}</p>
      <p class="zh-search-page__state-text">{{ section.settings.no_term_body }}</p>
    </div>
  {%- elsif products_total == 0 -%}
    <div class="zh-search-page__state">
      <p class="zh-search-page__state-title">{{ section.settings.empty_heading }}</p>
      <p class="zh-search-page__state-text">{{ section.settings.empty_body }}</p>
      {%- assign empty_url = section.settings.empty_button_url | default: routes.all_products_collection_url -%}
      <a href="{{ empty_url }}" class="zh-search-page__state-link">
        {{ section.settings.empty_button_label }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  {%- else -%}
    <div class="zh-search-page__results">
      <section>
        <div class="zh-search-page__section-heading">
          <h2>{{ 'general.search.products' | t }}</h2>
        </div>

        {%- paginate search.results by per_page -%}
          <div
            data-product-grid
            class="zh-search-page__grid grid grid-cols-2 gap-x-5 md:grid-cols-3 md:gap-x-7 lg:grid-cols-4 lg:gap-x-8"
          >
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <div data-search-product>
                  {% render 'product-card', product: item %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.next -%}
            <div data-load-more class="zh-search-page__load-more">
              <a
                href="{{ paginate.next.url }}"
                data-load-more-link
                data-loading-label="{{ 'general.search.loading' | t }}"
                data-retry-label="Opnieuw proberen"
                rel="next"
                class="zh-search-page__load-more-link"
              >
                <span data-load-more-text>Meer laden</span>
                <span aria-hidden="true">↓</span>
              </a>
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      </section>

      {%- if all_pages.size > 0 -%}
        <section class="zh-search-page__secondary-results">
          <div class="zh-search-page__section-heading">
            <h2>{{ 'general.search.pages' | t }}</h2>
            <span>{{ all_pages.size }}</span>
          </div>
          <div>
            {%- for item in all_pages -%}
              <a href="{{ item.url }}" class="zh-search-page__secondary-link">
                <span>{{ item.title }}</span>
                <span aria-hidden="true">→</span>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}

      {%- if all_articles.size > 0 -%}
        <section class="zh-search-page__secondary-results">
          <div class="zh-search-page__section-heading">
            <h2>{{ 'general.search.articles' | t }}</h2>
            <span>{{ all_articles.size }}</span>
          </div>
          <div>
            {%- for item in all_articles -%}
              <a href="{{ item.url }}" class="zh-search-page__secondary-link">
                <span>{{ item.title }}</span>
                <span aria-hidden="true">→</span>
              </a>
            {%- endfor -%}
          </div>
        </section>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% style %}
  #ZaynaSearchResults-{{ section.id }} {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 0 16px 78px;
    color: var(--color-ink, #2a2520);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__header {
    padding: 30px 0 24px;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 8px;
    color: var(--color-clay, #b5651d);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__eyebrow > span {
    width: 28px;
    height: 1px;
    background: rgba(181, 101, 29, 0.56);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__title {
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.8rem, 6.6vw, 2.08rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.024em;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__title span {
    color: rgba(166, 106, 63, 0.78);
    font-style: italic;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__count {
    margin: 9px 0 0;
    color: rgba(42, 37, 32, 0.58);
    font-size: 12.5px;
    line-height: 1.45;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__form {
    display: flex;
    width: 100%;
    max-width: 560px;
    min-height: 42px;
    align-items: center;
    margin-top: 18px;
    border: 1px solid rgba(42, 37, 32, 0.10);
    background: rgba(255, 253, 251, 0.62);
    transition: border-color 180ms ease, background-color 180ms ease;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__form:focus-within {
    border-color: rgba(181, 101, 29, 0.42);
    background: rgba(255, 253, 251, 0.86);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__form-icon {
    display: grid;
    width: 41px;
    flex: 0 0 auto;
    place-items: center;
    color: rgba(42, 37, 32, 0.42);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__input {
    min-width: 0;
    flex: 1 1 auto;
    height: 42px;
    border: 0;
    background: transparent;
    color: var(--color-ink, #2a2520);
    font-size: 15px;
    line-height: 1;
    outline: none;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__input::placeholder {
    color: rgba(120, 113, 108, 0.66);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit {
    display: grid;
    width: 42px;
    min-height: 42px;
    flex: 0 0 auto;
    place-items: center;
    border-left: 1px solid rgba(42, 37, 32, 0.065);
    background: rgba(250, 247, 242, 0.42);
    color: rgba(42, 37, 32, 0.78);
    transition: background-color 180ms ease, color 180ms ease;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit:hover {
    background: rgba(232, 225, 218, 0.72);
    color: var(--color-ink, #2a2520);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit:focus-visible {
    outline: 2px solid rgba(181, 101, 29, 0.52);
    outline-offset: 2px;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit-text {
    display: none;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__results {
    display: grid;
    gap: 50px;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 24px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(42, 37, 32, 0.075);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__section-heading h2 {
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-family: var(--font-display, Georgia, serif);
    font-size: 21px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__section-heading span {
    color: rgba(120, 113, 108, 0.72);
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
  }



  #ZaynaSearchResults-{{ section.id }} .zh-search-page__grid {
    row-gap: 34px;
  }

  #ZaynaSearchResults-{{ section.id }} [data-search-product] {
    min-width: 0;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__state {
    margin-top: 18px;
    padding: 44px 18px 54px;
    border-top: 1px solid rgba(42, 37, 32, 0.08);
    text-align: center;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__state-title {
    margin: 0;
    color: rgba(42, 37, 32, 0.78);
    font-family: var(--font-display, Georgia, serif);
    font-size: 24px;
    font-style: italic;
    line-height: 1.18;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__state-text {
    max-width: 36ch;
    margin: 12px auto 0;
    color: rgba(42, 37, 32, 0.62);
    font-size: 14px;
    line-height: 1.65;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__state-link,
  #ZaynaSearchResults-{{ section.id }} .zh-search-page__load-more-link {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    margin-top: 24px;
    padding: 0 18px;
    border: 1px solid rgba(42, 37, 32, 0.16);
    background: rgba(255, 253, 251, 0.54);
    color: var(--color-ink, #2a2520);
    font-size: 10px;
    letter-spacing: 0.13em;
    text-decoration: none;
    text-transform: uppercase;
    transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__state-link:hover,
  #ZaynaSearchResults-{{ section.id }} .zh-search-page__load-more-link:hover {
    border-color: rgba(181, 101, 29, 0.34);
    background: rgba(240, 235, 230, 0.62);
    color: var(--color-clay, #b5651d);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__load-more {
    display: flex;
    justify-content: center;
    margin-top: 44px;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__secondary-results {
    max-width: 720px;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__secondary-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid rgba(42, 37, 32, 0.075);
    color: inherit;
    text-decoration: none;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__secondary-link > span:first-child {
    color: var(--color-ink, #2a2520);
    font-family: var(--font-display, Georgia, serif);
    font-size: 17px;
    line-height: 1.25;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__secondary-link > span:last-child {
    color: rgba(120, 113, 108, 0.72);
    transition: transform 180ms ease, color 180ms ease;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__secondary-link:hover > span:last-child {
    transform: translateX(3px);
    color: var(--color-clay, #b5651d);
  }

  @media (min-width: 760px) {
    #ZaynaSearchResults-{{ section.id }} {
      padding: 0 24px 94px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__header {
      padding: 28px 0 32px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__title {
      max-width: 28ch;
      font-size: clamp(1.85rem, 2.6vw, 2.35rem);
      line-height: 1.08;
      letter-spacing: -0.020em;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__count {
      margin-top: 7px;
      font-size: 12.5px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__form {
      max-width: 510px;
      min-height: 46px;
      margin-top: 19px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__input {
      height: 44px;
      font-size: 15px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit {
      display: inline-flex;
      width: auto;
      min-height: 44px;
      align-items: center;
      gap: 8px;
      padding: 0 15px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit-icon {
      display: none;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__submit-text {
      display: inline;
      font-size: 9.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__results {
      gap: 40px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__grid {
      row-gap: 42px;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaSearchResults-{{ section.id }} {
      padding-right: 40px;
      padding-left: 40px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__header {
      padding-top: 34px;
      padding-bottom: 34px;
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__title {
      max-width: 30ch;
      font-size: clamp(2rem, 1.8vw, 2.55rem);
    }

    #ZaynaSearchResults-{{ section.id }} .zh-search-page__section-heading {
      margin-bottom: 22px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Zoeken" },
    { "type": "text", "id": "heading_no_term", "label": "Heading (no search term)", "default": "Wat zoek je?" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "header", "content": "No-term state" },
    { "type": "textarea", "id": "no_term_body", "label": "No-term body", "default": "Zoek naar producten of bekijk de volledige collectie." },
    { "type": "header", "content": "Empty (no results) state" },
    { "type": "text", "id": "empty_heading", "label": "Empty heading", "default": "Geen producten gevonden." },
    { "type": "textarea", "id": "empty_body", "label": "Empty body", "default": "Probeer een andere zoekterm of bekijk onze volledige collectie." },
    { "type": "text", "id": "empty_button_label", "label": "Empty button label", "default": "Bekijk collectie" },
    { "type": "url", "id": "empty_button_url", "label": "Empty button link" }
  ]
}
{% endschema %}
