{%- liquid
  assign terms = search.terms | strip
  assign original_terms = terms
  assign terms_key = terms | downcase | strip | handleize
  assign corrected_terms = terms

  case terms_key
    when 'pit', 'ppt', 'ppot', 'pott', 'pto', 'oot', 'poy'
      assign corrected_terms = 'pot'
    when 'potn', 'pottenn'
      assign corrected_terms = 'potten'
    when 'kruidepot', 'kruidenpt'
      assign corrected_terms = 'kruidenpot'
    when 'voorraadpt', 'vooraadpot'
      assign corrected_terms = 'voorraadpot'
    when 'bewaarpt'
      assign corrected_terms = 'bewaarpot'
    when 'doe', 'doke', 'doej', 'deok'
      assign corrected_terms = 'doek'
    when 'doekn', 'doekenn'
      assign corrected_terms = 'doeken'
    when 'keukendoekn', 'keuekendoek'
      assign corrected_terms = 'keukendoek'
    when 'theedoekn'
      assign corrected_terms = 'theedoeken'
    when 'gls', 'gals', 'glaz', 'glasz', 'gkas'
      assign corrected_terms = 'glas'
    when 'drinkgls'
      assign corrected_terms = 'drinkglas'
    when 'bkr', 'bekr', 'beeker', 'bekker'
      assign corrected_terms = 'beker'
    when 'bekerss'
      assign corrected_terms = 'bekers'
    when 'olue', 'olir', 'oliee', 'olii'
      assign corrected_terms = 'olie'
    when 'olieflesse'
      assign corrected_terms = 'olieflessen'
    when 'fls', 'flesz', 'flese', 'fless'
      assign corrected_terms = 'fles'
    when 'flessenn'
      assign corrected_terms = 'flessen'
    when 'mko', 'mokj', 'mokk'
      assign corrected_terms = 'mok'
    when 'moken'
      assign corrected_terms = 'mokken'
    when 'kpje', 'kopj', 'kopjeh'
      assign corrected_terms = 'kopje'
    when 'kopjesz'
      assign corrected_terms = 'kopjes'
    when 'koffiekpj'
      assign corrected_terms = 'koffiekopje'
    when 'the', 'theee', 'theeë'
      assign corrected_terms = 'thee'
    when 'thepot', 'theepott'
      assign corrected_terms = 'theepot'
    when 'karf', 'kraaf', 'karaff', 'karafg'
      assign corrected_terms = 'karaf'
    when 'hak', 'haakj'
      assign corrected_terms = 'haak'
    when 'haakn'
      assign corrected_terms = 'haken'
    when 'wandhak'
      assign corrected_terms = 'wandhaak'
    when 'bestk', 'bstek', 'bestekj', 'bstiek'
      assign corrected_terms = 'bestek'
    when 'rietj', 'rietjeh'
      assign corrected_terms = 'rietje'
    when 'rietjesz', 'rietjs'
      assign corrected_terms = 'rietjes'
    when 'onderzeter', 'onderzettr'
      assign corrected_terms = 'onderzetter'
    when 'pannenonderzeter'
      assign corrected_terms = 'pannenonderzetter'
    when 'maatlepls', 'maatlepelz'
      assign corrected_terms = 'maatlepels'
    when 'weeglepl'
      assign corrected_terms = 'weeglepel'
    when 'ovenwamt', 'ovenwanr'
      assign corrected_terms = 'ovenwant'
    when 'ovenhandschoe'
      assign corrected_terms = 'ovenhandschoen'
    when 'honig', 'honning'
      assign corrected_terms = 'honing'
    when 'honingpt'
      assign corrected_terms = 'honingpot'
    when 'zeepomp', 'zeeppom'
      assign corrected_terms = 'zeeppomp'
    when 'zeepdispenserr'
      assign corrected_terms = 'zeepdispenser'
    when 'barbeque'
      assign corrected_terms = 'barbecue'
    when 'bbqspies', 'barbecuespiez'
      assign corrected_terms = 'barbecuespies'
    when 'avacodo', 'avokado'
      assign corrected_terms = 'avocado'
    when 'avocadosnijdr'
      assign corrected_terms = 'avocadosnijder'
    when 'miniprint'
      assign corrected_terms = 'miniprinter'
    when 'labelprint', 'labelprinterr'
      assign corrected_terms = 'labelprinter'
  endcase

  assign has_search_correction = false
  if corrected_terms != terms
    assign has_search_correction = true
    assign terms = corrected_terms
    assign terms_key = terms | downcase | strip | handleize
  endif

  assign strict_search_group = ''
  assign strict_search_tags = ''
  assign strict_search_title_needles = ''

  case terms_key
    when 'pot', 'potten', 'voorraadpot', 'voorraadpotten', 'kruidenpot', 'kruidenpotten', 'kruidenpotjes', 'bewaarpot', 'bewaarpotten', 'glazen-pot', 'glazen-potten', 'honingpot', 'honingpotten'
      assign strict_search_group = 'pot'
      assign strict_search_tags = '|pot|potten|voorraadpot|voorraadpotten|kruidenpot|kruidenpotten|kruidenpotjes|bewaarpot|bewaarpotten|glazen-pot|glazen-potten|honingpot|honingpotten|'
      assign strict_search_title_needles = '|pot|voorraadpot|kruidenpot|bewaarpot|honingpot|'
    when 'doek', 'doeken', 'keukendoek', 'keukendoeken', 'handdoek', 'handdoeken', 'theedoek', 'theedoeken', 'keukentextiel', 'textiel'
      assign strict_search_group = 'doek'
      assign strict_search_tags = '|doek|doeken|keukendoek|keukendoeken|handdoek|handdoeken|theedoek|theedoeken|keukentextiel|textiel|'
      assign strict_search_title_needles = '|doek|handdoek|theedoek|keukentextiel|textiel|'
    when 'glas', 'glazen', 'drinkglas', 'drinkglazen', 'waterglas', 'waterglazen', 'theeglas', 'theeglazen', 'beker', 'bekers', 'ribbelglas', 'ribbelglazen', 'wave-glas', 'dubbelwandig-glas', 'dubbelwandige-glazen'
      assign strict_search_group = 'glas'
      assign strict_search_tags = '|glas|glazen|drinkglas|drinkglazen|waterglas|waterglazen|theeglas|theeglazen|beker|bekers|ribbelglas|ribbelglazen|wave-glas|dubbelwandig-glas|dubbelwandige-glazen|'
      assign strict_search_title_needles = '|glas|glazen|drinkglas|waterglas|theeglas|beker|bekers|ribbelglas|wave-glas|dubbelwandig-glas|'
    when 'fles', 'flessen', 'olie', 'olien', 'oliefles', 'olieflessen', 'olieflacon', 'olieflacons', 'azijn', 'azijnfles', 'azijnflessen', 'flacon', 'flacons'
      assign strict_search_group = 'fles'
      assign strict_search_tags = '|fles|flessen|olie|olien|oliefles|olieflessen|olieflacon|olieflacons|azijn|azijnfles|azijnflessen|flacon|flacons|'
      assign strict_search_title_needles = '|fles|flessen|olie|oliefles|olieflacon|azijn|azijnfles|flacon|flacons|'
    when 'mok', 'mokken', 'kop', 'kopje', 'kopjes', 'koffiekop', 'koffiekopje', 'koffiekopjes', 'espresso', 'espressokop', 'espressokopje', 'espressokopjes'
      assign strict_search_group = 'mok'
      assign strict_search_tags = '|mok|mokken|kop|kopje|kopjes|koffiekop|koffiekopje|koffiekopjes|espresso|espressokop|espressokopje|espressokopjes|'
      assign strict_search_title_needles = '|mok|mokken|kopje|kopjes|koffiekop|espresso|espressokop|'
    when 'thee', 'theepot', 'theepotten', 'theeglas', 'theeglazen', 'theezeef', 'zeef', 'filter', 'rvs-filter'
      assign strict_search_group = 'thee'
      assign strict_search_tags = '|thee|theepot|theepotten|theeglas|theeglazen|theezeef|zeef|filter|rvs-filter|'
      assign strict_search_title_needles = '|thee|theepot|theeglas|theezeef|filter|'
    when 'karaf', 'karaffen', 'waterkan', 'waterkannen', 'kan', 'kannen', 'schenkkan', 'schenkkannen'
      assign strict_search_group = 'karaf'
      assign strict_search_tags = '|karaf|karaffen|waterkan|waterkannen|kan|kannen|schenkkan|schenkkannen|'
      assign strict_search_title_needles = '|karaf|karaffen|waterkan|waterkannen|schenkkan|schenkkannen|'
    when 'label', 'labels', 'sticker', 'stickers', 'etiket', 'etiketten', 'kruidenlabel', 'kruidenlabels', 'kruidensticker', 'kruidenstickers'
      assign strict_search_group = 'label'
      assign strict_search_tags = '|label|labels|sticker|stickers|etiket|etiketten|kruidenlabel|kruidenlabels|kruidensticker|kruidenstickers|'
      assign strict_search_title_needles = '|label|labels|sticker|stickers|etiket|etiketten|'
    when 'haak', 'haken', 'wandhaak', 'wandhaken', 'handdoekhaak', 'handdoekhaken', 'zelfklevende-haak', 'zelfklevende-haken'
      assign strict_search_group = 'haak'
      assign strict_search_tags = '|haak|haken|wandhaak|wandhaken|handdoekhaak|handdoekhaken|zelfklevende-haak|zelfklevende-haken|'
      assign strict_search_title_needles = '|haak|haken|wandhaak|wandhaken|'
    when 'bestek', 'bestekset', 'vork', 'vorken', 'mes', 'messen', 'lepel', 'lepels', 'tafelbestek', 'goud-bestek', 'rvs-bestek'
      assign strict_search_group = 'bestek'
      assign strict_search_tags = '|bestek|bestekset|vork|vorken|mes|messen|lepel|lepels|tafelbestek|goud-bestek|rvs-bestek|'
      assign strict_search_title_needles = '|bestek|bestekset|vork|vorken|mes|messen|lepel|lepels|'
    when 'rietje', 'rietjes', 'glazen-rietje', 'glazen-rietjes', 'drinkrietje', 'drinkrietjes'
      assign strict_search_group = 'rietje'
      assign strict_search_tags = '|rietje|rietjes|glazen-rietje|glazen-rietjes|drinkrietje|drinkrietjes|'
      assign strict_search_title_needles = '|rietje|rietjes|'
    when 'maatlepel', 'maatlepels', 'meetlepel', 'meetlepels', 'weeglepel', 'lepelset'
      assign strict_search_group = 'maatlepel'
      assign strict_search_tags = '|maatlepel|maatlepels|meetlepel|meetlepels|weeglepel|lepelset|'
      assign strict_search_title_needles = '|maatlepel|maatlepels|meetlepel|meetlepels|weeglepel|lepelset|'
    when 'onderzetter', 'onderzetters', 'pannenonderzetter', 'pannenonderzetters'
      assign strict_search_group = 'onderzetter'
      assign strict_search_tags = '|onderzetter|onderzetters|pannenonderzetter|pannenonderzetters|'
      assign strict_search_title_needles = '|onderzetter|onderzetters|pannenonderzetter|pannenonderzetters|'
    when 'ovenwant', 'ovenwanten', 'ovenhandschoen', 'ovenhandschoenen', 'pannenlap', 'pannenlappen'
      assign strict_search_group = 'oven'
      assign strict_search_tags = '|ovenwant|ovenwanten|ovenhandschoen|ovenhandschoenen|pannenlap|pannenlappen|'
      assign strict_search_title_needles = '|ovenwant|ovenwanten|ovenhandschoen|ovenhandschoenen|pannenlap|pannenlappen|'
    when 'honing', 'honingpot', 'honingpotten', 'honinglepel'
      assign strict_search_group = 'honing'
      assign strict_search_tags = '|honing|honingpot|honingpotten|honinglepel|'
      assign strict_search_title_needles = '|honing|honingpot|honinglepel|'
    when 'zeep', 'zeeppomp', 'zeepdispenser', 'dispenser', 'pomp', 'pompje'
      assign strict_search_group = 'zeep'
      assign strict_search_tags = '|zeep|zeeppomp|zeepdispenser|dispenser|pomp|pompje|'
      assign strict_search_title_needles = '|zeep|zeeppomp|zeepdispenser|dispenser|pompje|'
    when 'bbq', 'barbecue', 'spies', 'spiesen', 'barbecuespies', 'barbecuespiesen'
      assign strict_search_group = 'bbq'
      assign strict_search_tags = '|bbq|barbecue|spies|spiesen|barbecuespies|barbecuespiesen|'
      assign strict_search_title_needles = '|bbq|barbecue|spies|spiesen|barbecuespies|barbecuespiesen|'
    when 'kruiden', 'kruidenpot', 'kruidenpotten', 'kruidenlabel', 'kruidenlabels', 'kruidensticker', 'kruidenstickers', 'kruidenstrooier', 'strooier'
      assign strict_search_group = 'kruiden'
      assign strict_search_tags = '|kruiden|kruidenpot|kruidenpotten|kruidenlabel|kruidenlabels|kruidensticker|kruidenstickers|kruidenstrooier|strooier|'
      assign strict_search_title_needles = '|kruiden|kruidenpot|kruidenlabel|kruidensticker|kruidenstrooier|strooier|'
    when 'tang', 'tangen', 'serveertang', 'keukentang'
      assign strict_search_group = 'tang'
      assign strict_search_tags = '|tang|tangen|serveertang|keukentang|'
      assign strict_search_title_needles = '|tang|tangen|serveertang|keukentang|'
    when 'printer', 'miniprinter', 'mini-printer', 'thermische-printer', 'labelprinter'
      assign strict_search_group = 'printer'
      assign strict_search_tags = '|printer|miniprinter|mini-printer|thermische-printer|labelprinter|'
      assign strict_search_title_needles = '|printer|miniprinter|mini-printer|thermische-printer|labelprinter|'
    when 'avocado', 'avocadosnijder', 'snijder'
      assign strict_search_group = 'avocado'
      assign strict_search_tags = '|avocado|avocadosnijder|snijder|'
      assign strict_search_title_needles = '|avocado|avocadosnijder|snijder|'
  endcase

  assign is_strict_search = false
  if strict_search_group != blank
    assign is_strict_search = true
  endif

  assign per_page = section.settings.products_per_page | default: 24
  if is_strict_search
    assign per_page = 250
  endif
-%}

{%- if has_search_correction -%}
  <script>
    (() => {
      const url = new URL(window.location.href);
      url.searchParams.set('q', {{ terms | json }});
      url.searchParams.set('type', 'product');
      url.searchParams.delete('page');
      window.location.replace(url.toString());
    })();
  </script>
{%- endif -%}

<script>
  (() => {
    const url = new URL(window.location.href);
    const page = Number.parseInt(url.searchParams.get('page') || '1', 10);

    if (Number.isFinite(page) && page > 1) {
      url.searchParams.delete('page');
      window.location.replace(url.toString());
    }
  })();
</script>

{%- paginate search.results by per_page -%}
  {%- liquid
    assign all_pages = search.results | where: 'object_type', 'page'
    assign all_articles = search.results | where: 'object_type', 'article'
    assign products_only = search.results | where: 'object_type', 'product'
    assign products_total = search.results_count | default: products_only.size

    assign strict_products_count = 0

    if is_strict_search
      for item in search.results
        if item.object_type == 'product'
          assign strict_match = false
          assign item_title_key = item.title | downcase | handleize
          assign title_needles = strict_search_title_needles | split: '|'

          for needle in title_needles
            if needle != blank and item_title_key contains needle
              assign strict_match = true
            endif
          endfor

          if strict_match == false
            for tag in item.tags
              assign tag_key = tag | downcase | strip | handleize
              assign tag_probe = '|' | append: tag_key | append: '|'

              if strict_search_tags contains tag_probe
                assign strict_match = true
              endif
            endfor
          endif

          if strict_match
            assign strict_products_count = strict_products_count | plus: 1
          endif
        endif
      endfor

      assign products_total = strict_products_count
    endif
  -%}

  {%- if is_strict_search and search.performed and terms != blank -%}
    <script>
      document.title = {{ 'Zoeken: ' | append: products_total | append: ' producten gevonden' | append: ' – ' | append: shop.name | json }};
    </script>
  {%- endif -%}

  <section
    id="ZaynaSearchResults-{{ section.id }}"
    class="zh-search-page{% if is_strict_search %} zh-search-page--strict{% endif %}"
    data-search
    data-section-id="{{ section.id }}"
    data-search-url="{{ routes.search_url }}"
  >
    <header class="zh-search-page__header">
      <p class="zh-search-page__eyebrow">
        <span aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </p>

      <h1 class="zh-search-page__title">
        {%- if search.performed and terms != blank -%}
          Resultaten voor <span>&ldquo;{{ terms }}&rdquo;</span>
        {%- else -%}
          {{ section.settings.heading_no_term }}
        {%- endif -%}
      </h1>

      {%- if search.performed and terms != blank -%}
        <p class="zh-search-page__count">
          {%- if products_total == 1 -%}
            1 product gevonden
          {%- elsif products_total > 1 -%}
            {{ products_total }} producten gevonden
          {%- else -%}
            Geen producten gevonden
          {%- endif -%}
        </p>
      {%- endif -%}

      <form
        action="{{ routes.search_url }}"
        method="get"
        role="search"
        class="zh-search-page__form"
      >
        <label for="SearchInput-{{ section.id }}" class="sr-only">
          {{ 'general.search.title' | t }}
        </label>

        <span class="zh-search-page__form-icon" aria-hidden="true">
          {% render 'icon', name: 'search', size: 18 %}
        </span>

        <input
          id="SearchInput-{{ section.id }}"
          type="search"
          name="q"
          value="{{ terms | escape }}"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          class="zh-search-page__input"
          aria-label="{{ 'general.search.title' | t }}"
        >

        <input type="hidden" name="type" value="product">

        <button type="submit" class="zh-search-page__submit" aria-label="{{ 'general.search.submit' | t }}">
          <span class="zh-search-page__submit-icon" aria-hidden="true">
            {% render 'icon', name: 'search', size: 17 %}
          </span>
          <span class="zh-search-page__submit-text">
            {{ 'general.search.submit' | t }}
          </span>
        </button>
      </form>
    </header>

    {%- if search.performed == false or terms == blank -%}
      <div class="zh-search-page__state">
        <p class="zh-search-page__state-title">{{ section.settings.heading_no_term }}</p>
        <p class="zh-search-page__state-text">{{ section.settings.no_term_body }}</p>
      </div>
    {%- elsif products_total == 0 -%}
      <div class="zh-search-page__state">
        <p class="zh-search-page__state-title">{{ section.settings.empty_heading }}</p>
        <p class="zh-search-page__state-text">{{ section.settings.empty_body }}</p>
        {%- assign empty_url = section.settings.empty_button_url | default: routes.all_products_collection_url -%}
        <a href="{{ empty_url }}" class="zh-search-page__state-link">
          {{ section.settings.empty_button_label }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {%- else -%}
      <div class="zh-search-page__results">
        <section>
          <div class="zh-search-page__section-heading">
            <h2>{{ 'general.search.products' | t }}</h2>
          </div>

          <div
            data-product-grid
            class="zh-search-page__grid grid grid-cols-2 gap-x-5 md:grid-cols-3 md:gap-x-7 lg:grid-cols-4 lg:gap-x-8"
          >
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- liquid
                  assign render_item = true

                  if is_strict_search
                    assign render_item = false
                    assign item_title_key = item.title | downcase | handleize
                    assign title_needles = strict_search_title_needles | split: '|'

                    for needle in title_needles
                      if needle != blank and item_title_key contains needle
                        assign render_item = true
                      endif
                    endfor

                    if render_item == false
                      for tag in item.tags
                        assign tag_key = tag | downcase | strip | handleize
                        assign tag_probe = '|' | append: tag_key | append: '|'

                        if strict_search_tags contains tag_probe
                          assign render_item = true
                        endif
                      endfor
                    endif
                  endif
                -%}

                {%- if render_item -%}
                  <div data-search-product>
                    {% render 'product-card', product: item %}
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.next and is_strict_search == false -%}
            <div data-load-more class="zh-search-page__load-more">
              <a
                href="{{ paginate.next.url }}"
                data-load-more-link
                data-loading-label="{{ 'general.search.loading' | t }}"
                data-retry-label="Opnieuw proberen"
                rel="next"
                class="zh-search-page__load-more-link"
              >
                <span data-load-more-text>Meer laden</span>
                <span aria-hidden="true">↓</span>
              </a>
            </div>
          {%- endif -%}
        </section>

        {%- if is_strict_search == false and all_pages.size > 0 -%}
          <section class="zh-search-page__secondary-results">
            <div class="zh-search-page__section-heading">
              <h2>{{ 'general.search.pages' | t }}</h2>
              <span>{{ all_pages.size }}</span>
            </div>
            <div>
              {%- for item in all_pages -%}
                <a href="{{ item.url }}" class="zh-search-page__secondary-link">
                  <span>{{ item.title }}</span>
                  <span aria-hidden="true">→</span>
                </a>
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- if is_strict_search == false and all_articles.size > 0 -%}
          <section class="zh-search-page__secondary-results">
            <div class="zh-search-page__section-heading">
              <h2>{{ 'general.search.articles' | t }}</h2>
              <span>{{ all_articles.size }}</span>
            </div>
            <div>
              {%- for item in all_articles -%}
                <a href="{{ item.url }}" class="zh-search-page__secondary-link">
                  <span>{{ item.title }}</span>
                  <span aria-hidden="true">→</span>
                </a>
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      </div>
    {%- endif -%}
  </section>
{%- endpaginate -%}

{% style %}
  #ZaynaSearchResults-{{ section.id }} {
    width: min(100%, 1280px);
    margin: 0 auto;
    padding: 0 16px 78px;
    color: var(--color-ink, #2a2520);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__header {
    padding: 30px 0 24px;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 0 0 8px;
    color: var(--color-clay, #b5651d);
    font-size: 9px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__eyebrow > span {
    width: 28px;
    height: 1px;
    background: rgba(181, 101, 29, 0.56);
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__title {
    max-width: 18ch;
    margin: 0;
    color: var(--color-ink, #2a2520);
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.8rem, 6.6vw, 2.08rem);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.024em;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__title span {
    color: rgba(166, 106, 63, 0.78);
    font-style: italic;
  }

  #ZaynaSearchResults-{{ section.id }} .zh-search-page__count {
    margin: 9px 0 0;
