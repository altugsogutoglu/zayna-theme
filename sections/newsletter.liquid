{%- liquid
  assign s = section.settings

  assign newsletter_heading_id = 'ZaynaNewsletterHeading-' | append: section.id
  assign newsletter_form_id = 'ZaynaNewsletterForm-' | append: section.id
  assign newsletter_email_id = 'ZaynaNewsletterEmail-' | append: section.id
  assign newsletter_help_id = 'ZaynaNewsletterHelp-' | append: section.id
  assign newsletter_error_id = 'ZaynaNewsletterError-' | append: section.id
  assign newsletter_status_id = 'ZaynaNewsletterStatus-' | append: section.id

  assign eyebrow = s.eyebrow_v2 | default: 'Nieuwsbrief'
  assign heading = s.heading_v2 | default: 'Ontvang rustige inspiratie voor thuis.'
  assign body = s.body_v2 | default: 'Blijf op de hoogte van nieuwe collecties, rustige woon- en keukeninspiratie en af en toe nieuws van Zayna Home.'
  assign field_label = s.field_label_v2 | default: 'E-mailadres'
  assign placeholder = s.placeholder_v2 | default: 'jouw@email.nl'
  assign submit_label = s.submit_label_v2 | default: 'Inschrijven'
  assign success_message = s.success_v2 | default: 'Bedankt voor je inschrijving. Vanaf nu ontvang je af en toe nieuws van Zayna Home.'
  assign disclaimer = s.disclaimer_v2 | default: 'Door je in te schrijven ontvang je e-mails van Zayna Home. Je kunt je op elk moment uitschrijven.'
  assign privacy_url = s.privacy_url | default: shop.privacy_policy.url
-%}

<section
  id="ZaynaNewsletter-{{ section.id }}"
  class="zayna-newsletter"
  aria-labelledby="{{ newsletter_heading_id }}"
>
  <div class="zayna-newsletter__glow" aria-hidden="true"></div>

  <div class="zayna-newsletter__inner">
    <div class="zayna-newsletter__intro">
      <p class="zayna-newsletter__eyebrow">
        <span aria-hidden="true"></span>
        {{ eyebrow | escape }}
      </p>

      <h2
        id="{{ newsletter_heading_id }}"
        class="zayna-newsletter__heading"
      >
        {{ heading | escape }}
      </h2>

      <p class="zayna-newsletter__body">
        {{ body | escape }}
      </p>
    </div>

    {%- form
      'customer',
      id: newsletter_form_id,
      class: 'zayna-newsletter__form',
      novalidate: 'novalidate'
    -%}
      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >

      {%- if form.posted_successfully? -%}
        <div
          id="{{ newsletter_status_id }}"
          class="zayna-newsletter__success"
          role="status"
          tabindex="-1"
          data-newsletter-success
        >
          <span
            class="zayna-newsletter__success-icon"
            aria-hidden="true"
          >
            ✓
          </span>

          <div>
            <p class="zayna-newsletter__success-title">
              Inschrijving ontvangen
            </p>

            <p class="zayna-newsletter__success-text">
              {{ success_message | escape }}
            </p>
          </div>
        </div>
      {%- else -%}
        <div class="zayna-newsletter__field-group">
          <label
            for="{{ newsletter_email_id }}"
            class="zayna-newsletter__label"
          >
            {{ field_label | escape }}
          </label>

          <div class="zayna-newsletter__controls">
            <div class="zayna-newsletter__input-wrap">
              <input
                id="{{ newsletter_email_id }}"
                class="zayna-newsletter__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="{{ placeholder | escape }}"
                autocomplete="email"
                inputmode="email"
                autocapitalize="none"
                spellcheck="false"
                aria-describedby="{{ newsletter_help_id }}{% if form.errors %} {{ newsletter_error_id }}{% endif %}"
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
                required
              >

              <span
                class="zayna-newsletter__input-line"
                aria-hidden="true"
              ></span>
            </div>

            <button
              type="submit"
              class="zayna-newsletter__submit"
              data-newsletter-submit
            >
              <span data-newsletter-submit-label>
                {{ submit_label | escape }}
              </span>

              <span
                class="zayna-newsletter__submit-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </button>
          </div>

          {%- if form.errors -%}
            <div
              id="{{ newsletter_error_id }}"
              class="zayna-newsletter__errors"
              role="alert"
            >
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <p
            id="{{ newsletter_help_id }}"
            class="zayna-newsletter__disclaimer"
          >
            <span>{{ disclaimer | escape }}</span>

            {%- if privacy_url != blank -%}
              <a href="{{ privacy_url }}">
                Lees het privacybeleid.
              </a>
            {%- endif -%}
          </p>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById(
      'ZaynaNewsletter-{{ section.id }}'
    );

    if (!section) return;

    const form = section.querySelector('.zayna-newsletter__form');
    const submitButton = section.querySelector(
      '[data-newsletter-submit]'
    );
    const submitLabel = section.querySelector(
      '[data-newsletter-submit-label]'
    );
    const successMessage = section.querySelector(
      '[data-newsletter-success]'
    );

    if (successMessage) {
      window.requestAnimationFrame(() => {
        try {
          successMessage.focus({ preventScroll: true });
        } catch (error) {
          successMessage.focus();
        }
      });
    }

    if (!form || !submitButton || !submitLabel) return;

    form.addEventListener('submit', (event) => {
      if (!form.checkValidity()) {
        event.preventDefault();
        form.reportValidity();
        return;
      }

      submitButton.disabled = true;
      submitButton.setAttribute('aria-busy', 'true');
      submitLabel.textContent = 'Even geduld';
    });
  })();
</script>

{% style %}
  #ZaynaNewsletter-{{ section.id }} {
    --zayna-newsletter-bg: #27231f;
    --zayna-newsletter-surface: #fffaf5;
    --zayna-newsletter-soft: rgba(255, 250, 245, 0.72);
    --zayna-newsletter-muted: rgba(255, 250, 245, 0.58);
    --zayna-newsletter-border: rgba(255, 250, 245, 0.3);
    --zayna-newsletter-accent: #b97848;
    --zayna-newsletter-button: #f1e8df;
    --zayna-newsletter-button-hover: #e7dbd0;
    --zayna-newsletter-ink: #29241f;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 46px 0 44px;
    background: var(--zayna-newsletter-bg);
    color: var(--zayna-newsletter-surface);
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        55% 80% at 88% 5%,
        rgba(185, 120, 72, 0.12),
        transparent 68%
      ),
      radial-gradient(
        70% 90% at 5% 100%,
        rgba(150, 138, 123, 0.07),
        transparent 72%
      );
    pointer-events: none;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
    display: grid;
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 0 20px;
    gap: 20px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__intro,
  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
    min-width: 0;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 11px;
    color: #d2986d;
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.21em;
    text-transform: uppercase;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__eyebrow
    > span {
    display: block;
    width: 28px;
    height: 1px;
    flex: 0 0 28px;
    background: rgba(210, 152, 109, 0.72);
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
    max-width: 16ch;
    margin: 0;
    color: var(--zayna-newsletter-surface);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(27px, 7.4vw, 31px);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -0.026em;
    text-wrap: balance;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
    max-width: 43ch;
    margin: 17px 0 0;
    color: var(--zayna-newsletter-soft);
    font-size: 14px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
    width: 100%;
    max-width: 620px;
    align-self: center;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__field-group {
    width: 100%;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__label {
    display: block;
    margin-bottom: 9px;
    color: rgba(255, 250, 245, 0.76);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__controls {
    display: grid;
    gap: 13px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__input-wrap {
    position: relative;
    min-width: 0;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 52px;
    padding: 7px 2px 9px;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--zayna-newsletter-surface);
    font: inherit;
    font-size: 16px;
    line-height: 1.3;
    appearance: none;
    -webkit-appearance: none;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input::placeholder {
    color: rgba(255, 250, 245, 0.42);
    opacity: 1;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    height: 1px;
    background: var(--zayna-newsletter-border);
    transform-origin: left center;
    transition:
      height 180ms ease,
      background-color 180ms ease;
    pointer-events: none;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input:focus
    + .zayna-newsletter__input-line {
    height: 2px;
    background: #d2986d;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input[aria-invalid="true"]
    + .zayna-newsletter__input-line {
    height: 2px;
    background: #e3a08e;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__submit {
    display: inline-flex;
    width: 100%;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 12px 20px;
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--zayna-newsletter-button);
    color: var(--zayna-newsletter-ink);
    font: inherit;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__submit:disabled {
    opacity: 0.62;
    cursor: wait;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__submit-arrow {
    font-size: 15px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__disclaimer {
    max-width: 46ch;
    margin: 14px 0 0;
    color: rgba(255, 250, 245, 0.68);
    font-size: 12px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__disclaimer
    > span {
    display: block;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__disclaimer
    a {
    display: inline-block;
    margin-top: 4px;
    color: rgba(255, 250, 245, 0.86);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__errors {
    margin-top: 12px;
    color: #f1b2a2;
    font-size: 12px;
    line-height: 1.5;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__errors
    ul {
    margin: 0;
    padding-left: 18px;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__errors
    a {
    color: inherit;
    text-underline-offset: 3px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__success {
    display: flex;
    max-width: 520px;
    align-items: flex-start;
    gap: 14px;
    padding: 19px 0 3px;
    border-top: 1px solid var(--zayna-newsletter-border);
    outline: none;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__success-icon {
    display: grid;
    width: 29px;
    height: 29px;
    flex: 0 0 29px;
    place-items: center;
    border: 1px solid rgba(210, 152, 109, 0.72);
    border-radius: 50%;
    color: #d2986d;
    font-size: 13px;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__success-title {
    margin: 0;
    color: var(--zayna-newsletter-surface);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: 19px;
    line-height: 1.3;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__success-text {
    max-width: 44ch;
    margin: 5px 0 0;
    color: var(--zayna-newsletter-soft);
    font-size: 13px;
    line-height: 1.55;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__submit:focus-visible,
  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__disclaimer
    a:focus-visible {
    outline: 2px solid #d2986d;
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__submit:hover {
      background: var(--zayna-newsletter-button-hover);
    }

    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__submit:hover
      .zayna-newsletter__submit-arrow {
      transform: translateX(3px);
    }

    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__disclaimer
      a:hover {
      color: var(--zayna-newsletter-surface);
    }
  }

  @media (max-width: 389px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 42px;
      padding-bottom: 40px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      padding-right: 18px;
      padding-left: 18px;
      gap: 22px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
      font-size: 26px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
      font-size: 13.5px;
    }
  }

  /*
    Op een gesplitst laptopvenster blijft de tekst boven het formulier,
    maar veld en knop staan naast elkaar. Echte smalle telefoons houden
    de ruimere, gestapelde mobiele bediening.
  */
  @media (hover: hover) and (pointer: fine) and (min-width: 560px) and (max-width: 959px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 34px;
      padding-bottom: 34px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      gap: 14px;
      padding-right: 28px;
      padding-left: 28px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
      max-width: 21ch;
      font-size: clamp(27px, 3.6vw, 30px);
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
      max-width: 50ch;
      margin-top: 12px;
      font-size: 13.8px;
      line-height: 1.58;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
      max-width: 720px;
      justify-self: start;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__controls {
      grid-template-columns: minmax(0, 1fr) 150px;
      align-items: end;
      gap: 10px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__submit {
      width: 150px;
      min-width: 150px;
      min-height: 48px;
      padding-right: 16px;
      padding-left: 16px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__disclaimer {
      max-width: 44ch;
      margin-top: 12px;
    }
  }

  @media (min-width: 960px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 44px;
      padding-bottom: 42px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(430px, 0.85fr);
      align-items: center;
      gap: clamp(34px, 4vw, 56px);
      padding-right: 36px;
      padding-left: 36px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
      max-width: 18ch;
      font-size: clamp(33px, 3vw, 38px);
      line-height: 1.05;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
      max-width: 42ch;
      margin-top: 15px;
      font-size: 14.5px;
      line-height: 1.62;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
      max-width: 560px;
      justify-self: end;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__controls {
      grid-template-columns: minmax(0, 1fr) 150px;
      align-items: end;
      gap: 10px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__submit {
      width: 150px;
      min-width: 150px;
      min-height: 48px;
      padding-right: 16px;
      padding-left: 16px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__disclaimer {
      max-width: 44ch;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 48px;
      padding-bottom: 44px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      gap: 52px;
      padding-right: 0;
      padding-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__input-line,
    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__submit,
    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__submit-arrow {
      transition: none;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_v2",
      "label": "Kleine bovenregel",
      "default": "Nieuwsbrief"
    },
    {
      "type": "text",
      "id": "heading_v2",
      "label": "Titel",
      "default": "Ontvang rustige inspiratie voor thuis."
    },
    {
      "type": "textarea",
      "id": "body_v2",
      "label": "Tekst",
      "default": "Blijf op de hoogte van nieuwe collecties, rustige woon- en keukeninspiratie en af en toe nieuws van Zayna Home."
    },
    {
      "type": "text",
      "id": "field_label_v2",
      "label": "Veldlabel",
      "default": "E-mailadres"
    },
    {
      "type": "text",
      "id": "placeholder_v2",
      "label": "Placeholder",
      "default": "jouw@email.nl"
    },
    {
      "type": "text",
      "id": "submit_label_v2",
      "label": "Knoptekst",
      "default": "Inschrijven"
    },
    {
      "type": "textarea",
      "id": "success_v2",
      "label": "Succesmelding",
      "default": "Bedankt voor je inschrijving. Vanaf nu ontvang je af en toe nieuws van Zayna Home."
    },
    {
      "type": "textarea",
      "id": "disclaimer_v2",
      "label": "Privacytekst",
      "default": "Door je in te schrijven ontvang je e-mails van Zayna Home. Je kunt je op elk moment uitschrijven."
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Link naar privacybeleid"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}