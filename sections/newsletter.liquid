{%- liquid
  assign s = section.settings

  assign newsletter_heading_id = 'ZaynaNewsletterHeading-' | append: section.id
  assign newsletter_form_id = 'ZaynaNewsletterForm-' | append: section.id
  assign newsletter_email_id = 'ZaynaNewsletterEmail-' | append: section.id
  assign newsletter_help_id = 'ZaynaNewsletterHelp-' | append: section.id
  assign newsletter_error_id = 'ZaynaNewsletterError-' | append: section.id
  assign newsletter_status_id = 'ZaynaNewsletterStatus-' | append: section.id

  assign eyebrow = s.eyebrow_v2 | default: 'Nieuwsbrief'
  assign old_heading = 'Ontvang rustige inspiratie voor thuis.'
  assign heading = s.heading_v2
  if heading == blank or heading == old_heading
    assign heading = 'Rustige inspiratie voor thuis.'
  endif
  assign old_body = 'Blijf op de hoogte van nieuwe collecties, rustige woon- en keukeninspiratie en af en toe nieuws van Zayna Home.'
  assign old_body_v2 = 'Ontvang af en toe nieuwe collecties, rustige keuken- en wooninspiratie en updates van Zayna Home.'
  assign old_body_v3 = 'Af en toe nieuwe collecties, wooninspiratie en updates van Zayna Home.'
  assign old_placeholder = 'jouw@email.nl'
  assign old_success = 'Bedankt voor je inschrijving. Vanaf nu ontvang je af en toe nieuws van Zayna Home.'
  assign old_success_v2 = 'Bedankt voor je inschrijving. Je ontvangt af en toe inspiratie en updates van Zayna Home.'
  assign old_disclaimer = 'Door je in te schrijven ontvang je e-mails van Zayna Home. Je kunt je op elk moment uitschrijven.'
  assign old_disclaimer_v2 = 'Je ontvangt e-mails van Zayna Home en kunt je op elk moment uitschrijven.'

  assign body = s.body_v2
  if body == blank or body == old_body or body == old_body_v2 or body == old_body_v3
    assign body = 'Nieuwe collecties, wooninspiratie en updates van Zayna Home. Rustig en af en toe.'
  endif

  assign field_label = s.field_label_v2 | default: 'E-mailadres'

  assign placeholder = s.placeholder_v2
  if placeholder == blank or placeholder == old_placeholder
    assign placeholder = 'naam@email.nl'
  endif

  assign submit_label = s.submit_label_v2 | default: 'Inschrijven'

  assign success_message = s.success_v2
  if success_message == blank or success_message == old_success or success_message == old_success_v2
    assign success_message = 'Bedankt, je inschrijving is ontvangen.'
  endif

  assign disclaimer = s.disclaimer_v2
  if disclaimer == blank or disclaimer == old_disclaimer or disclaimer == old_disclaimer_v2
    assign disclaimer = 'Je ontvangt af en toe e-mails van Zayna Home en kunt je op elk moment uitschrijven.'
  endif

  assign error_message = s.error_v2 | default: 'Vul een geldig e-mailadres in.'
  assign privacy_url = s.privacy_url | default: shop.privacy_policy.url
-%}

<section
  id="ZaynaNewsletter-{{ section.id }}"
  class="zayna-newsletter"
  aria-labelledby="{{ newsletter_heading_id }}"
>
  <div class="zayna-newsletter__glow" aria-hidden="true"></div>

  <div class="zayna-newsletter__inner">
    <div class="zayna-newsletter__intro">
      <p class="zayna-newsletter__eyebrow">
        <span aria-hidden="true"></span>
        {{ eyebrow | escape }}
      </p>

      <h2
        id="{{ newsletter_heading_id }}"
        class="zayna-newsletter__heading"
      >
        {{ heading | escape }}
      </h2>

      <p class="zayna-newsletter__body">
        {{ body | escape }}
      </p>
    </div>

    {%- form
      'customer',
      id: newsletter_form_id,
      class: 'zayna-newsletter__form',
      novalidate: 'novalidate'
    -%}
      <input
        type="hidden"
        name="contact[tags]"
        value="newsletter"
      >

      {%- if form.posted_successfully? -%}
        <div
          id="{{ newsletter_status_id }}"
          class="zayna-newsletter__success"
          role="status"
          tabindex="-1"
          data-newsletter-success
        >
          <p class="zayna-newsletter__success-label">
            Inschrijving ontvangen
          </p>

          <p class="zayna-newsletter__success-text">
            {{ success_message | escape }}
          </p>
        </div>
      {%- else -%}
        <div class="zayna-newsletter__field-group">
          <label
            for="{{ newsletter_email_id }}"
            class="zayna-newsletter__label"
          >
            {{ field_label | escape }}
          </label>

          <div class="zayna-newsletter__controls">
            <div class="zayna-newsletter__input-wrap">
              <input
                id="{{ newsletter_email_id }}"
                class="zayna-newsletter__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                placeholder="{{ placeholder | escape }}"
                autocomplete="email"
                inputmode="email"
                autocapitalize="none"
                spellcheck="false"
                aria-describedby="{{ newsletter_help_id }} {{ newsletter_error_id }}"
                {% if form.errors %}
                  aria-invalid="true"
                {% endif %}
                required
              >

              <span
                class="zayna-newsletter__input-line"
                aria-hidden="true"
              ></span>
            </div>

            <button
              type="submit"
              class="zayna-newsletter__submit"
              data-newsletter-submit
            >
              <span data-newsletter-submit-label>
                {{ submit_label | escape }}
              </span>

              <span
                class="zayna-newsletter__submit-arrow"
                aria-hidden="true"
              >
                →
              </span>
            </button>
          </div>

          <div
            id="{{ newsletter_error_id }}"
            class="zayna-newsletter__errors{% unless form.errors %} is-hidden{% endunless %}"
            role="alert"
            data-newsletter-error
          >
            {%- if form.errors -%}
              {{ error_message | escape }}
            {%- endif -%}
          </div>

          <p
            id="{{ newsletter_help_id }}"
            class="zayna-newsletter__disclaimer"
          >
            <span>{{ disclaimer | escape }}</span>

            {%- if privacy_url != blank -%}
              <a href="{{ privacy_url }}">
                Lees het privacybeleid.
              </a>
            {%- endif -%}
          </p>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById(
      'ZaynaNewsletter-{{ section.id }}'
    );

    if (!section) return;

    const form = section.querySelector('.zayna-newsletter__form');
    const emailInput = section.querySelector('.zayna-newsletter__input');
    const errorMessage = section.querySelector('[data-newsletter-error]');
    const submitButton = section.querySelector(
      '[data-newsletter-submit]'
    );
    const submitLabel = section.querySelector(
      '[data-newsletter-submit-label]'
    );
    const successMessage = section.querySelector(
      '[data-newsletter-success]'
    );

    const cleanupNewsletterUrl = () => {
      if (!window.history || !window.history.replaceState) return;

      const url = new URL(window.location.href);
      let shouldUpdate = false;

      if (url.searchParams.has('customer_posted')) {
        url.searchParams.delete('customer_posted');
        shouldUpdate = true;
      }

      if (url.searchParams.has('contact_posted')) {
        url.searchParams.delete('contact_posted');
        shouldUpdate = true;
      }

      if (url.hash === '#contact_form' || url.hash === '#newsletter') {
        url.hash = '';
        shouldUpdate = true;
      }

      if (shouldUpdate) {
        const cleanUrl = `${url.pathname}${url.search}${url.hash}`;
        window.history.replaceState({}, document.title, cleanUrl);
      }
    };

    if (successMessage) {
      cleanupNewsletterUrl();

      try {
        const savedScrollY = window.sessionStorage?.getItem(
          'zhNewsletterScrollY'
        );
        const parsedScrollY = Number(savedScrollY);

        if (Number.isFinite(parsedScrollY)) {
          window.requestAnimationFrame(() => {
            window.scrollTo({ top: parsedScrollY, behavior: 'auto' });
          });
        }

        window.sessionStorage?.removeItem('zhNewsletterScrollY');
        window.sessionStorage?.removeItem('zhNewsletterReturnTo');
      } catch (error) {
        // Do nothing when storage is unavailable.
      }
    }

    if (!form || !emailInput || !submitButton || !submitLabel) return;

    form.setAttribute('novalidate', 'novalidate');
    emailInput.setAttribute('novalidate', 'novalidate');

    const customErrorText = {{ error_message | json }};
    const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

    const isEmailValid = () => {
      const value = emailInput.value.trim();
      return value !== '' && emailPattern.test(value);
    };

    const stopSubmit = (event) => {
      event.preventDefault();
      event.stopPropagation();

      if (typeof event.stopImmediatePropagation === 'function') {
        event.stopImmediatePropagation();
      }
    };

    const showError = () => {
      emailInput.setAttribute('aria-invalid', 'true');

      if (errorMessage) {
        errorMessage.textContent = customErrorText;
        errorMessage.classList.remove('is-hidden');
      }
    };

    const clearError = () => {
      emailInput.removeAttribute('aria-invalid');

      if (errorMessage) {
        errorMessage.textContent = customErrorText;
        errorMessage.classList.add('is-hidden');
      }
    };

    clearError();

    emailInput.addEventListener('input', () => {
      if (emailInput.value.trim() === '' || isEmailValid()) {
        clearError();
      }
    });

    const handleNewsletterAttempt = (event) => {
      if (!isEmailValid()) {
        stopSubmit(event);
        showError();
        return false;
      }

      return true;
    };

    submitButton.addEventListener(
      'click',
      (event) => {
        handleNewsletterAttempt(event);
      },
      true
    );

    form.addEventListener(
      'submit',
      (event) => {
        if (!handleNewsletterAttempt(event)) return;

        clearError();

        try {
          window.sessionStorage?.setItem(
            'zhNewsletterScrollY',
            String(window.scrollY || 0)
          );
        } catch (error) {
          // Do nothing when storage is unavailable.
        }

        submitButton.disabled = true;
        submitButton.setAttribute('aria-busy', 'true');
        submitLabel.textContent = 'Even geduld';
      },
      true
    );
  })();
</script>

{% style %}
  #ZaynaNewsletter-{{ section.id }} {
    --zayna-newsletter-bg: #332820;
    --zayna-newsletter-bg-soft: #3a2f27;
    --zayna-newsletter-surface: #fffaf5;
    --zayna-newsletter-soft: rgba(255, 250, 245, 0.72);
    --zayna-newsletter-muted: rgba(255, 250, 245, 0.58);
    --zayna-newsletter-border: rgba(255, 250, 245, 0.3);
    --zayna-newsletter-accent: #c1845a;
    --zayna-newsletter-button: #efe3d7;
    --zayna-newsletter-button-hover: #e6d6c8;
    --zayna-newsletter-ink: #29241f;

    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 34px 0 26px;
    background: linear-gradient(135deg, var(--zayna-newsletter-bg-soft) 0%, var(--zayna-newsletter-bg) 72%);
    color: var(--zayna-newsletter-surface);
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        55% 80% at 88% 5%,
        rgba(193, 132, 90, 0.105),
        transparent 68%
      ),
      radial-gradient(
        70% 90% at 5% 100%,
        rgba(150, 138, 123, 0.055),
        transparent 72%
      );
    pointer-events: none;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
    display: grid;
    width: min(100%, 1180px);
    margin: 0 auto;
    padding: 0 20px;
    gap: 14px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__intro,
  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
    min-width: 0;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 11px;
    color: #d2986d;
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.21em;
    text-transform: uppercase;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__eyebrow
    > span {
    display: block;
    width: 28px;
    height: 1px;
    flex: 0 0 28px;
    background: rgba(210, 152, 109, 0.72);
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
    max-width: 16ch;
    margin: 0;
    color: var(--zayna-newsletter-surface);
    font-family:
      var(
        --font-display,
        var(--font-heading-family, Georgia, serif)
      );
    font-size: clamp(27px, 7.4vw, 31px);
    font-weight: 400;
    line-height: 1.07;
    letter-spacing: -0.026em;
    text-wrap: balance;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
    max-width: 42ch;
    margin: 15px 0 0;
    color: var(--zayna-newsletter-soft);
    font-size: 14px;
    line-height: 1.65;
    text-wrap: pretty;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
    width: 100%;
    max-width: 620px;
    min-height: 154px;
    align-self: center;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__field-group {
    width: 100%;
    min-height: 154px;
    padding-top: 2px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__label {
    display: block;
    margin-bottom: 9px;
    color: rgba(255, 250, 245, 0.76);
    font-size: 9px;
    line-height: 1.4;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__controls {
    display: grid;
    gap: 13px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__input-wrap {
    position: relative;
    min-width: 0;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 50px;
    padding: 7px 2px 8px;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--zayna-newsletter-surface);
    font: inherit;
    font-size: 16px;
    line-height: 1.3;
    appearance: none;
    -webkit-appearance: none;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input::placeholder {
    color: rgba(255, 250, 245, 0.42);
    opacity: 1;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input-line {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: block;
    height: 1px;
    background: var(--zayna-newsletter-border);
    transform-origin: left center;
    transition:
      height 180ms ease,
      background-color 180ms ease;
    pointer-events: none;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input:focus
    + .zayna-newsletter__input-line {
    height: 2px;
    background: #d2986d;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__input[aria-invalid="true"]
    + .zayna-newsletter__input-line {
    height: 2px;
    background: #e3a08e;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__submit {
    display: inline-flex;
    width: 100%;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 12px 20px;
    border: 1px solid transparent;
    border-radius: 0;
    background: var(--zayna-newsletter-button);
    color: var(--zayna-newsletter-ink);
    font: inherit;
    font-size: 10px;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 180ms ease,
      color 180ms ease,
      opacity 180ms ease;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__submit:disabled {
    opacity: 0.62;
    cursor: wait;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__submit-arrow {
    font-size: 15px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__disclaimer {
    max-width: 46ch;
    margin: 8px 0 0;
    color: rgba(255, 250, 245, 0.64);
    font-size: 12px;
    line-height: 1.55;
    text-wrap: pretty;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__disclaimer
    > span {
    display: block;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__disclaimer
    a {
    display: inline-block;
    margin-top: 4px;
    color: rgba(255, 250, 245, 0.86);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__errors {
    min-height: 18px;
    margin-top: 7px;
    color: #e8b7aa;
    font-size: 12px;
    line-height: 1.5;
    opacity: 1;
    visibility: visible;
    transition: opacity 160ms ease;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__errors.is-hidden {
    opacity: 0;
    visibility: hidden;
  }

  #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__success {
    display: grid;
    max-width: 520px;
    min-height: 154px;
    align-content: start;
    gap: 5px;
    padding: 2px 0 2px;
    outline: none;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__success-label {
    margin: 0;
    color: #d2986d;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__success-text {
    max-width: 44ch;
    margin: 0;
    color: var(--zayna-newsletter-soft);
    font-size: 13px;
    line-height: 1.55;
  }

  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__submit:focus-visible,
  #ZaynaNewsletter-{{ section.id }}
    .zayna-newsletter__disclaimer
    a:focus-visible {
    outline: 2px solid #d2986d;
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__submit:hover {
      background: var(--zayna-newsletter-button-hover);
    }

    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__submit:hover
      .zayna-newsletter__submit-arrow {
      transform: translateX(3px);
    }

    #ZaynaNewsletter-{{ section.id }}
      .zayna-newsletter__disclaimer
      a:hover {
      color: var(--zayna-newsletter-surface);
    }
  }

  @media (max-width: 389px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 30px;
      padding-bottom: 24px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      padding-right: 18px;
      padding-left: 18px;
      gap: 8px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
      font-size: 26px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
      font-size: 13.5px;
    }
  }

  /*
    Op een gesplitst laptopvenster blijft de tekst boven het formulier,
    maar veld en knop staan naast elkaar. Echte smalle telefoons houden
    de ruimere, gestapelde mobiele bediening.
  */
  @media (hover: hover) and (pointer: fine) and (min-width: 560px) and (max-width: 959px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 32px;
      padding-bottom: 16px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      gap: 14px;
      padding-right: 28px;
      padding-left: 28px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
      max-width: 21ch;
      font-size: clamp(27px, 3.6vw, 30px);
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
      max-width: 50ch;
      margin-top: 12px;
      font-size: 13.8px;
      line-height: 1.58;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
      max-width: 720px;
      min-height: 136px;
      justify-self: start;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__field-group,
    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__success {
      min-height: 136px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__controls {
      grid-template-columns: minmax(0, 1fr) 150px;
      align-items: end;
      gap: 10px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__submit {
      width: 150px;
      min-width: 150px;
      min-height: 48px;
      padding-right: 16px;
      padding-left: 16px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__disclaimer {
      max-width: 44ch;
      margin-top: 12px;
    }
  }

  @media (min-width: 960px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 44px;
      padding-bottom: 30px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__inner {
      grid-template-columns: minmax(0, 0.95fr) minmax(430px, 0.85fr);
      align-items: center;
      gap: clamp(34px, 4vw, 56px);
      padding-right: 36px;
      padding-left: 36px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__heading {
      max-width: 18ch;
      font-size: clamp(33px, 3vw, 38px);
      line-height: 1.05;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__body {
      max-width: 42ch;
      margin-top: 15px;
      font-size: 14.5px;
      line-height: 1.62;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__form {
      max-width: 560px;
      min-height: 136px;
      justify-self: end;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__field-group,
    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__success {
      min-height: 136px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__controls {
      grid-template-columns: minmax(0, 1fr) 150px;
      align-items: end;
      gap: 10px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__submit {
      width: 150px;
      min-width: 150px;
      min-height: 48px;
      padding-right: 16px;
      padding-left: 16px;
    }

    #ZaynaNewsletter-{{ section.id }} .zayna-newsletter__disclaimer {
      max-width: 44ch;
    }
  }

  @media (min-width: 1180px) {
    #ZaynaNewsletter-{{ section.id }} {
      padding-top: 48px;
